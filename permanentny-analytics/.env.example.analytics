# Server-only. Obtain from your PostgreSQL/Neon integration in Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Safe rollout switch. Keep false until Preview collector + DB are verified.
PUBLIC_PA_ENABLED=false

# Separate production activation, only after approval and production DB checks.
# Production requires BOTH switches to be exactly true. Redeploy after changing.
PUBLIC_PA_PRODUCTION_ENABLED=false
