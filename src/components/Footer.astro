---
import { booksyUrl, serviceLinks, exploreLinks, socialLinks, formalLinks } from '../data/site-navigation';
const year = new Date().getFullYear();
---
<footer class="site-footer bph-footer">
  <div class="bph-footer-shell">
    <div class="bph-footer-grid">
      <div class="bph-footer-brand"><a class="bph-footer-logo" href="/" aria-label="Bogusława Herda — strona główna"><img src="/images/logo-boguslawa-herda-pmu-desktop.webp" alt="Bogusława Herda · Makijaż permanentny" width="1600" height="334" loading="lazy" decoding="async" /></a><p>Powrót do natury.<br />Makijaż permanentny dopasowany do Ciebie.</p><a class="bph-footer-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Umów wizytę w Booksy ↗</a><div class="bph-footer-social">{socialLinks.slice(0,2).map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div>
      <nav class="bph-footer-nav" aria-label="Zabiegi w gabinecie"><h2>Zabiegi</h2>{serviceLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>
      <nav class="bph-footer-nav" aria-label="Informacje o gabinecie"><h2>Poznaj nas</h2>{exploreLinks.map(link => <a href={link.href}>{link.label}</a>)}<a href="/sercemmalowane/">#SercemMalowane</a></nav>
      <div class="bph-footer-contact"><h2>Porozmawiajmy.</h2><a class="bph-footer-phone" href="tel:+48730900125">730 900 125</a><a href="mailto:bogusia@permanentnybielsko.com">bogusia@permanentnybielsko.com</a><address>ul. Barlickiego 5/23<br />43-300 Bielsko-Biała</address><a href={socialLinks[2].href} target="_blank" rel="noopener noreferrer">Mapa i opinie Google ↗</a><a class="bph-footer-sister" href="https://kosmetologiabielsko.com" target="_blank" rel="noopener noreferrer">Poznaj także naszą kosmetologię ↗</a></div>
    </div>
    <div class="bph-footer-bottom"><nav aria-label="Dokumenty i mapa strony">{formalLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav><p>© {year} Bogusława Herda · BPHM®</p></div>
  </div>
</footer>
<style>
  .bph-footer{position:relative;padding:56px 0 24px;border-top:1px solid #e8dfe2;background:#fcf7f8;color:#292323;font-family:"Inter",system-ui,sans-serif}
  .bph-footer *{box-sizing:border-box;min-width:0}.bph-footer a{color:#126b65;text-decoration:none;line-height:1.5}.bph-footer a:hover{text-decoration:underline}.bph-footer a:focus-visible{outline:3px solid #126b65;outline-offset:4px}
  .bph-footer-shell{width:min(1200px,calc(100% - 56px));margin:auto}.bph-footer-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.8fr) minmax(0,.8fr) minmax(0,1.2fr);gap:32px}
  .bph-footer h2{margin:0 0 14px;font-size:1rem;line-height:1.4;font-weight:750;letter-spacing:-.015em}.bph-footer-logo{display:flex;align-items:center;min-height:44px;max-width:250px}.bph-footer-logo img{display:block;width:100%;height:auto}
  .bph-footer-brand p{margin:20px 0;color:#625958;font-size:.9rem;line-height:1.7}.bph-footer .bph-footer-booksy{display:inline-flex;justify-content:center;align-items:center;min-height:46px;padding:12px 16px;border:1px solid #126b65;border-radius:13px;background:#126b65;color:#fff;font-size:.84rem;font-weight:700;text-align:center}
  .bph-footer-social{display:flex;flex-wrap:wrap;gap:0 20px;margin-top:10px}.bph-footer-social a{display:flex;align-items:center;min-height:44px;font-size:.8rem}
  .bph-footer-nav a{display:flex;align-items:center;min-height:44px;padding:7px 0;font-size:.85rem}.bph-footer-contact>a{display:flex;align-items:center;min-height:44px;padding:7px 0;font-size:.84rem;overflow-wrap:anywhere}
  .bph-footer-contact .bph-footer-phone{font-size:1.4rem;font-weight:750;letter-spacing:-.025em}.bph-footer address{margin:14px 0 4px;color:#625958;font-style:normal;font-size:.87rem;line-height:1.7}.bph-footer-contact .bph-footer-sister{margin-top:8px;font-size:.75rem}
  .bph-footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px 24px;margin-top:36px;padding-top:16px;border-top:1px solid #e8dfe2}.bph-footer-bottom nav{display:flex;flex-wrap:wrap;gap:0 24px}.bph-footer-bottom a{display:flex;align-items:center;min-height:44px;font-size:.73rem}.bph-footer-bottom p{margin:0;color:#625958;font-size:.73rem;line-height:1.5}
  @media(max-width:1024px){.bph-footer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bph-footer-brand{order:0}.bph-footer-contact{order:1}.bph-footer-nav{order:2}}
  @media(max-width:640px){.bph-footer{padding:36px 0 22px}.bph-footer-shell{width:calc(100% - 36px)}.bph-footer-grid{gap:28px 20px}.bph-footer-brand,.bph-footer-contact{grid-column:1 / -1}.bph-footer-contact{padding:22px 20px;border:1px solid #d4e7e2;border-radius:22px;background:#eff8f5}.bph-footer-bottom{margin-top:28px;gap:14px}.bph-footer-bottom nav{gap:0 18px}}
</style>
