---
import { booksyUrl, serviceLinks, exploreLinks, socialLinks, formalLinks } from '../data/site-navigation';
import { siteConfig } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer bph-footer" id="stopka">
  <div class="bph-footer-shell">
    <div class="bph-footer-grid">
      <div class="bph-footer-brand">
        <a class="bph-footer-logo" href="/" aria-label="Bogusława Herda — strona główna"><img src="/images/logo-boguslawa-herda-pmu-desktop.webp" alt="Bogusława Herda · Makijaż permanentny" width="1600" height="334" loading="lazy" decoding="async" /></a>
        <p><span>Powrót do natury.</span><br />Makijaż permanentny dopasowany do Ciebie.</p>
        <a class="bph-footer-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer"><span class="bph-footer-desktop-label">Umów wizytę w Booksy ↗</span><span class="bph-footer-mobile-label">Umów wizytę w Booksy <span aria-hidden="true">↗</span></span></a>
        <div class="bph-footer-social" aria-label="Media społecznościowe">
          {socialLinks.slice(0,2).map((link, index) => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} — otwiera nową kartę`}>
            <span class="bph-footer-social-icon" aria-hidden="true">
              {index === 0 ? <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg> : <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M14 21v-8h3l.5-4H14V7c0-1.1.4-2 2-2h2V1.4A24 24 0 0 0 15 1c-3 0-5 1.8-5 5v3H7v4h3v8z"/></svg>}
            </span>
            <span>{link.label}<span class="bph-footer-social-arrow" aria-hidden="true"> ↗</span></span>
          </a>)}
        </div>
      </div>
      <nav class="bph-footer-nav" aria-label="Zabiegi w gabinecie"><h2>Zabiegi</h2>{serviceLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>
      <nav class="bph-footer-nav" aria-label="Informacje o gabinecie"><h2>Poznaj nas</h2>{exploreLinks.map(link => <a href={link.href}>{link.label}</a>)}<a href="/sercemmalowane/">#SercemMalowane</a></nav>
      <div class="bph-footer-contact"><h2>Porozmawiajmy.</h2><a class="bph-footer-phone" href="tel:+48730900125">730 900 125</a><a class="bph-footer-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><address>ul. Barlickiego 5/23<br />43-300 Bielsko-Biała</address><a class="bph-footer-map" href={socialLinks[2].href} target="_blank" rel="noopener noreferrer"><span class="bph-footer-desktop-label">Mapa i opinie Google ↗</span><span class="bph-footer-mobile-label">Otwórz w Google Maps <span aria-hidden="true">↗</span></span></a><a class="bph-footer-sister" href="https://kosmetologiabielsko.com" target="_blank" rel="noopener noreferrer">Poznaj także naszą kosmetologię ↗</a></div>
    </div>
    <div class="bph-footer-bottom"><nav aria-label="Dokumenty i mapa strony">{formalLinks.map(link => <a href={link.href}>{link.label}</a>)}<button type="button" class="bph-footer-privacy" data-cookie-reopen>Ustawienia prywatności</button></nav><p>© {year} Bogusława Herda · BPHM®</p></div>
  </div>
</footer>
<style>
  .bph-footer{position:relative;padding:56px 0 24px;border-top:1px solid #e8dfe2;background:#fcf7f8;color:#292323;font-family:"Inter",system-ui,sans-serif}
  .bph-footer *{box-sizing:border-box;min-width:0}.bph-footer a{color:#126b65;text-decoration:none;line-height:1.5}.bph-footer a:hover{text-decoration:underline}.bph-footer a:focus-visible{outline:3px solid #126b65;outline-offset:4px}
  .bph-footer-shell{width:min(1200px,calc(100% - 56px));margin:auto}.bph-footer-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.8fr) minmax(0,.8fr) minmax(0,1.2fr);gap:32px}
  .bph-footer h2{margin:0 0 14px;font-size:1rem;line-height:1.4;font-weight:750;letter-spacing:-.015em}.bph-footer-logo{display:flex;align-items:center;min-height:44px;max-width:250px}.bph-footer-logo img{display:block;width:100%;height:auto}
  .bph-footer-brand p{margin:20px 0;color:#625958;font-size:.9rem;line-height:1.7}.bph-footer .bph-footer-booksy{display:inline-flex;justify-content:center;align-items:center;min-height:46px;padding:12px 16px;border:1px solid #126b65;border-radius:13px;background:#126b65;color:#fff;font-size:.84rem;font-weight:700;text-align:center}
  .bph-footer-social{display:flex;flex-wrap:wrap;gap:0 20px;margin-top:10px}.bph-footer-social a{display:flex;align-items:center;min-height:44px;font-size:.8rem}
  .bph-footer-nav a{display:flex;align-items:center;min-height:44px;padding:7px 0;font-size:.85rem}.bph-footer-contact>a{display:flex;align-items:center;min-height:44px;padding:7px 0;font-size:.84rem;overflow-wrap:anywhere}
  .bph-footer-contact .bph-footer-phone{font-size:1.4rem;font-weight:750;letter-spacing:-.025em}.bph-footer address{margin:14px 0 4px;color:#625958;font-style:normal;font-size:.87rem;line-height:1.7}.bph-footer-contact .bph-footer-sister{margin-top:8px;font-size:.75rem}
  .bph-footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px 24px;margin-top:36px;padding-top:16px;border-top:1px solid #e8dfe2}.bph-footer-bottom nav{display:flex;flex-wrap:wrap;gap:0 24px}.bph-footer-bottom a{display:flex;align-items:center;min-height:44px;font-size:.73rem}.bph-footer-privacy{display:flex;align-items:center;min-height:44px;padding:0;border:0;background:transparent;color:#126b65;font:inherit;font-size:.73rem;cursor:pointer}.bph-footer-privacy:hover{text-decoration:underline}.bph-footer-privacy:focus-visible{outline:3px solid #126b65;outline-offset:4px}.bph-footer-bottom p{margin:0;color:#625958;font-size:.73rem;line-height:1.5}
  .bph-footer-social-icon,.bph-footer-mobile-label{display:none}
  @media(max-width:1024px){.bph-footer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bph-footer-brand{order:0}.bph-footer-contact{order:1}.bph-footer-nav{order:2}}
  /* Shared mobile footer: branding, social profiles, contact and open navigation. */
  @media(max-width:640px){
    .bph-footer{padding:48px 0 max(24px,env(safe-area-inset-bottom));scroll-margin-top:94px;border-color:#dce2db;background:#f7f6f2;letter-spacing:-.015em;font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
    .bph-footer-shell{width:calc(100% - 48px)}
    .bph-footer-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 24px}
    .bph-footer-brand,.bph-footer-contact{grid-column:1/-1}
    .bph-footer-brand{display:flex;flex-direction:column;align-items:flex-start}
    .bph-footer-brand p{margin:20px 0 16px;max-width:30ch;font-size:1rem;line-height:1.55;font-weight:400}
    .bph-footer-brand p>span{color:#292323}
    .bph-footer-social{gap:12px 24px;margin:0;order:1}
    .bph-footer-social a{gap:10px;min-height:48px;font-size:.875rem;font-weight:500}
    .bph-footer-social-icon{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;border:1px solid #bdcdc3;border-radius:50%;background:transparent}
    .bph-footer-social svg{display:block}
    .bph-footer-social-arrow,.bph-footer-desktop-label{display:none}
    .bph-footer .bph-footer-booksy{order:2;justify-content:space-between;width:100%;min-height:54px;margin-top:24px;padding:15px 18px;border-radius:10px;font-size:.86rem;font-weight:730;line-height:1.45}
    .bph-footer-contact{padding:30px 0 0;border:0;border-top:1px solid #dce2db;border-radius:0;background:transparent}
    .bph-footer-contact h2{margin-bottom:14px;font-size:clamp(30px,8vw,40px);line-height:1.08;letter-spacing:-.045em;font-weight:720}
    .bph-footer-contact .bph-footer-phone{width:fit-content;min-height:48px;padding:4px 0;font-size:clamp(29px,8vw,38px);font-weight:650;letter-spacing:-.035em}
    .bph-footer-contact .bph-footer-email{min-height:44px;font-size:.875rem;line-height:1.5}
    .bph-footer address{margin:22px 0 6px;font-size:1rem;line-height:1.55;color:#292323}
    .bph-footer-mobile-label{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%}
    .bph-footer-contact .bph-footer-map{min-height:48px;font-size:.86rem;line-height:1.45;font-weight:730}
    .bph-footer-contact .bph-footer-sister{margin-top:8px;font-size:.8rem}
    .bph-footer-nav{padding-top:24px;border-top:1px solid #dce2db}
    .bph-footer-nav h2{margin-bottom:10px;font-size:1.1rem;line-height:1.4;font-weight:700;letter-spacing:-.025em}
    .bph-footer-nav a{align-items:flex-start;min-height:44px;padding:10px 0;font-size:.875rem;line-height:1.5;color:#4c514d}
    .bph-footer-nav a:hover{color:#126b65}
    .bph-footer-bottom{display:block;margin-top:30px;padding-top:18px;border-color:#dce2db}
    .bph-footer-bottom nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}
    .bph-footer-bottom a,.bph-footer-privacy{justify-content:flex-start;min-height:44px;padding:8px 0;font-size:.75rem;line-height:1.5;color:#4c514d;text-align:left}
    .bph-footer-bottom p{margin-top:20px;font-size:.75rem;line-height:1.5;color:#625958}
  }
  @media(max-width:360px){
    .bph-footer-shell{width:calc(100% - 40px)}
    .bph-footer-grid,.bph-footer-bottom nav{column-gap:20px}
    .bph-footer-social{column-gap:18px}
    .bph-footer-social a{gap:8px;font-size:.8125rem}
    .bph-footer-contact .bph-footer-email{font-size:.8125rem}
  }
</style>
