---
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pmuLeadUrl = "/makijaz-permanentny-bielsko/#kwalifikacja-pmu";
const instagramUrl = "https://www.instagram.com/permanentnybielsko";
const facebookUrl = "https://www.facebook.com/PermanentnyBielsko";
const googleUrl = "https://share.google/r1H8ZLwSZMdRIflO9";

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "PMU", href: "/makijaz-permanentny-bielsko/" },
  { label: "Brwi", href: "/makijaz-permanentny-brwi/" },
  { label: "Usta", href: "/makijaz-permanentny-ust/" },
  { label: "Kreski", href: "/makijaz-permanentny-oczu/" },
  { label: "Usuwanie", href: "/usuwanie-makijazu-permanentnego/" },
  { label: "Szkolenia", href: "/szkolenie-makijaz-permanentny/" },
  { label: "Poradnik", href: "/poradnik/" },
  { label: "Galeria", href: "/galeria/" },
  { label: "Cennik", href: "/cennik-makijaz-permanentny/" },
  { label: "Kontakt", href: "/kontakt/" },
];

const mobileQuickLinks = [
  { label: "Regulamin", href: "/regulamin-salonu/" },
  { label: "Polityka prywatności", href: "/rodo-polityka-prywatnosci-regulamin/" },
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath === href.replace(/\/$/, "");
};
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <a
      class="header-logo header-logo-image-link"
      href="/"
      aria-label="Bogusława Herda — strona główna"
    >
      <picture class="header-logo-picture">
        <source
          media="(max-width: 1080px)"
          srcset="/images/logo-boguslawa-herda-pmu-mobile.webp"
        />
        <img
          data-header-logo-img
          src="/images/logo-boguslawa-herda-pmu-desktop.webp"
          alt="Bogusława Herda Makijaż Permanentny – Powrót do natury"
          width="1600"
          height="334"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>

      <span class="header-logo-text-fallback" aria-hidden="true">
        <strong>Bogusława Herda</strong>
        <em>Permanentny Make-up</em>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Menu główne">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <nav class="header-socials" aria-label="Profile online">
        <a
          class="header-social-orb header-orb-instagram"
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram PermanentnyBielsko"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.25" cy="6.75" r="1.15"></circle>
          </svg>
        </a>

        <a
          class="header-social-orb header-orb-facebook"
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook PermanentnyBielsko"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.05 8.2V6.7c0-.72.24-1.2 1.31-1.2H17V2.7c-.8-.1-1.58-.16-2.38-.16-2.36 0-3.98 1.44-3.98 4.08V8.2H8v3.14h2.64v10.12h3.41V11.34h2.67l.42-3.14h-3.09Z"></path>
          </svg>
        </a>

        <a
          class="header-social-orb header-orb-google"
          href={googleUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google mapa i opinie"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="g-blue" d="M21.6 12.23c0-.72-.06-1.42-.18-2.08H12v3.94h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.32 2.98-7.39Z"></path>
            <path class="g-green" d="M12 22c2.7 0 4.96-.9 6.62-2.38l-3.24-2.51c-.9.6-2.04.96-3.38.96-2.6 0-4.8-1.76-5.59-4.12H3.06v2.6A10 10 0 0 0 12 22Z"></path>
            <path class="g-yellow" d="M6.41 13.95A6.02 6.02 0 0 1 6.1 12c0-.68.11-1.34.31-1.95v-2.6H3.06A10 10 0 0 0 2 12c0 1.61.39 3.13 1.06 4.55l3.35-2.6Z"></path>
            <path class="g-red" d="M12 5.93c1.47 0 2.79.5 3.82 1.5l2.87-2.87C16.95 2.94 14.7 2 12 2a10 10 0 0 0-8.94 5.45l3.35 2.6C7.2 7.69 9.4 5.93 12 5.93Z"></path>
          </svg>
        </a>
      </nav>

      <a
        class="header-booksy"
        href={booksyUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Umów przez Booksy
      </a>

      <button
        class="mobile-menu-button"
        type="button"
        aria-label="Otwórz menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        data-menu-button
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu-backdrop" data-menu-backdrop></div>

  <aside
    class="mobile-menu-panel"
    id="mobile-menu-panel"
    aria-label="Menu mobilne"
    data-mobile-menu
  >
    <div class="mobile-menu-intro">
      <span>Menu</span>
      <strong>Naturalny PMU · Bielsko-Biała</strong>
    </div>

    <div class="mobile-menu-cta">
      <a
        class="mobile-booksy-cta"
        href={booksyUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Umów przez Booksy
      </a>

      <a class="mobile-form-cta" href={pmuLeadUrl}>
        Mam pytanie przed wizytą
      </a>
    </div>

    <nav class="mobile-nav" aria-label="Menu mobilne">
      {navLinks.map((link, index) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{link.label}</strong>
        </a>
      ))}
    </nav>

    <section class="mobile-social-section" aria-label="Media społecznościowe i profile online">
      <p>Zobacz moje prace</p>

      <div class="mobile-social-links">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link mobile-social-instagram"
          aria-label="Instagram PermanentnyBielsko"
        >
          <span class="mobile-social-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2"></rect>
              <circle cx="12" cy="12" r="4.2"></circle>
              <circle cx="17.25" cy="6.75" r="1.15"></circle>
            </svg>
          </span>
          <strong>Instagram</strong>
        </a>

        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link mobile-social-facebook"
          aria-label="Facebook PermanentnyBielsko"
        >
          <span class="mobile-social-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.05 8.2V6.7c0-.72.24-1.2 1.31-1.2H17V2.7c-.8-.1-1.58-.16-2.38-.16-2.36 0-3.98 1.44-3.98 4.08V8.2H8v3.14h2.64v10.12h3.41V11.34h2.67l.42-3.14h-3.09Z"></path>
            </svg>
          </span>
          <strong>Facebook</strong>
        </a>

        <a
          href={googleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link mobile-social-google"
          aria-label="Google mapa i opinie"
        >
          <span class="mobile-social-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="g-blue" d="M21.6 12.23c0-.72-.06-1.42-.18-2.08H12v3.94h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.32 2.98-7.39Z"></path>
              <path class="g-green" d="M12 22c2.7 0 4.96-.9 6.62-2.38l-3.24-2.51c-.9.6-2.04.96-3.38.96-2.6 0-4.8-1.76-5.59-4.12H3.06v2.6A10 10 0 0 0 12 22Z"></path>
              <path class="g-yellow" d="M6.41 13.95A6.02 6.02 0 0 1 6.1 12c0-.68.11-1.34.31-1.95v-2.6H3.06A10 10 0 0 0 2 12c0 1.61.39 3.13 1.06 4.55l3.35-2.6Z"></path>
              <path class="g-red" d="M12 5.93c1.47 0 2.79.5 3.82 1.5l2.87-2.87C16.95 2.94 14.7 2 12 2a10 10 0 0 0-8.94 5.45l3.35 2.6C7.2 7.69 9.4 5.93 12 5.93Z"></path>
            </svg>
          </span>
          <strong>Google</strong>
        </a>

        <a
          href={booksyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link mobile-social-booksy"
          aria-label="Booksy rezerwacja wizyty"
        >
          <span class="mobile-social-icon mobile-social-booksy-icon">B</span>
          <strong>Booksy</strong>
        </a>
      </div>
    </section>

    <nav class="mobile-formal-links" aria-label="Linki formalne">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </aside>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const button = document.querySelector("[data-menu-button]");
  const panel = document.querySelector("[data-mobile-menu]");
  const backdrop = document.querySelector("[data-menu-backdrop]");
  const logoImage = document.querySelector("[data-header-logo-img]");

  const logoFallbacks = [
    "/images/logo-boguslawa-herda-pmu-desktop.webp",
    "/images/logo-boguslawa-herda-pmu-mobile.webp",
    "/images/logo-boguslawa-herda-pmu-full.webp",
    "/images/logo-boguslawa-herda-black.webp",
    "/images/logo-boguslawa-herda-header.webp",
    "/images/logo-boguslawa-herda-pmu-header.webp",
  ];

  let logoFallbackIndex = 0;

  logoImage?.addEventListener("error", () => {
    if (!(logoImage instanceof HTMLImageElement)) return;

    if (logoFallbackIndex < logoFallbacks.length) {
      const nextLogo = logoFallbacks[logoFallbackIndex];
      logoFallbackIndex += 1;

      if (logoImage.getAttribute("src") !== nextLogo) {
        logoImage.src = nextLogo;
        return;
      }
    }

    logoImage.style.display = "none";
    logoImage.closest(".header-logo")?.classList.add("is-logo-fallback");
  });

  const closeMenu = () => {
    if (!header || !button) return;

    header.classList.remove("is-menu-open");
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-label", "Otwórz menu");
    document.documentElement.classList.remove("mobile-menu-open");
  };

  const openMenu = () => {
    if (!header || !button) return;

    header.classList.add("is-menu-open");
    button.setAttribute("aria-expanded", "true");
    button.setAttribute("aria-label", "Zamknij menu");
    document.documentElement.classList.add("mobile-menu-open");
  };

  button?.addEventListener("click", () => {
    if (header?.classList.contains("is-menu-open")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  backdrop?.addEventListener("click", closeMenu);

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 1080) closeMenu();
  });
</script>

<style>
  :global(html.mobile-menu-open),
  :global(html.mobile-menu-open body) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .site-header {
    position: fixed;
    top: 12px;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0 12px;
    pointer-events: none;
  }

  .header-shell {
    width: min(1480px, 100%);
    min-height: 76px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 10px 12px 10px 16px;
    border: 1px solid rgba(183, 101, 118, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 20px 60px rgba(72, 42, 55, 0.12);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    pointer-events: auto;
  }

  .header-logo,
  .desktop-nav a,
  .header-booksy,
  .mobile-menu-button,
  .mobile-nav a,
  .mobile-formal-links a,
  .header-social-orb,
  .mobile-social-link {
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .header-logo:focus-visible,
  .desktop-nav a:focus-visible,
  .header-booksy:focus-visible,
  .mobile-menu-button:focus-visible,
  .mobile-nav a:focus-visible,
  .mobile-formal-links a:focus-visible,
  .header-social-orb:focus-visible,
  .mobile-social-link:focus-visible {
    box-shadow: 0 0 0 3px rgba(56, 187, 181, 0.18);
  }

  .header-logo {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    color: var(--color-text, #17151d);
    text-decoration: none;
  }

  .header-logo-picture {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
  }

  .header-logo-image-link {
    width: clamp(230px, 18vw, 315px);
    max-width: 315px;
    height: 62px;
    flex: 0 0 auto;
    overflow: visible;
  }

  .header-logo-image-link img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 58px;
    object-fit: contain;
    object-position: left center;
  }

  .header-logo-text-fallback {
    display: none;
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .header-logo-text-fallback strong {
    color: #17151d;
    font-size: 1rem;
    font-weight: 820;
    line-height: 1;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header-logo-text-fallback em {
    color: #b76576;
    font-size: 0.55rem;
    font-style: normal;
    font-weight: 760;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header-logo-image-link.is-logo-fallback .header-logo-picture {
    display: none;
  }

  .header-logo-image-link.is-logo-fallback .header-logo-text-fallback {
    display: grid;
  }

  .desktop-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .desktop-nav a {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 0 clamp(9px, 0.76vw, 14px);
    border-radius: 999px;
    color: #17151d;
    font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(0.78rem, 0.74vw, 0.9rem);
    font-weight: 720;
    line-height: 1;
    letter-spacing: 0.075em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .desktop-nav a:hover {
    background: rgba(255, 255, 255, 0.64);
    transform: translateY(-1px);
  }

  .desktop-nav a[aria-current="page"] {
    background: rgba(219, 246, 243, 0.74);
    box-shadow: inset 0 0 0 1px rgba(56, 187, 181, 0.11);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
  }

  .header-socials {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .header-social-orb {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(183, 101, 118, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 12px 30px rgba(72, 42, 55, 0.10);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .header-social-orb:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 38px rgba(72, 42, 55, 0.15);
  }

  .header-social-orb svg {
    width: 20px;
    height: 20px;
  }

  .header-orb-instagram svg rect,
  .header-orb-instagram svg circle {
    fill: none;
    stroke: #d62976;
    stroke-width: 1.9;
  }

  .header-orb-facebook svg {
    fill: #1877f2;
  }

  .g-blue { fill: #4285f4; }
  .g-green { fill: #34a853; }
  .g-yellow { fill: #fbbc05; }
  .g-red { fill: #ea4335; }

  .header-booksy {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 999px;
    color: #ffffff;
    font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    font-size: 0.84rem;
    font-weight: 760;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(135deg, #0f7773 0%, #1aa5a0 100%);
    box-shadow: 0 14px 36px rgba(35, 156, 150, 0.20);
  }

  .mobile-menu-button {
    display: none;
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(183, 101, 118, 0.16);
    border-radius: 999px;
    padding: 0;
    background: rgba(255, 255, 255, 0.80);
    cursor: pointer;
  }

  .mobile-menu-button span {
    grid-area: 1 / 1;
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-text, #17151d);
    transition: transform 0.24s ease, opacity 0.18s ease;
  }

  .mobile-menu-button span:nth-child(1) {
    transform: translateY(-6px);
  }

  .mobile-menu-button span:nth-child(3) {
    transform: translateY(6px);
  }

  .is-menu-open .mobile-menu-button span:nth-child(1) {
    transform: rotate(45deg);
  }

  .is-menu-open .mobile-menu-button span:nth-child(2) {
    opacity: 0;
  }

  .is-menu-open .mobile-menu-button span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: -2;
    opacity: 0;
    pointer-events: none;
    background: rgba(25, 18, 24, 0.28);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    transition: opacity 0.22s ease;
  }

  .mobile-menu-panel {
    position: fixed;
    top: 92px;
    right: 12px;
    bottom: 10px;
    z-index: -1;
    width: min(430px, calc(100vw - 24px));
    height: calc(100dvh - 102px);
    max-height: calc(100dvh - 102px);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    gap: 8px;
    overflow: hidden;
    padding: 12px;
    border: 1px solid rgba(183, 101, 118, 0.16);
    border-radius: 26px;
    background:
      radial-gradient(circle at 94% 8%, rgba(56, 187, 181, 0.17), transparent 12rem),
      radial-gradient(circle at 8% 92%, rgba(201, 127, 143, 0.13), transparent 13rem),
      rgba(255, 255, 255, 0.94);
    box-shadow: 0 24px 80px rgba(72, 42, 55, 0.24);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px) scale(0.985);
    transform-origin: top right;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .is-menu-open .mobile-menu-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .is-menu-open .mobile-menu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .mobile-menu-intro {
    display: flex;
    min-height: 28px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 3px;
  }

  .mobile-menu-intro > span {
    display: inline-flex;
    min-height: 26px;
    align-items: center;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.72);
    color: var(--color-turquoise-dark, #0f7773);
    font-size: 0.62rem;
    font-weight: 860;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mobile-menu-intro > strong {
    overflow: hidden;
    color: rgba(23, 21, 29, 0.62);
    font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    font-size: 0.64rem;
    font-weight: 760;
    letter-spacing: 0.055em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mobile-menu-cta {
    display: grid;
    gap: 6px;
  }

  .mobile-booksy-cta,
  .mobile-form-cta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-booksy-cta {
