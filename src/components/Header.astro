---
import { booksyUrl, serviceLinks, exploreLinks, socialLinks } from '../data/site-navigation';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === current;
---
<header class="site-header bph-header" data-site-header data-compact={compact || undefined}>
  <div class="bph-header-shell">
    <a class="bph-logo" href="/" aria-label="Bogusława Herda — strona główna">
      <picture><source media="(max-width:640px)" srcset="/images/logo-boguslawa-herda-pmu-mobile.webp" /><img src="/images/logo-boguslawa-herda-pmu-desktop.webp" alt="Bogusława Herda · Makijaż permanentny · Powrót do natury" width="1600" height="334" decoding="async" /></picture>
    </a>
    <nav class="bph-desktop" aria-label="Nawigacja główna">
      <details class="bph-services" data-services-menu>
        <summary>Zabiegi <span aria-hidden="true">⌄</span></summary>
        <div class="bph-service-links">{serviceLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
      </details>
      {exploreLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="bph-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer" aria-label="Umów wizytę w Booksy — otwiera nową kartę">Umów wizytę <span aria-hidden="true">↗</span></a>
    <button class="bph-menu-toggle" type="button" data-menu-button aria-expanded="false" aria-controls="bph-mobile-menu" aria-label="Otwórz menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
  </div>
  <dialog class="bph-menu" id="bph-mobile-menu" data-header-dialog aria-labelledby="bph-menu-title">
    <div class="bph-menu-head"><div><p>Bogusława Herda</p><h2 id="bph-menu-title">W czym możemy pomóc?</h2></div><button type="button" data-menu-close autofocus aria-label="Zamknij menu">×</button></div>
    <div class="bph-menu-scroll">
      <nav class="bph-mobile-services" aria-label="Zabiegi">{serviceLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">→</span></a>)}</nav>
      <nav class="bph-mobile-explore" aria-label="Poznaj gabinet">{exploreLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
      <div class="bph-menu-contact"><a class="bph-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="bph-menu-phone" href="tel:+48730900125">Zadzwoń: 730 900 125</a><p>Barlickiego 5/23 · Bielsko-Biała</p></div>
      <div class="bph-menu-social">{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
    </div>
  </dialog>
  <noscript><nav class="bph-fallback" aria-label="Wszystkie strony">{[...serviceLinks,...exploreLinks].map(link => <a href={link.href}>{link.label}</a>)}</nav><style>.bph-menu-toggle{display:none!important}</style></noscript>
</header>
<script>import '../scripts/site-header';</script>
<style>
  .bph-header{position:fixed;inset:10px 0 auto;z-index:1000;padding:0 16px;pointer-events:none;font-family:"Inter",system-ui,sans-serif;color:#292323}
  .bph-header *{box-sizing:border-box}
  .bph-header a{color:#126b65;text-decoration:none}
  .bph-header :is(a,button,summary):focus-visible{outline:3px solid #126b65;outline-offset:4px}
  .bph-header-shell{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr) auto;align-items:center;gap:24px;width:min(1320px,100%);min-height:76px;margin:auto;padding:10px 16px 10px 22px;border:1px solid #e8dfe2;border-radius:22px;background:rgba(255,255,255,.97);box-shadow:0 8px 30px #2923230b;pointer-events:auto}
  .bph-logo{display:flex;align-items:center;width:100%;max-width:220px;min-width:0;min-height:44px}
  .bph-logo picture{display:block;width:100%}.bph-logo img{display:block;width:100%;height:auto;max-height:48px;object-fit:contain;object-position:left}
  .bph-desktop{display:flex;justify-content:center;align-items:center;gap:4px;min-width:0}
  .bph-desktop>a,.bph-services summary{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 12px;color:#292323;font-size:.85rem;font-weight:650;line-height:1.4;white-space:nowrap;border-radius:10px}
  .bph-header [aria-current=page]{color:#126b65;background:#eff8f5}
  .bph-desktop a:hover,.bph-services summary:hover{background:#eff8f5}
  .bph-services{position:relative;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}
  .bph-services summary{list-style:none;cursor:pointer}.bph-services summary::-webkit-details-marker{display:none}
  .bph-service-links{position:absolute;left:0;top:calc(100% + 12px);width:290px;padding:10px;border:1px solid #e8dfe2;border-radius:18px;background:#fff;box-shadow:0 12px 30px #29232312}
  .bph-service-links a{display:flex;align-items:center;min-height:46px;padding:10px 12px;border-radius:10px;font-size:.9rem;line-height:1.5}
  .bph-header .bph-booksy{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 18px;border:1px solid #126b65;border-radius:13px;background:#126b65;color:#fff;font-size:.83rem;font-weight:750;line-height:1.4;text-align:center;white-space:nowrap}
  .bph-header .bph-booksy:hover{background:#0e5752}
  .bph-menu-toggle{display:none;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid #e8dfe2;border-radius:13px;background:#fff;color:#292323;cursor:pointer}
  .bph-menu{position:fixed;inset:8px 8px 8px auto;width:min(480px,calc(100% - 16px));max-width:none;height:calc(100vh - 16px);height:calc(100dvh - 16px);max-height:none;margin:0;padding:0;border:1px solid #e8dfe2;border-radius:22px;background:#fff;color:#292323;overflow:hidden;pointer-events:auto}
  .bph-menu:not([open]){display:none}.bph-menu[open]{display:flex;flex-direction:column}.bph-menu::backdrop{background:#231d1f59}
  .bph-menu-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex:0 0 auto;padding:18px 20px;border-bottom:1px solid #e8dfe2;background:#fcf3f6}
  .bph-menu-head p{margin:0 0 4px;color:#126b65;font-size:.72rem;font-weight:700;letter-spacing:.04em}
  .bph-menu-head h2{margin:0;font-size:1.08rem;line-height:1.35;letter-spacing:-.02em}
  .bph-menu-head button{flex:0 0 44px;width:44px;height:44px;border:1px solid #e8dfe2;border-radius:50%;background:#fff;color:#292323;font:normal 1.8rem/1 system-ui;cursor:pointer}
  .bph-menu-scroll{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:20px 20px max(24px,env(safe-area-inset-bottom))}
  .bph-mobile-services{display:grid;gap:3px}.bph-mobile-services a{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:10px 12px;border-radius:10px;font-size:1rem;font-weight:650;line-height:1.5}
  .bph-mobile-explore{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:20px;padding-top:20px;border-top:1px solid #e8dfe2}
  .bph-mobile-explore a{display:flex;align-items:center;min-height:46px;padding:10px 12px;border:1px solid #e8dfe2;border-radius:10px;font-size:.88rem;line-height:1.4}
  .bph-menu-contact{display:grid;gap:4px;margin-top:24px}.bph-menu-contact .bph-booksy{white-space:normal}.bph-menu-phone{display:flex;justify-content:center;align-items:center;min-height:46px;font-weight:700;font-size:.95rem}
  .bph-menu-contact p{margin:0;text-align:center;font-size:.8rem;line-height:1.5;color:#625958}
  .bph-menu-social{display:flex;flex-wrap:wrap;gap:0 18px;margin-top:18px}.bph-menu-social a{display:flex;align-items:center;min-height:44px;font-size:.78rem}
  .bph-fallback{display:flex;flex-wrap:wrap;gap:6px 16px;max-height:180px;overflow:auto;background:#fff;pointer-events:auto;padding:12px}.bph-fallback a{min-height:44px;display:flex;align-items:center}
  @media(max-width:1179px){.bph-header-shell{grid-template-columns:minmax(0,1fr) auto auto;gap:12px}.bph-desktop{display:none}.bph-menu-toggle{display:inline-flex}}
  @media(max-width:640px){.bph-header{top:8px;padding:0 10px}.bph-header-shell{min-height:60px;gap:8px;padding:7px 8px 7px 12px;border-radius:18px}.bph-logo{max-width:190px}.bph-header-shell .bph-booksy{min-height:44px;padding:10px;font-size:.72rem}.bph-header-shell .bph-booksy span{display:none}.bph-menu-head{padding:14px 16px}.bph-menu-scroll{padding-inline:16px;padding-top:18px}}
</style>
