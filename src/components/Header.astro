---
import { booksyUrl, serviceLinks, exploreLinks, socialLinks } from '../data/site-navigation';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === current;
---
<header class="site-header bph-header" data-site-header data-compact={compact || undefined}>
  <div class="bph-header-shell">
    <a class="bph-logo" href="/" aria-label="Bogusława Herda — strona główna">
      <picture><source media="(max-width:640px)" srcset="/images/logo-boguslawa-herda-pmu-mobile.webp" /><img src="/images/logo-boguslawa-herda-pmu-desktop.webp" alt="Bogusława Herda · Makijaż permanentny · Powrót do natury" width="1600" height="334" decoding="async" /></picture>
    </a>
    <nav class="bph-desktop" aria-label="Nawigacja główna">
      <details class="bph-services" data-services-menu>
        <summary>Zabiegi <span aria-hidden="true">⌄</span></summary>
        <div class="bph-service-links">{serviceLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
      </details>
      {exploreLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="bph-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer" aria-label="Umów wizytę w Booksy — otwiera nową kartę"><span class="bph-header-desktop">Umów wizytę</span><span class="bph-header-mobile">Rezerwuj</span><span class="bph-header-arrow" aria-hidden="true">↗</span></a>
    <button class="bph-menu-toggle" type="button" data-menu-button aria-expanded="false" aria-controls="bph-mobile-menu" aria-label="Otwórz menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path class="bph-header-desktop" d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path class="bph-header-mobile" d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>
  </div>
  <dialog class="bph-menu" id="bph-mobile-menu" data-header-dialog aria-labelledby="bph-menu-title">
    <div class="bph-menu-head"><div><p>Bogusława Herda</p><h2 id="bph-menu-title"><span class="bph-header-desktop">W czym możemy pomóc?</span><span class="bph-header-mobile">Menu</span></h2></div><button type="button" data-menu-close autofocus aria-label="Zamknij menu">×</button></div>
    <div class="bph-menu-scroll bph-menu-tablet">
      <nav class="bph-mobile-services" aria-label="Zabiegi">{serviceLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">→</span></a>)}</nav>
      <nav class="bph-mobile-explore" aria-label="Poznaj gabinet">{exploreLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
      <div class="bph-menu-contact"><a class="bph-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="bph-menu-phone" href="tel:+48730900125">Zadzwoń: 730 900 125</a><p>Barlickiego 5/23 · Bielsko-Biała</p></div>
      <div class="bph-menu-social">{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>
    </div>
    <nav class="bph-phone-nav" aria-label="Nawigacja mobilna">
      <details class="bph-phone-treatments" data-phone-treatments>
        <summary class:list={{ 'bph-phone-treatment-active': serviceLinks.some(link => isActive(link.href)) }}>
          <span>Zabiegi PMU</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <div class="bph-phone-treatment-links">
          {serviceLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">→</span></a>)}
        </div>
      </details>
      {exploreLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}<span class="bph-phone-page-dot" aria-hidden="true"></span></a>)}
    </nav>
    <div class="bph-phone-actions">
      <a class="bph-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer" aria-label="Umów wizytę w Booksy — otwiera nową kartę">Umów wizytę <span aria-hidden="true">↗</span></a>
      <div class="bph-phone-contact">
        <a href="tel:+48730900125">Zadzwoń: 730 900 125</a>
        <a href={socialLinks[2].href} target="_blank" rel="noopener noreferrer" aria-label="Dojazd: Barlickiego 5/23, Bielsko-Biała — Google Maps">Dojazd <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </dialog>
  <noscript><nav class="bph-fallback" aria-label="Wszystkie strony">{[...serviceLinks,...exploreLinks].map(link => <a href={link.href}>{link.label}</a>)}</nav><style>.bph-menu-toggle{display:none!important}</style></noscript>
</header>
<script>import '../scripts/site-header';</script>
<style>
  .bph-header{position:fixed;inset:10px 0 auto;z-index:1000;padding:0 16px;pointer-events:none;font-family:"Inter",system-ui,sans-serif;color:#292323}
  .bph-header *{box-sizing:border-box}
  .bph-header a{color:#126b65;text-decoration:none}
  .bph-header :is(a,button,summary):focus-visible{outline:3px solid #126b65;outline-offset:4px}
  .bph-header-shell{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr) auto;align-items:center;gap:24px;width:min(1320px,100%);min-height:76px;margin:auto;padding:10px 16px 10px 22px;border:1px solid #e8dfe2;border-radius:22px;background:rgba(255,255,255,.97);box-shadow:0 8px 30px #2923230b;pointer-events:auto}
  .bph-logo{display:flex;align-items:center;width:100%;max-width:220px;min-width:0;min-height:44px}
  .bph-logo picture{display:block;width:100%}.bph-logo img{display:block;width:100%;height:auto;max-height:48px;object-fit:contain;object-position:left}
  .bph-desktop{display:flex;justify-content:center;align-items:center;gap:4px;min-width:0}
  .bph-desktop>a,.bph-services summary{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 12px;color:#292323;font-size:.85rem;font-weight:650;line-height:1.4;white-space:nowrap;border-radius:10px}
  .bph-header [aria-current=page]{color:#126b65;background:#eff8f5}
  .bph-desktop a:hover,.bph-services summary:hover{background:#eff8f5}
  .bph-services{position:relative;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}
  .bph-services summary{list-style:none;cursor:pointer}.bph-services summary::-webkit-details-marker{display:none}
  .bph-service-links{position:absolute;left:0;top:calc(100% + 12px);width:290px;padding:10px;border:1px solid #e8dfe2;border-radius:18px;background:#fff;box-shadow:0 12px 30px #29232312}
  .bph-service-links a{display:flex;align-items:center;min-height:46px;padding:10px 12px;border-radius:10px;font-size:.9rem;line-height:1.5}
  .bph-header .bph-booksy{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 18px;border:1px solid #126b65;border-radius:13px;background:#126b65;color:#fff;font-size:.83rem;font-weight:750;line-height:1.4;text-align:center;white-space:nowrap}
  .bph-header .bph-booksy:hover{background:#0e5752}
  .bph-menu-toggle{display:none;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid #e8dfe2;border-radius:13px;background:#fff;color:#292323;cursor:pointer}
  .bph-menu{position:fixed;inset:8px 8px 8px auto;width:min(480px,calc(100% - 16px));max-width:none;height:calc(100vh - 16px);height:calc(100dvh - 16px);max-height:none;margin:0;padding:0;border:1px solid #e8dfe2;border-radius:22px;background:#fff;color:#292323;overflow:hidden;pointer-events:auto}
  .bph-menu:not([open]){display:none}.bph-menu[open]{display:flex;flex-direction:column}.bph-menu::backdrop{background:#231d1f59}
  .bph-menu-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex:0 0 auto;padding:18px 20px;border-bottom:1px solid #e8dfe2;background:#fcf3f6}
  .bph-menu-head p{margin:0 0 4px;color:#126b65;font-size:.72rem;font-weight:700;letter-spacing:.04em}
  .bph-menu-head h2{margin:0;font-size:1.08rem;line-height:1.35;letter-spacing:-.02em}
  .bph-menu-head button{flex:0 0 44px;width:44px;height:44px;border:1px solid #e8dfe2;border-radius:50%;background:#fff;color:#292323;font:normal 1.8rem/1 system-ui;cursor:pointer}
  .bph-menu-scroll{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:20px 20px max(24px,env(safe-area-inset-bottom))}
  .bph-mobile-services{display:grid;gap:3px}.bph-mobile-services a{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:10px 12px;border-radius:10px;font-size:1rem;font-weight:650;line-height:1.5}
  .bph-mobile-explore{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:20px;padding-top:20px;border-top:1px solid #e8dfe2}
  .bph-mobile-explore a{display:flex;align-items:center;min-height:46px;padding:10px 12px;border:1px solid #e8dfe2;border-radius:10px;font-size:.88rem;line-height:1.4}
  .bph-menu-contact{display:grid;gap:4px;margin-top:24px}.bph-menu-contact .bph-booksy{white-space:normal}.bph-menu-phone{display:flex;justify-content:center;align-items:center;min-height:46px;font-weight:700;font-size:.95rem}
  .bph-menu-contact p{margin:0;text-align:center;font-size:.8rem;line-height:1.5;color:#625958}
  .bph-menu-social{display:flex;flex-wrap:wrap;gap:0 18px;margin-top:18px}.bph-menu-social a{display:flex;align-items:center;min-height:44px;font-size:.78rem}
  .bph-fallback{display:flex;flex-wrap:wrap;gap:6px 16px;max-height:180px;overflow:auto;background:#fff;pointer-events:auto;padding:12px}.bph-fallback a{min-height:44px;display:flex;align-items:center}
  .bph-header-mobile,.bph-menu-social-icon{display:none}
  .bph-phone-nav,.bph-phone-actions{display:none}
  @media(max-width:1179px){.bph-header-shell{grid-template-columns:minmax(0,1fr) auto auto;gap:12px}.bph-desktop{display:none}.bph-menu-toggle{display:inline-flex}}
  @media(max-width:640px){
    .bph-header{top:0;padding:0;font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;letter-spacing:-.015em}
    .bph-header .bph-header-mobile{display:block}
    .bph-header .bph-header-desktop,.bph-header-shell .bph-header-arrow{display:none}
    .bph-header-shell{width:100%;min-height:64px;grid-template-columns:minmax(0,1fr) auto 44px;gap:8px;padding:calc(10px + env(safe-area-inset-top)) 20px 10px;border:0;border-bottom:1px solid #dce2db;border-radius:0;background:rgba(255,255,255,.98);box-shadow:0 3px 18px #142c2505}
    .bph-logo{max-width:210px}
    .bph-logo img{max-height:44px}
    .bph-header-shell .bph-booksy{min-height:44px;padding:10px 12px;border-radius:10px;font-size:.75rem;line-height:1.45;font-weight:730}
    .bph-menu-toggle{border:0;border-radius:10px;background:transparent}
    .bph-menu-toggle:hover{background:#f1f4f1}
    .bph-menu{--menu-gutter:24px;inset:0;inline-size:100%;max-inline-size:100%;height:100vh;height:100dvh;max-height:100dvh;min-width:0;margin:0;border:0;border-radius:0;transform:none;background:#fff}
    .bph-menu[open]{align-items:stretch}
    .bph-menu::backdrop{background:#142c2580}
    .bph-menu-head{width:100%;min-width:0;gap:16px;padding:calc(16px + env(safe-area-inset-top)) max(var(--menu-gutter),env(safe-area-inset-right)) 12px max(var(--menu-gutter),env(safe-area-inset-left));border:0;background:#fff}
    .bph-menu-head p{margin:0 0 5px;color:#625958;font-size:10px;line-height:1.4;letter-spacing:.1em;font-weight:600;text-transform:uppercase}
    .bph-menu-head h2{font-size:26px;line-height:1.1;letter-spacing:-.035em;font-weight:600}
    .bph-menu-head button{border:1px solid #e1e5df;border-radius:50%;background:#fff;font-size:28px;font-weight:300}
    .bph-menu-tablet{display:none}
    .bph-phone-nav{display:block;flex:1 1 auto;min-height:0;min-width:0;width:100%;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:4px max(var(--menu-gutter),env(safe-area-inset-right)) 12px max(var(--menu-gutter),env(safe-area-inset-left))}
    .bph-phone-nav>a,.bph-phone-treatments>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:52px;width:100%;padding:12px 0;color:#292323;font-size:22px;line-height:1.2;letter-spacing:-.025em;font-weight:500;text-decoration:none}
    .bph-phone-nav>a{border-bottom:1px solid #e6e9e3}
    .bph-phone-treatments{margin:0;padding:0;border:0;border-bottom:1px solid #e6e9e3;border-radius:0;background:transparent;box-shadow:none}
    .bph-phone-treatments>summary{cursor:pointer;list-style:none}
    .bph-phone-treatments>summary::-webkit-details-marker{display:none}
    .bph-phone-treatments>summary svg{flex:0 0 20px;color:#126b65}
    .bph-phone-treatments[open]>summary svg{transform:rotate(180deg)}
    .bph-phone-treatment-links{display:grid;gap:0;padding:0 0 10px 16px}
    .bph-phone-treatment-links>a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;padding:10px 0;color:#625958;font-size:16px;line-height:1.4;font-weight:400;text-decoration:none}
    .bph-phone-treatment-links>a>span{flex:0 0 16px;color:#126b65;text-align:right}
    .bph-menu .bph-phone-nav [aria-current=page],.bph-menu .bph-phone-treatment-active{color:#126b65;background:transparent;font-weight:650}
    .bph-phone-nav>a[aria-current=page] .bph-phone-page-dot{width:6px;height:6px;flex:0 0 6px;border-radius:50%;background:#126b65}
    .bph-phone-nav :is(a,summary):focus-visible{outline-offset:-3px;border-radius:4px}
    .bph-phone-actions{display:block;flex:0 0 auto;padding:12px max(var(--menu-gutter),env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(var(--menu-gutter),env(safe-area-inset-left));border-top:1px solid #e6e9e3;background:#fff}
    .bph-phone-actions>.bph-booksy{display:flex;justify-content:space-between;width:100%;min-height:52px;padding:14px 18px;border-radius:10px;font-size:.86rem;font-weight:730;line-height:1.45}
    .bph-phone-contact{display:flex;justify-content:space-between;gap:12px;margin-top:4px}
    .bph-phone-contact>a{display:flex;align-items:center;gap:8px;min-height:44px;color:#625958;font-size:12px;line-height:1.4;font-weight:500}
  }
  @media(max-width:360px){
    .bph-header-shell{padding-inline:16px}
    .bph-menu{--menu-gutter:20px}
    .bph-phone-nav>a,.bph-phone-treatments>summary{font-size:20px}
    .bph-phone-contact>a{font-size:11.5px}
  }
  @media(max-width:640px) and (max-height:700px){
    .bph-menu-head{padding-top:calc(10px + env(safe-area-inset-top));padding-bottom:8px}
    .bph-menu-head p{display:none}
    .bph-menu-head h2{font-size:24px}
    .bph-phone-nav>a,.bph-phone-treatments>summary{min-height:44px;padding-block:10px;font-size:20px}
    .bph-phone-actions{padding-top:10px;padding-bottom:max(8px,env(safe-area-inset-bottom))}
    .bph-phone-actions>.bph-booksy{min-height:48px;padding-block:12px}
  }
</style>
