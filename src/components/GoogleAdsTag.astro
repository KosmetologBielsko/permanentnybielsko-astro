<!-- Globalne mierzenie wszystkich kliknięć prowadzących do Booksy -->
<script is:inline>
  (function () {
    var conversionId = 'AW-18200277713/B-mQCMzbtL8cENHlyOZD';

    document.addEventListener('click', function (event) {
      var clickedElement = event.target;

      if (!(clickedElement instanceof Element)) return;

      var booksyLink = clickedElement.closest(
        'a[href*="booksy.com"], a[href*="booksy.pl"]'
      );

      if (!booksyLink) return;
      if (typeof window.gtag !== 'function') return;

      window.gtag('event', 'conversion', {
        send_to: conversionId,
        value: 1.0,
        currency: 'PLN',
        event_timeout: 2000
      });
    });
  })();
</script>