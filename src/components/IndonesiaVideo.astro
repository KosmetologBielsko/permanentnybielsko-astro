<figure class="indonesia-video">
  <div class="indonesia-video-frame">
    <video controls playsinline preload="none" poster="/images/pmu-indonesia-2026/film-poster.webp" width="720" height="1280" aria-label="Film z PMU Indonesia Festival 2026, bez dźwięku">
      <source src="/video/pmu-indonesia-2026-32s.mp4" type="video/mp4" />
      <a href="/video/pmu-indonesia-2026-32s.mp4">Pobierz film z festiwalu</a>
    </video>
    <button type="button" hidden aria-label="Odtwórz film z Indonezji">▶ &nbsp; Zobacz film</button>
  </div>
  <figcaption>PMU Indonesia 2026 · 32 sekundy · bez dźwięku</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.indonesia-video-frame').forEach(frame => {
    const video = frame.querySelector('video')!;
    const button = frame.querySelector('button')!;
    button.hidden = false;
    button.addEventListener('click', () => {
      button.hidden = true;
      video.play().catch(() => { button.hidden = false; });
    });
    video.addEventListener('play', () => { button.hidden = true; });
    video.addEventListener('ended', () => { button.hidden = false; });
  });
</script>
<style>
  .indonesia-video{margin:0;width:100%;min-width:0}
  .indonesia-video-frame{position:relative;aspect-ratio:9/16;border-radius:24px;overflow:hidden;background:#151a1a}
  video{display:block;width:100%;height:100%;object-fit:contain}
  button{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border:1px solid #ffffffa0;background:#ffffffed;color:#126b65;border-radius:100px;min-height:56px;padding:14px 22px;font:inherit;font-weight:750;white-space:nowrap;cursor:pointer;box-shadow:0 6px 24px #0003}
  button[hidden]{display:none}button:focus-visible{outline:3px solid #126b65;outline-offset:4px}
  figcaption{font-size:12px;margin-top:10px;text-align:center;color:#625958;line-height:1.6}
</style>
