<figure class="indonesia-video">
  <div class="indonesia-video-frame">
    <video controls playsinline preload="none" poster="/images/pmu-indonesia-2026/portret-przypinki-640.webp" width="720" height="1280" aria-label="Film z PMU Indonesia Festival 2026, bez dźwięku">
      <source src="/video/pmu-indonesia-2026-32s.mp4" type="video/mp4" />
      <a href="/video/pmu-indonesia-2026-32s.mp4">Pobierz film z festiwalu</a>
    </video>
    <button class="indonesia-video-cover" type="button" hidden aria-label="Odtwórz film z PMU Indonesia Festival, 32 sekundy, bez dźwięku">
      <img src="/images/pmu-indonesia-2026/portret-przypinki-640.webp" width="1152" height="1536" alt="" loading="lazy" decoding="async" />
      <span class="indonesia-video-label"><span class="indonesia-play-icon" aria-hidden="true">▶</span><span>Zobacz film<small>32 sekundy · bez dźwięku</small></span></span>
    </button>
  </div>
  <figcaption>Wspomnienia z PMU Indonesia 2026</figcaption>
  <p class="indonesia-video-error" role="status" hidden>Nie udało się odtworzyć filmu. <a href="/video/pmu-indonesia-2026-32s.mp4">Otwórz nagranie bezpośrednio →</a></p>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.indonesia-video-frame').forEach(frame => {
    const video = frame.querySelector('video')!;
    const button = frame.querySelector<HTMLButtonElement>('.indonesia-video-cover')!;
    const error = frame.parentElement!.querySelector<HTMLElement>('.indonesia-video-error')!;
    // Keep native controls without JS; show only the opaque cover before playback.
    video.controls = false;
    video.tabIndex = -1;
    frame.classList.add('has-cover');
    button.hidden = false;
    const reveal = () => {
      frame.classList.remove('has-cover');
      button.hidden = true;
      video.controls = true;
      video.tabIndex = 0;
    };
    button.addEventListener('click', () => {
      error.hidden = true;
      reveal();
      video.focus({ preventScroll: true });
      video.play().catch(() => { error.hidden = false; });
    });
    video.addEventListener('play', reveal);
    video.addEventListener('error', () => { error.hidden = false; });
  });
</script>
<style>
  .indonesia-video{margin:0;width:100%;min-width:0}
  .indonesia-video-frame{position:relative;aspect-ratio:3/4;border-radius:24px;overflow:hidden;background:#151a1a;isolation:isolate}
  .indonesia-video-frame video{display:block;width:100%;height:100%;object-fit:contain}
  .has-cover video{visibility:hidden}
  .indonesia-video-cover{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;border-radius:inherit;background:#151a1a;color:#fff;text-align:left;font:inherit;cursor:pointer}
  .indonesia-video-frame .indonesia-video-cover img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0}
  .indonesia-video-cover::after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,#000b);pointer-events:none}
  .indonesia-video-label{position:absolute;z-index:1;inset:auto 20px 22px;display:flex;align-items:center;gap:12px;font-size:17px;line-height:1.35;font-weight:700}
  .indonesia-play-icon{display:grid;place-items:center;flex:0 0 46px;height:46px;border:1px solid #fff9;border-radius:50%;background:#fff;color:#126b65;font-size:16px;padding-left:2px}
  .indonesia-video-label small{display:block;margin-top:3px;font-size:12px;font-weight:400;color:#ffffffe6}
  .indonesia-video-cover[hidden],.indonesia-video-error[hidden]{display:none}
  .indonesia-video-cover:focus-visible{outline:3px solid white;outline-offset:-6px}
  figcaption{font-size:12px;margin-top:10px;text-align:center;color:#625958;line-height:1.6}
  .indonesia-video-error{font-size:14px;line-height:1.5;margin-top:12px}
</style>
