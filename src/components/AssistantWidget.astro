---
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pmuLeadUrl = "/makijaz-permanentny-bielsko/#kwalifikacja-pmu";
---

<div class="ai-assistant" data-ai-assistant>
  <div class="ai-assistant-panel" role="dialog" aria-modal="false" aria-label="AI Asystent PMU" data-ai-panel>
    <div class="ai-panel-head">
      <div>
        <span class="ai-panel-kicker">AI Asystent PMU</span>
        <h2>Dobierz kierunek zabiegu</h2>
      </div>

      <button class="ai-panel-close" type="button" aria-label="Zamknij AI Asystenta" data-ai-close>
        ×
      </button>
    </div>

    <p class="ai-panel-lead">
      Wybierz temat, a podpowiemy najbezpieczniejszą ścieżkę: Booksy, formularz kwalifikacji albo rozmowę telefoniczną.
    </p>

    <div class="ai-choice-grid" aria-label="Wybierz temat PMU">
      <button
        type="button"
        data-ai-choice
        data-title="Brwi permanentne"
        data-text="Najczęściej zaczynamy od oceny naturalnej oprawy oka, skóry i oczekiwanego efektu. Przy brwiach możesz od razu przejść do Booksy albo wysłać pytanie, jeśli masz stary PMU."
        data-link="/makijaz-permanentny-brwi/"
        data-link-label="Zobacz brwi"
      >
        Brwi
      </button>

      <button
        type="button"
        data-ai-choice
        data-title="Usta permanentne"
        data-text="Przy ustach ważna jest czerwień wargowa, symetria, kolor i skłonność do opryszczki. Jeśli masz wątpliwości, najpierw wyślij krótkie pytanie."
        data-link="/makijaz-permanentny-ust/"
        data-link-label="Zobacz usta"
      >
        Usta
      </button>

      <button
        type="button"
        data-ai-choice
        data-title="Kreski permanentne"
        data-text="Rodzaj kreski dobieramy do budowy oka, powieki i oczekiwanego efektu. Jeśli masz opadającą powiekę albo stary PMU, lepiej najpierw zapytać."
        data-link="/makijaz-permanentny-oczu/"
        data-link-label="Zobacz kreski"
      >
        Kreski
      </button>

      <button
        type="button"
        data-ai-choice
        data-title="Korekta lub usuwanie PMU"
        data-text="Przy starym, zbyt ciemnym albo nieudanym PMU najważniejsza jest kwalifikacja. Najlepiej opisać sytuację i dołączyć zdjęcie przed rezerwacją."
        data-link="/usuwanie-makijazu-permanentnego/"
        data-link-label="Zobacz korektę"
      >
        Korekta
      </button>

      <button
        type="button"
        data-ai-choice
        data-title="Szkolenia PMU"
        data-text="Jeśli interesują Cię szkolenia, przejdź do oferty edukacyjnej: Step by Step, Masterclass, Silky Hairstroke Brows i praca z pigmentem."
        data-link="/szkolenie-makijaz-permanentny/"
        data-link-label="Zobacz szkolenia"
      >
        Szkolenia
      </button>
    </div>

    <div class="ai-result" data-ai-result hidden>
      <span class="ai-result-label">Rekomendacja</span>
      <h3 data-ai-result-title>Brwi permanentne</h3>
      <p data-ai-result-text></p>

      <div class="ai-result-actions">
        <a class="ai-result-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">
          Umów przez Booksy
        </a>

        <a class="ai-result-secondary" href={pmuLeadUrl}>
          Mam pytanie
        </a>

        <a class="ai-result-link" href="/makijaz-permanentny-bielsko/" data-ai-result-link>
          Zobacz PMU
        </a>
      </div>
    </div>
  </div>

  <button
    class="ai-assistant-orb"
    type="button"
    aria-label="Otwórz AI Asystenta PMU"
    aria-expanded="false"
    data-ai-toggle
  >
    <span>AI</span>
  </button>
</div>

<script>
  const assistant = document.querySelector("[data-ai-assistant]");
  const toggle = assistant?.querySelector("[data-ai-toggle]");
  const closeButton = assistant?.querySelector("[data-ai-close]");
  const choices = assistant?.querySelectorAll("[data-ai-choice]");
  const result = assistant?.querySelector("[data-ai-result]");
  const resultTitle = assistant?.querySelector("[data-ai-result-title]");
  const resultText = assistant?.querySelector("[data-ai-result-text]");
  const resultLink = assistant?.querySelector("[data-ai-result-link]");

  const setOpen = (isOpen) => {
    if (!assistant || !toggle) return;

    assistant.classList.toggle("is-open", isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute(
      "aria-label",
      isOpen ? "Zamknij AI Asystenta PMU" : "Otwórz AI Asystenta PMU"
    );
  };

  toggle?.addEventListener("click", () => {
    setOpen(!assistant?.classList.contains("is-open"));
  });

  closeButton?.addEventListener("click", () => setOpen(false));

  choices?.forEach((choice) => {
    choice.addEventListener("click", () => {
      choices.forEach((item) => item.classList.remove("is-active"));
      choice.classList.add("is-active");

      const title = choice.getAttribute("data-title") || "Rekomendacja PMU";
      const text = choice.getAttribute("data-text") || "Wybierz najlepszą ścieżkę kontaktu.";
      const link = choice.getAttribute("data-link") || "/makijaz-permanentny-bielsko/";
      const linkLabel = choice.getAttribute("data-link-label") || "Zobacz więcej";

      if (resultTitle) resultTitle.textContent = title;
      if (resultText) resultText.textContent = text;
      if (resultLink instanceof HTMLAnchorElement) {
        resultLink.href = link;
        resultLink.textContent = linkLabel;
      }
      if (result instanceof HTMLElement) result.hidden = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!assistant || !assistant.classList.contains("is-open")) return;
    if (event.target instanceof Node && assistant.contains(event.target)) return;
    setOpen(false);
  });
</script>

<style>
  .ai-assistant {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 1200;
    font-family:
      "Avenir Next",
      "Helvetica Neue",
      Arial,
      sans-serif;
  }

  .ai-assistant-orb {
    position: relative;
    display: grid;
    width: 70px;
    height: 70px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 999px;
    padding: 0;
    color: #ffffff;
    background:
      radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.44), transparent 2.8rem),
      linear-gradient(145deg, #d6b46c 0%, #bf9546 45%, #8c6327 100%);
    box-shadow:
      0 20px 50px rgba(111, 75, 27, 0.28),
      0 0 0 7px rgba(255, 247, 226, 0.72),
      inset 0 1px 0 rgba(255, 255, 255, 0.42);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;
  }

  .ai-assistant-orb::after {
    content: "";
    position: absolute;
    inset: 8px 11px auto 11px;
    height: 17px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.56), transparent);
    pointer-events: none;
  }

  .ai-assistant-orb span {
    position: relative;
    z-index: 1;
    font-size: 1.08rem;
    font-weight: 920;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-assistant-orb:hover {
    transform: translateY(-2px) scale(1.02);
    filter: saturate(1.04) brightness(1.02);
    box-shadow:
      0 24px 58px rgba(111, 75, 27, 0.34),
      0 0 0 7px rgba(255, 247, 226, 0.82),
      inset 0 1px 0 rgba(255, 255, 255, 0.48);
  }

  .ai-assistant-orb:focus,
  .ai-assistant-orb:active {
    outline: none;
  }

  .ai-assistant-orb:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 4px rgba(56, 187, 181, 0.18),
      0 24px 58px rgba(111, 75, 27, 0.34),
      0 0 0 9px rgba(255, 247, 226, 0.86);
  }

  .ai-assistant-panel {
    position: absolute;
    right: 0;
    bottom: 90px;
    width: min(390px, calc(100vw - 28px));
    max-height: min(680px, calc(100vh - 128px));
    overflow: auto;
    padding: 18px;
    border: 1px solid rgba(201, 127, 143, 0.17);
    border-radius: 30px;
    background:
      radial-gradient(circle at 92% 10%, rgba(56, 187, 181, 0.14), transparent 12rem),
      radial-gradient(circle at 8% 90%, rgba(201, 127, 143, 0.12), transparent 14rem),
      rgba(255, 255, 255, 0.94);
    box-shadow: 0 26px 84px rgba(72, 42, 55, 0.25);
    backdrop-filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px) scale(0.97);
    transform-origin: bottom right;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .ai-assistant.is-open .ai-assistant-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .ai-panel-head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .ai-panel-kicker,
  .ai-result-label {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    justify-content: center;
    margin: 0 0 10px;
    padding: 0 11px;
    border-radius: 999px;
    color: #0f7773;
    background: rgba(219, 246, 243, 0.74);
    border: 1px solid rgba(56, 187, 181, 0.16);
    font-size: 0.62rem;
    font-weight: 880;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-panel-head h2 {
    margin: 0;
    color: #17151d;
    font-size: 1.48rem;
    font-weight: 830;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .ai-panel-close {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(183, 101, 118, 0.13);
    border-radius: 999px;
    color: rgba(23, 21, 29, 0.62);
    background: rgba(255, 255, 255, 0.74);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .ai-panel-lead {
    margin: 14px 0 0;
    color: #6e6670;
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .ai-choice-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    margin-top: 16px;
  }

  .ai-choice-grid button {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(56, 187, 181, 0.14);
    border-radius: 16px;
    padding: 0 12px;
    color: #17151d;
    background:
      radial-gradient(circle at 86% 12%, rgba(219, 246, 243, 0.52), transparent 5rem),
      rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    font-weight: 820;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease;
  }

  .ai-choice-grid button:hover,
  .ai-choice-grid button.is-active {
    transform: translateY(-1px);
    color: #0f7773;
    background: rgba(219, 246, 243, 0.84);
    border-color: rgba(56, 187, 181, 0.22);
  }

  .ai-result {
    margin-top: 15px;
    padding: 15px;
    border: 1px solid rgba(201, 127, 143, 0.14);
    border-radius: 22px;
    background:
      radial-gradient(circle at 90% 12%, rgba(201, 127, 143, 0.10), transparent 9rem),
      rgba(255, 249, 251, 0.82);
  }

  .ai-result h3 {
    margin: 0;
    color: #17151d;
    font-size: 1.18rem;
    font-weight: 830;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .ai-result p {
    margin: 10px 0 0;
    color: #6e6670;
    font-size: 0.9rem;
    line-height: 1.58;
  }

  .ai-result-actions {
    display: grid;
    gap: 9px;
    margin-top: 14px;
  }

  .ai-result-actions a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 14px;
    font-size: 0.8rem;
    font-weight: 840;
    line-height: 1;
    text-align: center;
    text-decoration: none;
  }

  .ai-result-primary {
    color: #ffffff;
    background: linear-gradient(135deg, #18a889 0%, #0f8f78 55%, #0b7868 100%);
    box-shadow: 0 14px 30px rgba(15, 143, 120, 0.18);
  }

  .ai-result-secondary {
    color: #ffffff;
    background: linear-gradient(135deg, #d992a2, #c77788);
    box-shadow: 0 14px 30px rgba(199, 119, 136, 0.18);
  }

  .ai-result-link {
    color: #0f7773;
    background: rgba(219, 246, 243, 0.72);
    border: 1px solid rgba(56, 187, 181, 0.16);
  }

  @media (max-width: 760px) {
    .ai-assistant {
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
    }

    .ai-assistant-orb {
      width: 62px;
      height: 62px;
      box-shadow:
        0 18px 44px rgba(111, 75, 27, 0.25),
        0 0 0 6px rgba(255, 247, 226, 0.76),
        inset 0 1px 0 rgba(255, 255, 255, 0.42);
    }

    .ai-assistant-orb span {
      font-size: 1rem;
    }

    .ai-assistant-panel {
      right: 0;
      bottom: 80px;
      width: min(370px, calc(100vw - 28px));
      max-height: min(650px, calc(100vh - 104px));
      padding: 16px;
      border-radius: 26px;
    }

    .ai-panel-head h2 {
      font-size: 1.32rem;
    }

    .ai-choice-grid {
      grid-template-columns: 1fr;
    }

    .ai-choice-grid button {
      min-height: 46px;
    }
  }

  @media (max-width: 390px) {
    .ai-assistant-orb {
      width: 58px;
      height: 58px;
    }

    .ai-assistant-panel {
      width: calc(100vw - 24px);
      padding: 14px;
    }
  }
</style>
