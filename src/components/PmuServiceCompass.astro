---
interface LinkItem {
  label: string;
  title: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  items: LinkItem[];
  secondary?: LinkItem[];
}

const { eyebrow, title, lead, items, secondary = [] } = Astro.props;
---

<section class="pmu-compass" aria-label={eyebrow}>
  <div class="container">
    <div class="pmu-compass-heading">
      <p class="section-kicker">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>

    <nav class="pmu-compass-scroll" aria-label="Najważniejsze informacje o zabiegu">
      {items.map((item, index) => (
        <a href={item.href}>
          <span>{String(index + 1).padStart(2, "0")} · {item.label}</span>
          <strong>{item.title}</strong>
        </a>
      ))}
    </nav>

    {secondary.length > 0 && (
      <div class="pmu-compass-secondary">
        {secondary.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .pmu-compass{padding:38px 0 68px;scroll-margin-top:110px}
  .pmu-compass-heading{max-width:980px;margin-bottom:22px}
  .pmu-compass-heading h2{margin:0;color:var(--color-text,#17151d);font-size:clamp(2.1rem,3.7vw,3.8rem);font-weight:760;line-height:1.02;letter-spacing:-.065em}
  .pmu-compass-heading>p:not(.section-kicker){max-width:860px;margin:15px 0 0;color:var(--color-muted,#6e6670);font-size:.96rem;line-height:1.62}
  .pmu-compass-scroll{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
  .pmu-compass-scroll a{display:flex;min-height:108px;flex-direction:column;justify-content:space-between;padding:17px;border:1px solid rgba(183,101,118,.14);border-radius:22px;background:radial-gradient(circle at 92% 8%,rgba(56,187,181,.07),transparent 9rem),rgba(255,255,255,.92);color:inherit;text-decoration:none;box-shadow:0 14px 38px rgba(89,53,67,.045);transition:transform .18s ease,box-shadow .18s ease}
  .pmu-compass-scroll a:hover{transform:translateY(-2px);box-shadow:0 18px 44px rgba(89,53,67,.075)}
  .pmu-compass-scroll span,.pmu-compass-secondary span{color:var(--color-muted,#6e6670);font-size:.61rem;font-weight:780;letter-spacing:.07em;text-transform:uppercase}
  .pmu-compass-scroll strong,.pmu-compass-secondary strong{color:var(--color-turquoise-dark,#0f7773);font-size:.8rem;font-weight:850;line-height:1.26}
  .pmu-compass-secondary{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px;margin-top:9px}
  .pmu-compass-secondary a{display:flex;min-height:62px;align-items:center;justify-content:space-between;gap:14px;padding:12px 15px;border:1px solid rgba(56,187,181,.14);border-radius:18px;background:rgba(219,246,243,.36);color:inherit;text-decoration:none}
  .pmu-compass-secondary strong{text-align:right}
  @media(max-width:900px){.pmu-compass-scroll{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){
    .pmu-compass{padding:27px 0 48px}
    .pmu-compass-heading h2{font-size:clamp(1.95rem,8.7vw,2.72rem);line-height:1.04;letter-spacing:-.058em}
    .pmu-compass-heading>p:not(.section-kicker){margin-top:12px;font-size:.87rem;line-height:1.55}
    .pmu-compass-scroll{display:grid;grid-auto-flow:column;grid-auto-columns:min(74vw,278px);grid-template-columns:none;gap:8px;margin-inline:-16px;padding:2px 16px 10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .pmu-compass-scroll::-webkit-scrollbar{display:none}
    .pmu-compass-scroll a{min-height:94px;padding:14px;border-radius:19px;scroll-snap-align:start}
    .pmu-compass-secondary{grid-template-columns:1fr;gap:7px;margin-top:7px}
    .pmu-compass-secondary a{min-height:56px;padding:11px 13px}
  }
  @media(max-width:390px){.pmu-compass-scroll{grid-auto-columns:80vw}}
  @media(prefers-reduced-motion:reduce){.pmu-compass-scroll a{transition:none}.pmu-compass-scroll a:hover{transform:none}}
</style>
