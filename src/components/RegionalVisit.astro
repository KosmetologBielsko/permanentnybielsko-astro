---
import media from "../data/pmu-media-library.json";
const photo = media.silky.find(item => item.id === "silky-07")!;
---
<section class="regional-visit" id="pmu-slask" aria-labelledby="regional-visit-title">
  <figure class="regional-visit__photo">
    <img src={photo.thumb} srcset={photo.srcset} sizes="(max-width:700px) calc(100vw - 36px), (max-width:1100px) 38vw, 450px" width={photo.width} height={photo.height} alt="Brwi wykonane techniką Silky Hairstroke Brows — zbliżenie włosa maszynowego" loading="lazy" decoding="async" />
    <figcaption>Silky Hairstroke Brows · włos maszynowy</figcaption>
  </figure>
  <div class="regional-visit__copy">
    <p class="pmu-home-kicker">Bielsko-Biała · dla klientek ze Śląska</p>
    <h2 id="regional-visit-title">Naturalny efekt zaczyna się od świadomego wyboru.</h2>
    <p>Szukasz naturalnego makijażu permanentnego na Śląsku? W moim gabinecie w Bielsku-Białej zaczynamy od rozmowy o Twoich oczekiwaniach i oceny skóry. Dobieramy technikę do Ciebie — od włosa maszynowego Silky Hairstroke Brows po miękki cień, subtelne usta i kreski.</p>
    <p>Przyjeżdżają do mnie także klientki z innych regionów Polski i z zagranicy. Jeśli planujesz podróż, przed rezerwacją porozmawiajmy o kolejnych etapach zabiegu.</p>
    <div class="regional-visit__actions">
      <a class="pmu-home-primary" href="/kontakt/#przyjazd">Zaplanuj wizytę <span aria-hidden="true">→</span></a>
      <a class="regional-visit__text-link" href="/o-mnie/">Poznaj moje doświadczenie <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
  .regional-visit { display:grid; grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr); gap:clamp(28px,5vw,76px); align-items:center; margin:32px 0 50px; padding:36px; border:1px solid #e7dce0; border-radius:28px; background:#fff8fa; }
  .regional-visit__photo { min-width:0; margin:0; }
  .regional-visit__photo img { display:block; width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; border-radius:20px; }
  .regional-visit__photo figcaption { padding-top:12px; color:#625958; font-size:.77rem; line-height:1.5; }
  .regional-visit__copy { min-width:0; }
  .regional-visit__copy h2 { max-width:19ch; text-wrap:balance; }
  .regional-visit__copy p:not(.pmu-home-kicker) { margin:0 0 18px; font-size:1rem; line-height:1.75; }
  .regional-visit__actions { display:flex; align-items:center; flex-wrap:wrap; gap:8px 20px; margin-top:24px; }
  .regional-visit__text-link { display:inline-flex; align-items:center; gap:8px; min-height:48px; font-size:.9rem; font-weight:650; }
  @media(max-width:900px) { .regional-visit { gap:26px; padding:26px; } }
  @media(max-width:700px) {
    .regional-visit { grid-template-columns:minmax(0,1fr); gap:24px; margin:20px 0 36px; padding:22px 18px; border-radius:24px; }
    .regional-visit__copy { grid-row:1; }
    .regional-visit__copy h2 { max-width:24ch; }
    .regional-visit__copy p:not(.pmu-home-kicker) { font-size:.96rem; line-height:1.7; }
    .regional-visit__actions { gap:8px; }
    .regional-visit__actions a { width:100%; justify-content:center; }
    .regional-visit__photo img { aspect-ratio:5/4; object-position:center 58%; }
  }
</style>
