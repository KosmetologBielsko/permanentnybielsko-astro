---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { Image } from "astro:assets";
import heartPortrait from "../assets/home-13/sercem-malowane.webp";
import "../styles/pmu-landing.css";

const pageUrl = "https://www.permanentnybielsko.com/sercemmalowane/";
const pageTitle = "#SercemMalowane | Bogusława Herda Bielsko-Biała";
const pageDescription =
  "#SercemMalowane Bogusława Herda — bezpłatne zabiegi PMU w szczególnych historiach, m.in. po leczeniu onkologicznym, przy alopecji i po rozszczepie wargi. Zawsze po indywidualnej kwalifikacji.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDescription,
    "inLanguage": "pl-PL",
    "isPartOf": {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    "about": {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": "https://www.permanentnybielsko.com/images/portret-sercem-malowane-boguslawa-herda.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Strona główna",
        "item": "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "#SercemMalowane",
        "item": pageUrl
      }
    ]
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/sercemmalowane/" structuredData={structuredData}>
  <Header />
  <a class="pmu-landing-skip" href="#sercem-historia">Przejdź do historii inicjatywy</a>
  <main class="pmu-landing pmu-heart" id="sercemmalowane">
    <div class="pmu-landing-shell">
      <nav class="pmu-landing-breadcrumbs" aria-label="Okruszki nawigacyjne">
        <a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">#SercemMalowane</span>
      </nav>

      <section class="pmu-landing-intro" aria-labelledby="sercem-tytul">
        <div>
          <p class="pmu-landing-kicker"><span class="pmu-heart-mark" aria-hidden="true">♥</span> #SercemMalowane</p>
          <h1 id="sercem-tytul">Niektóre historie wymagają <span>więcej niż techniki.</span></h1>
          <p class="pmu-landing-lead">Nie każda pigmentacja zaczyna się od potrzeby makijażu. Czasem zaczyna się od potrzeby, żeby znowu poczuć się dobrze ze swoją twarzą.</p>
          <p>W inicjatywie #SercemMalowane łączę doświadczenie w makijażu permanentnym z uważnością na historię drugiej osoby.</p>
          <a class="pmu-landing-intro-link" href="#kontakt">Zacznijmy od rozmowy <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="pmu-heart-portrait">
          <Image src={heartPortrait} alt="Bogusława Herda z dyplomem Ambasador Serca podczas wydarzenia #SercemMalowane Long-Time-Liner" width={360} widths={[240,360,540,720]} sizes="(max-width:640px) 240px, (max-width:900px) 280px, 360px" format="webp" quality={83} loading="eager" fetchpriority="high" decoding="async" />
          <figcaption><strong>Ambasador Serca</strong><span>Bogusława Herda · Long-Time-Liner®</span></figcaption>
        </figure>
      </section>

      <section class="pmu-landing-section pmu-heart-story" id="sercem-historia" aria-labelledby="sercem-historia-tytul">
        <div>
          <p class="pmu-landing-kicker">Historia, od której zaczynamy</p>
          <h2 id="sercem-historia-tytul">Czasem chodzi o coś więcej niż makijaż.</h2>
          <p>Utrata naturalnych brwi, zmiany wyglądu po leczeniu czy asymetria ust po rozszczepie wargi mogą wpływać na to, jak patrzymy na swoją twarz. Każda z tych historii wymaga osobnego podejścia.</p>
          <p>Makijaż permanentny może optycznie uzupełnić brwi lub podkreślić kolor i kontur ust. To praca z wyglądem — nie leczenie ani terapia. Możliwości pigmentacji ustalamy dopiero po kwalifikacji.</p>
        </div>
        <aside class="pmu-landing-stance" aria-labelledby="sercem-pomoc">
          <p class="pmu-landing-kicker">W ramach inicjatywy</p>
          <h3 id="sercem-pomoc">Uważność na Twoją historię.</h3>
          <p>Wybrane zabiegi wykonuję <strong>bezpłatnie</strong> — zawsze po rozmowie i indywidualnej kwalifikacji. Zgłoszenie nie oznacza automatycznej decyzji o zabiegu.</p>
          <p class="pmu-heart-signature">Bogusława Herda</p>
        </aside>
      </section>

      <section class="pmu-landing-section" aria-labelledby="sercem-kroki">
        <div class="pmu-landing-section-heading">
          <p class="pmu-landing-kicker">Jak to wygląda</p>
          <h2 id="sercem-kroki">Najpierw rozmowa. Potem decyzja.</h2>
          <p>Nie musisz wiedzieć, jaki zabieg będzie właściwy. Zaczynamy od poznania Twojej sytuacji i oceny bezpieczeństwa.</p>
        </div>
        <ol class="pmu-landing-steps pmu-heart-steps">
          <li><span aria-hidden="true">01</span><h3>Rozmowa</h3><p>Opowiadasz swoją historię i mówisz, co jest dla Ciebie ważne.</p></li>
          <li><span aria-hidden="true">02</span><h3>Kwalifikacja</h3><p>Oceniamy stan skóry, przeciwwskazania i możliwości pigmentacji.</p></li>
          <li><span aria-hidden="true">03</span><h3>Projekt</h3><p>Jeśli zabieg jest możliwy, wspólnie omawiamy kształt, kolor i zakres pracy.</p></li>
          <li><span aria-hidden="true">04</span><h3>Decyzja i pigmentacja</h3><p>Dopiero po kwalifikacji i akceptacji projektu ustalamy dalsze kroki.</p></li>
        </ol>
      </section>

      <section class="pmu-landing-booking" id="kontakt" aria-labelledby="sercem-kontakt">
        <div>
          <p class="pmu-landing-kicker">Zacznijmy od rozmowy</p>
          <h2 id="sercem-kontakt">Chcesz opowiedzieć nam swoją historię?</h2>
          <p>Każdą sytuację oceniamy indywidualnie. Pierwszym krokiem jest spokojna rozmowa i kwalifikacja.</p>
        </div>
        <div class="pmu-landing-booking-actions">
          <a class="pmu-landing-primary" href="/kontakt/">Skontaktuj się z gabinetem <span aria-hidden="true">→</span></a>
          <a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pmu-heart .pmu-heart-mark { margin-right:6px; color:#a34e62; }
  .pmu-heart .pmu-heart-portrait { width:min(100%,360px); justify-self:center; }
  .pmu-heart .pmu-heart-portrait img { width:100%; height:auto; border:1px solid var(--landing-line); border-radius:28px; }
  .pmu-heart .pmu-heart-portrait figcaption { display:grid; gap:3px; margin-top:12px; color:var(--landing-muted); font-size:.78rem; line-height:1.5; text-align:center; }
  .pmu-heart .pmu-heart-portrait strong { color:var(--landing-teal); font-size:.86rem; }
  .pmu-heart .pmu-heart-story { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr); align-items:start; gap:var(--pmu-wide-gap,36px); padding-top:36px; border-top:1px solid var(--landing-line); }
  .pmu-heart-story > div > p + p { margin-top:16px; }
  .pmu-heart .pmu-heart-signature { margin-top:18px; color:var(--landing-teal); font-size:.83rem; font-weight:700; }
  .pmu-heart .pmu-heart-steps { grid-template-columns:repeat(4,minmax(0,1fr)); }
  @media(max-width:900px) {
    .pmu-heart .pmu-heart-portrait { width:min(100%,280px); }
    .pmu-heart .pmu-heart-story { grid-template-columns:minmax(0,1fr); gap:24px; }
    .pmu-heart .pmu-heart-steps { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:640px) {
    .pmu-heart .pmu-heart-portrait { width:min(100%,240px); }
    .pmu-heart .pmu-heart-portrait img { border-radius:22px; }
    .pmu-heart .pmu-heart-story { padding-top:28px; }
    .pmu-heart .pmu-heart-steps { grid-template-columns:minmax(0,1fr); }
  }
</style>
