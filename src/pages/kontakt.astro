---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import { siteConfig } from "../config/site";
import "../styles/pmu-contact.css";
const { booksyUrl, phone, email, address } = siteConfig;
const phoneHref = `tel:${phone.replace(/\s/g, "")}`;
const emailHref = `mailto:${email}`;
const mapUrl = "https://share.google/r1H8ZLwSZMdRIflO9";
const formUrl = "/makijaz-permanentny-bielsko/#kwalifikacja-pmu";
const pageUrl = "https://www.permanentnybielsko.com/kontakt/";
const pageTitle = "Kontakt | Bogusława Herda Makijaż Permanentny Bielsko-Biała";
const pageDescription = "Kontakt do gabinetu Bogusława Herda w Bielsku-Białej: tel. 730 900 125, Booksy, formularz PMU, e-mail i dojazd na ul. Barlickiego 5/23.";
const days: Record<string, string> = { Monday: "Poniedziałek", Tuesday: "Wtorek", Wednesday: "Środa", Thursday: "Czwartek", Friday: "Piątek", Saturday: "Sobota", Sunday: "Niedziela" };
const hours = siteConfig.openingHoursSpecification.map(item => ({
  label: Array.isArray(item.dayOfWeek) ? `${days[item.dayOfWeek[0]]} – ${days[item.dayOfWeek[item.dayOfWeek.length - 1]]}` : days[item.dayOfWeek as string],
  time: `${item.opens}–${item.closes}`
}));
const faqItems = [
  {
    question: "Jak najlepiej umówić wizytę?",
    answer:
      "Najprościej przez Booksy, gdzie można sprawdzić aktualne terminy i zarezerwować wizytę online.",
  },
  {
    question: "Mam stare PMU — czy rezerwować od razu nowy zabieg?",
    answer:
      "Najpierw warto skorzystać z formularza kwalifikacji. Stary pigment wymaga oceny koloru, nasycenia, kształtu i stanu skóry.",
  },
  {
    question: "Czy mogę zadzwonić przed rezerwacją?",
    answer:
      "Tak. Telefon jest dobrym rozwiązaniem w sprawach organizacyjnych albo wtedy, gdy nie wiesz, którą usługę wybrać.",
  },
  {
    question: "Gdzie znajduje się gabinet?",
    answer:
      "Gabinet znajduje się przy ul. Barlickiego 5/23, 43-300 Bielsko-Biała, w centrum miasta.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    dateModified: "2026-09-14",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: { "@id": "https://www.permanentnybielsko.com/#website" },
    about: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntity: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Kontakt",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "PostalAddress",
    "@id": `${pageUrl}#address`,
    streetAddress: "ul. Barlickiego 5/23",
    postalCode: "43-300",
    addressLocality: "Bielsko-Biała",
    addressCountry: "PL",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/kontakt/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-contact-skip" href="#kontakt-rezerwacja">Przejdź do rezerwacji i telefonu</a>
  <main class="pmu-contact" id="kontakt">
    <div class="pmu-contact-shell">
      <nav class="pmu-contact-breadcrumbs" aria-label="Okruszki nawigacyjne"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Kontakt</span></nav>
      <section class="pmu-contact-intro" aria-labelledby="kontakt-tytul">
        <div class="pmu-contact-copy">
          <p class="pmu-contact-kicker">Kontakt · Bielsko-Biała</p>
          <h1 id="kontakt-tytul">Umów wizytę.<br /><span>Zacznij od rozmowy.</span></h1>
          <p class="pmu-contact-lead">Masz pomysł na brwi, usta lub kreski? Sprawdź terminy. Jeśli dopiero szukasz swojego kierunku albo masz stare PMU, pomożemy ustalić pierwszy krok.</p>
          <a class="pmu-contact-author" href="/makijaz-permanentny-bielsko/#boguslawa-herda">
            <Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" />
            <span><strong>Bogusława Herda</strong><span>Linergistka · trenerka PMU</span></span>
          </a>
        </div>
        <aside class="pmu-contact-overview" id="kontakt-rezerwacja" aria-labelledby="kontakt-wybor">
          <p class="pmu-contact-kicker" id="kontakt-wybor">Twój pierwszy krok</p>
          <a class="pmu-contact-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a>
          <p class="pmu-contact-booksy-note">Wybierz usługę i zarezerwuj wizytę online.</p>
          <a class="pmu-contact-phone" href={phoneHref}>
            <span><small>Wolisz porozmawiać? Zadzwoń</small><strong>730 900 125</strong></span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a16 16 0 0 1-7-7l2-2-2-5Z" /></svg>
          </a>
          <a class="pmu-contact-form-link" href={formUrl}><span><strong>Masz stare PMU lub pytanie o metodę?</strong><span>Opisz swoją sytuację w formularzu</span></span><span aria-hidden="true">→</span></a>
        </aside>
      </section>
      <div class="pmu-contact-address-strip">
        <div><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><p><strong>{address.streetAddress}</strong><span>{address.addressLocality} · centrum miasta</span></p></div>
        <a class="pmu-contact-text-link" href="#kontakt-dojazd">Adres i dojazd <span aria-hidden="true">↓</span></a>
      </div>
      <section class="pmu-contact-location" id="kontakt-dojazd" aria-labelledby="kontakt-lokalizacja">
        <div>
          <p class="pmu-contact-kicker">Spotkajmy się w gabinecie</p>
          <h2 id="kontakt-lokalizacja">W centrum Bielska-Białej.</h2>
          <address class="pmu-contact-address"><strong>Bogusława Herda</strong><span>Makijaż Permanentny &amp; Kosmetologia Estetyczna</span><p>{address.streetAddress}<br />{address.postalCode} {address.addressLocality}</p></address>
          <a class="pmu-contact-secondary" href={mapUrl} target="_blank" rel="noopener noreferrer">Otwórz mapę i wyznacz trasę <span aria-hidden="true">↗</span></a>
          <p class="pmu-contact-note">Przed przyjazdem sprawdź datę i godzinę swojej rezerwacji. Jeśli potrzebujesz wskazówek dotyczących dotarcia do gabinetu, <a href={phoneHref}>zadzwoń do nas</a>.</p>
        </div>
        <aside class="pmu-contact-hours" aria-labelledby="kontakt-godziny">
          <p class="pmu-contact-kicker">Zaplanuj wizytę</p><h3 id="kontakt-godziny">Godziny przyjęć</h3>
          <dl>{hours.map(item => <div><dt>{item.label}</dt><dd>{item.time}</dd></div>)}<div><dt>Niedziela</dt><dd>zamknięte</dd></div></dl>
          <p>Godziny mogą zależeć od zapisów. Aktualne wolne terminy sprawdzisz w Booksy.</p>
          <a class="pmu-contact-text-link" href={booksyUrl} target="_blank" rel="noopener noreferrer">Zobacz dostępność wizyt <span aria-hidden="true">↗</span></a>
        </aside>
      </section>
      <section class="pmu-contact-message" aria-labelledby="kontakt-wiadomosc">
        <div><p class="pmu-contact-kicker">Wolisz napisać?</p><h2 id="kontakt-wiadomosc">Zacznijmy od Twojego pytania.</h2><p>Przy wcześniejszej pigmentacji napisz, jaki obszar dotyczy zabiegu, kiedy był wykonany i co chcesz zmienić. To ułatwi rozmowę o dalszym postępowaniu.</p></div>
        <div class="pmu-contact-message-actions">
          <a class="pmu-contact-secondary" href={formUrl}>Przejdź do formularza PMU <span aria-hidden="true">→</span></a>
          <a class="pmu-contact-email" href={emailHref}><small>Kontakt e-mail</small><strong>{email}</strong><span>Napisz wiadomość <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>
      <section class="pmu-contact-faq" aria-labelledby="kontakt-pytania">
        <p class="pmu-contact-kicker">Przed pierwszą wizytą</p><h2 id="kontakt-pytania">Kilka odpowiedzi na początek.</h2>
        {faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
      </section>
      <section class="pmu-contact-explore" aria-labelledby="kontakt-online">
        <p class="pmu-contact-kicker">Poznaj nas bliżej</p><h2 id="kontakt-online">Prace, ceny i codzienność gabinetu.</h2>
        <div class="pmu-contact-explore-links">
          <a href="/galeria/"><strong>Galeria PMU</strong><span>Brwi, usta i kreski <span aria-hidden="true">→</span></span></a>
          <a href="/cennik-makijaz-permanentny/"><strong>Cennik zabiegów</strong><span>Sprawdź zakres i ceny <span aria-hidden="true">→</span></span></a>
          <a href="https://www.instagram.com/permanentnybielsko" target="_blank" rel="noopener noreferrer"><strong>Instagram</strong><span>@permanentnybielsko <span aria-hidden="true">↗</span></span></a>
          <a href="https://www.facebook.com/PermanentnyBielsko" target="_blank" rel="noopener noreferrer"><strong>Facebook</strong><span>PermanentnyBielsko <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>
      <GuideAssistant />
    </div>
  </main>
  <Footer />
</Layout>
