---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const phone = "+48 730 900 125";
const phoneHref = "tel:+48730900125";
const email = "bogusia@permanentnybielsko.com";
const emailHref = "mailto:bogusia@permanentnybielsko.com";
const mapUrl = "https://share.google/r1H8ZLwSZMdRIflO9";

const pageUrl = "https://www.permanentnybielsko.com/kontakt/";
const pageTitle =
  "Kontakt | Bogusława Herda Makijaż Permanentny Bielsko-Biała";
const pageDescription =
  "Kontakt do gabinetu Bogusławy Herda w Bielsku-Białej. Booksy, formularz PMU, telefon, e-mail, adres ul. Barlickiego 5/23 i informacje przed wizytą.";

const quickContacts = [
  {
    number: "01",
    label: "Rezerwacja",
    title: "Booksy",
    text: "Aktualne terminy i wygodna rezerwacja online.",
    href: booksyUrl,
    cta: "Sprawdź terminy",
    external: true,
    accent: true,
  },
  {
    number: "02",
    label: "Kwalifikacja",
    title: "Formularz PMU",
    text: "Stare PMU, pytanie o metodę albo wątpliwości przed zabiegiem.",
    href: "/makijaz-permanentny-bielsko/#kwalifikacja-pmu",
    cta: "Wyślij zapytanie",
  },
  {
    number: "03",
    label: "Telefon",
    title: phone,
    text: "Szybki kontakt w sprawach organizacyjnych.",
    href: phoneHref,
    cta: "Zadzwoń",
  },
  {
    number: "04",
    label: "Lokalizacja",
    title: "Barlickiego 5/23",
    text: "Gabinet w centrum Bielska-Białej.",
    href: mapUrl,
    cta: "Zobacz mapę",
    external: true,
  },
];

const socialLinks = [
  {
    short: "IG",
    label: "Instagram",
    text: "@permanentnybielsko",
    href: "https://www.instagram.com/permanentnybielsko",
  },
  {
    short: "FB",
    label: "Facebook",
    text: "PermanentnyBielsko",
    href: "https://www.facebook.com/PermanentnyBielsko",
  },
  {
    short: "B",
    label: "Booksy",
    text: "Rezerwacja online",
    href: booksyUrl,
  },
  {
    short: "G",
    label: "Google",
    text: "Mapa i opinie",
    href: mapUrl,
  },
];

const faqItems = [
  {
    question: "Jak najlepiej umówić wizytę?",
    answer:
      "Najprościej przez Booksy, gdzie można sprawdzić aktualne terminy i zarezerwować wizytę online.",
  },
  {
    question: "Mam stare PMU — czy rezerwować od razu nowy zabieg?",
    answer:
      "Najpierw warto skorzystać z formularza kwalifikacji. Stary pigment wymaga oceny koloru, nasycenia, kształtu i stanu skóry.",
  },
  {
    question: "Czy mogę zadzwonić przed rezerwacją?",
    answer:
      "Tak. Telefon jest dobrym rozwiązaniem w sprawach organizacyjnych albo wtedy, gdy nie wiesz, którą usługę wybrać.",
  },
  {
    question: "Gdzie znajduje się gabinet?",
    answer:
      "Gabinet znajduje się przy ul. Barlickiego 5/23, 43-300 Bielsko-Biała, w centrum miasta.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: { "@id": "https://www.permanentnybielsko.com/#website" },
    about: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntity: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Kontakt",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "PostalAddress",
    "@id": `${pageUrl}#address`,
    streetAddress: "ul. Barlickiego 5/23",
    postalCode: "43-300",
    addressLocality: "Bielsko-Biała",
    addressCountry: "PL",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/kontakt/"
  structuredData={structuredData}
>
  <div class="contact-page">
    <Header />

    <main>
      <section class="contact-hero" id="kontakt">
        <div class="container contact-hero-grid">
          <div class="contact-hero-copy">
            <p class="section-kicker">Kontakt · Bielsko-Biała</p>

            <h1>
              <span>Umów wizytę</span> albo zacznij od spokojnej kwalifikacji PMU.
            </h1>

            <p class="contact-hero-lead">
              Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy w Booksy.
              Jeśli masz stare PMU, wątpliwości lub nie wiesz, którą metodę wybrać,
              skorzystaj z formularza kwalifikacji.
            </p>

            <div class="contact-actions">
              <a class="button-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
                Formularz PMU <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href={phoneHref}>Zadzwoń</a>
            </div>
          </div>

          <aside class="contact-hero-panel">
            <p class="contact-mark" aria-hidden="true">PMU</p>
            <div>
              <p class="section-kicker section-kicker-light">Gabinet</p>
              <h2>ul. Barlickiego 5/23<br />Bielsko-Biała</h2>
              <p>Makijaż permanentny, konsultacje, korekty i usuwanie PMU w centrum miasta.</p>

              <div class="contact-mini-actions">
                <a href={mapUrl} target="_blank" rel="noopener noreferrer">Mapa →</a>
                <a href={emailHref}>E-mail →</a>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="contact-proof">
        <div class="container contact-proof-grid">
          <div><strong>Booksy</strong><span>aktualne terminy online</span></div>
          <div><strong>{phone}</strong><span>kontakt telefoniczny</span></div>
          <div><strong>Barlickiego 5/23</strong><span>centrum Bielska-Białej</span></div>
          <div><strong>Formularz PMU</strong><span>kwalifikacja przed zabiegiem</span></div>
        </div>
      </section>

      <section class="contact-section">
        <div class="container">
          <div class="contact-heading">
            <p class="section-kicker">Wybierz kontakt</p>
            <h2>Jedna strona, cztery proste drogi.</h2>
            <p>Bez szukania numeru telefonu, adresu czy formularza w kilku miejscach.</p>
          </div>

          <div class="contact-fast-grid">
            {quickContacts.map((card) => (
              <a
                class:list={["contact-fast-card", card.accent && "is-accent"]}
                href={card.href}
                target={card.external ? "_blank" : undefined}
                rel={card.external ? "noopener noreferrer" : undefined}
              >
                <span class="contact-fast-number">{card.number}</span>
                <p class="contact-fast-label">{card.label}</p>
                <h3>{card.title}</h3>
                <em>{card.text}</em>
                <strong>{card.cta} →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-section contact-location-section">
        <div class="container contact-location-grid">
          <article class="contact-card">
            <p class="section-kicker">Adres i dojazd</p>
            <h2>Bogusława Herda Permanent Makeup & Kosmetologia Estetyczna</h2>

            <div class="contact-data-list">
              <div>
                <span>Adres</span>
                <strong>ul. Barlickiego 5/23<br />43-300 Bielsko-Biała</strong>
              </div>
              <div>
                <span>Telefon</span>
                <a href={phoneHref}>{phone}</a>
              </div>
              <div>
                <span>E-mail</span>
                <a href={emailHref}>{email}</a>
              </div>
            </div>

            <div class="contact-location-actions">
              <a class="button-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">
                Zobacz trasę →
              </a>
              <a class="button-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
                Booksy →
              </a>
            </div>
          </article>

          <article class="contact-card">
            <p class="section-kicker">Godziny</p>
            <h2>Przed wizytą sprawdź aktualny termin w Booksy.</h2>

            <div class="contact-hours">
              <div><strong>Poniedziałek – piątek</strong><span>9:00–18:00</span></div>
              <div><strong>Sobota</strong><span>10:00–14:00</span></div>
              <div><strong>Niedziela</strong><span>zamknięte</span></div>
            </div>

            <p class="contact-note">
              Godziny mogą zależeć od zapisów i dostępnych terminów.
              Najbardziej aktualne informacje o wolnych wizytach pokazuje Booksy.
            </p>
          </article>
        </div>
      </section>

      <section class="contact-section">
        <div class="container contact-social-card">
          <div>
            <p class="section-kicker">Online</p>
            <h2>Zobacz prace, opinie albo przejdź od razu do rezerwacji.</h2>
          </div>

          <div class="contact-social-grid">
            {socialLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <span>{item.short}</span>
                <div>
                  <strong>{item.label}</strong>
                  <p>{item.text}</p>
                </div>
                <em aria-hidden="true">→</em>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-section contact-faq-section">
        <div class="container">
          <div class="contact-heading">
            <p class="section-kicker">Najczęstsze pytania</p>
            <h2>Jak najlepiej zacząć kontakt z gabinetem?</h2>
          </div>

          <div class="contact-faq-list">
            {faqItems.map((item) => (
              <details class="contact-faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="contact-faq-icon" aria-hidden="true"></span>
                </summary>
                <div><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-section">
        <div class="container contact-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Wiesz już, czego potrzebujesz?</h2>
          <p>
            Sprawdź termin w Booksy. Jeśli nie — formularz kwalifikacji pomoże
            zacząć od właściwego miejsca.
          </p>

          <div class="contact-actions contact-final-actions">
            <a class="button-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy →
            </a>
            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU →
            </a>
            <a class="button-secondary" href={phoneHref}>Zadzwoń</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .contact-page {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 78% 11%, rgba(56, 187, 181, 0.10), transparent 28rem),
      radial-gradient(circle at 12% 42%, rgba(201, 127, 143, 0.10), transparent 26rem),
      linear-gradient(180deg, #fffdfd 0%, #fff8fa 52%, #ffffff 100%);
  }

  .contact-page *,
  .contact-page *::before,
  .contact-page *::after {
    box-sizing: border-box;
  }

  .contact-page main,
  .contact-page section,
  .contact-page .container,
  .contact-page div,
  .contact-page article {
    min-width: 0;
  }

  .contact-page .section-kicker {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    margin: 0 0 18px;
    padding: 0 13px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.72);
    color: var(--color-turquoise-dark, #0f7773);
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .contact-page .section-kicker-light {
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .contact-hero {
    padding: 146px 0 78px;
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: 24px;
  }

  .contact-hero-copy,
  .contact-hero-panel,
  .contact-fast-card,
  .contact-card,
  .contact-social-card,
  .contact-faq-item,
  .contact-final-card {
    border: 1px solid rgba(183, 101, 118, 0.14);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.07);
  }

  .contact-hero-copy {
    padding: clamp(38px, 5vw, 68px);
    border-radius: 40px;
    background: rgba(255, 255, 255, 0.82);
  }

  .contact-hero-copy h1 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-family: inherit;
    font-size: clamp(3rem, 5.2vw, 6.1rem);
    font-weight: 770;
    line-height: 0.99;
    letter-spacing: -0.076em;
  }

  .contact-hero-copy h1 span {
    background: linear-gradient(120deg, #0d6a67, #0f7773 24%, #1aa5a0 48%, #63d7cf 72%, #0d6a67);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .contact-hero-lead {
    max-width: 780px;
    margin: 26px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(1.02rem, 1.25vw, 1.12rem);
    line-height: 1.68;
  }

  .contact-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
  }

  .contact-actions > a,
  .contact-location-actions > a {
    display: inline-flex;
    width: 100%;
    min-width: 0;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 18px;
    border-radius: 999px;
    font-family: inherit !important;
    font-size: 0.98rem !important;
    font-weight: 820 !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    text-align: center;
    text-transform: none !important;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }

  .button-booksy {
    border: 1px solid rgba(8, 111, 91, 0.16);
    background: linear-gradient(135deg, #18a889 0%, #0f8f78 55%, #0b7868 100%);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(15, 143, 120, 0.16);
  }

  .contact-hero-panel {
    position: relative;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: clamp(34px, 4vw, 52px);
    border-radius: 40px;
    color: #fff;
    background:
      radial-gradient(circle at 18% 16%, rgba(255,255,255,.30), transparent 12rem),
      linear-gradient(145deg, #0f7773 0%, #1aa5a0 38%, #63d7cf 67%, #0d6a67 100%);
  }

  .contact-mark {
    position: absolute;
    top: 32px;
    left: 38px;
    margin: 0;
    color: rgba(255,255,255,.19);
    font-size: clamp(4.8rem, 7.4vw, 8rem);
    font-weight: 850;
    line-height: .8;
    letter-spacing: -.1em;
  }

  .contact-hero-panel > div {
    position: relative;
    z-index: 1;
  }

  .contact-hero-panel h2 {
    margin: 116px 0 0;
    color: #fff;
    font-size: clamp(2rem, 3vw, 3.15rem);
    font-weight: 770;
    line-height: 1;
    letter-spacing: -.068em;
  }

  .contact-hero-panel > div > p:not(.section-kicker) {
    margin: 18px 0 0;
    color: rgba(255,255,255,.9);
    line-height: 1.64;
  }

  .contact-mini-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
  }

  .contact-mini-actions a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 0 15px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 999px;
    background: rgba(255,255,255,.14);
    color: #fff;
    font-size: .72rem;
    font-weight: 820;
    text-decoration: none;
  }

  .contact-proof {
    border-block: 1px solid rgba(183,101,118,.10);
    background: rgba(255,255,255,.74);
  }

  .contact-proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
  }

  .contact-proof-grid > div {
    min-height: 112px;
    padding: 24px 22px;
    border-right: 1px solid rgba(183,101,118,.12);
  }

  .contact-proof-grid > div:last-child { border-right: 0; }

  .contact-proof-grid strong {
    display: block;
    margin-bottom: 7px;
    color: var(--color-text, #17151d);
    font-size: .94rem;
    font-weight: 790;
    overflow-wrap: anywhere;
  }

  .contact-proof-grid span {
    display: block;
    color: var(--color-muted, #6e6670);
    font-size: .7rem;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .contact-section {
    padding: 82px 0;
  }

  .contact-location-section,
  .contact-faq-section {
    background:
      radial-gradient(circle at 88% 20%, rgba(56,187,181,.08), transparent 24rem),
      rgba(255,255,255,.56);
  }

  .contact-heading {
    max-width: 1000px;
    margin-bottom: 34px;
  }

  .contact-heading h2,
  .contact-card h2,
  .contact-social-card h2,
  .contact-final-card h2 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-size: clamp(2.35rem, 4vw, 4.25rem);
    font-weight: 760;
    line-height: 1.02;
    letter-spacing: -.072em;
  }

  .contact-heading > p:not(.section-kicker),
  .contact-final-card > p:not(.signature) {
    max-width: 840px;
    margin: 18px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(.98rem, 1.15vw, 1.06rem);
    line-height: 1.7;
  }

  .contact-fast-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 14px;
  }

  .contact-fast-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: 28px;
    color: inherit;
    text-decoration: none;
    background:
      radial-gradient(circle at 94% 12%, rgba(56,187,181,.08), transparent 12rem),
      rgba(255,255,255,.90);
  }

  .contact-fast-card.is-accent {
    color: #fff;
    background:
      radial-gradient(circle at 18% 18%, rgba(255,255,255,.24), transparent 10rem),
      linear-gradient(145deg, #0f7773 0%, #1aa5a0 42%, #138a86 72%, #0d6a67 100%);
  }

  .contact-fast-number {
    display: block;
    margin-bottom: 32px;
    color: var(--color-turquoise-dark, #0f7773);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .18em;
  }

  .contact-fast-label {
    display: inline-flex;
    width: fit-content;
    min-height: 29px;
    align-items: center;
    margin: 0 0 16px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(219,246,243,.66);
    color: var(--color-turquoise-dark, #0f7773);
    font-size: .63rem;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .contact-fast-card h3 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-size: clamp(1.45rem, 1.9vw, 2.05rem);
    font-weight: 780;
    line-height: 1.03;
    letter-spacing: -.06em;
    overflow-wrap: anywhere;
  }

  .contact-fast-card em {
    display: block;
    margin: 14px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: .94rem;
    font-style: normal;
    line-height: 1.58;
  }

  .contact-fast-card > strong {
    display: inline-flex;
    margin-top: auto;
    padding-top: 22px;
    color: var(--color-turquoise-dark, #0f7773);
    font-size: .78rem;
    font-weight: 850;
  }

  .contact-fast-card.is-accent .contact-fast-number,
  .contact-fast-card.is-accent .contact-fast-label,
  .contact-fast-card.is-accent h3,
  .contact-fast-card.is-accent em,
  .contact-fast-card.is-accent > strong {
    color: #fff;
  }

  .contact-fast-card.is-accent .contact-fast-label {
    background: rgba(255,255,255,.14);
  }

