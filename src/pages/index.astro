---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomeBrandVideo from "../components/HomeBrandVideo.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { Image } from "astro:assets";
import naturePortrait from "../assets/home-13/powrot-do-natury-kapelusz.webp";
import expertPortrait from "../assets/home-13/boguslawa-herda-ekspert.webp";
import ankaraImage from "../assets/home-13/ankara.webp";
import teamImage from "../assets/home-13/long-time-liner-zespol.webp";
import missionPortrait from "../assets/home-13/sercem-malowane.webp";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import media from "../data/pmu-media-library.json";
import { siteConfig } from "../config/site";
import "../styles/pmu-home.css";
const { booksyUrl } = siteConfig;
const formUrl = "/makijaz-permanentny-bielsko/#kwalifikacja-pmu";

const pageUrl = "https://www.permanentnybielsko.com/";
const pageTitle = "Makijaż permanentny Bielsko-Biała | Bogusława Herda";
const pageDescription =
  "Makijaż permanentny Bielsko-Biała: naturalne brwi permanentne, usta permanentne, kreski permanentne, Silky Hairstroke Brows, korekta i usuwanie PMU oraz szkolenia PMU.";

const mainServices = [
  {
    name: "Makijaż permanentny Bielsko-Biała",
    description: "Naturalny makijaż permanentny brwi, ust i kresek dopasowany do urody, skóry i oczekiwanego efektu.",
    url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/"
  },
  {
    name: "Brwi permanentne",
    description: "Naturalne brwi permanentne, metoda włoskowa, cieniowanie, włos z cieniem i Silky Hairstroke Brows.",
    url: "https://www.permanentnybielsko.com/makijaz-permanentny-brwi/"
  },
  {
    name: "Makijaż permanentny ust",
    description: "Subtelne odświeżenie koloru ust, wyrównanie czerwieni wargowej i naturalny efekt bez przerysowania.",
    url: "https://www.permanentnybielsko.com/makijaz-permanentny-ust/"
  },
  {
    name: "Makijaż permanentny oczu",
    description: "Kreski permanentne, zagęszczenie linii rzęs i dopasowanie kreski do budowy oka.",
    url: "https://www.permanentnybielsko.com/makijaz-permanentny-oczu/"
  },
  {
    name: "Usuwanie makijażu permanentnego",
    description: "Rozjaśnianie starego PMU, korekta nieudanego pigmentu i przygotowanie skóry do nowej pigmentacji.",
    url: "https://www.permanentnybielsko.com/usuwanie-makijazu-permanentnego/"
  },
  {
    name: "Szkolenie makijaż permanentny",
    description: "Szkolenia PMU: Step by Step, Masterclass, Silky Hairstroke Brows i Bye-Bye Pigment Remover.",
    url: "https://www.permanentnybielsko.com/szkolenie-makijaz-permanentny/"
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDescription,
    "inLanguage": "pl-PL",
    "dateModified": "2026-09-14",
    "isPartOf": {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    "about": {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": "https://www.permanentnybielsko.com/images/powrot-do-natury-boguslawa-herda-kapelusz.webp"
    },
    "mainEntity": {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Strona główna",
        "item": pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${pageUrl}#main-services`,
    "name": "Główne usługi makijażu permanentnego",
    "itemListElement": mainServices.map((service, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": service.name,
      "description": service.description,
      "url": service.url
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "@id": `${pageUrl}#offer-catalog`,
    "name": "Oferta PMU Bogusława Herda",
    "itemListElement": mainServices.map((service) => ({
      "@type": "Offer",
      "url": service.url,
      "itemOffered": {
        "@type": "Service",
        "name": service.name,
        "description": service.description,
        "provider": {
          "@id": "https://www.permanentnybielsko.com/#localbusiness"
        },
        "areaServed": {
          "@type": "City",
          "name": "Bielsko-Biała"
        }
      }
    }))
  }
];


const treatments = [
  { id: "home-brwi-cien", kicker: "Miękkie wypełnienie", title: "Brwi metodą cienia", price: "1200 zł", photo: media.cien[0], alt: "Brwi metodą cienia — miękkie wypełnienie i oprawa oka", text: "Kształt i nasycenie koloru dopasowane do skóry oraz naturalnej oprawy oka.", href: "/makijaz-permanentny-brwi/", cta: "Poznaj metodę cienia" },
  { id: "metody", kicker: "Włos maszynowy", title: "Silky Hairstroke Brows", price: "1400 zł", photo: media.silky[5], alt: "Silky Hairstroke Brows — autorska technika włosa maszynowego Bogusława Herda", text: "Precyzyjnie pigmentowane włoski. Autorska technika Bogusława Herda, poprzedzona oceną skóry.", href: "/makijaz-permanentny-brwi/#silky-hairstroke-brows", cta: "Zobacz, czym jest Silky" },
  { id: "home-usta", kicker: "Kolor i kontur", title: "Usta permanentne", price: "1400 zł", photo: media.usta[8], alt: "Makijaż permanentny ust — różowe, równomierne podkreślenie", text: "Odświeżenie koloru i uporządkowanie konturu z poszanowaniem naturalnego kształtu ust.", href: "/makijaz-permanentny-ust/", cta: "Poznaj pigmentację ust" },
  { id: "home-kreski", kicker: "Podkreślenie spojrzenia", title: "Kreski permanentne", price: "od 500 zł", photo: media.oczy[3], alt: "Górna kreska permanentna z wyraźniejszym zakończeniem", text: "Zagęszczenie rzęs, kreska dekoracyjna lub dolna. Rodzaj i cenę dobieramy do zakresu zabiegu.", href: "/makijaz-permanentny-oczu/", cta: "Porównaj rodzaje kresek" },
];
const destinations = [
  { city: "Ankara", country: "Turcja", role: "Prelegentka Long-Time-Liner®" },
  { city: "Budapeszt", country: "Węgry", role: "Warsztaty i prelekcje PMU" },
  { city: "Lyon", country: "Francja", role: "Jurorka Mistrzostw Francji PMU" },
  { city: "Monachium", country: "Niemcy", role: "Wicemistrzostwo świata PMU" },
  { city: "Düsseldorf", country: "Niemcy", role: "Warsztaty, prelekcje i Silky" },
  { city: "Dżakarta", country: "Indonezja", role: "Jurorka i prelegentka PMU Indonesia", upcoming: true },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-home-skip" href="#makijaz-permanentny">Przejdź do oferty makijażu permanentnego</a>
  <main class="pmu-home">
    <div class="pmu-home-shell">
      <section class="pmu-home-hero" aria-labelledby="home-tytul">
        <div class="pmu-home-hero-copy"><p class="pmu-home-kicker">Bogusława Herda · Bielsko-Biała</p><h1 id="home-tytul">Makijaż permanentny,<br /><span>który podkreśla naturalne piękno.</span></h1><p class="pmu-home-lead">Brwi, usta i kreski dopasowane do Twojej urody. Konsultacja, rysunek wstępny i spokojny wybór efektu — od pierwszej rozmowy do wygojenia.</p><a class="pmu-home-author" href="#autorytet"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" /><span><strong>Bogusława Herda</strong><span>Wicemistrzyni świata PMU · trenerka Long-Time-Liner®</span></span></a>
<!-- PMU-SOCIAL-PROOF-1200 -->
<a
  class="pmu-home-review-badge"
  href={booksyUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Opinie klientek Bogusława Herda w Booksy"
>
  <span class="pmu-home-review-star" aria-hidden="true">★</span>
  <strong>5.0 Booksy</strong>
  <span>1200+ opinii klientek</span>
</a></div>
        <figure class="pmu-home-hero-photo"><Image src={naturePortrait} alt="Bogusława Herda w kapeluszu — Powrót do natury" width={880} widths={[360,540,720,880,1122]} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) 480px, 440px" format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async" /><figcaption>Powrót do natury</figcaption></figure>
        <div class="pmu-home-hero-actions"><a class="pmu-home-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="pmu-home-secondary" href={formUrl}>Mam pytanie przed wizytą →</a><div class="pmu-home-hero-links"><a href="tel:+48730900125">Zadzwoń: 730 900 125</a><a href="/cennik-makijaz-permanentny/">Zobacz cennik →</a></div></div>
      </section>
      <nav class="pmu-home-nav" aria-label="Przejdź do wybranej części strony"><a href="#makijaz-permanentny">Zabiegi i zdjęcia ↓</a><a href="#powrot-do-natury">Zobacz film ↓</a><a href="#autorytet">Doświadczenie ↓</a><a href="#o-mnie">Międzynarodowe PMU ↓</a><a href="#kontakt">Kontakt ↓</a></nav>
      <section class="pmu-home-section" id="makijaz-permanentny" aria-labelledby="home-zabiegi"><div class="pmu-home-section-heading"><p class="pmu-home-kicker">01 / Twój kierunek</p><h2 id="home-zabiegi">Co chcesz podkreślić?</h2><p>Naturalne brwi, odświeżenie koloru ust czy delikatna oprawa oka? Wybierz obszar i poznaj możliwości. Ostateczny projekt dobieramy po ocenie skóry i Twoich oczekiwań.</p></div>
        <div class="pmu-home-treatments">{treatments.map(item => <article class="pmu-home-treatment" id={item.id}><a class="pmu-home-treatment-photo" href={item.href} aria-label={item.cta}><img src={item.photo.thumb} srcset={item.photo.srcset} sizes="(max-width:360px) calc(100vw - 36px), (max-width:640px) calc((100vw - 50px) / 2), (max-width:900px) calc((100vw - 72px) / 2), 260px" width={item.photo.width} height={item.photo.height} alt={item.alt} loading="lazy" decoding="async" /></a><div class="pmu-home-treatment-copy"><p class="pmu-home-kicker">{item.kicker}</p><h3>{item.title}</h3><p>{item.text}</p><strong class="pmu-home-treatment-price">{item.price}</strong><a href={item.href}>{item.cta} →</a></div></article>)}</div>
        <p class="pmu-home-price-note">Ceny głównych zabiegów oznaczonych gwiazdką w cenniku obejmują korektę po wygojeniu, <strong>do 2 miesięcy</strong>.</p>
        <div class="pmu-home-links"><a href="/makijaz-permanentny-bielsko/">Poznaj całą ofertę PMU →</a><a href="/cennik-makijaz-permanentny/">Cennik, korekty i odświeżenia →</a></div>
        <aside class="pmu-home-old-pmu"><div><h3>Masz już makijaż permanentny?</h3><p>Najpierw oceńmy jego kolor, nasycenie i kształt. Czasem nową pigmentację poprzedza rozjaśnienie lub usuwanie starego PMU.</p></div><a href="/usuwanie-makijazu-permanentnego/">Stare PMU — co dalej? →</a></aside>
      </section>
      <section class="pmu-home-section pmu-home-film" id="powrot-do-natury" aria-labelledby="home-film"><div class="pmu-home-section-heading"><p class="pmu-home-kicker">02 / Zobacz mój kierunek</p><h2 id="home-film">Powrót do natury w praktyce.</h2><p>Miękka linia, właściwy odcień i świeżość, która pozostaje spójna z twarzą. Tak rozumiem naturalny makijaż permanentny.</p></div><HomeBrandVideo /></section>
      <section class="pmu-home-expert pmu-home-section" id="autorytet" aria-labelledby="home-doswiadczenie"><figure class="pmu-home-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — wicemistrzyni świata PMU i trenerka Long-Time-Liner" width={680} widths={[280,420,560,680]} sizes="(max-width:640px) 220px, (max-width:900px) 280px, 340px" format="webp" quality={83} loading="lazy" decoding="async" /></figure><div><p class="pmu-home-kicker">03 / Poznaj osobę, której powierzysz swój makijaż</p><h2 id="home-doswiadczenie">Doświadczenie.<br />I uważność na Ciebie.</h2><p>Jestem kosmetologiem, linergistką i trenerką Long-Time-Liner®. Łączę ponad 10 lat praktyki, doświadczenie konkursowe i edukację, by dobierać pigmentację do skóry, mimiki i naturalnych proporcji twarzy.</p><dl class="pmu-home-credentials"><div><dt>8×</dt><dd>Mistrzyni PMU, w tym wicemistrzyni świata</dd></div><div><dt>10+ lat</dt><dd>Praktyki gabinetowej i doświadczenia</dd></div><div><dt>Long-Time-Liner®</dt><dd>Europejski trener marki</dd></div><div><dt>Silky</dt><dd>Autorska technika włosa maszynowego</dd></div></dl>



<blockquote class="pmu-home-stance"><p>Oceniam skórę, proporcje twarzy, wcześniejsze pigmentacje i oczekiwany efekt, a dopiero później dobieram technikę, kolor i intensywność.</p><footer>Bogusława Herda · podejście do pracy</footer>
<a
  class="pmu-home-review-strip"
  href={booksyUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Przeczytaj opinie klientek Bogusława Herda w Booksy"
>
  <span class="pmu-home-review-strip-icon" aria-hidden="true">★</span>

  <span class="pmu-home-review-strip-copy">
    <strong>5.0 w Booksy</strong>
    <span>1200+ opinii klientek</span>
  </span>

  <span class="pmu-home-review-strip-link">
    Przeczytaj opinie ↗
  </span>
</a></blockquote><div class="pmu-home-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj moje doświadczenie →</a></div></div></section>
      <section class="pmu-home-section pmu-home-world" id="o-mnie" aria-labelledby="home-swiat"><div class="pmu-home-section-heading"><p class="pmu-home-kicker">04 / Doświadczenie międzynarodowe</p><h2 id="home-swiat">Z Bielska-Białej<br />na międzynarodową scenę PMU.</h2><p>Pokazy, warsztaty, mistrzostwa i praca w jury to ważna część mojej drogi. Do gabinetu wracam z nowymi perspektywami i doświadczeniem w pracy z różnymi technikami oraz oczekiwaniami klientek.</p></div><div class="pmu-home-world-grid"><figure class="pmu-home-world-image"><Image src={ankaraImage} alt="Ankara, Turcja — prelegentka Long-Time-Liner" width={720} widths={[360,540,720,960]} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) 480px, 400px" format="webp" quality={83} loading="lazy" decoding="async" /><figcaption>Ankara · Long-Time-Liner®</figcaption></figure><dl class="pmu-home-destinations">{destinations.map(item => <div><dt>{item.city}<span>{item.country}</span></dt><dd>{item.role}{item.upcoming && <span class="pmu-home-upcoming">Przed nami · 2026</span>}</dd></div>)}</dl></div></section>
      <section class="pmu-home-section pmu-home-education" id="szkolenia-pmu" aria-labelledby="szkolenia"><div><p class="pmu-home-kicker">05 / Dla linergistek</p><h2 id="szkolenia">Precyzja, którą przekazuję dalej.</h2><p>Szkolenia makijażu permanentnego: Step by Step, Masterclass, Silky Hairstroke Brows i Bye-Bye Pigment Remover. Poznaj program i wybierz ścieżkę dopasowaną do swojego doświadczenia.</p><a class="pmu-home-secondary" href="/szkolenie-makijaz-permanentny/">Zobacz szkolenia PMU →</a><details class="pmu-home-more"><summary>Long-Time-Liner® i moja droga zawodowa <span aria-hidden="true">+</span></summary><p>Edukacja, precyzja i szacunek do naturalnej urody to ważna część mojego podejścia. Magda Bogulak — Long-Time-Liner Polska i Sharley Medical Clinic &amp; Day SPA — jest mentorką i jedną z najważniejszych osób w mojej zawodowej historii.</p></details></div><figure><Image src={teamImage} alt="Bogusława Herda z zespołem Long-Time-Liner podczas wydarzenia PMU" width={800} widths={[360,540,800,1080]} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) calc(100vw - 56px), 500px" format="webp" quality={82} loading="lazy" decoding="async" /><figcaption>Long-Time-Liner® · edukacja i wspólna praca</figcaption></figure></section>
      <section class="pmu-home-section pmu-home-mission" id="sercem-malowane" aria-labelledby="home-serce"><figure><Image src={missionPortrait} alt="Bogusława Herda z wyróżnieniem Ambasador Serca Long-Time-Liner w projekcie SercemMalowane" width={480} widths={[180,280,480]} sizes="(max-width:640px) 180px, 240px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-home-kicker">#SercemMalowane · Ambasador Serca</p><h2 id="home-serce">Czasem chodzi o coś więcej niż makijaż.</h2><p>Utrata brwi, zmiany po leczeniu czy rozszczep wargi mogą wpływać na to, jak czujemy się ze swoją twarzą. W projekcie #SercemMalowane łączę doświadczenie z uważnością na historię drugiej osoby.</p><p>„Nie każda pigmentacja zaczyna się od potrzeby makijażu. Czasem zaczyna się od potrzeby, żeby znowu poczuć się dobrze ze swoją twarzą.”</p><a href="/sercemmalowane/">Poznaj projekt #SercemMalowane →</a></div></section>
      <section class="pmu-home-section pmu-home-explore" id="efekty" aria-labelledby="home-zobacz"><div class="pmu-home-section-heading"><p class="pmu-home-kicker">Zanim podejmiesz decyzję</p><h2 id="home-zobacz">Zobacz prace.<br />Znajdź odpowiedzi.</h2></div><div class="pmu-home-explore-grid"><article><p class="pmu-home-kicker">Zdjęcia z galerii</p><h3>Jaki efekt jest Ci najbliższy?</h3><p>Brwi metodą cienia, Silky, usta i kreski. Obejrzyj szczegóły w powiększeniu i poznaj różnice.</p><a class="pmu-home-secondary" href="/galeria/">Przejdź do galerii →</a><details class="pmu-home-more pmu-home-metamorphoses"><summary>Zobacz krótki film z metamorfozami <span aria-hidden="true">+</span></summary><video controls playsinline preload="none" poster="/video/metamorfozy-pmu-boguslawa-herda-poster.webp" width="540" height="960" aria-label="Metamorfozy PMU — film Bogusława Herda"><source src="/video/metamorfozy-pmu-boguslawa-herda.mp4" type="video/mp4" />Twoja przeglądarka nie obsługuje filmu.</video></details></article><article><p class="pmu-home-kicker">Poradnik PMU</p><h3>Przygotowanie, gojenie i wybór metody.</h3><p>Konkretne odpowiedzi na pytania, które pojawiają się przed zabiegiem i po pigmentacji.</p><ul><li><a href="/poradnik/jak-goja-sie-brwi-permanentne/">Jak goją się brwi permanentne? →</a></li><li><a href="/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/">Jak wygląda gojenie ust? →</a></li><li><a href="/poradnik/kreska-permanentna-cena/">Ile kosztuje kreska permanentna? →</a></li></ul><a class="pmu-home-text-link" href="/poradnik/">Wszystkie poradniki →</a></article></div></section>
      <section class="pmu-home-booking" id="kontakt" aria-labelledby="home-kontakt"><div><p class="pmu-home-kicker">Spotkajmy się w gabinecie</p><h2 id="home-kontakt">Zacznij od rozmowy.<br />Wybierz swój kierunek.</h2><p><strong>Bogusława Herda</strong><br />ul. Barlickiego 5/23 · Bielsko-Biała</p><p>Nie musisz znać nazwy techniki. Opisz, jaki efekt Ci się podoba i co chcesz zmienić.</p></div><div class="pmu-home-booking-actions"><a class="pmu-home-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="pmu-home-secondary" href={formUrl}>Mam pytanie przed wizytą →</a><a class="pmu-home-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-home-text-link" href="/kontakt/">Adres i dojazd →</a></div></section>
      <GuideAssistant />
    </div>
  </main>
  <Footer />
</Layout>
