---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SilkyVideoShowcaseV3 from "../components/SilkyVideoShowcaseV3.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-brwi/";

const pageTitle =
  "Brwi permanentne Bielsko-Biała | Silky Hairstroke Brows";

const pageDescription =
  "Brwi permanentne Bielsko-Biała: cieniowanie od 1200 zł, metoda włoskowa, włos z cieniem i autorska technika Silky Hairstroke Brows Bogusławy Herda.";

const faqItems = [
  {
    question: "Czy brwi permanentne mogą wyglądać naturalnie?",
    answer:
      "Tak. Naturalny efekt zależy od rysunku wstępnego, kierunku włosa, koloru, skóry i właściwie dobranej techniki. Celem nie jest ciężka rama, ale uporządkowanie oprawy oka."
  },
  {
    question: "Ile kosztują brwi permanentne w Bielsku-Białej?",
    answer:
      "Brwi cieniowane kosztują 1200 zł, a metoda włoskowa i włos z cieniem 1400 zł. Ceny oznaczone w cenniku gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące."
  },
  {
    question: "Czym różni się metoda włoskowa od cieniowania?",
    answer:
      "Metoda włoskowa buduje efekt pojedynczych włosków, natomiast cieniowanie daje miękkie, bardziej równomierne wypełnienie. Włos z cieniem łączy oba kierunki. Wybór zależy od skóry, naturalnych brwi i oczekiwanego efektu."
  },
  {
    question: "Czy Silky Hairstroke Brows jest dla każdego?",
    answer:
      "Nie zawsze. Technika włosa maszynowego wymaga odpowiednich warunków skóry i właściwego planu. Przed zabiegiem oceniane jest, czy Silky Hairstroke Brows będzie najlepszym rozwiązaniem."
  },
  {
    question: "Czy przed zabiegiem wykonywany jest rysunek wstępny?",
    answer:
      "Tak. Przed pigmentacją omawiane są kształt, wysokość, długość, grubość oraz charakter brwi. Dopiero po zaakceptowaniu kierunku pracy rozpoczyna się pigmentacja."
  },
  {
    question: "Czy można poprawić stare brwi permanentne?",
    answer:
      "Czasem tak, ale najpierw trzeba ocenić kolor, nasycenie, głębokość i kształt starej pigmentacji. Jeśli stary makijaż jest zbyt ciężki, przed nową pracą może być potrzebne rozjaśnienie lub usuwanie PMU."
  },
  {
    question: "Kiedy widoczny jest finalny efekt brwi permanentnych?",
    answer:
      "Bezpośrednio po zabiegu brwi są zwykle intensywniejsze. Finalny efekt ocenia się po wygojeniu skóry, a następnie — jeśli jest taka potrzeba — dopracowuje podczas korekty."
  },
  {
    question: "Gdzie wykonywane są brwi permanentne?",
    answer:
      "Zabieg wykonywany jest w gabinecie Bogusławy Herda w Bielsku-Białej. Terminy można sprawdzić w Booksy, a w przypadku starego PMU lub wątpliwości skorzystać z formularza kwalifikacji."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/brwi-permanentne-naturalny-wlos-zblizenie.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Brwi permanentne",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Brwi permanentne Bielsko-Biała",
    serviceType: "Makijaż permanentny brwi",
    description:
      "Naturalne brwi permanentne w Bielsku-Białej: cieniowanie, metoda włoskowa, włos z cieniem, korekty starych brwi i autorska technika Silky Hairstroke Brows.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała"
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie"
      }
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny"
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Metody brwi permanentnych",
      itemListElement: [
        {
          "@type": "Offer",
          price: "1200",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Brwi cieniowane"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Metoda włoskowa"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Włos z cieniem"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Silky Hairstroke Brows"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta starych brwi permanentnych"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/makijaz-permanentny-brwi/"
  structuredData={structuredData}
>
  <div class="brow-page">
    <Header />

    <main>
      <section class="brow-hero">
        <div class="brow-glow brow-glow-one" aria-hidden="true"></div>
        <div class="brow-glow brow-glow-two" aria-hidden="true"></div>

        <div class="container brow-hero-grid">
          <div class="brow-hero-copy">
            <p class="section-kicker">Brwi permanentne Bielsko-Biała</p>

            <h1>
              <span class="brow-rose-text">Naturalne brwi permanentne</span>,
              które porządkują twarz bez efektu maski.
            </h1>

            <p class="brow-hero-lead">
              Cieniowanie, włos maszynowy, włos z cieniem i autorska technika
              Silky Hairstroke Brows. Każdy zabieg poprzedza analiza urody i
              rysunek wstępny.
            </p>

            <div class="brow-hero-actions" aria-label="Brwi permanentne — szybkie działania">
              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Sprawdź terminy brwi permanentnych w Booksy"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-primary" href="#efekty-silky">
                Zobacz efekty <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>

            <p class="brow-hero-note">
              Masz stare brwi permanentne? Nie rezerwuj nowej pigmentacji w ciemno —
              najpierw sprawdź, czy stary pigment można bezpiecznie poprawić.
            </p>
          </div>

          <aside class="brow-hero-card" aria-label="Silky Hairstroke Brows">
            <p class="brow-card-label">Silky</p>
            <h2>Włos maszynowy w miękkim, realistycznym kierunku.</h2>
            <p>
              Autorskie podejście Bogusławy Herda do brwi, w którym liczą się
              rytm włosa, lekkość i dopasowanie do twarzy — bez ciężkiej ramy.
            </p>

            <a href="#silky-hairstroke-brows" class="brow-hero-card-link">
              Poznaj Silky <span aria-hidden="true">→</span>
            </a>
          </aside>
        </div>
      </section>

      <section class="brow-natural-section" aria-label="Naturalny efekt brwi permanentnych">
        <div class="container brow-natural-card">
          <figure class="brow-media-frame brow-natural-photo">
            <img
              src="/images/brwi-permanentne-naturalny-wlos-zblizenie.webp"
              alt="Zbliżenie na naturalne brwi permanentne wykonane metodą włosa maszynowego"
              width="1200"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>

          <div class="brow-natural-copy">
            <p class="section-kicker">Naturalny włos</p>
            <h2>Najpierw patrzymy na twarz. Dopiero później wybieramy technikę.</h2>
            <p>
              Włos, cień i intensywność powinny wynikać z naturalnych brwi, skóry,
              mimiki i codziennego stylu. Dzięki temu efekt może być wyraźny,
              ale nie wygląda jak gotowy szablon.
            </p>
          </div>
        </div>
      </section>

      <section class="brow-proof-section" aria-label="Najważniejsze zasady pracy z brwiami">
        <div class="container brow-proof-grid">
          <div>
            <strong>Rysunek wstępny</strong>
            <span>kształt omawiany przed pigmentacją</span>
          </div>

          <div>
            <strong>Naturalny kierunek</strong>
            <span>brwi dopasowane do mimiki i urody</span>
          </div>

          <div>
            <strong>Silky Hairstroke Brows</strong>
            <span>autorskie podejście do efektu włosa</span>
          </div>

          <div>
            <strong>Stare PMU</strong>
            <span>najpierw ocena pigmentu i możliwości skóry</span>
          </div>
        </div>
      </section>

      <section class="brow-methods-section" id="metody-brwi">
        <div class="container">
          <div class="brow-section-heading">
            <p class="section-kicker">Metody brwi permanentnych</p>
            <h2>Nie wybieramy techniki z nazwy. Dobieramy ją do efektu i skóry.</h2>
            <p>
              Cieniowanie, włos maszynowy, włos z cieniem i korekta starego PMU
              rozwiązują różne problemy. Przesuń kafelki i porównaj metody.
            </p>
          </div>

          <div class="brow-slider-controls" aria-label="Przewijanie metod brwi">
            <button
              class="brow-slider-arrow brow-method-arrow-left"
              type="button"
              aria-label="Poprzednia metoda"
            >
              ←
            </button>
            <button
              class="brow-slider-arrow brow-method-arrow-right"
              type="button"
              aria-label="Następna metoda"
            >
              →
            </button>
          </div>

          <div
            class="brow-method-scroll"
            id="browMethodScroll"
            aria-label="Metody brwi permanentnych"
          >
            <article class="brow-method-card">
              <span>01</span>
              <h3>Brwi cieniowane</h3>
              <p>
                Miękkie wypełnienie dla większej regularności kształtu. Efekt może
                przypominać delikatnie podkreślone brwi bez ostrej, graficznej ramy.
              </p>
              <strong>1200 zł</strong>
            </article>

            <article class="brow-method-card brow-method-card-rose">
              <span>02</span>
              <h3>Metoda włoskowa</h3>
              <p>
                Efekt pojedynczych włosków prowadzonych zgodnie z naturalnym
                kierunkiem brwi. Technika wymaga odpowiednich warunków skóry.
              </p>
              <strong>1400 zł</strong>
            </article>

            <article class="brow-method-card">
              <span>03</span>
              <h3>Włos z cieniem</h3>
              <p>
                Połączenie struktury włosa z delikatnym cieniem. Daje pełniejszą
                oprawę oka przy zachowaniu miękkości efektu.
              </p>
              <strong>1400 zł</strong>
            </article>

            <article class="brow-method-card brow-method-card-silky">
              <span>04</span>
              <h3>Silky Hairstroke Brows</h3>
              <p>
                Autorskie podejście do włosa maszynowego: lekkość, rytm, realistyczny
                kierunek i dopasowanie do rysów twarzy.
              </p>
              <strong>autorska metoda</strong>
            </article>

            <article class="brow-method-card brow-method-card-gold">
              <span>05</span>
              <h3>Korekta starych brwi</h3>
              <p>
                Najpierw oceniamy kolor, nasycenie i kształt starego pigmentu.
                Czasem lepszym pierwszym krokiem jest rozjaśnienie PMU.
              </p>
              <strong>kwalifikacja indywidualna</strong>
            </article>
          </div>

          <div class="brow-price-strip" aria-label="Ceny brwi permanentnych">
            <div>
              <span>Cieniowanie</span>
              <strong>1200 zł</strong>
            </div>
            <div>
              <span>Włos / włos z cieniem</span>
              <strong>1400 zł</strong>
            </div>
            <a href="/cennik-makijaz-permanentny/">
              Pełny cennik <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section
        class="brow-silky-section"
        id="silky-hairstroke-brows"
        aria-label="Silky Hairstroke Brows"
      >
        <div class="container brow-silky-panel">
          <div class="brow-silky-copy">
            <p class="section-kicker">Autorska metoda Bogusławy Herda</p>
            <h2>Silky Hairstroke Brows</h2>
            <p class="brow-silky-lead">
              Włos maszynowy w miękkim, realistycznym kierunku.
            </p>
            <p>
              Silky Hairstroke Brows powstało z potrzeby tworzenia brwi, które
              są obecne na twarzy, ale nie odbierają jej naturalności. Liczy się
              rytm linii, odstęp, kierunek oraz kontrola nasycenia.
            </p>
            <p>
              Metoda nie jest wybierana automatycznie. Najpierw oceniana jest skóra,
              naturalny wzrost włosa i wcześniejsze pigmentacje.
            </p>
          </div>

          <figure class="brow-silky-video">
            <video
              src="/video/brwi-permanentne-silky-zblizenie-bez-dzwieku.mp4"
              poster="/video/brwi-permanentne-silky-zblizenie-poster.webp"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Zbliżenie na efekt Silky Hairstroke Brows"
            ></video>
          </figure>

          <div class="brow-silky-points" aria-label="Cechy techniki Silky Hairstroke Brows">
            <div>
              <span>01</span>
              <strong>Naturalny kierunek</strong>
              <p>Linie wspierają naturalny układ brwi i mimikę twarzy.</p>
            </div>

            <div>
              <span>02</span>
              <strong>Bez ciężkiej ramy</strong>
              <p>Efekt porządkuje oprawę oka, ale nie dominuje nad twarzą.</p>
            </div>

            <div>
              <span>03</span>
              <strong>Precyzja maszynowa</strong>
              <p>Kontrola linii, rytmu i nasycenia w każdym fragmencie brwi.</p>
            </div>

            <div>
              <span>04</span>
              <strong>Autorski charakter</strong>
              <p>Technika rozwijana przez Bogusławę Herda i prezentowana międzynarodowo.</p>
            </div>
          </div>

          <div class="brow-silky-gallery" id="efekty-silky">
            <div class="brow-gallery-heading">
              <div>
                <p class="section-kicker">Efekty Silky</p>
                <h3>Realna praca. Detal włosa. Efekt widoczny na całej twarzy.</h3>
              </div>

              <div class="brow-slider-controls" aria-label="Przewijanie zdjęć Silky">
                <button
                  class="brow-slider-arrow brow-gallery-arrow-left"
                  type="button"
                  aria-label="Poprzednie zdjęcie"
                >
                  ←
                </button>
                <button
                  class="brow-slider-arrow brow-gallery-arrow-right"
                  type="button"
                  aria-label="Następne zdjęcie"
                >
                  →
                </button>
              </div>
            </div>

            <div
              class="brow-gallery-scroll"
              id="browSilkyGalleryScroll"
              aria-label="Galeria efektów Silky Hairstroke Brows"
            >
              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-efekt-01.webp"
                  alt="Naturalny efekt brwi metodą Silky Hairstroke Brows u klientki"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-efekt-02.webp"
                  alt="Naturalne brwi permanentne w technice Silky Hairstroke Brows"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-efekt-03.webp"
                  alt="Delikatny efekt włosa maszynowego w makijażu permanentnym brwi"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-detal-01.webp"
                  alt="Zbliżenie na brwi wykonane metodą Silky Hairstroke Brows"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-efekt-04.webp"
                  alt="Naturalny efekt brwi permanentnych po zabiegu metodą włosa maszynowego"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="brow-gallery-card">
                <img
                  src="/images/silky-hairstroke-brows-detal-02.webp"
                  alt="Detal brwi permanentnych wykonanych techniką Silky Hairstroke Brows"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
          </div>
        </div>

        <div class="container brow-video-showcase">
          <SilkyVideoShowcaseV3 />
        </div>
      </section>

      <section class="brow-for-section" aria-label="Kiedy warto wykonać brwi permanentne">
        <div class="container">
          <div class="brow-section-heading">
            <p class="section-kicker">Kiedy warto?</p>
            <h2>Brwi permanentne mają rozwiązać konkretny problem — nie tworzyć nowy.</h2>
            <p>
              Zobacz sytuacje, w których pigmentacja może uporządkować oprawę oka
              i codzienny makijaż.
            </p>
          </div>

          <div class="brow-for-grid">
            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-przerzedzone-brwi.webp?v=20260709-kiedy-warto"
                alt="Przerzedzone brwi — brak gęstości i regularnej oprawy oka"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-asymetria.webp?v=20260709-kiedy-warto"
                alt="Asymetria brwi — różnica kształtu lub wysokości brwi"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-codzienny-makijaz.webp?v=20260709-kiedy-warto"
                alt="Codzienny makijaż brwi — częste dorysowywanie brwi"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-naturalna-oprawa-oka.webp?v=20260709-kiedy-warto"
                alt="Naturalna oprawa oka — miękki efekt bez ciężkiej ramy"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-stare-pmu.webp?v=20260709-kiedy-warto"
                alt="Stare brwi permanentne wymagające oceny lub planu naprawczego"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <figure class="brow-for-card">
              <img
                src="/images/brwi-kiedy-warto-delikatna-zmiana.webp?v=20260709-kiedy-warto"
                alt="Delikatna zmiana brwi bez zmiany charakteru twarzy"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        </div>
      </section>

      <section class="brow-process-section">
        <div class="container">
          <div class="brow-process-intro">
            <div class="brow-process-copy">
              <p class="section-kicker">Proces zabiegu</p>
              <h2>Rysunek wstępny jest częścią decyzji, a nie formalnością.</h2>
              <p>
                Przed pigmentacją omawiamy kształt, wysokość, długość, grubość
