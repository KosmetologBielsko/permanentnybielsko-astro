---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PmuServiceFinalLinks from "../components/PmuServiceFinalLinks.astro";
import PmuExpertAuthority from "../components/PmuExpertAuthority.astro";
import PmuServiceCompass from "../components/PmuServiceCompass.astro";
import SilkyVideoShowcaseV3 from "../components/SilkyVideoShowcaseV3.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-brwi/";

const pageTitle =
  "Brwi permanentne Bielsko-Biała | Silky Hairstroke Brows";

const pageDescription =
  "Brwi permanentne Bielsko-Biała: cieniowanie od 1200 zł, metoda włoskowa, włos z cieniem i autorska technika Silky Hairstroke Brows Bogusławy Herda.";

const browEffectsImages = [
  {
    src: "/images/brwi-permanentne-zblizenie-oka-naturalny-efekt.webp",
    alt: "Brwi permanentne Bielsko-Biała — zbliżenie oka i naturalny efekt pigmentacji",
  },
  {
    src: "/images/brwi-permanentne-makro-wlos-maszynowy.webp",
    alt: "Brwi permanentne Bielsko-Biała — makro włosa maszynowego",
  },
  {
    src: "/images/brwi-permanentne-pelne-spojrzenie-naturalna-pigmentacja.webp",
    alt: "Brwi permanentne Bielsko-Biała — pełne spojrzenie i naturalna pigmentacja",
  },
  {
    src: "/images/brwi-permanentne-zblizenie-oko-i-brew.webp",
    alt: "Brwi permanentne Bielsko-Biała — zbliżenie oka i brwi",
  },
  {
    src: "/images/brwi-permanentne-detal-precyzyjnej-pigmentacji.webp",
    alt: "Brwi permanentne Bielsko-Biała — detal precyzyjnej pigmentacji",
  },
  {
    src: "/images/brwi-permanentne-naturalna-uroda-twarzy.webp",
    alt: "Brwi permanentne Bielsko-Biała — naturalna uroda twarzy",
  },
  {
    src: "/images/brwi-permanentne-makro-struktura-wlosa.webp",
    alt: "Brwi permanentne Bielsko-Biała — makro struktura włosa",
  },
  {
    src: "/images/silky-hairstroke-brows-zblizenie-naturalny-efekt.webp",
    alt: "Silky Hairstroke Brows — zbliżenie i naturalny efekt włosa maszynowego",
    badge: "Silky",
  },
  {
    src: "/images/brwi-permanentne-naturalny-efekt-zielen-stylizacja.webp",
    alt: "Brwi permanentne Bielsko-Biała — naturalny efekt w stylizacji z zielenią",
  },
  {
    src: "/images/brwi-permanentne-efekt-po-zabiegu-portret.webp",
    alt: "Brwi permanentne Bielsko-Biała — efekt po zabiegu, portret",
  },
  {
    src: "/images/brwi-permanentne-naturalny-efekt-portret-01.webp",
    alt: "Brwi permanentne Bielsko-Biała — naturalny efekt, portret",
  },
  {
    src: "/images/brwi-permanentne-delikatny-efekt-oczy-zamkniete-02.webp",
    alt: "Brwi permanentne Bielsko-Biała — delikatny efekt, oczy zamknięte",
  },
  {
    src: "/images/brwi-permanentne-efekt-po-zabiegu-portret-03.webp",
    alt: "Brwi permanentne Bielsko-Biała — efekt po zabiegu, portret",
  },
  {
    src: "/images/brwi-permanentne-naturalna-pigmentacja-portret-04.webp",
    alt: "Brwi permanentne Bielsko-Biała — naturalna pigmentacja, portret",
  },
];

const faqItems = [
  {
    question: "Czy brwi permanentne mogą wyglądać naturalnie?",
    answer:
      "Tak. Naturalny efekt zależy od rysunku wstępnego, kierunku włosa, koloru, skóry i właściwie dobranej techniki. Celem nie jest ciężka rama, ale uporządkowanie oprawy oka."
  },
  {
    question: "Ile kosztują brwi permanentne w Bielsku-Białej?",
    answer:
      "Brwi cieniowane kosztują 1200 zł, a metoda włoskowa i włos z cieniem 1400 zł. Ceny oznaczone w cenniku gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące."
  },
  {
    question: "Czym różni się metoda włoskowa od cieniowania?",
    answer:
      "Metoda włoskowa buduje efekt pojedynczych włosków, natomiast cieniowanie daje miękkie, bardziej równomierne wypełnienie. Włos z cieniem łączy oba kierunki. Wybór zależy od skóry, naturalnych brwi i oczekiwanego efektu."
  },
  {
    question: "Czy Silky Hairstroke Brows jest dla każdego?",
    answer:
      "Nie zawsze. Technika włosa maszynowego wymaga odpowiednich warunków skóry i właściwego planu. Przed zabiegiem oceniane jest, czy Silky Hairstroke Brows będzie najlepszym rozwiązaniem."
  },
  {
    question: "Czy przed zabiegiem wykonywany jest rysunek wstępny?",
    answer:
      "Tak. Przed pigmentacją omawiane są kształt, wysokość, długość, grubość oraz charakter brwi. Dopiero po zaakceptowaniu kierunku pracy rozpoczyna się pigmentacja."
  },
  {
    question: "Czy można poprawić stare brwi permanentne?",
    answer:
      "Czasem tak, ale najpierw trzeba ocenić kolor, nasycenie, głębokość i kształt starej pigmentacji. Jeśli stary makijaż jest zbyt ciężki, przed nową pracą może być potrzebne rozjaśnienie lub usuwanie PMU."
  },
  {
    question: "Kiedy widoczny jest finalny efekt brwi permanentnych?",
    answer:
      "Bezpośrednio po zabiegu brwi są zwykle intensywniejsze. Finalny efekt ocenia się po wygojeniu skóry, a następnie — jeśli jest taka potrzeba — dopracowuje podczas korekty."
  },
  {
    question: "Gdzie wykonywane są brwi permanentne?",
    answer:
      "Zabieg wykonywany jest w gabinecie Bogusławy Herda w Bielsku-Białej. Terminy można sprawdzić w Booksy, a w przypadku starego PMU lub wątpliwości skorzystać z formularza kwalifikacji."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/brwi-permanentne-naturalny-wlos-zblizenie.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Brwi permanentne",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Brwi permanentne Bielsko-Biała",
    serviceType: "Makijaż permanentny brwi",
    description:
      "Naturalne brwi permanentne w Bielsku-Białej: cieniowanie, metoda włoskowa, włos z cieniem, korekty starych brwi i autorska technika Silky Hairstroke Brows.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała"
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie"
      }
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny"
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Metody brwi permanentnych",
      itemListElement: [
        {
          "@type": "Offer",
          price: "1200",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Brwi cieniowane"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Metoda włoskowa"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Włos z cieniem"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Silky Hairstroke Brows"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta starych brwi permanentnych"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/makijaz-permanentny-brwi/"
  structuredData={structuredData}
>
  <div class="brow-page">
    <Header />

    <main>
      <section class="brow-hero">
        <div class="brow-glow brow-glow-one" aria-hidden="true"></div>
        <div class="brow-glow brow-glow-two" aria-hidden="true"></div>

        <div class="container brow-hero-grid">
          <div class="brow-hero-copy">
            <p class="section-kicker">Brwi permanentne Bielsko-Biała</p>

            <h1>
              <span class="brow-rose-text">Naturalne brwi permanentne</span>,
              które porządkują twarz bez efektu maski.
            </h1>

            <p class="brow-hero-lead">
              Cieniowanie, włos maszynowy, włos z cieniem i autorska technika
              Silky Hairstroke Brows. Każdy zabieg poprzedza analiza urody i
              rysunek wstępny.
            </p>

            <div class="brow-hero-actions" aria-label="Brwi permanentne — szybkie działania">
              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Sprawdź terminy brwi permanentnych w Booksy"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-primary" href="#efekty-brwi">
                Zobacz efekty <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>

            <p class="brow-hero-note">
              Masz stare brwi permanentne? Nie rezerwuj nowej pigmentacji w ciemno —
              najpierw sprawdź, czy stary pigment można bezpiecznie poprawić.
            </p>
          </div>

          <aside class="brow-hero-card" aria-label="Silky Hairstroke Brows">
            <p class="brow-card-label">Silky</p>
            <h2>Włos maszynowy w miękkim, realistycznym kierunku.</h2>
            <p>
              Autorskie podejście Bogusławy Herda do brwi, w którym liczą się
              rytm włosa, lekkość i dopasowanie do twarzy — bez ciężkiej ramy.
            </p>

            <a href="#silky-hairstroke-brows" class="brow-hero-card-link">
              Poznaj Silky <span aria-hidden="true">→</span>
            </a>
          </aside>
        </div>
      </section>

<section class="brow-gallery-section pmu-effects-top" id="efekty-brwi" data-pmu-effects>
        <div class="container pmu-effects-heading-row">
          <div class="pmu-effects-heading">
            <p class="section-kicker">Efekty brwi</p>
            <h2>Najpierw zobacz efekt. Dopiero później wybieraj metodę.</h2>
            <p>Przesuń zdjęcia palcem. Każde możesz otworzyć na pełnym ekranie i spokojnie obejrzeć detal pigmentacji.</p>
          </div>

          <div class="pmu-effects-controls" aria-label="Przewijanie efektów brwi">
            <button type="button" class="pmu-effects-arrow" data-pmu-effects-prev aria-label="Poprzednie zdjęcie">←</button>
            <button type="button" class="pmu-effects-arrow" data-pmu-effects-next aria-label="Następne zdjęcie">→</button>
          </div>
        </div>

        <div class="container">
          <div class="pmu-effects-scroll" data-pmu-effects-track>
            {browEffectsImages.map((image) => (
              <button
                type="button"
                class="pmu-effect-card"
                data-pmu-effect-image
                data-image-src={image.src}
                data-image-alt={image.alt}
                aria-label={`Powiększ zdjęcie: ${image.alt}`}
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  width="900"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
                <span class="pmu-effect-zoom" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
        </div>
      </section>


      <section class="brow-natural-section" id="naturalny-efekt-brwi" aria-label="Naturalny efekt brwi permanentnych">
        <div class="container brow-natural-card">
          <figure class="brow-media-frame brow-natural-photo">
            <img
              src="/images/brwi-permanentne-naturalny-wlos-zblizenie.webp"
              alt="Zbliżenie na naturalne brwi permanentne wykonane metodą włosa maszynowego"
              width="1200"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>

          <div class="brow-natural-copy">
            <p class="section-kicker">Naturalny włos</p>
            <h2>Najpierw patrzymy na twarz. Dopiero później wybieramy technikę.</h2>
            <p>
              Włos, cień i intensywność powinny wynikać z naturalnych brwi, skóry,
              mimiki i codziennego stylu. Dzięki temu efekt może być wyraźny,
              ale nie wygląda jak gotowy szablon.
            </p>
          </div>
        </div>
      </section>

      <section class="brow-proof-section" aria-label="Najważniejsze zasady pracy z brwiami">
        <div class="container brow-proof-grid">
          <div>
            <strong>Rysunek wstępny</strong>
            <span>kształt omawiany przed pigmentacją</span>
          </div>

          <div>
            <strong>Naturalny kierunek</strong>
            <span>brwi dopasowane do mimiki i urody</span>
          </div>

          <div>
            <strong>Silky Hairstroke Brows</strong>
            <span>autorskie podejście do efektu włosa</span>
          </div>

          <div>
            <strong>Stare PMU</strong>
            <span>najpierw ocena pigmentu i możliwości skóry</span>
          </div>
        </div>
      </section>

      <div data-pmu-compass="brows">
        <PmuServiceCompass
          eyebrow="Brwi permanentne — szybka decyzja"
          title="Najpierw efekt i skóra. Potem metoda."
          lead="Cieniowanie, włos maszynowy i Silky nie są wybierane z samej nazwy. Najpierw oceniamy naturalne brwi, skórę, stare pigmentacje i efekt, który ma współpracować z twarzą."
          items={[
            { label: "Efekty", title: "Zobacz realne brwi →", href: "#efekty-brwi" },
            { label: "Metody", title: "Porównaj techniki →", href: "#metody-brwi" },
            { label: "Cena", title: "1200–1400 zł →", href: "/cennik-makijaz-permanentny/#price-group-1" },
            { label: "Gojenie", title: "Jak goją się brwi? →", href: "/poradnik/jak-goja-sie-brwi-permanentne/" }
          ]}
          secondary={[
            { label: "Stare PMU", title: "Brwi permanentne po latach →", href: "/poradnik/brwi-permanentne-po-latach/" },
            { label: "Rozjaśnianie", title: "Laserowe usuwanie brwi →", href: "/poradnik/laserowe-usuwanie-brwi-permanentnych/" },
            { label: "Kwalifikacja", title: "Opisz swój przypadek →", href: "/makijaz-permanentny-bielsko/#kwalifikacja-pmu" }
          ]}
        />
      </div>

      <section class="brow-methods-section pmu-methods-unified" id="metody-brwi">
        <div class="container">
          <div class="pmu-methods-heading">
            <p class="section-kicker">Metody brwi permanentnych</p>
            <h2>Jedna twarz, różne możliwości. Metodę dobieramy do skóry i efektu.</h2>
            <p>Nie musisz znać nazw technik przed wizytą. Rozwiń metodę, zobacz różnicę i przejdź od razu do efektów, ceny albo kwalifikacji.</p>
          </div>

          <div class="pmu-method-list" aria-label="Metody brwi permanentnych">

            <details class="pmu-method-item">
              <summary>
                <span class="pmu-method-index">01</span>

                <span class="pmu-method-summary">
                  <strong>Brwi cieniowane</strong>
                  <small>miękkie wypełnienie i uporządkowany kształt</small>
                </span>

                <span class="pmu-method-price">1200 zł</span>
                <span class="pmu-method-plus" aria-hidden="true"></span>
              </summary>

              <div class="pmu-method-details">
                <p>Dobre rozwiązanie, gdy zależy Ci na większej regularności i subtelnym podkreśleniu brwi bez ostrej, graficznej ramy.</p>

                <div class="pmu-method-actions">
                  <a href="#efekty-brwi">Zobacz efekty →</a>
                  <a href="/cennik-makijaz-permanentny/#price-group-1">Sprawdź cenę →</a>
                  <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Dobierz metodę →</a>
                </div>
              </div>
            </details>

            <details class="pmu-method-item">
              <summary>
                <span class="pmu-method-index">02</span>

                <span class="pmu-method-summary">
                  <strong>Metoda włoskowa</strong>
                  <small>pojedyncze włoski i naturalny kierunek brwi</small>
                </span>

                <span class="pmu-method-price">1400 zł</span>
                <span class="pmu-method-plus" aria-hidden="true"></span>
              </summary>

              <div class="pmu-method-details">
                <p>Efekt budowany pojedynczymi liniami imitującymi naturalny włos. Technika wymaga odpowiednich warunków skóry i dobrego planu kierunku włosa.</p>

                <div class="pmu-method-actions">
                  <a href="#efekty-brwi">Zobacz efekty →</a>
                  <a href="/cennik-makijaz-permanentny/#price-group-1">Sprawdź cenę →</a>
                  <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Dobierz metodę →</a>
                </div>
              </div>
            </details>

            <details class="pmu-method-item">
              <summary>
                <span class="pmu-method-index">03</span>

                <span class="pmu-method-summary">
                  <strong>Włos z cieniem</strong>
                  <small>struktura włosa + delikatne, miękkie wypełnienie</small>
                </span>

                <span class="pmu-method-price">1400 zł</span>
                <span class="pmu-method-plus" aria-hidden="true"></span>
              </summary>

              <div class="pmu-method-details">
                <p>Łączy lekkość włosa z subtelnym cieniem. Sprawdza się, kiedy sama struktura włosków byłaby zbyt delikatna, ale nadal chcemy uniknąć ciężkiej formy.</p>

                <div class="pmu-method-actions">
                  <a href="#efekty-brwi">Zobacz efekty →</a>
                  <a href="/cennik-makijaz-permanentny/#price-group-1">Sprawdź cenę →</a>
                  <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Dobierz metodę →</a>
                </div>
              </div>
            </details>

            <details class="pmu-method-item pmu-method-item--accent">
              <summary>
                <span class="pmu-method-index">04</span>

                <span class="pmu-method-summary">
                  <strong>Silky Hairstroke Brows</strong>
                  <small>autorskie podejście do naturalnego włosa maszynowego</small>
                </span>

                <span class="pmu-method-price">autorska metoda</span>
                <span class="pmu-method-plus" aria-hidden="true"></span>
              </summary>

              <div class="pmu-method-details">
                <p>Lekkość, rytm i realistyczny kierunek włosa dopasowany do rysów twarzy. Metoda rozwijana przez Bogusławę Herda dla efektu bez ciężkiej ramy.</p>

                <div class="pmu-method-actions">
                  <a href="#efekty-brwi">Zobacz efekty →</a>
                  <a href="/cennik-makijaz-permanentny/#price-group-1">Sprawdź cenę →</a>
                  <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Dobierz metodę →</a>
                </div>
              </div>
            </details>

            <details class="pmu-method-item pmu-method-item--rose">
              <summary>
                <span class="pmu-method-index">05</span>

                <span class="pmu-method-summary">
                  <strong>Korekta starych brwi</strong>
                  <small>najpierw ocena pigmentu, koloru i kształtu</small>
                </span>

                <span class="pmu-method-price">kwalifikacja</span>
                <span class="pmu-method-plus" aria-hidden="true"></span>
              </summary>

              <div class="pmu-method-details">
