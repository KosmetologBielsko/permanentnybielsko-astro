---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import GalleryPhoto from "../components/GalleryPhoto.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import media from "../data/pmu-media-library.json";
import "../styles/pmu-gallery.css";
import "../styles/pmu-landing.css";
import "../styles/pmu-brows.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pageUrl = "https://www.permanentnybielsko.com/makijaz-permanentny-brwi/";
const pageTitle = "Brwi permanentne Bielsko-Biała | Silky Hairstroke Brows";
const pageDescription = "Brwi permanentne Bielsko-Biała: cieniowanie od 1200 zł, metoda włoskowa, włos z cieniem i autorska technika Silky Hairstroke Brows Bogusławy Herda.";
const heroPhoto = media.silky[1];
// Kategorie pochodza z biblioteki zdjec zatwierdzonej przez gabinet.
const silkyPhotos = [
  { ...media.silky[0], alt: "Brwi metodą włosa maszynowego Silky — zbliżenie łuku brwiowego", caption: "Silky: indywidualnie zaprojektowany kierunek włosków." },
  { ...media.silky[5], alt: "Silky Hairstroke Brows — włos maszynowy, ujęcie brwi z boku", caption: "Silky: lekka struktura brwi w ujęciu z boku." },
];
const shadePhotos = [
  { ...media.cien[0], alt: "Brwi metodą cienia — miękkie wypełnienie łuku brwiowego", caption: "Metoda cienia: miękkie wypełnienie kształtu." },
  { ...media.cien[5], alt: "Brwi cieniowane — zbliżenie pudrowego nasycenia koloru", caption: "Metoda cienia: pudrowe nasycenie w zbliżeniu." },
];
const steps = [
  { title: "Rozmowa i kwalifikacja", text: "Omawiamy efekt, oceniamy skórę, naturalne brwi i wcześniejszy pigment. Dobieramy metodę, która ma sens w Twoim przypadku." },
  { title: "Rysunek wstępny", text: "Ustalamy kształt, proporcje i kolor. W Silky planujemy także kierunek i rytm włosków. Akceptujesz projekt przed pigmentacją." },
  { title: "Pigmentacja", text: "Realizujemy uzgodniony projekt. Po zabiegu otrzymujesz indywidualne zalecenia dotyczące pielęgnacji i gojenia." },
  { title: "Wygojenie i korekta", text: "Oceniamy wygojony efekt i dopracowujemy go podczas korekty. Przy zabiegu głównym objętym gwiazdką w cenniku odbywa się ona do 2 miesięcy." },
];
const faqItems = [
  { question: "Ile trwa zabieg brwi permanentnych?", answer: "Zarezerwuj około 2 godzin. Cennik przewiduje 120 minut na cieniowanie i 130 minut na metodę włoskową. Czas obejmuje także konsultację i przygotowanie projektu.", href: "/poradnik/ile-trwa-zabieg-makijazu-permanentnego/", label: "Jak zaplanować czas na wizytę" },
  { question: "Czy makijaż permanentny brwi boli?", answer: "Odczucia są indywidualne i zależą między innymi od wrażliwości oraz stanu skóry. Przed pigmentacją omawiamy przebieg zabiegu i Twój komfort.", href: "/poradnik/czy-makijaz-permanentny-boli/", label: "Odczucia podczas zabiegu" },
  { question: "Jak długo utrzymują się brwi permanentne?", answer: "Pigment z czasem zmienia intensywność. Trwałość zależy od skóry, techniki, pielęgnacji i ekspozycji na słońce, dlatego terminu odświeżenia nie ustalamy automatycznie dla każdej osoby.", href: "/poradnik/brwi-permanentne-po-latach/", label: "Jak brwi zmieniają się po latach" },
  { question: "Czy cena obejmuje korektę? Czym jest dopigmentowanie?", answer: "Zabiegi główne oznaczone w cenniku gwiazdką obejmują korektę po wygojeniu, do 2 miesięcy od zabiegu głównego. Późniejsze odświeżenie lub praca na pigmentacji z innego gabinetu wymaga osobnej oceny i wyceny.", href: "/poradnik/dopigmentowanie-brwi-permanentnych/", label: "Korekta a późniejsze dopigmentowanie" },
  { question: "Jak goją się brwi i kiedy ocenić efekt?", answer: "Świeża pigmentacja może wyglądać intensywniej niż wygojona. Kieruj się zaleceniami gabinetu; efekt oceniamy po wygojeniu, a nie na podstawie wyglądu brwi w pierwszych dniach.", href: "/poradnik/jak-goja-sie-brwi-permanentne/", label: "Gojenie i pielęgnacja brwi" },
  { question: "Jak przygotować się do makijażu permanentnego brwi?", answer: "Przed wizytą przekaż informacje o wcześniejszej pigmentacji, stanie skóry, chorobach i przyjmowanych lekach. Indywidualne zalecenia ustalamy podczas kwalifikacji.", href: "/poradnik/jak-przygotowac-sie-do-makijazu-permanentnego-brwi/", label: "Przygotowanie do wizyty" },
  { question: "Kiedy zabieg trzeba odłożyć lub z niego zrezygnować?", answer: "Kwalifikacja uwzględnia stan skóry, zdrowia i aktualne leczenie. Jeśli masz wątpliwości, skontaktuj się z gabinetem przed rezerwacją; w niektórych sytuacjach potrzebna jest również konsultacja lekarska.", href: "/poradnik/przeciwwskazania-do-makijazu-permanentnego/", label: "Przeciwwskazania do pigmentacji" },
];
const guides = [
  { title: "Porównaj metody brwi", text: "Włos maszynowy, cień i techniki łączone — dokładniejsze porównanie efektów.", href: "/poradnik/metody-brwi-permanentnych-ombre-pudrowe-wloskowe/" },
  { title: "Co wpływa na cenę?", text: "Zakres pracy i dobór techniki. Aktualne kwoty znajdziesz w Cenniku.", href: "/poradnik/makijaz-permanentny-brwi-cena/" },
  { title: "Nieudane lub stare brwi", text: "Co warto ustalić przed próbą poprawienia wcześniejszej pigmentacji.", href: "/poradnik/nieudany-makijaz-permanentny-brwi-co-zrobic/" },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    dateModified: "2026-09-19",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/galeria-10/silky/silky-02.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Brwi permanentne",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Brwi permanentne Bielsko-Biała",
    serviceType: "Makijaż permanentny brwi",
    description:
      "Naturalne brwi permanentne w Bielsku-Białej: cieniowanie, metoda włoskowa, włos z cieniem, korekty starych brwi i autorska technika Silky Hairstroke Brows.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała"
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie"
      }
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny"
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Metody brwi permanentnych",
      itemListElement: [
        {
          "@type": "Offer",
          price: "1200",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Brwi cieniowane"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Silky Hairstroke Brows — metoda włosa maszynowego"
          }
        },
        {
          "@type": "Offer",
          price: "1400",
          priceCurrency: "PLN",
          itemOffered: {
            "@type": "Service",
            name: "Włos z cieniem"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta starych brwi permanentnych"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/makijaz-permanentny-brwi/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-landing-skip" href="#metody-brwi">Przejdź do wyboru metody</a>
  <main class="pmu-landing pmu-gallery pmu-brows">
    <div class="pmu-landing-shell">
      <nav class="pmu-landing-breadcrumbs" aria-label="Okruszki nawigacyjne"><a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/makijaz-permanentny-bielsko/">Makijaż permanentny</a><span aria-hidden="true">/</span><span aria-current="page">Brwi</span></nav>
      <section class="pmu-landing-intro pmu-brows-hero" aria-labelledby="brwi-tytul">
        <div>
          <p class="pmu-landing-kicker">Brwi permanentne · Bielsko-Biała</p>
          <h1 id="brwi-tytul"><span>Naturalne brwi permanentne</span>, które porządkują twarz bez efektu maski.</h1>
          <p class="pmu-landing-lead">Lekka struktura włosków czy miękki cień? Dobieramy efekt do Twojej skóry, naturalnych brwi i urody. Zaczynamy od rozmowy i rysunku wstępnego.</p>
          <a class="pmu-landing-author" href="#doswiadczenie-brwi"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" /><span><strong>Bogusława Herda</strong><span>Autorka Silky Hairstroke Brows · trenerka PMU</span></span></a>
          <p class="pmu-brows-hero-price"><strong>Brwi od 1200 zł</strong><span>z korektą po wygojeniu, do 2 miesięcy</span></p>
          <div class="pmu-brows-hero-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a><a class="pmu-landing-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div>
        </div>
        <figure class="pmu-brows-hero-photo"><img src={heroPhoto.thumb} srcset={heroPhoto.srcset} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) 520px, (max-width:1156px) calc((100vw - 104px) / 2.15), 490px" width={heroPhoto.width} height={heroPhoto.height} alt="Silky Hairstroke Brows — brwi wykonane metodą włosa maszynowego w gabinecie Bogusława Herda" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Silky Hairstroke Brows <span>· włos maszynowy · praca gabinetu</span></figcaption></figure>
      </section>
      <nav class="pmu-landing-nav" aria-label="Przejdź do wybranej części strony"><a href="#metody-brwi">Dobierz metodę ↓</a><a href="#efekty-brwi">Zobacz efekty ↓</a><a href="#cena-brwi">Cena i korekta ↓</a><a href="#doswiadczenie-brwi">Doświadczenie ↓</a><a href="#pytania-brwi">Pytania ↓</a></nav>

      <section class="pmu-landing-section" id="metody-brwi" aria-labelledby="metody-tytul">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Wybierz kierunek</p><h2 id="metody-tytul">Włoski czy miękki cień?</h2><p>Obie metody mogą podkreślać brwi subtelnie. Różni je sposób budowania efektu: pojedyncze linie włosków albo pudrowe wypełnienie.</p></div>
        <div class="pmu-brows-methods">
          <article class="pmu-brows-method" id="silky-hairstroke-brows"><p class="pmu-landing-kicker">Autorska technika · włos maszynowy</p><h3>Silky Hairstroke Brows</h3><p>Autorski kierunek, który rozwija <strong>Bogusława Herda</strong>. Brwi permanentne metodą włosa maszynowego: pigmentowane linie odtwarzają strukturę włosków, a ich kierunek, rytm i rozmieszczenie projektujemy indywidualnie.</p><dl><div><dt>Efekt</dt><dd>Lekka, nieregularna struktura zamiast jednolitego wypełnienia.</dd></div><div><dt>Dla kogo?</dt><dd>Dla osoby szukającej naturalnej oprawy oka, jeśli stan skóry i wcześniejszy pigment pozwalają na czytelny rysunek włosków.</dd></div></dl><a href="#efekty-silky">Zobacz realizacje Silky <span aria-hidden="true">↓</span></a></article>
          <article class="pmu-brows-method pmu-brows-method-shade"><p class="pmu-landing-kicker">Miękkie wypełnienie · efekt pudrowy</p><h3>Brwi metodą cienia</h3><p>Kolor delikatnie wypełnia kształt brwi. Dobieramy jego intensywność i przejścia tak, aby oprawa oka była spójna z Twoją urodą. To <strong>cieniowanie</strong>, a nie rysowanie pojedynczych włosków.</p><dl><div><dt>Efekt</dt><dd>Miękki, pudrowy kolor i uporządkowany kształt brwi.</dd></div><div><dt>Dla kogo?</dt><dd>Dla osoby, która lubi wypełnienie kolorem. Zakres i intensywność dopasowujemy po ocenie skóry, brwi i ewentualnej starej pigmentacji.</dd></div></dl><a href="#efekty-cienia">Zobacz realizacje metodą cienia <span aria-hidden="true">↓</span></a></article>
        </div>
        <div class="pmu-brows-choice" id="naturalny-efekt-brwi"><h3>Najpierw Twoje brwi. Potem metoda.</h3><p>Ocenia się skórę, kierunek naturalnego wzrostu włosków, wcześniejszą pigmentację i oczekiwany efekt. <strong>Włos z cieniem</strong> to możliwe połączenie obu kierunków — wybierane po kwalifikacji, nie automatycznie.</p></div>
        <details class="pmu-landing-more"><summary>Włos maszynowy a microblading — jaka jest różnica? <span aria-hidden="true">+</span></summary><div><p>Włos maszynowy powstaje za pomocą urządzenia do pigmentacji, a microblading jest techniką manualną. Silky Hairstroke Brows to włos maszynowy. Dobór techniki wymaga oceny skóry i oczekiwanego efektu.</p><div class="pmu-landing-links"><a href="/poradnik/microblading-a-makijaz-permanentny-brwi/">Porównanie technik w poradniku →</a></div></div></details>
      </section>

      <section class="pmu-landing-section" id="efekty-brwi" aria-labelledby="efekty-tytul">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">02 / Prace gabinetu</p><h2 id="efekty-tytul">Zobacz różnicę w detalach.</h2><p>Osobno pokazujemy włos maszynowy i metodę cienia. Dotknij zdjęcia, aby je powiększyć. Projekt i wygojony efekt zależą od indywidualnych warunków skóry.</p></div>
        <div class="pmu-brows-gallery-groups">
          <section id="efekty-silky" data-pmu-gallery-section data-media-label="Silky — włos maszynowy" data-service-href="/galeria/#galeria-silky" data-service-label="Więcej realizacji Silky" aria-labelledby="galeria-silky-tytul"><h3 id="galeria-silky-tytul">Silky / włos maszynowy</h3><div class="pmu-brows-photo-grid" id="browSilkyGalleryScroll">{silkyPhotos.map(image => <GalleryPhoto image={image} />)}</div></section>
          <section id="efekty-cienia" data-pmu-gallery-section data-media-label="Brwi metodą cienia" data-service-href="/galeria/#galeria-brwi" data-service-label="Więcej realizacji metodą cienia" aria-labelledby="galeria-cien-tytul"><h3 id="galeria-cien-tytul">Cień / brwi pudrowe</h3><div class="pmu-brows-photo-grid">{shadePhotos.map(image => <GalleryPhoto image={image} />)}</div></section>
        </div>
        <details class="pmu-landing-more pmu-brows-film"><summary>Zobacz Silky w ruchu — film z gabinetu <span aria-hidden="true">+</span></summary><figure><video width="900" height="900" controls playsinline muted preload="none" poster="/video/brwi-permanentne-silky-zblizenie-poster.webp" aria-label="Film z gabinetu: brwi Silky Hairstroke Brows w zbliżeniu"><source src="/video/brwi-permanentne-silky-zblizenie-bez-dzwieku.mp4" type="video/mp4" />Twoja przeglądarka nie obsługuje odtwarzania filmu.</video><figcaption>Zbliżenie brwi Silky Hairstroke Brows. <span>Film bez dźwięku.</span></figcaption></figure></details>
        <div class="pmu-landing-links"><a href="/galeria/">Zobacz pełną galerię gabinetu →</a></div>
      </section>

      <section class="pmu-landing-section pmu-brows-price" id="cena-brwi" data-analytics-price="brows" data-service-key="brows" aria-labelledby="cena-tytul">
        <div><p class="pmu-landing-kicker">03 / Cena i korekta</p><h2 id="cena-tytul">Brwi permanentne<br />od 1200 zł.</h2><p>Dobieramy metodę podczas kwalifikacji. Pełny zakres usług, odświeżeń i ich cen znajdziesz w Cenniku.</p><div class="pmu-landing-links"><a href="/cennik-makijaz-permanentny/#price-group-1">Pełny cennik brwi permanentnych →</a></div></div>
        <div><dl class="pmu-brows-price-list"><div><dt>Metoda cienia*</dt><dd>1200 zł</dd></div><div><dt>Silky / włos maszynowy*</dt><dd>1400 zł</dd></div><div><dt>Włos z cieniem*</dt><dd>1400 zł</dd></div></dl><p class="pmu-brows-price-note">* Zabieg główny z korektą po wygojeniu, <strong>do 2 miesięcy od zabiegu głównego</strong>. Stare PMU i praca po innym gabinecie wymagają indywidualnej oceny.</p><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="pmu-landing-section" id="proces-brwi" aria-labelledby="proces-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">04 / Spokojnie, krok po kroku</p><h2 id="proces-tytul">Wiesz, co będzie dalej.</h2></div><ol class="pmu-landing-steps">{steps.map((step,index) => <li><span aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>

      <section class="pmu-landing-callout" id="stare-brwi-pmu" aria-labelledby="stare-brwi-tytul"><p class="pmu-landing-kicker">Masz wcześniejszą pigmentację?</p><h2 id="stare-brwi-tytul">Zacznij od oceny starego PMU.</h2><p>Nie każdą pigmentację można przykryć nowymi włoskami lub cieniem. Najpierw sprawdzamy kształt, kolor i nasycenie. Czasem potrzebne jest rozjaśnienie albo usuwanie, zanim zaplanujemy nowy efekt.</p><div class="pmu-landing-links"><a class="pmu-landing-secondary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Opisz stare PMU — formularz kwalifikacji →</a><a href="/usuwanie-makijazu-permanentnego/">Kiedy rozważyć usuwanie →</a></div></section>

      <section class="pmu-landing-section pmu-landing-expert" id="doswiadczenie-brwi" aria-labelledby="doswiadczenie-tytul"><figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — autorka Silky Hairstroke Brows i trenerka PMU" width={720} widths={[240,360,540,720]} sizes="(max-width:640px) 200px, (max-width:900px) 280px, 340px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-landing-kicker">05 / Doświadczenie w projektowaniu brwi</p><h2 id="doswiadczenie-tytul">Bogusława Herda</h2><p>Autorka Silky Hairstroke Brows, wicemistrzyni świata w makijażu permanentnym i europejski trener Long-Time-Liner®. Ponad 10 lat praktyki gabinetowej to doświadczenie w pracy z różnymi brwiami, skórą i wcześniejszą pigmentacją.</p><p class="pmu-brows-expert-note">W projekcie liczą się proporcje twarzy, naturalny wzrost włosków i Twoje oczekiwania. Metodę dobieramy po rozmowie i ocenie brwi.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie i sposób pracy →</a></div></div></section>

      <section class="pmu-landing-faq" id="pytania-brwi" aria-labelledby="faq-tytul"><p class="pmu-landing-kicker">Przed rezerwacją</p><h2 id="faq-tytul">Pytania o zabieg brwi.</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}<br /><a class="pmu-brows-faq-link" href={item.href}>{item.label} →</a></p></details>)}</section>

      <section class="pmu-landing-section" aria-labelledby="poradniki-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">Gdy chcesz wiedzieć więcej</p><h2 id="poradniki-tytul">Przejdź do właściwej odpowiedzi.</h2></div><div class="pmu-brows-guides">{guides.map(item => <a href={item.href}><h3>{item.title}</h3><p>{item.text}</p><span>Czytaj poradnik →</span></a>)}</div></section>

      <section class="pmu-landing-booking" id="kontakt" aria-labelledby="rezerwacja-tytul"><div><p class="pmu-landing-kicker">Twój następny krok</p><h2 id="rezerwacja-tytul">Porozmawiajmy o Twoich brwiach.</h2><p>Wybierz termin w gabinecie Bogusława Herda.<br />Bielsko-Biała, ul. Barlickiego 5/23.</p></div><div class="pmu-landing-booking-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a><a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-landing-text-link" href="/kontakt/">Sprawdź dojazd i kontakt →</a></div></section>
