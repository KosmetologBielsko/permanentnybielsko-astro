    gap: number
  ) => {
    const scroll = document.querySelector<HTMLElement>(scrollSelector);
    const left = document.querySelector<HTMLButtonElement>(leftSelector);
    const right = document.querySelector<HTMLButtonElement>(rightSelector);

    if (!scroll || !left || !right) return;

    const getAmount = () => {
      const firstCard = scroll.querySelector<HTMLElement>(cardSelector);
      if (!firstCard) return fallbackAmount;
      return firstCard.getBoundingClientRect().width + gap;
    };

    left.addEventListener("click", () => {
      scroll.scrollBy({
        left: -getAmount(),
        behavior: "smooth"
      });
    });

    right.addEventListener("click", () => {
      scroll.scrollBy({
        left: getAmount(),
        behavior: "smooth"
      });
    });
  };

  bindHorizontalSlider(
    "#browMethodScroll",
    ".brow-method-arrow-left",
    ".brow-method-arrow-right",
    ".brow-method-card",
    350,
    18
  );

  bindHorizontalSlider(
    "#browSilkyGalleryScroll",
    ".brow-gallery-arrow-left",
    ".brow-gallery-arrow-right",
    ".brow-gallery-card",
    300,
    14
  );
</script>
