---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import practicePhoto from "../../public/images/szkolenia-pmu-praktyka-zabiegowa-long-time-liner.webp";
import "../styles/pmu-landing.css";
import "../styles/pmu-brows.css";
import "../styles/pmu-services-17.css";
import trainingHero from "../../public/images/szkolenia-pmu-hero-boguslawa-herda-elite-top-linergist.webp";
import certificatePhoto from "../../public/images/szkolenia-pmu-masterclass-certyfikat.webp";
const pageUrl = "https://www.permanentnybielsko.com/szkolenie-makijaz-permanentny/";
const pageTitle = "Szkolenie makijaż permanentny Bielsko-Biała | Bogusława Herda";
const pageDescription =
  "Indywidualne szkolenia makijażu permanentnego w Bielsku-Białej: Step by Step, Masterclass, Silky Hairstroke Brows i Bye-Bye Pigment Remover. Bogusława Herda — trenerka Long-Time-Liner® i Elite Top Linergist.";
const faqItems = [
  {
    "question": "Od którego szkolenia zacząć bez doświadczenia?",
    "answer": "Step by Step jest ścieżką dla osób budujących podstawy. To 3 dni pracy 1:1 w jednym wybranym obszarze: brwi, usta albo oczy. Zakres omawiamy przed zapisem."
  },
  {
    "question": "Dla kogo jest Masterclass?",
    "answer": "Dla linergistek, które już pracują i chcą dopracować technikę lub rozwiązać konkretny problem. Jednodniowy program dobieramy do poziomu uczestniczki."
  },
  {
    "question": "Czego dotyczy Silky Hairstroke Brows?",
    "answer": "To autorski kierunek Bogusławy Herda oparty na włosie maszynowym: indywidualne projektowanie kierunku i rytmu włosa oraz naturalny efekt. O program, wymagany poziom, termin i cenę zapytaj przed zapisem."
  },
  {
    "question": "Gdzie odbywają się szkolenia PMU?",
    "answer": "W Bielsku-Białej, w gabinecie przy ul. Barlickiego 5/23. Termin i szczegóły organizacyjne ustalamy indywidualnie."
  },
  {
    "question": "Czy podane ceny szkoleń zawierają VAT?",
    "answer": "Pokazujemy kwoty netto oraz brutto z 23% VAT. Step by Step: 8610 zł brutto, Masterclass: 3690 zł brutto, Bye-Bye Pigment Remover: 2460 zł brutto. Preparat Bye-Bye Pigment kosztuje 890 zł brutto."
  },
  {
    "question": "Jak zapisać się na szkolenie?",
    "answer": "Zadzwoń lub napisz e-mail. Podaj swoje doświadczenie, interesujący Cię obszar i preferowany termin. Przed zapisem ustalimy właściwy program oraz warunki udziału."
  }
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-09-20",
    inLanguage: "pl-PL"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Szkolenie makijaż permanentny",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "@id": `${pageUrl}#course`,
    name: "Szkolenie makijaż permanentny Bielsko-Biała",
    description: pageDescription,
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    creator: {
      "@id": "https://www.permanentnybielsko.com/#person"
    },
    dateModified: "2026-09-20",
    inLanguage: "pl-PL",
    hasCourseInstance: { "@type": "CourseInstance", courseMode: "onsite", location: { "@type": "Place", name: "Gabinet Bogusława Herda, Bielsko-Biała" } },
    educationalLevel: "professional"
  }
,
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqItems.map(item => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) }
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/szkolenie-makijaz-permanentny/" structuredData={structuredData} inlineGuideAssistant={true}>
<a class="pmu-landing-skip" href="#tresc">Przejdź do treści</a><Header compact />
<main id="tresc" class="pmu-landing pmu-brows pmu-service17 pmu-training"><div class="pmu-landing-shell"><nav class="pmu-landing-breadcrumbs" aria-label="Okruszki"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Szkolenia PMU</span></nav>
<section class="pmu-landing-intro pmu-brows-hero" aria-labelledby="tytul-strony"><div><p class="pmu-landing-kicker">Szkolenia PMU · Bielsko-Biała</p><h1 id="tytul-strony">Uczę nie tylko techniki. Uczę podejmować dobre decyzje.</h1><p class="pmu-landing-lead">Indywidualne szkolenia makijażu permanentnego: od podstaw po doskonalenie pracy. Wybierz kierunek, a program dopasujemy do Twojego doświadczenia.</p><a class="pmu-landing-author" href="#doswiadczenie-szkolenia"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} /><span><strong>Bogusława Herda</strong><span>Linergistka · trenerka Long-Time-Liner®</span></span></a><p class="pmu-service17-hero-price"><strong>Step by Step · Masterclass · Silky</strong><span>oraz Bye-Bye Pigment Remover</span></p><div class="pmu-brows-hero-actions"><a class="pmu-landing-primary" href="mailto:bogusia@permanentnybielsko.com?subject=Szkolenie%20PMU">Zapytaj o program i termin →</a><a class="pmu-landing-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div></div><figure class="pmu-brows-hero-photo"><Image src={trainingHero} alt="Bogusława Herda z wyróżnieniem Elite Top Linergist Long-Time-Liner" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="eager" decoding="async" fetchpriority="high" /><figcaption>Bogusława Herda · Elite Top Linergist</figcaption></figure></section><nav class="pmu-landing-nav" aria-label="Na tej stronie"><a href="#szkolenia">Wybierz szkolenie<span aria-hidden="true">↓</span></a><a href="#praktyka-szkolenia">Praktyka<span aria-hidden="true">↓</span></a><a href="#ceny-szkolen">Ceny<span aria-hidden="true">↓</span></a><a href="#doswiadczenie-szkolenia">Trenerka<span aria-hidden="true">↓</span></a><a href="#kontakt">Kontakt<span aria-hidden="true">↓</span></a></nav><section class="pmu-landing-section " id="szkolenia"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Dobry punkt wyjścia</p><h2>Jaki etap jest teraz Twój?</h2></div><div class="pmu-brows-methods"><article class="pmu-brows-method"><p class="pmu-landing-kicker">Podstawy · 3 dni · 1:1</p><h3>Step by Step</h3><p>Jedno szkolenie tematyczne: brwi, usta albo oczy. Analiza twarzy, rysunek wstępny, kolor i praktyka — z czasem na zrozumienie całego procesu.</p><a href="#ceny-szkolen">Sprawdź cenę →</a></article><article class="pmu-brows-method pmu-brows-method-shade"><p class="pmu-landing-kicker">Doskonalenie · 1 dzień</p><h3>Masterclass</h3><p>Dla linergistek, które już pracują. Analiza błędów i praca nad wybranym problemem technicznym zamiast ponownego przechodzenia całych podstaw.</p><a href="#ceny-szkolen">Sprawdź cenę →</a></article><article class="pmu-brows-method"><p class="pmu-landing-kicker">Autorski kierunek · Bogusława Herda</p><h3>Silky Hairstroke Brows</h3><p>Naturalny włos maszynowy: kierunek, rytm i miękkość linii. Projektowanie pod konkretną twarz i naturalny układ brwi. Zapytaj o program, wymagany poziom, termin i cenę.</p><a href="mailto:bogusia@permanentnybielsko.com?subject=Szkolenie%20PMU">Zapytaj o Silky →</a></article><article class="pmu-brows-method pmu-brows-method-shade"><p class="pmu-landing-kicker">Remover · 1 dzień</p><h3>Bye-Bye Pigment</h3><p>Kwalifikacja, bezpieczeństwo i świadoma praca ze starym PMU. Szkolenie z removera Long-Time-Liner®. Cena preparatu: 890 zł brutto.</p><a href="#ceny-szkolen">Sprawdź cenę →</a></article></div></section><section class="pmu-landing-section " id="praktyka-szkolenia"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">02 / Zobacz sposób pracy</p><h2>Wiedza, którą przekładasz na ruch ręki.</h2></div><p>Podczas szkolenia jest miejsce na analizę, pytania i praktykę. Chodzi o świadome decyzje: kiedy zmienić projekt, jak ocenić swoją pracę i nad czym dalej ćwiczyć.</p><figure class="pmu-service17-film"><video controls playsinline preload="none" width="960" height="540" poster="/video/szkolenia-pmu-boguslawa-herda-trener-long-time-liner-poster.webp" aria-label="Bogusława Herda — film o szkoleniach PMU"><source src="/video/szkolenia-pmu-boguslawa-herda-trener-long-time-liner.mp4" type="video/mp4" /><a href="/video/szkolenia-pmu-boguslawa-herda-trener-long-time-liner.mp4">Otwórz film o szkoleniach</a></video><figcaption>Szkolenia PMU · Bogusława Herda</figcaption></figure><div class="pmu-service17-photos"><figure><Image src={practicePhoto} alt="Bogusława Herda podczas precyzyjnej pracy zabiegowej" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="lazy" decoding="async" /><figcaption>Praktyka i uważna praca ze skórą.</figcaption></figure><figure><Image src={certificatePhoto} alt="Bogusława Herda z uczestniczką szkolenia Masterclass i certyfikatem" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="lazy" decoding="async" /><figcaption>Masterclass · rozwijanie umiejętności.</figcaption></figure></div></section><section class="pmu-landing-section " id="ceny-szkolen"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">03 / Przejrzyste warunki</p><h2>Ceny szkoleń PMU.</h2></div><div class="pmu-service17-prices"><article><h3>Step by Step</h3><p>3 dni · 1:1 · jeden obszar</p><strong>8610 zł brutto</strong><p>7000 zł netto + 23% VAT</p></article><article><h3>Masterclass</h3><p>1 dzień · doskonalenie techniki</p><strong>3690 zł brutto</strong><p>3000 zł netto + 23% VAT</p></article><article><h3>Bye-Bye Pigment Remover</h3><p>1 dzień · praca z removerem</p><strong>2460 zł brutto</strong><p>2000 zł netto + 23% VAT</p></article></div><p class="pmu-service17-note">Preparat Bye-Bye Pigment: 890 zł brutto. Step by Step obejmuje jeden wybrany obszar — brwi, usta albo oczy. O cenę i warunki Silky Hairstroke Brows zapytaj indywidualnie.</p><div class="pmu-landing-links"><a href="mailto:bogusia@permanentnybielsko.com?subject=Szkolenie%20PMU">Ustal program i termin szkolenia →</a></div></section><section class="pmu-landing-section pmu-landing-expert" id="doswiadczenie-szkolenia"><figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — trenerka makijażu permanentnego" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-landing-kicker">Doświadczenie i sposób pracy</p><h2>Bogusława Herda</h2><p>Europejski trener Long-Time-Liner®, Elite Top Linergist, wicemistrzyni świata w makijażu permanentnym i autorka Silky Hairstroke Brows. Ponad 10 lat praktyki gabinetowej przekłada na naukę projektowania, techniki i podejmowania decyzji przy konkretnej skórze.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie i podejście do PMU →</a></div></div></section><section class="pmu-landing-faq" id="faq-szkolenia"><p class="pmu-landing-kicker">Przed wizytą</p><h2>Pytania przed wyborem szkolenia.</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</section><section class="pmu-landing-section pmu-landing-callout"><p class="pmu-landing-kicker">Przed decyzją</p><h2>Wybierz program odpowiedni do swojego etapu.</h2><p>Sprawdź, na co zwrócić uwagę przy wyborze szkolenia i jak rozumiemy naturalny efekt włosa maszynowego.</p><div class="pmu-landing-links"><a href="/poradnik/jak-wybrac-szkolenie-pmu/">Jak wybrać szkolenie PMU? →</a><a href="/makijaz-permanentny-brwi/">Poznaj Silky Hairstroke Brows →</a></div></section><section class="pmu-landing-booking" id="kontakt"><div><p class="pmu-landing-kicker">Twój kolejny krok</p><h2>Porozmawiajmy o Twoim rozwoju.</h2><p>Napisz, czy dopiero zaczynasz, czy już pracujesz. Podaj obszar, nad którym chcesz popracować, oraz preferowany termin.</p><p class="pmu-service17-note">Barlickiego 5/23 · Bielsko-Biała</p></div><div class="pmu-landing-booking-actions"><a class="pmu-landing-primary" href="mailto:bogusia@permanentnybielsko.com?subject=Szkolenie%20PMU">Napisz o szkoleniu →</a><a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-landing-text-link" href="/kontakt/">Kontakt i dojazd →</a></div></section>
<GuideAssistant /></div></main><Footer />
</Layout>
