---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl = "https://www.permanentnybielsko.com/szkolenie-makijaz-permanentny/";
const pageTitle = "Szkolenie makijaż permanentny Bielsko-Biała | Bogusława Herda";
const pageDescription =
  "Indywidualne szkolenia makijażu permanentnego w Bielsku-Białej: Step by Step, Masterclass, Silky Hairstroke Brows i Bye-Bye Pigment Remover. Bogusława Herda — trenerka Long-Time-Liner® i Elite Top Linergist.";

const heroImage = "/images/szkolenia-pmu-hero-boguslawa-herda-elite-top-linergist.webp";

const paths = [
  {
    number: "01",
    title: "Step by Step",
    image: "/images/01-step-by-step.webp",
    intro: "Dla osób, które chcą zbudować mocne podstawy.",
    text: "Tematyczne szkolenie z brwi, ust albo oczu. Porządkujemy cały proces: analizę twarzy, rysunek wstępny, kolor, technikę, praktykę i ocenę efektu po wygojeniu.",
    points: ["brwi, usta albo oczy", "3 dni", "tryb 1:1", "rysunek + praktyka"]
  },
  {
    number: "02",
    title: "Masterclass",
    image: "/images/02-masterclass.webp",
    intro: "Dla linergistek, które już pracują i chcą wejść poziom wyżej.",
    text: "Pracujemy nad konkretnymi problemami technicznymi, błędami, jakością efektu i decyzjami zabiegowymi. Zakres dobierany jest do realnego poziomu uczestniczki.",
    points: ["1 dzień", "analiza błędów", "brwi, usta lub oczy", "doskonalenie techniki"]
  },
  {
    number: "03",
    title: "Silky Hairstroke Brows",
    image: "/images/03-silky-hairstroke-brows.webp",
    intro: "Autorska metoda naturalnego włosa maszynowego.",
    text: "Kierunek włosa, rytm ręki, miękkość linii i realistyczny efekt. Nie kopiujemy schematu — uczymy budować włos pod konkretną twarz i naturalny układ brwi.",
    points: ["kierunek włosa", "lekkość ręki", "włos + cień", "analiza wygojenia"]
  }
];

const prices = [
  {
    title: "Step by Step",
    price: "7.000 zł netto + 23% VAT",
    meta: "3 dni · 1:1",
    text: "Jedno szkolenie tematyczne: brwi, usta albo oczy."
  },
  {
    title: "Masterclass",
    price: "3.000 zł netto + 23% VAT",
    meta: "1 dzień · poziom zaawansowany",
    text: "Doszkolenie z wybranego obszaru lub problemu technicznego."
  },
  {
    title: "Bye-Bye Pigment Remover",
    price: "2.000 zł netto + 23% VAT",
    meta: "1 dzień",
    text: "Kwalifikacja, bezpieczeństwo i świadoma praca z removerem. Preparat: 890 zł brutto."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Szkolenie makijaż permanentny",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Course",
    name: "Szkolenie makijaż permanentny Bielsko-Biała",
    description: pageDescription,
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    creator: {
      "@id": "https://www.permanentnybielsko.com/#person"
    },
    inLanguage: "pl-PL",
    courseMode: "onsite",
    educationalLevel: "professional"
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/szkolenie-makijaz-permanentny/"
  structuredData={structuredData}
>
  <div class="training-page">
    <Header />

    <main>
      <section class="training-hero">
        <div class="container training-hero-grid">
          <div class="training-hero-copy">
            <p class="training-chip">Szkolenia PMU · Bielsko-Biała</p>

            <h1>
              Uczę nie tylko techniki.
              <span>Uczę podejmować dobre decyzje.</span>
            </h1>

            <p class="training-lead">
              Indywidualne szkolenia makijażu permanentnego dla osób początkujących
              i linergistek, które chcą pracować precyzyjniej, spokojniej i bardziej świadomie.
            </p>

            <div class="training-trust">
              <span>Long-Time-Liner®</span>
              <span>Elite Top Linergist</span>
              <span>Silky Hairstroke Brows</span>
              <span>1:1</span>
            </div>

            <div class="training-actions">
              <a class="training-button training-button-primary" href="/kontakt/">
                Zapytaj o szkolenie →
              </a>
              <a class="training-button training-button-secondary" href="tel:+48730900125">
                Zadzwoń
              </a>
              <a
                class="training-button training-button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy →
              </a>
            </div>
          </div>

          <figure class="training-hero-photo">
            <img
              src={heroImage}
              alt="Bogusława Herda — Elite Top Linergist Long-Time-Liner, szkolenia PMU Bielsko-Biała"
              width="1086"
              height="1448"
              loading="eager"
              decoding="async"
            />
            <figcaption>
              <span>Trenerka PMU</span>
              <strong>Bogusława Herda</strong>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="training-proof-section" aria-label="Dlaczego szkolenie z Bogusławą Herda">
        <div class="container training-proof-grid">
          <article>
            <strong>Trenerka Long-Time-Liner®</strong>
            <span>standard pracy i edukacji</span>
          </article>
          <article>
            <strong>Elite Top Linergist</strong>
            <span>doświadczenie i precyzja</span>
          </article>
          <article>
            <strong>Silky Hairstroke Brows</strong>
            <span>autorska metoda włosa</span>
          </article>
          <article>
            <strong>Szkolenie 1:1</strong>
            <span>tempo dopasowane do Ciebie</span>
          </article>
        </div>
      </section>

      <section class="training-paths-section" id="szkolenia">
        <div class="container">
          <div class="training-heading">
            <p class="training-chip">Wybierz ścieżkę</p>
            <h2>Nie potrzebujesz „więcej wiedzy”. Potrzebujesz właściwego szkolenia.</h2>
            <p>
              Inaczej pracujemy z osobą, która zaczyna, inaczej z linergistką poprawiającą technikę,
              a jeszcze inaczej z kimś, kto chce wejść w naturalny włos maszynowy.
            </p>
          </div>

          <div class="training-path-grid">
            {paths.map((path) => (
              <details class="training-path-card">
                <summary>
                  <div class="training-path-media">
                    <img
                      src={path.image}
                      alt={`${path.title} — szkolenie makijażu permanentnego`}
                      width="1536"
                      height="1024"
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{path.number}</span>
                  </div>

                  <div class="training-path-copy">
                    <h3>{path.title}</h3>
                    <p>{path.intro}</p>
                    <div class="training-path-toggle">
                      <span>Szczegóły</span>
                      <i aria-hidden="true"></i>
                    </div>
                  </div>
                </summary>

                <div class="training-path-details">
                  <p>{path.text}</p>
                  <ul>
                    {path.points.map((point) => <li>{point}</li>)}
                  </ul>
                </div>
              </details>
            ))}
          </div>

          <a class="training-remover-mini" href="#ceny-szkolen">
            <span>Opcja dodatkowa</span>
            <strong>Bye-Bye Pigment Remover</strong>
            <em>Kwalifikacja · bezpieczeństwo · remover →</em>
          </a>
        </div>
      </section>

      <section class="training-process-section">
        <div class="container training-process-card">
          <div class="training-process-copy">
            <p class="training-chip training-chip-light">Jak wygląda szkolenie?</p>
            <h2>Analiza. Praktyka. Korekta decyzji.</h2>
            <p>
              Po szkoleniu masz wiedzieć nie tylko <strong>jak</strong> wykonać ruch,
              ale również <strong>dlaczego</strong> właśnie tak.
            </p>

            <div class="training-process-steps">
              <div>
                <span>01</span>
                <strong>Analizujemy</strong>
                <p>Twarz, skórę, asymetrię, rysunek i plan zabiegu.</p>
              </div>
              <div>
                <span>02</span>
                <strong>Pracujemy praktycznie</strong>
                <p>Tempo, ruch ręki, pigmentacja i realne przypadki.</p>
              </div>
              <div>
                <span>03</span>
                <strong>Wyciągamy wnioski</strong>
                <p>Co poprawić, czego unikać i jak budować powtarzalny efekt.</p>
              </div>
            </div>
          </div>

          <figure class="training-video-frame" data-training-video-frame>
            <video
              poster="/video/szkolenia-pmu-boguslawa-herda-trener-long-time-liner-poster.webp"
              muted
              loop
              autoplay
              playsinline
              controls
              preload="metadata"
              aria-label="Bogusława Herda — trenerka Long-Time-Liner, szkolenia PMU"
            >
              <source
                src="/video/szkolenia-pmu-boguslawa-herda-trener-long-time-liner.mp4"
                type="video/mp4"
              />
            </video>

            <button class="training-video-sound-button" type="button" data-training-sound-toggle>
              Włącz dźwięk
            </button>
          </figure>
        </div>
      </section>

      <section class="training-price-section" id="ceny-szkolen">
        <div class="container">
          <div class="training-heading">
            <p class="training-chip">Ceny i organizacja</p>
            <h2>Konkretnie: wybierasz zakres, resztę ustalamy indywidualnie.</h2>
            <p>
              Szkolenia odbywają się w Bielsku-Białej. Termin i szczegóły organizacyjne ustalamy przed szkoleniem.
            </p>
          </div>

          <div class="training-price-grid">
            {prices.map((item) => (
              <article class="training-price-card">
                <span>{item.meta}</span>
                <h3>{item.title}</h3>
                <strong>{item.price}</strong>
                <p>{item.text}</p>
              </article>
            ))}
          </div>

          <div class="training-price-note">
            <strong>Nie wiesz, który poziom wybrać?</strong>
            <span>
              Opisz swoje doświadczenie i cel. Dobiorę właściwy zakres zamiast sprzedawać Ci przypadkowe szkolenie.
            </span>
          </div>
        </div>
      </section>

      <section class="training-final-section" id="kontakt">
        <div class="container training-final-card">
          <p class="training-chip">Szkolenie 1:1</p>
          <h2>Powiedz mi, na jakim jesteś poziomie. Dobierzemy właściwą drogę.</h2>
          <p>
            Możesz zacząć od krótkiej wiadomości albo telefonu. Nie musisz samodzielnie
            wybierać szkolenia przed kontaktem.
          </p>

          <div class="training-actions training-final-actions">
            <a class="training-button training-button-primary" href="/kontakt/">
              Zapytaj o szkolenie →
            </a>
            <a class="training-button training-button-secondary" href="tel:+48730900125">
              Zadzwoń
            </a>
            <a
              class="training-button training-button-booksy"
              href={booksyUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Booksy →
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  document.querySelectorAll("[data-training-video-frame]").forEach((frame) => {
    const video = frame.querySelector("video");
    const button = frame.querySelector("[data-training-sound-toggle]");

    if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;

    button.addEventListener("click", async () => {
      video.muted = !video.muted;
      button.textContent = video.muted ? "Włącz dźwięk" : "Wyłącz dźwięk";
      button.classList.toggle("is-sound-on", !video.muted);

      if (!video.muted) {
        try { await video.play(); } catch {}
      }
    });
  });

  document.querySelectorAll(".training-path-card").forEach((card) => {
    card.addEventListener("toggle", () => {
      if (!(card instanceof HTMLDetailsElement) || !card.open) return;

      document.querySelectorAll(".training-path-card[open]").forEach((other) => {
        if (other !== card && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
</script>

<style>
  .training-page {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(56,187,181,.10), transparent 28rem),
      radial-gradient(circle at 12% 42%, rgba(201,127,143,.09), transparent 25rem),
      linear-gradient(180deg,#fffdfd 0%,#fff8fa 52%,#fff 100%);
  }

  .training-page * { box-sizing: border-box; }

  .training-chip {
    display: inline-flex;
    width: fit-content;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    margin: 0 0 18px;
    padding: 0 13px;
    border: 1px solid rgba(56,187,181,.16);
    border-radius: 999px;
    background: rgba(219,246,243,.72);
    color: var(--color-turquoise-dark,#0f7773);
    font-size: .70rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .training-chip-light {
    border-color: rgba(255,255,255,.24);
    background: rgba(255,255,255,.14);
    color: #fff;
  }

  .training-hero { padding: 150px 0 68px; }

  .training-hero-grid {
    display: grid;
    grid-template-columns: minmax(0,1.08fr) minmax(320px,.72fr);
    gap: 22px;
    align-items: stretch;
  }

  .training-hero-copy,
  .training-hero-photo,
  .training-path-card,
  .training-process-card,
  .training-price-card,
  .training-price-note,
  .training-final-card {
    border: 1px solid rgba(183,101,118,.14);
    box-shadow: 0 20px 58px rgba(89,53,67,.065);
  }

  .training-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(36px,5vw,68px);
    border-radius: 40px;
    background:
      radial-gradient(circle at 92% 12%,rgba(56,187,181,.09),transparent 14rem),
      rgba(255,255,255,.84);
  }

  .training-hero-copy h1 {
    max-width: 980px;
    margin: 0;
    color: var(--color-text,#17151d);
    font-size: clamp(3rem,5.5vw,6.25rem);
    font-weight: 760;
    line-height: .98;
    letter-spacing: -.078em;
  }

  .training-hero-copy h1 span {
    display: block;
    background: linear-gradient(120deg,#0d6a67 0%,#0f7773 24%,#1aa5a0 52%,#74e0d7 76%,#138a86 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .training-lead {
    max-width: 760px;
    margin: 26px 0 0;
    color: var(--color-muted,#6e6670);
    font-size: 1.08rem;
    line-height: 1.68;
  }

  .training-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .training-trust span {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 12px;
    border: 1px solid rgba(56,187,181,.14);
    border-radius: 999px;
    background: rgba(255,255,255,.76);
    color: var(--color-text,#17151d);
    font-size: .70rem;
    font-weight: 800;
  }

  .training-actions {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 10px;
    width: min(100%,820px);
    margin-top: 28px;
  }

  .training-button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 999px;
    font-size: .92rem;
    font-weight: 820;
    text-align: center;
    text-decoration: none;
  }

  .training-button-primary,
  .training-button-booksy {
    color: #fff;
    background: linear-gradient(135deg,#18a889 0%,#0f8f78 55%,#0b7868 100%);
    box-shadow: 0 14px 34px rgba(15,143,120,.20);
  }

  .training-button-secondary {
    border: 1px solid rgba(183,101,118,.18);
    color: var(--color-text,#17151d);
    background: rgba(255,255,255,.78);
  }

  .training-hero-photo {
    position: relative;
    min-height: 610px;
    margin: 0;
    overflow: hidden;
    padding: 10px;
    border-radius: 40px;
    background: rgba(255,255,255,.88);
  }

  .training-hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 590px;
    border-radius: 31px;
    object-fit: cover;
    object-position: center top;
  }

  .training-hero-photo figcaption {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: grid;
    gap: 4px;
    padding: 15px 17px;
    border-radius: 20px;
    background: rgba(15,119,115,.84);
    color: #fff;
    backdrop-filter: blur(10px);
  }

  .training-hero-photo figcaption span {
    font-size: .62rem;
    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .training-proof-section {
    border-top: 1px solid rgba(183,101,118,.10);
    border-bottom: 1px solid rgba(183,101,118,.10);
    background: rgba(255,255,255,.75);
  }

  .training-proof-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
  }

  .training-proof-grid article {
    min-height: 108px;
    padding: 23px 22px;
    border-right: 1px solid rgba(183,101,118,.11);
  }

  .training-proof-grid article:last-child { border-right: 0; }

  .training-proof-grid strong {
    display: block;
    margin-bottom: 7px;
    font-size: .92rem;
    font-weight: 800;
  }

  .training-proof-grid span {
    color: var(--color-muted,#6e6670);
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .training-paths-section,
  .training-process-section,
  .training-price-section,
  .training-final-section { padding: 82px 0; }

  .training-heading {
    max-width: 980px;
    margin-bottom: 30px;
  }

  .training-heading h2,
  .training-process-copy h2,
  .training-final-card h2 {
    margin: 0;
    color: var(--color-text,#17151d);
    font-size: clamp(2.4rem,4.2vw,4.35rem);
    font-weight: 760;
    line-height: 1.02;
    letter-spacing: -.072em;
  }

  .training-heading > p:not(.training-chip),
  .training-process-copy > p:not(.training-chip),
  .training-final-card > p:not(.training-chip) {
    max-width: 820px;
    margin: 17px 0 0;
    color: var(--color-muted,#6e6670);
    font-size: 1rem;
    line-height: 1.65;
  }

  .training-path-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
  }

  .training-path-card {
    overflow: hidden;
    border-radius: 30px;
    background: rgba(255,255,255,.90);
  }

  .training-path-card summary {
    cursor: pointer;
    list-style: none;
  }

  .training-path-card summary::-webkit-details-marker { display: none; }

  .training-path-media {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
  }

  .training-path-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .training-path-media > span {
    position: absolute;
    left: 18px;
    bottom: 16px;
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(15,119,115,.82);
    color: #fff;
    font-size: .70rem;
    font-weight: 900;
  }

  .training-path-copy { padding: 22px 22px 20px; }

  .training-path-copy h3 {
    margin: 0;
    font-size: 1.55rem;
    font-weight: 780;
    line-height: 1.04;
    letter-spacing: -.055em;
  }

  .training-path-copy > p {
    min-height: 48px;
    margin: 10px 0 0;
    color: var(--color-muted,#6e6670);
    font-size: .88rem;
    line-height: 1.55;
  }

  .training-path-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 17px;
    padding-top: 15px;
    border-top: 1px solid rgba(56,187,181,.13);
    color: #0f7773;
    font-size: .68rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .training-path-toggle i {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: rgba(219,246,243,.65);
  }

  .training-path-toggle i::before,
  .training-path-toggle i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 2px;
    background: #0f7773;
    transform: translate(-50%,-50%);
  }

