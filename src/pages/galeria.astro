<script>
  const bindGallerySlider = (section: HTMLElement) => {
    const track = section.querySelector<HTMLElement>("[data-slider-track]");
    const previous = section.querySelector<HTMLButtonElement>("[data-slider-prev]");
    const next = section.querySelector<HTMLButtonElement>("[data-slider-next]");

    if (!track || !previous || !next) return;

    const getAmount = () => {
      const firstCard = track.querySelector<HTMLElement>(".gallery-photo-card");
      if (!firstCard) return Math.min(track.clientWidth * 0.86, 760);
      return firstCard.getBoundingClientRect().width + 14;
    };

    previous.addEventListener("click", () => {
      track.scrollBy({ left: -getAmount(), behavior: "smooth" });
    });

    next.addEventListener("click", () => {
      track.scrollBy({ left: getAmount(), behavior: "smooth" });
    });
  };

  document.querySelectorAll<HTMLElement>("[data-gallery-section]").forEach((section) => {
    bindGallerySlider(section);
  });

  const imageDialog = document.querySelector<HTMLDialogElement>("[data-image-dialog]");
  const dialogImage = imageDialog?.querySelector<HTMLImageElement>("[data-dialog-image]");
  const imageClose = imageDialog?.querySelector<HTMLButtonElement>("[data-image-close]");
  const imagePrevious = imageDialog?.querySelector<HTMLButtonElement>("[data-image-prev]");
  const imageNext = imageDialog?.querySelector<HTMLButtonElement>("[data-image-next]");
  const imageCounter = imageDialog?.querySelector<HTMLElement>("[data-image-counter]");
  let activeImages: HTMLElement[] = [];
  let activeImageIndex = 0;

  const showGalleryImage = (index: number) => {
    if (!dialogImage || activeImages.length === 0) return;
    activeImageIndex = (index + activeImages.length) % activeImages.length;
    const imageButton = activeImages[activeImageIndex];
    dialogImage.src = imageButton.dataset.imageSrc ?? "";
    dialogImage.alt = imageButton.dataset.imageAlt ?? "";
    if (imageCounter) imageCounter.textContent = `${activeImageIndex + 1} / ${activeImages.length}`;
  };

  const closeImageDialog = () => {
    if (!imageDialog) return;

    if (imageDialog.open && typeof imageDialog.close === "function") {
      imageDialog.close();
    } else {
      imageDialog.removeAttribute("open");
    }

    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
  };

  document.querySelectorAll<HTMLElement>("[data-gallery-image]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!imageDialog || !dialogImage) return;
      const section = button.closest<HTMLElement>("[data-gallery-section]");
      activeImages = section
        ? Array.from(section.querySelectorAll<HTMLElement>("[data-gallery-image]"))
        : [button];
      showGalleryImage(Math.max(0, activeImages.indexOf(button)));

      if (typeof imageDialog.showModal === "function") {
        imageDialog.showModal();
      } else {
        imageDialog.setAttribute("open", "");
      }

      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
    });
  });

  imageClose?.addEventListener("click", closeImageDialog);
  imagePrevious?.addEventListener("click", () => showGalleryImage(activeImageIndex - 1));
  imageNext?.addEventListener("click", () => showGalleryImage(activeImageIndex + 1));

  imageDialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") showGalleryImage(activeImageIndex - 1);
    if (event.key === "ArrowRight") showGalleryImage(activeImageIndex + 1);
  });

  imageDialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeImageDialog();
  });

  imageDialog?.addEventListener("click", (event) => {
    if (event.target === imageDialog) closeImageDialog();
  });

  const videoGallery = document.querySelector<HTMLElement>("[data-video-gallery]");

  if (videoGallery) {
    const videoTrack = videoGallery.querySelector<HTMLElement>("[data-video-track]");
    const videoPrev = videoGallery.querySelector<HTMLButtonElement>("[data-video-prev]");
    const videoNext = videoGallery.querySelector<HTMLButtonElement>("[data-video-next]");
    const cards = Array.from(
      videoGallery.querySelectorAll<HTMLElement>("[data-video-card]")
    );

    const getVideoAmount = () => {
      const firstCard = videoTrack?.querySelector<HTMLElement>(".gallery-video-card");
      if (!firstCard) return 380;
      return firstCard.getBoundingClientRect().width + 14;
    };

    videoPrev?.addEventListener("click", () => {
      videoTrack?.scrollBy({ left: -getVideoAmount(), behavior: "smooth" });
    });

    videoNext?.addEventListener("click", () => {
      videoTrack?.scrollBy({ left: getVideoAmount(), behavior: "smooth" });
    });

    const pauseOtherVideos = (exception?: HTMLVideoElement) => {
      cards.forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>("[data-card-video]");
        if (video && video !== exception) video.pause();
      });
    };

    cards.forEach((card) => {
      const cardVideo = card.querySelector<HTMLVideoElement>("[data-card-video]");
      const cardMedia = card.querySelector<HTMLElement>(".gallery-video-media");
      const cardIcon = card.querySelector<HTMLElement>("[data-card-icon]");
      const cardSmallIcon = card.querySelector<HTMLElement>("[data-card-small-icon]");
      const dialog = card.querySelector<HTMLDialogElement>("[data-video-dialog]");
      const dialogVideo = card.querySelector<HTMLVideoElement>("[data-dialog-video]");
      const dialogShell = card.querySelector<HTMLElement>(".gallery-video-dialog-shell");
      const dialogIcon = card.querySelector<HTMLElement>("[data-dialog-icon]");
      const dialogSmallIcon = card.querySelector<HTMLElement>("[data-dialog-small-icon]");

      if (!cardVideo || !dialog || !dialogVideo) return;

      cardVideo.muted = true;
      dialogVideo.muted = true;

      const updateCard = () => {
        const playing = !cardVideo.paused && !cardVideo.ended;
        cardMedia?.classList.toggle("is-playing", playing);
        if (cardIcon) cardIcon.textContent = playing ? "Ⅱ" : "▶";
        if (cardSmallIcon) cardSmallIcon.textContent = playing ? "Ⅱ" : "▶";
      };

      const toggleCard = async () => {
        if (cardVideo.paused || cardVideo.ended) {
          pauseOtherVideos(cardVideo);
          try {
            await cardVideo.play();
          } catch {
            // Ponowne kliknięcie pozostaje dostępne.
          }
        } else {
          cardVideo.pause();
        }
        updateCard();
      };

      card.querySelectorAll<HTMLElement>("[data-card-toggle]").forEach((button) => {
        button.addEventListener("click", toggleCard);
      });

      cardVideo.addEventListener("play", updateCard);
      cardVideo.addEventListener("pause", updateCard);
      cardVideo.addEventListener("ended", updateCard);

      const updateDialog = () => {
        const playing = !dialogVideo.paused && !dialogVideo.ended;
        dialogShell?.classList.toggle("is-playing", playing);
        if (dialogIcon) dialogIcon.textContent = playing ? "Ⅱ" : "▶";
        if (dialogSmallIcon) dialogSmallIcon.textContent = playing ? "Ⅱ" : "▶";
      };

      const toggleDialog = async () => {
        if (dialogVideo.paused || dialogVideo.ended) {
          try {
            await dialogVideo.play();
          } catch {
            // Przycisk PLAY pozostaje dostępny.
          }
        } else {
          dialogVideo.pause();
        }
        updateDialog();
      };

      card.querySelectorAll<HTMLElement>("[data-dialog-toggle]").forEach((button) => {
        button.addEventListener("click", toggleDialog);
      });

      const openDialog = async () => {
        const continuePlaying = !cardVideo.paused && !cardVideo.ended;
        const currentTime = Number.isFinite(cardVideo.currentTime)
          ? cardVideo.currentTime
          : 0;

        cardVideo.pause();
        updateCard();

        try {
          dialogVideo.currentTime = currentTime;
        } catch {
          // Synchronizacja czasu nie jest krytyczna.
        }

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        } else {
          dialog.setAttribute("open", "");
        }

        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";

        if (continuePlaying) {
          try {
            await dialogVideo.play();
          } catch {
            // Ręczne wznowienie pozostaje dostępne.
          }
        }

        updateDialog();
      };

      const closeDialog = () => {
        const currentTime = Number.isFinite(dialogVideo.currentTime)
          ? dialogVideo.currentTime
          : cardVideo.currentTime;

        dialogVideo.pause();

        try {
          cardVideo.currentTime = currentTime;
        } catch {
          // Synchronizacja czasu nie jest krytyczna.
        }

        if (dialog.open && typeof dialog.close === "function") {
          dialog.close();
        } else {
          dialog.removeAttribute("open");
        }

        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
        updateDialog();
      };

      card.querySelector<HTMLElement>("[data-video-open]")?.addEventListener(
        "click",
        openDialog
      );

      card.querySelectorAll<HTMLElement>("[data-video-close]").forEach((button) => {
        button.addEventListener("click", closeDialog);
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeDialog();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeDialog();
      });

      dialogVideo.addEventListener("play", updateDialog);
      dialogVideo.addEventListener("pause", updateDialog);
      dialogVideo.addEventListener("ended", updateDialog);

      updateCard();
      updateDialog();
    });
  }
</script>
