---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/galeria/"
  structuredData={structuredData}
>
  <div class="gallery-page">
    <Header />

    <main>
      <section class="gallery-hero">
        <div class="gallery-glow gallery-glow-one" aria-hidden="true"></div>
        <div class="gallery-glow gallery-glow-two" aria-hidden="true"></div>

        <div class="container gallery-hero-grid">
          <div class="gallery-hero-copy">
            <p class="section-kicker">Galeria makijażu permanentnego</p>

            <h1>
              <span class="gallery-turquoise-text">Realne efekty PMU</span>
              pokazane bez zbędnego tekstu.
            </h1>

            <p class="gallery-hero-lead">
              Brwi, Silky Hairstroke Brows, usta, kreski i filmy z procesu pracy.
              Zobacz detale pigmentacji, pełniejsze kadry i różne kierunki efektu.
            </p>

            <div class="gallery-hero-actions" aria-label="Galeria PMU — szybkie działania">
              <a class="button-primary" href="#galeria-brwi">
                Zobacz efekty <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>
          </div>

          <aside class="gallery-hero-card" aria-label="Portfolio PMU">
            <p class="gallery-card-label">PMU</p>
            <h2>Portfolio ma pokazać styl pracy, nie ilość zdjęć.</h2>
            <p>
              Naturalne proporcje, czysty detal, miękki kolor i efekt,
              który dobrze wygląda w kontekście całej twarzy.
            </p>
          </aside>
        </div>
      </section>

      <section class="gallery-proof-section" aria-label="Zakres galerii">
        <div class="container gallery-proof-grid">
          <div>
