---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import GalleryPhoto from "../components/GalleryPhoto.astro";
import { Image } from "astro:assets";
import { guideAuthorPortrait } from "../data/guide-series-01";
import { booksyUrl, pageTitle, pageDescription, sections, galleryAreas, videoGalleryItems, faqItems, structuredData } from "../data/pmu-gallery";
import thumbnails from "../data/pmu-gallery-thumbnails.json";
import "../styles/pmu-gallery.css";
const previewCount = 6;
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/galeria/" structuredData={structuredData} inlineGuideAssistant>
  <Header compact />
  <a class="pmu-gallery-skip" href="#galeria-silky">Przejdź do zdjęć</a>
  <main class="pmu-gallery">
    <div class="pmu-gallery-shell">
      <nav class="pmu-gallery-breadcrumbs" aria-label="Okruszki nawigacyjne">
        <a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Galeria PMU</span>
      </nav>
      <section class="pmu-gallery-intro" aria-labelledby="galeria-tytul">
        <div class="pmu-gallery-intro-copy">
          <p class="pmu-gallery-kicker">Galeria PMU · Bielsko-Biała</p>
          <h1 id="galeria-tytul">Galeria makijażu permanentnego.</h1>
          <p class="pmu-gallery-lead">Zobacz detal. Znajdź swój kierunek. Porównaj brwi Silky z metodą cienia, obejrzyj kreski i wybierz inspirację dla ust.</p>
          <a class="pmu-gallery-author" href="/makijaz-permanentny-bielsko/#boguslawa-herda">
            <Image src={guideAuthorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="lazy" decoding="async" />
            <span><strong>Bogusława Herda</strong><span>Makijaż permanentny · Powrót do natury</span></span>
          </a>
        </div>
        <nav class="pmu-gallery-overview" aria-label="Wybierz swój kierunek">
          <p class="pmu-gallery-kicker">Cztery kierunki. Twój wybór.</p>
          <ul>{galleryAreas.map((area) => <li><a href={area.href}>
            <img src={area.image.thumb} srcset={area.image.srcset} sizes="64px" width="64" height="64" alt="" loading="eager" decoding="async" />
            <span><strong>{area.title}</strong><small>{area.text}</small></span><span class="pmu-gallery-overview-arrow" aria-hidden="true">↓</span>
          </a></li>)}</ul>
          <p class="pmu-gallery-overview-note">Otwórz wybrane zdjęcie, aby zobaczyć cały kadr.</p>
          <a class="pmu-gallery-primary" href="/cennik-makijaz-permanentny/">Porównaj ceny zabiegów <span aria-hidden="true">→</span></a>
        </nav>
      </section>
      <nav class="pmu-gallery-nav" aria-label="Kategorie galerii">
        {sections.map((section) => <a href={`#${section.id}`}>{section.label}<span>{section.items.length}</span></a>)}
        <a href="#galeria-wideo">Wideo<span>{videoGalleryItems.length}</span></a>
      </nav>

      {sections.map((section, sectionIndex) => (
        <section class="pmu-gallery-section" id={section.id} data-pmu-gallery-section data-media-label={section.label}
          data-service-href={section.serviceHref} data-service-label={section.serviceLabel} aria-labelledby={`${section.id}-tytul`}>
          <div class="pmu-gallery-section-heading">
            <div><p class="pmu-gallery-kicker">{section.label}</p><h2 id={`${section.id}-tytul`}>{section.title}</h2><p>{section.text}</p></div>
            <a href={section.serviceHref}>{section.serviceLabel} <span aria-hidden="true">→</span></a>
          </div>
          <div class="pmu-gallery-grid">
            {section.items.slice(0, previewCount).map((image, index) => <GalleryPhoto image={image} priority={false} contain={section.id === "galeria-szkolenia"} />)}
          </div>
          {section.items.length > previewCount && (
            <details class="pmu-gallery-more">
              <summary><span class="pmu-gallery-closed-label">Pokaż pozostałe zdjęcia: {section.items.length - previewCount}</span><span class="pmu-gallery-open-label">Zwiń dodatkowe zdjęcia</span><span class="pmu-gallery-plus" aria-hidden="true">+</span></summary>
              <div class="pmu-gallery-grid">{section.items.slice(previewCount).map((image) => <GalleryPhoto image={image} contain={section.id === "galeria-szkolenia"} />)}</div>
            </details>
          )}
        </section>
      ))}

      <section class="pmu-gallery-section pmu-gallery-videos" id="galeria-wideo" data-pmu-gallery-section data-media-label="Wideo"
        data-service-href="/makijaz-permanentny-bielsko/" data-service-label="Zobacz ofertę PMU" aria-labelledby="galeria-wideo-tytul">
        <div class="pmu-gallery-section-heading"><div><p class="pmu-gallery-kicker">Z bliska</p><h2 id="galeria-wideo-tytul">Ruch, detal i praca w gabinecie.</h2><p>Otwórz wybrany film. Odtwarzanie rozpoczyna się po kliknięciu; możesz je zatrzymać i wrócić do galerii.</p></div></div>
        <div class="pmu-gallery-video-grid">
          {videoGalleryItems.map((video) => {
            const media = thumbnails[video.poster as keyof typeof thumbnails];
            return <figure class="pmu-gallery-video-card"><a href={video.src} target="_blank" rel="noopener" data-pmu-video data-media-caption={video.title} data-media-poster={video.poster} aria-label={`Odtwórz film: ${video.title}`}>
              <img src={media.thumb} srcset={media.srcset} sizes="(max-width: 640px) calc(100vw - 36px), (max-width: 900px) calc((100vw - 74px) / 2), 353px" width={media.width} height={media.height} alt="" loading="lazy" decoding="async" />
              <span class="pmu-gallery-play" aria-hidden="true">▶</span><span class="pmu-gallery-video-label">Obejrzyj film</span>
            </a><figcaption>{video.title}</figcaption></figure>;
          })}
        </div>
      </section>

      <section class="pmu-gallery-decision" aria-labelledby="galeria-decyzja">
        <div><p class="pmu-gallery-kicker">Od inspiracji do wizyty</p><h2 id="galeria-decyzja">Podoba Ci się ten kierunek?</h2><p>Zobacz ceny lub sprawdź terminy. Projekt dobieramy do Twojej twarzy i oczekiwań — zdjęcie może być początkiem rozmowy.</p><a class="pmu-gallery-inline" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Masz wcześniejszą pigmentację? Opisz swoją sytuację →</a></div>
        <div class="pmu-gallery-decision-actions"><a class="pmu-gallery-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="pmu-gallery-secondary" href="/cennik-makijaz-permanentny/">Zobacz cennik PMU →</a><a class="pmu-gallery-inline" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div>
      </section>
      <section class="pmu-gallery-faq" aria-labelledby="galeria-faq">
        <p class="pmu-gallery-kicker">Warto wiedzieć</p><h2 id="galeria-faq">Jak oglądać efekty PMU?</h2>
        {faqItems.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
      </section>
      <div class="pmu-gallery-social"><p>Więcej prac i aktualności z gabinetu</p><div><a href="https://www.instagram.com/permanentnybielsko" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.facebook.com/PermanentnyBielsko" target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href="/poradnik/">Poradnik PMU →</a></div></div>
      <GuideAssistant />
    </div>

    <dialog class="pmu-gallery-dialog" data-pmu-gallery-dialog aria-labelledby="pmu-gallery-dialog-title" aria-describedby="pmu-gallery-dialog-caption">
      <div class="pmu-gallery-dialog-shell">
        <div class="pmu-gallery-dialog-head"><p id="pmu-gallery-dialog-title" data-pmu-dialog-counter aria-live="polite">Podgląd galerii</p><button type="button" data-pmu-dialog-close aria-label="Zamknij podgląd" autofocus>×</button></div>
        <div class="pmu-gallery-dialog-stage" data-pmu-dialog-stage>
          <img data-pmu-dialog-image alt="" hidden decoding="async" />
          <video data-pmu-dialog-video hidden controls playsinline muted preload="none"></video>
          <p data-pmu-dialog-error hidden role="status">Nie udało się wczytać materiału. Możesz otworzyć oryginalny plik poniżej.</p>
        </div>
        <p class="pmu-gallery-dialog-caption" id="pmu-gallery-dialog-caption" data-pmu-dialog-caption></p>
        <div class="pmu-gallery-dialog-controls"><button type="button" data-pmu-dialog-prev aria-label="Poprzedni materiał">←</button><a data-pmu-dialog-original target="_blank" rel="noopener">Otwórz pełne zdjęcie ↗</a><button type="button" data-pmu-dialog-next aria-label="Następny materiał">→</button></div>
        <a class="pmu-gallery-dialog-service" data-pmu-dialog-service>Zobacz ofertę →</a>
      </div>
    </dialog>
  </main>
  <Footer />
  <script>import "../scripts/pmu-gallery";</script>
</Layout>
