<script is:inline>
  (() => {
    const formElement = document.querySelector("[data-pmu-lead-form]");

    if (!(formElement instanceof HTMLFormElement)) {
      return;
    }

    const form = formElement;
    const statusElement = form.querySelector("[data-pmu-lead-status]");
    const endpoint = "https://formspree.io/f/mjgnwzvp";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButtonElement = form.querySelector('button[type="submit"]');
      const submitButton =
        submitButtonElement instanceof HTMLButtonElement
          ? submitButtonElement
          : null;

      const status =
        statusElement instanceof HTMLElement
          ? statusElement
          : null;

      const formData = new FormData(form);

      formData.set("page", window.location.href);
      formData.set("_subject", "Nowe zapytanie PMU — Permanentny Bielsko");

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Wysyłanie...";
      }

      if (status) {
        status.hidden = false;
        status.textContent = "Wysyłamy zapytanie...";
      }

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json"
          }
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          const errors =
            data &&
            typeof data === "object" &&
            Array.isArray(data.errors)
              ? data.errors
              : [];

          const formspreeMessage = errors
            .map((item) => {
              if (
                item &&
                typeof item === "object" &&
                "message" in item &&
                typeof item.message === "string"
              ) {
                return item.message;
              }

              return "";
            })
            .filter(Boolean)
            .join(" ");

          throw new Error(
            formspreeMessage || "Nie udało się wysłać formularza."
          );
        }

        if (status) {
          status.textContent =
            "Dziękujemy. Formularz został wysłany. Gabinet skontaktuje się w sprawie kwalifikacji.";
        }

        form.reset();

        const gtag = window["gtag"];

        if (typeof gtag === "function") {
          gtag("event", "conversion", {
            send_to: "AW-18200277713/3I8RCPuF8NIcENHlyOZD",
            value: 1.0,
            currency: "PLN"
          });

          gtag("event", "pmu_lead_submit", {
