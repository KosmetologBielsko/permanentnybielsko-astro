---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import PmuLeadForm from "../components/PmuLeadForm.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import media from "../data/pmu-media-library.json";
import "../styles/pmu-landing.css";
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/";
const pageTitle =
  "Makijaż permanentny Bielsko-Biała | Brwi, usta i kreski";
const pageDescription =
  "Makijaż permanentny Bielsko-Biała u Bogusławy Herda. Naturalne brwi, usta i kreski, konsultacja i rysunek wstępny. Brwi od 1200 zł. Sprawdź terminy.";
const faqItems = [
  {
    question: "Czy makijaż permanentny może wyglądać naturalnie?",
    answer:
      "Tak. Naturalny efekt zależy od rysunku wstępnego, koloru, techniki, skóry i doświadczenia osoby wykonującej zabieg. Celem jest podkreślenie urody bez ciężkiej, graficznej formy."
  },
  {
    question: "Ile kosztuje makijaż permanentny w Bielsku-Białej?",
    answer:
      "Brwi permanentne kosztują od 1200 zł, makijaż permanentny ust 1400 zł, a kreski permanentne od 500 zł. Pełny zakres cen, odświeżeń i usuwania PMU znajduje się w cenniku."
  },
  {
    question: "Czy przed zabiegiem wykonywany jest rysunek wstępny?",
    answer:
      "Tak. Kształt, proporcje i kierunek pracy są omawiane przed pigmentacją. Dopiero po zaakceptowaniu planu przechodzimy do właściwego zabiegu."
  },
  {
    question: "Czy makijaż permanentny boli?",
    answer:
      "Odczucia są indywidualne i zależą od progu wrażliwości, okolicy zabiegowej oraz stanu skóry. Przebieg zabiegu i komfort klientki są omawiane przed rozpoczęciem pigmentacji."
  },
  {
    question: "Jak długo utrzymuje się makijaż permanentny?",
    answer:
      "Trwałość zależy między innymi od skóry, techniki, koloru, pielęgnacji, ekspozycji na słońce i metabolizmu pigmentu. Z czasem pigment stopniowo się rozjaśnia i może wymagać odświeżenia."
  },
  {
    question: "Czy można poprawić stary makijaż permanentny?",
    answer:
      "Czasem tak, ale stary pigment trzeba najpierw ocenić. Przy zbyt ciemnym, chłodnym, nierównym lub niekorzystnie ułożonym PMU może być potrzebne wcześniejsze rozjaśnienie albo usuwanie."
  },
  {
    question: "Kiedy wykonuje się korektę lub dopigmentowanie?",
    answer:
      "Korektę wykonuje się po wygojeniu skóry, gdy można realnie ocenić kolor, nasycenie i równomierność efektu. Ceny oznaczone w cenniku gwiazdką obejmują zabieg główny wraz z korektą do 2 miesięcy od zabiegu głównego."
  },
  {
    question: "Gdzie wykonywany jest makijaż permanentny?",
    answer:
      "Zabiegi wykonywane są w gabinecie Bogusławy Herda w Bielsku-Białej. Aktualne terminy można sprawdzić w Booksy, a w przypadku wątpliwości wysłać formularz kwalifikacji PMU."
  }
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    dateModified: "2026-09-14",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: "https://www.permanentnybielsko.com/images/dlaczego-boguslawa-herda-pmu.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Makijaż permanentny Bielsko-Biała",
    serviceType: "Makijaż permanentny",
    description:
      "Naturalny makijaż permanentny brwi, ust i kresek w Bielsku-Białej, poprzedzony konsultacją, analizą urody i rysunkiem wstępnym.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała"
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie"
      }
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny"
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Oferta makijażu permanentnego",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Brwi permanentne"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Makijaż permanentny ust"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Kreski permanentne"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta lub odświeżenie makijażu permanentnego"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];

const treatments = [
  { id: "brwi-cien", kicker: "Miękkie wypełnienie", title: "Brwi metodą cienia", price: "1200 zł", photo: media.cien[0], alt: "Brwi wykonane metodą cienia — miękkie wypełnienie kształtu", text: "Podkreślenie kształtu i miękkie nasycenie koloru. Intensywność dopasowujemy do skóry, urody i oczekiwanego efektu.", href: "/makijaz-permanentny-brwi/", cta: "Poznaj metodę cienia" },
  { id: "brwi-silky", kicker: "Włos maszynowy", title: "Silky Hairstroke Brows", price: "1400 zł", photo: media.silky[1], alt: "Silky Hairstroke Brows — brwi wykonane autorską techniką włosa maszynowego", text: "Autorska technika Bogusława Herda. Precyzyjnie pigmentowane włoski tworzą lekką strukturę brwi. Metodę poprzedza ocena skóry.", href: "/makijaz-permanentny-brwi/#silky-hairstroke-brows", cta: "Zobacz, czym jest Silky" },
  { id: "usta-pmu", kicker: "Kolor i kontur", title: "Usta permanentne", price: "1400 zł", photo: media.usta[22], alt: "Makijaż permanentny ust — różowy kolor i podkreślona naturalna linia ust", text: "Odświeżenie koloru i uporządkowanie konturu. Odcień dobieramy do naturalnej czerwieni wargowej oraz Twojej urody.", href: "/makijaz-permanentny-ust/", cta: "Poznaj pigmentację ust" },
  { id: "kreski-pmu", kicker: "Podkreślenie spojrzenia", title: "Kreski permanentne", price: "od 500 zł", photo: media.oczy[0], alt: "Górna kreska permanentna — podkreślenie oka przy linii rzęs", text: "Zagęszczenie linii rzęs, kreska dekoracyjna lub dolna. Zakres i cenę ustalamy po doborze rodzaju kreski do oka i powieki.", href: "/makijaz-permanentny-oczu/", cta: "Porównaj rodzaje kresek" },
];
const overview = [
  { label: "Brwi", note: "Cień lub włos maszynowy", price: "od 1200 zł", href: "#brwi-cien", photo: media.silky[1] },
  { label: "Usta", note: "Kolor dopasowany do Ciebie", price: "1400 zł", href: "#usta-pmu", photo: media.usta[22] },
  { label: "Kreski", note: "Dobór do oka i powieki", price: "od 500 zł", href: "#kreski-pmu", photo: media.oczy[0] },
];
const steps = [
  { number: "01", title: "Rozmowa i kwalifikacja", text: "Oczekiwania, skóra, wcześniejsze pigmentacje i przeciwwskazania. Ustalamy, czy i jaki zabieg będzie właściwy." },
  { number: "02", title: "Rysunek wstępny", text: "Planujemy kształt, proporcje, kolor i intensywność. Pigmentację poprzedza akceptacja kierunku pracy." },
  { number: "03", title: "Pigmentacja i pielęgnacja", text: "Pracujemy zgodnie z ustalonym planem. Po zabiegu otrzymujesz zalecenia dotyczące pielęgnacji i gojenia." },
  { number: "04", title: "Ocena po wygojeniu", text: "Oceniamy kolor i równomierność efektu. Korekta zabiegu głównego objętego gwiazdką w cenniku odbywa się do 2 miesięcy." },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/makijaz-permanentny-bielsko/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-landing-skip" href="#zakres-zabiegow">Przejdź do zabiegów i cen</a>
  <main class="pmu-landing">
    <div class="pmu-landing-shell">
      <nav class="pmu-landing-breadcrumbs" aria-label="Okruszki nawigacyjne"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Makijaż permanentny</span></nav>
      <section class="pmu-landing-intro" aria-labelledby="pmu-tytul">
        <div>
          <p class="pmu-landing-kicker">Brwi · usta · kreski</p>
          <h1 id="pmu-tytul">Makijaż permanentny w Bielsku-Białej — <span>naturalny efekt dopasowany do twarzy.</span></h1>
          <p class="pmu-landing-lead">Brwi, usta i kreski permanentne poprzedzone konsultacją i rysunkiem wstępnym. Dobieramy kształt, kolor i intensywność do Twojej urody, skóry i codziennego stylu.</p>
          <a class="pmu-landing-author" href="#boguslawa-herda">
            <Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" />
            <span><strong>Bogusława Herda</strong><span>Wicemistrzyni świata · trenerka PMU</span></span>
          </a>
          <a class="pmu-landing-intro-link" href="#kwalifikacja-pmu">Masz stare PMU lub pytanie? Opisz swoją sytuację <span aria-hidden="true">↓</span></a>
        </div>
        <aside class="pmu-landing-overview" aria-labelledby="pmu-skrot">
          <p class="pmu-landing-kicker">Twój kierunek w 20 sekund</p>
          <h2 id="pmu-skrot">Co chcesz podkreślić?</h2>
          <ul>{overview.map(item => <li><a href={item.href}>
            <img src={item.photo.srcset.split(",")[0].trim().split(" ")[0]} width="56" height="56" alt="" loading="eager" decoding="async" />
            <span><strong>{item.label}</strong><small>{item.note}</small></span><span class="pmu-landing-overview-amount">{item.price}</span>
          </a></li>)}</ul>
          <p class="pmu-landing-overview-note">Ceny głównych zabiegów oznaczonych gwiazdką obejmują korektę po wygojeniu, <strong>do 2 miesięcy</strong>.</p>
          <a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a>
        </aside>
      </section>
      <nav class="pmu-landing-nav" aria-label="Przejdź do wybranej części strony">
        <a href="#zakres-zabiegow">Zabiegi i zdjęcia ↓</a><a href="#boguslawa-herda">Doświadczenie ↓</a><a href="#jak-pracuje">Jak wygląda zabieg ↓</a><a href="#kwalifikacja-pmu">Formularz PMU ↓</a><a href="#pytania-pmu">Pytania i odpowiedzi ↓</a>
      </nav>
      <section class="pmu-landing-section" id="zakres-zabiegow" aria-labelledby="pmu-zabiegi">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Dobierz swój efekt</p><h2 id="pmu-zabiegi">Podkreślamy rysy.<br />Zaczynamy od Ciebie.</h2><p>Brwi mogą uporządkować oprawę oka, usta zyskać wyraźniejszy kolor, a kreska podkreślić spojrzenie. Zobacz różnice i wybierz obszar, który Cię interesuje.</p></div>
        <div class="pmu-landing-treatments">{treatments.map(item => <article class="pmu-landing-treatment" id={item.id}>
          <a class="pmu-landing-treatment-photo" href={item.href} aria-label={item.cta}><img src={item.photo.thumb} srcset={item.photo.srcset} sizes="(max-width:360px) calc(100vw - 36px), (max-width:640px) calc((100vw - 50px) / 2), (max-width:900px) calc((100vw - 72px) / 2), 260px" width={item.photo.width} height={item.photo.height} alt={item.alt} loading="lazy" decoding="async" /></a>
          <div class="pmu-landing-treatment-copy"><p class="pmu-landing-kicker">{item.kicker}</p><h3>{item.title}</h3><p>{item.text}</p><strong class="pmu-landing-treatment-price">{item.price}</strong><a href={item.href}>{item.cta} <span aria-hidden="true">→</span></a></div>
        </article>)}</div>
        <div class="pmu-landing-links"><a href="/galeria/">Zobacz więcej prac w galerii →</a><a href="/cennik-makijaz-permanentny/">Pełny cennik i zasady korekt →</a></div>
      </section>
      <section class="pmu-landing-expert pmu-landing-section" id="boguslawa-herda" aria-labelledby="pmu-doswiadczenie">
        <figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — linergistka i trenerka makijażu permanentnego" width={720} widths={[240,360,540,720]} sizes="(max-width:640px) 200px, (max-width:900px) 280px, 340px" format="webp" quality={82} loading="lazy" decoding="async" /><figcaption>Bogusława Herda<br /><span>Linergistka · kosmetolog · trenerka PMU</span></figcaption></figure>
        <div>
          <p class="pmu-landing-kicker">02 / Dlaczego Bogusława Herda</p>
          <h2 id="pmu-doswiadczenie">Doświadczenie ma znaczenie przy każdej decyzji.</h2>
          <p><strong>Bogusława Herda</strong> to 8-krotna mistrzyni makijażu permanentnego, w tym wicemistrzyni świata, kosmetolog z ponad 10-letnim doświadczeniem i czterema ukończonymi studiami podyplomowymi. Europejski trener Long-Time-Liner® i autorka techniki Silky Hairstroke Brows.</p>
          <dl class="pmu-landing-credentials"><div><dt>8×</dt><dd>Mistrzyni PMU, w tym wicemistrzyni świata</dd></div><div><dt>10+ lat</dt><dd>Praktyki gabinetowej i doświadczenia</dd></div><div><dt>4</dt><dd>Ukończone studia podyplomowe</dd></div><div><dt>Long-Time-Liner®</dt><dd>Europejski trener marki</dd></div></dl>
          <blockquote class="pmu-landing-stance"><p>W gabinecie w Bielsku-Białej nie pracuję według jednego schematu. Oceniam skórę, proporcje twarzy, wcześniejsze pigmentacje i oczekiwany efekt, a dopiero później dobieram technikę, kolor i intensywność. Czasem najlepszą decyzją jest delikatniejszy efekt, praca etapami albo wcześniejsze rozjaśnienie starego PMU.</p><footer>Bogusława Herda · podejście do pracy</footer>

<!-- PMU-LANDING-BOOKSY-PROOF -->
<a
  class="pmu-landing-review-inline"
  href={booksyUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Przeczytaj opinie klientek Bogusława Herda w Booksy"
>
  <span class="pmu-landing-review-star" aria-hidden="true">★</span>

  <span class="pmu-landing-review-copy">
    <strong>5.0 w Booksy</strong>
    <span>1200+ opinii klientek</span>
  </span>

  <span class="pmu-landing-review-link">
    Przeczytaj opinie ↗
  </span>
</a>
</blockquote>
          <details class="pmu-landing-more"><summary>Międzynarodowa edukacja i działalność społeczna <span aria-hidden="true">+</span></summary><div><p><strong>2026:</strong> jurorka i prelegentka New Generation Congress &amp; Competition w Lyonie oraz jurorka i spikerka PMU Indonesia 2026.</p><p>Ambasadorka akcji <strong>#SercemMalowane</strong> oraz inicjatywy <strong>Koronacja</strong>, w ramach których wykonuje bezpłatne zabiegi dla osób po chorobach i znajdujących się w trudnej sytuacji życiowej.</p><div class="pmu-landing-links"><a href="/szkolenie-makijaz-permanentny/">Poznaj szkolenia →</a><a href="/sercemmalowane/">O akcji #SercemMalowane →</a></div></div></details>
        </div>
      </section>
      <section class="pmu-landing-section" id="jak-pracuje" aria-labelledby="pmu-proces">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">03 / Spokojnie, krok po kroku</p><h2 id="pmu-proces">Najpierw rozmowa i rysunek.<br />Później pigmentacja.</h2><p>Analiza twarzy, skóry i wcześniejszych pigmentacji pozwala dobrać kształt, technikę, kolor i intensywność bez pracy według jednego schematu.</p></div>
        <div class="pmu-landing-process"><ol class="pmu-landing-steps">{steps.map(item => <li><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol><figure class="pmu-landing-video"><video controls playsinline preload="none" poster="/video/proces-makijazu-permanentnego-boguslawa-herda-poster.webp" width="720" height="1280" aria-label="Film z gabinetu Bogusława Herda"><source src="/video/proces-makijazu-permanentnego-boguslawa-herda.mp4" type="video/mp4" />Twoja przeglądarka nie obsługuje filmu.</video><figcaption>Krótki film z gabinetu · 21 sekund</figcaption></figure></div>
      </section>
      <aside class="pmu-landing-callout" id="stare-pmu" aria-labelledby="pmu-stare"><div><p class="pmu-landing-kicker">Masz wcześniejszą pigmentację?</p><h2 id="pmu-stare">Najpierw oceńmy stare PMU.</h2><p>Nie każdą starą pigmentację warto od razu przykrywać nową. Przy niekorzystnym kolorze, nasyceniu lub kształcie pierwszym krokiem może być konsultacja, rozjaśnienie albo odłożenie zabiegu.</p></div><div class="pmu-landing-links"><a href="#kwalifikacja-pmu">Opisz swój przypadek ↓</a><a href="/usuwanie-makijazu-permanentnego/">Sprawdź możliwości usuwania →</a></div></aside>
      <section class="pmu-landing-qualification pmu-landing-section" id="kwalifikacja-pmu" aria-labelledby="pmu-kwalifikacja">
        <div><p class="pmu-landing-kicker">04 / Zacznijmy od Twojego pytania</p><h2 id="pmu-kwalifikacja">Nie musisz znać nazwy zabiegu.</h2><p>Wyślij krótkie zapytanie, jeśli masz stary makijaż permanentny, wahasz się między metodami albo chcesz najpierw sprawdzić, czy pigmentacja będzie właściwym rozwiązaniem.</p><p class="pmu-landing-qualification-note">Napisz, jaki obszar Cię interesuje, czy był już pigmentowany i co chcesz zmienić. Odpowiemy w sprawie kwalifikacji i dalszego kroku.</p><a class="pmu-landing-secondary" href="tel:+48730900125">Wolisz zadzwonić? 730 900 125</a></div><PmuLeadForm pageUrl={pageUrl} />
      </section>
      <section class="pmu-landing-faq" id="pytania-pmu" aria-labelledby="pmu-faq"><p class="pmu-landing-kicker">Przed pierwszą wizytą</p><h2 id="pmu-faq">Co warto wiedzieć o makijażu permanentnym?</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</section>
      <section class="pmu-landing-booking" id="kontakt" aria-labelledby="pmu-kontakt"><div><p class="pmu-landing-kicker">Twój następny krok</p><h2 id="pmu-kontakt">Wybierz termin.<br />Albo zacznij od rozmowy.</h2><p>Spotkajmy się w gabinecie przy ul. Barlickiego 5/23 w Bielsku-Białej. Ustalimy zakres pracy i efekt dopasowany do Ciebie.</p></div><div class="pmu-landing-booking-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-landing-text-link" href="/kontakt/">Adres, dojazd i kontakt →</a></div></section>
      <div class="pmu-landing-links"><a href="/poradnik/">Przygotowanie, gojenie i wybór metody — poradnik PMU →</a><a href="#boguslawa-herda">Poznaj doświadczenie Bogusława Herda ↑</a></div>
      <GuideAssistant />
    </div>
  </main>
  <Footer />
</Layout>
