---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProcessVideo from "../components/ProcessVideo.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/";

const pageTitle =
  "Makijaż permanentny Bielsko-Biała | Brwi, usta i kreski";

const pageDescription =
  "Makijaż permanentny Bielsko-Biała u Bogusławy Herda. Naturalne brwi, usta i kreski, konsultacja i rysunek wstępny. Brwi od 1200 zł. Sprawdź terminy.";

const faqItems = [
  {
    question: "Czy makijaż permanentny może wyglądać naturalnie?",
    answer:
      "Tak. Naturalny efekt zależy od rysunku wstępnego, koloru, techniki, skóry i doświadczenia osoby wykonującej zabieg. Celem jest podkreślenie urody bez ciężkiej, graficznej formy."
  },
  {
    question: "Ile kosztuje makijaż permanentny w Bielsku-Białej?",
    answer:
      "Brwi permanentne kosztują od 1200 zł, makijaż permanentny ust 1400 zł, a kreski permanentne od 500 zł. Pełny zakres cen, odświeżeń i usuwania PMU znajduje się w cenniku."
  },
  {
    question: "Czy przed zabiegiem wykonywany jest rysunek wstępny?",
    answer:
      "Tak. Kształt, proporcje i kierunek pracy są omawiane przed pigmentacją. Dopiero po zaakceptowaniu planu przechodzimy do właściwego zabiegu."
  },
  {
    question: "Czy makijaż permanentny boli?",
    answer:
      "Odczucia są indywidualne i zależą od progu wrażliwości, okolicy zabiegowej oraz stanu skóry. Przebieg zabiegu i komfort klientki są omawiane przed rozpoczęciem pigmentacji."
  },
  {
    question: "Jak długo utrzymuje się makijaż permanentny?",
    answer:
      "Trwałość zależy między innymi od skóry, techniki, koloru, pielęgnacji, ekspozycji na słońce i metabolizmu pigmentu. Z czasem pigment stopniowo się rozjaśnia i może wymagać odświeżenia."
  },
  {
    question: "Czy można poprawić stary makijaż permanentny?",
    answer:
      "Czasem tak, ale stary pigment trzeba najpierw ocenić. Przy zbyt ciemnym, chłodnym, nierównym lub niekorzystnie ułożonym PMU może być potrzebne wcześniejsze rozjaśnienie albo usuwanie."
  },
  {
    question: "Kiedy wykonuje się korektę lub dopigmentowanie?",
    answer:
      "Korektę wykonuje się po wygojeniu skóry, gdy można realnie ocenić kolor, nasycenie i równomierność efektu. Ceny oznaczone w cenniku gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące."
  },
  {
    question: "Gdzie wykonywany jest makijaż permanentny?",
    answer:
      "Zabiegi wykonywane są w gabinecie Bogusławy Herda w Bielsku-Białej. Aktualne terminy można sprawdzić w Booksy, a w przypadku wątpliwości wysłać formularz kwalifikacji PMU."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: "https://www.permanentnybielsko.com/images/hero-boguslawa-herda-pmu-cutout.webp"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Makijaż permanentny Bielsko-Biała",
    serviceType: "Makijaż permanentny",
    description:
      "Naturalny makijaż permanentny brwi, ust i kresek w Bielsku-Białej, poprzedzony konsultacją, analizą urody i rysunkiem wstępnym.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała"
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie"
      }
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny"
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Oferta makijażu permanentnego",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Brwi permanentne"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Makijaż permanentny ust"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Kreski permanentne"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta lub odświeżenie makijażu permanentnego"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/makijaz-permanentny-bielsko/"
  structuredData={structuredData}
>
  <div class="pmu-service-page">
    <Header />

    <main>
      <section class="pmu-hero">
        <div class="pmu-glow pmu-glow-one" aria-hidden="true"></div>
        <div class="pmu-glow pmu-glow-two" aria-hidden="true"></div>

        <div class="container pmu-hero-grid">
          <div class="pmu-hero-copy">
            <p class="section-kicker">Makijaż permanentny Bielsko-Biała</p>

            <h1>
              <span class="pmu-hero-gold-text">Makijaż permanentny w Bielsku-Białej</span>
              — naturalny efekt dopasowany do twarzy.
            </h1>

            <p class="pmu-hero-lead">
              Brwi, usta i kreski permanentne poprzedzone konsultacją i rysunkiem wstępnym.
              Jeśli nie wiesz, która opcja będzie właściwa, wyślij krótkie zapytanie — pomożemy
              dobrać zabieg przed rezerwacją.
            </p>

            <div class="pmu-hero-actions" aria-label="Szybki kontakt i rezerwacja">
              <a class="button-primary" href="#kwalifikacja-pmu">
                Formularz PMU <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Sprawdź terminy w Booksy"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-secondary"
                href="tel:+48730900125"
                aria-label="Zadzwoń do gabinetu Bogusławy Herda"
              >
                Zadzwoń
              </a>
            </div>

            <p class="pmu-hero-contact-note">
              Masz stary makijaż permanentny albo nie wiesz, czy potrzebujesz pigmentacji,
              korekty czy usuwania? Najpierw wyślij formularz kwalifikacji.
            </p>
          </div>

          <aside class="pmu-hero-card" aria-label="Podejście do makijażu permanentnego">
            <p class="pmu-card-label" aria-hidden="true">PMU</p>
            <h2>Najpierw decyzja. Dopiero później pigmentacja.</h2>
            <p>
              Analiza twarzy, skóry i wcześniejszych pigmentacji pozwala dobrać kształt,
              technikę, kolor i intensywność bez pracy według jednego schematu.
            </p>
          </aside>
        </div>
      </section>

      <section class="pmu-proof-section" aria-label="Doświadczenie i specjalizacja">
        <div class="container pmu-proof-grid">
          <div>
            <strong>Wicemistrzyni świata</strong>
            <span>doświadczenie konkursowe PMU</span>
          </div>

          <div>
            <strong>Trenerka Long-Time-Liner®</strong>
            <span>standard edukacji i precyzji</span>
          </div>

          <div>
            <strong>Silky Hairstroke Brows</strong>
            <span>autorskie podejście do brwi</span>
          </div>

          <div>
            <strong>Bielsko-Biała</strong>
            <span>gabinet i konsultacje na miejscu</span>
          </div>
        </div>
      </section>

      <section class="pmu-services-section" id="zakres-zabiegow">
        <div class="container">
          <div class="pmu-section-heading">
            <p class="section-kicker">Wybierz obszar</p>
            <h2>Brwi, usta czy kreski? Zacznij od efektu, którego naprawdę potrzebujesz.</h2>
            <p>
              Każdy obszar wymaga innego podejścia. Wybierz usługę, aby zobaczyć szczegóły,
              przykłady efektów i informacje o zabiegu.
            </p>
          </div>

          <div
            class="pmu-service-image-grid"
            aria-label="Zakres zabiegów makijażu permanentnego"
          >
            <a
              class="pmu-service-image-card"
              href="/makijaz-permanentny-brwi/"
              aria-label="Zobacz brwi permanentne"
            >
              <img
                src="/images/oferta-brwi-permanentne.webp?v=20260709-v2"
                alt="Brwi permanentne — naturalna oprawa oka i miękki kształt dopasowany do twarzy"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 860px) calc(100vw - 32px), min(560px, 46vw)"
              />
            </a>

            <a
              class="pmu-service-image-card"
              href="/silky-hairstroke-brows/"
              aria-label="Zobacz Silky Hairstroke Brows"
            >
              <img
                src="/images/oferta-silky-hairstroke-brows-mobile.webp?v=20260709-v2"
                alt="Silky Hairstroke Brows — autorska metoda włosa maszynowego dla realistycznego efektu brwi"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 860px) calc(100vw - 32px), min(560px, 46vw)"
              />
            </a>

            <a
              class="pmu-service-image-card"
              href="/makijaz-permanentny-ust/"
              aria-label="Zobacz makijaż permanentny ust"
            >
              <img
                src="/images/oferta-usta-permanentne.webp?v=20260709-v2"
                alt="Makijaż permanentny ust — subtelne odświeżenie koloru i wyrównanie konturu"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 860px) calc(100vw - 32px), min(560px, 46vw)"
              />
            </a>

            <a
              class="pmu-service-image-card"
              href="/makijaz-permanentny-oczu/"
              aria-label="Zobacz kreski permanentne"
            >
              <img
                src="/images/oferta-kreski-permanentne.webp?v=20260709-v2"
                alt="Kreski permanentne — zagęszczenie linii rzęs i podkreślenie spojrzenia"
                width="1448"
                height="1086"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 860px) calc(100vw - 32px), min(560px, 46vw)"
              />
            </a>
          </div>

          <div class="pmu-price-strip" aria-label="Najważniejsze ceny makijażu permanentnego">
            <div>
              <span>Brwi</span>
              <strong>od 1200 zł</strong>
            </div>
            <div>
              <span>Usta</span>
              <strong>1400 zł</strong>
            </div>
            <div>
              <span>Kreski</span>
              <strong>od 500 zł</strong>
            </div>
            <a href="/cennik-makijaz-permanentny/">
              Pełny cennik <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="pmu-portrait-section" aria-label="Dla kogo jest makijaż permanentny">
        <div class="container pmu-portrait-card">
          <div class="pmu-portrait-copy">
            <p class="section-kicker">Dla kogo jest PMU?</p>
            <h2>Podkreślamy rysy. Nie zmieniamy twarzy.</h2>
            <p>
              Brwi mogą uporządkować oprawę oka, pigmentacja ust wyrównać kolor i kontur,
              a odpowiednio dobrana kreska subtelnie zagęścić linię rzęs. Zakres pracy
              dobierany jest do urody, skóry, mimiki i codziennego stylu.
            </p>
            <p>
              Jeśli masz wcześniejszy makijaż permanentny, najpierw oceniamy jego kolor,
              nasycenie i kształt. Nie każdą starą pigmentację warto od razu przykrywać nową.
            </p>

            <div class="pmu-portrait-points" aria-label="Najważniejsze elementy planowania PMU">
              <span>analiza twarzy</span>
              <span>rysunek wstępny</span>
              <span>dobór pigmentu</span>
              <span>kwalifikacja starego PMU</span>
            </div>
          </div>

          <figure class="pmu-portrait-photo">
            <img
              src="/images/portret-boguslawa-herda-naturalny-pmu.webp"
              alt="Bogusława Herda — makijaż permanentny Bielsko-Biała"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="pmu-process-section" aria-label="Jak wygląda zabieg makijażu permanentnego">
        <div class="container">
          <div class="pmu-process-feature-row">
            <div class="pmu-process-feature-card">
              <p class="section-kicker">Proces</p>
              <h2>Nie zaczynamy od pigmentu. Zaczynamy od rozmowy i rysunku.</h2>
              <p>
                Przed zabiegiem ustalamy oczekiwania, oceniamy skórę i planujemy kształt.
                Dopiero po zaakceptowaniu kierunku pracy przechodzimy do pigmentacji.
              </p>
            </div>

            <div class="pmu-process-video-shell">
              <ProcessVideo />
            </div>

            <div class="pmu-process-mini-list">
              <div>
                <strong>1. Konsultacja</strong>
                <span>oczekiwania, skóra, wcześniejsze zabiegi i przeciwwskazania</span>
              </div>

              <div>
                <strong>2. Rysunek wstępny</strong>
                <span>kształt, proporcje i kierunek pracy przed pigmentacją</span>
              </div>

              <div>
                <strong>3. Pigmentacja i gojenie</strong>
                <span>kontrola nasycenia oraz ocena efektu po wygojeniu</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="pmu-lead-section" id="kwalifikacja-pmu">
        <div class="container pmu-lead-card">
          <div class="pmu-lead-copy">
            <p class="section-kicker">Kwalifikacja PMU</p>
            <h2>Nie jesteś pewna, jaki zabieg wybrać?</h2>
            <p>
              Wyślij krótkie zapytanie. To najlepsza opcja, jeśli masz stary makijaż
              permanentny, wahasz się między kilkoma zabiegami albo chcesz najpierw
              sprawdzić, czy pigmentacja będzie właściwym rozwiązaniem.
            </p>

            <div class="pmu-lead-actions">
              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-secondary"
                href="tel:+48730900125"
                aria-label="Zadzwoń do gabinetu Bogusławy Herda"
              >
                Zadzwoń: 730 900 125
              </a>
            </div>
          </div>

          <form
            class="pmu-lead-form"
            action="https://formspree.io/f/mjgnwzvp"
            method="POST"
            data-pmu-lead-form
          >
            <div class="pmu-form-heading">
              <strong>Formularz PMU</strong>
              <span>Odpowiemy w sprawie kwalifikacji i dalszego kroku.</span>
            </div>

            <label>
              Imię
              <input
                type="text"
                name="name"
                autocomplete="name"
                required
              />
            </label>

            <label>
              Telefon
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                inputmode="tel"
                required
              />
            </label>

            <label>
              Jaki zabieg Cię interesuje?
              <select name="service">
                <option value="">Wybierz</option>
                <option>Brwi permanentne</option>
                <option>Usta permanentne</option>
                <option>Kreska permanentna</option>
                <option>Usuwanie PMU</option>
                <option>Nie wiem — potrzebuję konsultacji</option>
              </select>
            </label>

            <label>
              Czy był wcześniej makijaż permanentny?
              <select name="old_pmu">
                <option value="">Wybierz</option>
                <option>Tak</option>
                <option>Nie</option>
                <option>Nie jestem pewna</option>
              </select>
            </label>

            <label>
              Krótka wiadomość
              <textarea
                name="message"
                rows="4"
                placeholder="Np. mam stare brwi permanentne i nie wiem, czy można je odświeżyć."
              ></textarea>
            </label>

            <input
              class="pmu-lead-hidden"
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <input
              type="hidden"
              name="_subject"
              value="Nowe zapytanie PMU — Permanentny Bielsko"
            />

            <input
              type="hidden"
              name="page"
              value={pageUrl}
            />

            <label class="pmu-lead-consent">
              <input type="checkbox" name="consent" value="yes" required />
              <span>
                Wyrażam zgodę na kontakt w odpowiedzi na przesłane zapytanie.
              </span>
            </label>

            <button class="button-primary" type="submit">
              Wyślij formularz PMU
            </button>

            <p
              class="pmu-lead-status"
              data-pmu-lead-status
              role="status"
              aria-live="polite"
              hidden
            ></p>
          </form>
        </div>
      </section>

      <section class="pmu-expert-section" aria-label="Dlaczego Bogusława Herda">
        <div class="container pmu-expert-card">
          <figure class="pmu-expert-photo">
            <img
              src="/images/dlaczego-boguslawa-herda-pmu.webp"
              alt="Bogusława Herda — ekspertka makijażu permanentnego w Bielsku-Białej"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="pmu-expert-copy">
            <p class="section-kicker">Dlaczego Bogusława Herda</p>
            <h2>Doświadczenie ma znaczenie wtedy, gdy trzeba podjąć właściwą decyzję.</h2>
            <p>
              W makijażu permanentnym technika jest tylko częścią pracy. Równie ważne jest
              wyczucie proporcji, intensywności i momentu, w którym lepiej zrezygnować
              z mocniejszego efektu albo zaplanować zabieg etapami.
            </p>
            <p>
              Doświadczenie konkursowe, praca szkoleniowa oraz autorskie podejście
              Silky Hairstroke Brows przekładają się na sposób planowania każdej pigmentacji.
            </p>
          </div>
        </div>
      </section>

      <section class="pmu-safety-section">
        <div class="container pmu-safety-grid">
          <div class="pmu-safety-card">
            <p class="section-kicker">Bezpieczeństwo i kwalifikacja</p>
            <h2>Nie każdy zabieg trzeba wykonać od razu.</h2>
            <p>
              Przy starej pigmentacji, niekorzystnym kolorze albo problemach ze skórą
              najlepszym pierwszym krokiem może być konsultacja, rozjaśnienie PMU
              lub odłożenie nowego zabiegu.
            </p>
          </div>

          <div class="pmu-safety-list">
            <div>
              <strong>Stare pigmentacje</strong>
              <span>ocena koloru, nasycenia i możliwości wykonania nowej pracy</span>
            </div>
            <div>
              <strong>Dobór techniki</strong>
              <span>brwi pudrowe, włos maszynowy, usta, kreski albo korekta</span>
            </div>
            <div>
              <strong>Intensywność</strong>
              <span>efekt dopasowany do twarzy i codziennego stylu</span>
            </div>
            <div>
              <strong>Gojenie</strong>
              <span>zalecenia i dalszy plan omawiane po pigmentacji</span>
            </div>
          </div>
        </div>
      </section>

      <section class="pmu-faq-section">
        <div class="container">
          <div class="pmu-section-heading">
            <p class="section-kicker">Najczęstsze pytania</p>
            <h2>Co warto wiedzieć przed makijażem permanentnym?</h2>
          </div>

          <div class="pmu-faq-list">
            {faqItems.map((item) => (
              <details class="pmu-faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="pmu-faq-icon" aria-hidden="true"></span>
                </summary>
