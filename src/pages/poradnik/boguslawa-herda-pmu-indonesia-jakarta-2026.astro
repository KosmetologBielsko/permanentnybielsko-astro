---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GuideSeriesByline from "../../components/GuideSeriesByline.astro";
import { jakartaEvent, jakartaMedia } from "../../data/guide-events";
import IndonesiaVideo from "../../components/IndonesiaVideo.astro";
import IndonesiaPhoto from "../../components/IndonesiaPhoto.astro";
import IndonesiaMemories from "../../components/IndonesiaMemories.astro";
import memories from "../../data/indonesia-memories.json";
import photos from "../../data/indonesia-photos.json";
import "../../styles/guide-article.css";
import "../../styles/guide-events.css";
const site = "https://www.permanentnybielsko.com";
const pageUrl = site + jakartaEvent.href;
const socialImage = await getImage({ src: jakartaMedia.cover.src, width: 1200, format: "webp", quality: 90 });
const imageUrl = new URL(socialImage.src, site).href;
const sources = [
  {
    "title": "JPNN · 23 października 2026",
    "detail": "Frekwencja, kraje i program według informacji organizatorów.",
    "href": "https://jabar.jpnn.com/jabar-terkini/33941/pmu-indonesia-festival-2026-hadirkan-700-peserta-dari-24-negara"
  },
  {
    "title": "Metro TV · 26 października 2026",
    "detail": "Relacja po wydarzeniu: standardy pracy i kwalifikacje zawodowe.",
    "href": "https://www.metrotvnews.com/play/b3JC9R6l-pmu-indonesia-festival-2026-pemerintah-dan-pelaku-industri-genjot-standar-profesi"
  },
  {
    "title": "QVISION Academy",
    "detail": "Oficjalna strona akademii z Tajlandii.",
    "href": "https://qvisionpmu.com/en/home"
  },
  {
    "title": "Zapowiedź udziału w jury",
    "detail": "Archiwalny plakat organizatora: Bogusława Herda, PMU Judge.",
    "href": "https://www.instagram.com/p/DP20aRbEkjJ/"
  }
];
const structuredData = [
  { "@context": "https://schema.org", "@type": "Article", "@id": pageUrl + "#article", url: pageUrl,
    headline: jakartaEvent.title, description: jakartaEvent.description, image: [imageUrl],
    datePublished: "2026-09-29", dateModified: "2026-11-02", inLanguage: "pl-PL", articleSection: "Wydarzenia",
    author: { "@type": "Person", "@id": site + "/#person", name: "Bogusława Herda", url: site + "/makijaz-permanentny-bielsko/#boguslawa-herda" },
    publisher: { "@id": site + "/#localbusiness" }, mainEntityOfPage: { "@id": pageUrl + "#webpage" },
    citation: sources.filter(source => !source.href.includes("/share/")).map(source => source.href) },
  { "@context": "https://schema.org", "@type": "WebPage", "@id": pageUrl + "#webpage", url: pageUrl,
    name: jakartaEvent.title, primaryImageOfPage: { "@type": "ImageObject", url: imageUrl }, isPartOf: { "@id": site + "/poradnik/wydarzenia/#collection" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement:
    [["Strona główna", "/"], ["Poradnik", "/poradnik/"], ["Wydarzenia", "/poradnik/wydarzenia/"], ["Dżakarta 2026", jakartaEvent.href]].map(([name, path], i) => ({ "@type": "ListItem", position: i + 1, name, item: site + path })) },
];
---
<Layout title={`${jakartaEvent.title} | Poradnik PMU`} description={jakartaEvent.description} canonicalPath={jakartaEvent.href} ogType="article" ogImage={socialImage.src} ogImageAlt={jakartaMedia.cover.alt} structuredData={structuredData} showGuideSocial={false}>
<a class="event-skip" href="#o-festiwalu">Przejdź do artykułu</a><Header compact />
<main class="pmu-guide-v3 pmu-event-article">
  <header class="expert-article-hero"><div class="container">
    <nav class="event-breadcrumbs" aria-label="Ścieżka strony"><a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/poradnik/">Poradnik</a><span aria-hidden="true">/</span><a href="/poradnik/wydarzenia/">Wydarzenia</a><span aria-hidden="true">/</span><span aria-current="page">Dżakarta 2026</span></nav>
    <div class="expert-article-hero-grid event-hero-grid"><div>
      <p class="section-kicker">Wydarzenia · relacja</p><div class="expert-article-meta"><span>20–23 października 2026</span><span>Jakarta, Indonezja</span></div>
      <h1>Bogusława Herda w jury <span class="bph-title-accent">PMU Indonesia Festival 2026</span></h1>
      <p class="expert-article-lead">Do Indonezji pojechałam jako jurorka PMU Indonesia Festival. Wracam z ogromną wdzięcznością za spotkania, rozmowy i możliwość oglądania tak wielu pięknych prac. Zapraszam do mojej relacji — ze zdjęciami i filmem.</p>
      <GuideSeriesByline date="2026-11-02" dateLabel="2 listopada 2026" role="Autorka · jurorka PMU" />
      <div class="event-actions"><a class="button-primary" href="#film">Obejrzyj film ↓</a><a class="event-text-link" href="#galeria">Zobacz zdjęcia ↓</a></div>
    </div><div class="event-poster"><IndonesiaPhoto photo={photos[0]} eager /></div></div>
    <dl class="event-facts"><div><dt>Termin festiwalu</dt><dd>20–23.10.2026</dd></div><div><dt>Miejsce</dt><dd>Jakarta · Indonezja</dd></div><div><dt>Moja rola</dt><dd>Jurorka PMU</dd></div></dl>
  </div></header>
<section class="expert-article-nav-section"><div class="container"><details class="guide-toc" open><summary>W tej relacji</summary><nav aria-label="Spis treści artykułu"><a href="#o-festiwalu">Spotkanie międzynarodowego środowiska PMU</a><a href="#jury">Moja rola w jury</a><a href="#metoda-wloskowa">Prace włoskowe, które zapamiętam</a><a href="#qvision">Spotkanie z właścicielami QVISION Academy</a><a href="#spotkania">Różne kultury i rozmowy o pięknie</a><a href="#kwalifikacje">Rozmowa o jakości pracy i kwalifikacjach</a><a href="#po-powrocie">Co zostaje ze mną po festiwalu</a><a href="#film">Film</a><a href="#galeria">Galeria zdjęć</a></nav></details></div></section>
<section class="expert-article-section" id="o-festiwalu"><div class="container event-reading"><h2>Spotkanie międzynarodowego środowiska PMU</h2><p>PMU Indonesia Festival odbywał się 20–23 października 2026 w rejonie Pantai Indah Kapuk, w aglomeracji Dżakarty. Spotkanie powitalne i rejestrację zaplanowano na 20 października, a główna część wydarzenia trwała od 21 do 23 października. W programie znalazły się konkursy, prezentacje technik i spotkania specjalistów. <a href="#zrodla">[1, 4]</a></p><p>Według informacji organizatorów przytoczonych przez JPNN w festiwalu uczestniczyło około 700 osób z 24 krajów: około 400 z Indonezji i 300 z zagranicy. Konkursy obejmowały brwi, usta i eyeliner. Te liczby dotyczą uczestników całego wydarzenia, nie wyłącznie zawodników. <a href="#zrodla">[1]</a></p><p>Na zdjęciach widać rozmach sceny i międzynarodową oprawę festiwalu. Dla mnie najważniejsi pozostają jednak ludzie: ich prace, doświadczenie i otwartość na spotkanie z innymi osobami z branży.</p><IndonesiaPhoto photo={photos[2]} /></div></section>
<section class="expert-article-section" id="jury"><div class="container event-reading"><h2>Moja rola w jury</h2><p>Udział w jury był dla mnie ważnym zawodowym doświadczeniem. Ocena prac wymaga skupienia i uważnego przyjrzenia się detalom. Podczas takiego wydarzenia można zobaczyć różne sposoby podejścia do tego samego zadania i docenić, jak wiele zależy od decyzji osoby wykonującej pigmentację.</p><p>Cieszę się, że mogłam być częścią tego grona. Możliwość oglądania prac z bliska i rozmów z osobami, które rozwijają makijaż permanentny w innych krajach, zostaje ze mną dłużej niż sama festiwalowa oprawa.</p><div class="indonesia-jury-pair"><IndonesiaPhoto photo={memories[1]} /><IndonesiaPhoto photo={memories[4]} /></div></div></section>
<section class="expert-article-section" id="metoda-wloskowa"><div class="container event-reading"><h2>Prace włoskowe, które zapamiętam</h2><p>Największe wrażenie zrobiły na mnie prace azjatyckich artystów wykonane metodą włoskową. Nigdy wcześniej nie widziałam tak wielu pięknych realizacji naraz. To był jeden z tych momentów, w których zawodowa ciekawość łączy się ze zwykłym zachwytem nad czyjąś pracą.</p><p>Metoda włoskowa jest mi szczególnie bliska, dlatego oglądanie tych realizacji było dla mnie tak ciekawe. Każda praca daje okazję, by zastanowić się nad efektem, jaki można uzyskać, i nad tym, jak różnie specjaliści podchodzą do brwi. Z festiwalu przywożę wiele inspiracji do dalszego zgłębiania tej techniki.</p></div></section>
<section class="expert-article-section" id="qvision"><div class="container event-reading"><h2>Spotkanie z właścicielami QVISION Academy</h2><p>Jedną z ważnych pamiątek z Indonezji jest wspólne zdjęcie z właścicielami QVISION Academy. Ta działająca w Tajlandii akademia zajmuje się pigmentacją brwi i szkoleniami, a na swojej stronie prezentuje m.in. technikę hairstroke. <a href="#zrodla">[3]</a></p><p>To spotkanie ma dla mnie szczególne znaczenie i dlatego chcę zachować je w tej relacji. Międzynarodowe wydarzenia pozwalają spotkać osobiście ludzi związanych z różnymi szkołami pracy i spojrzeć na własny zawód z szerszej perspektywy.</p><IndonesiaPhoto photo={photos[1]} /></div></section>
<section class="expert-article-section" id="spotkania"><div class="container event-reading"><h2>Różne kultury i rozmowy o pięknie</h2><p>Z festiwalu zapamiętam wiele rozmów i nowych znajomości. Mamy wspólny zawód, ale różne doświadczenia, inspiracje i sposoby patrzenia na twarz. Bardzo lubię odkrywać, jak kultura wpływa na rozumienie piękna i oczekiwania wobec makijażu permanentnego.</p><p>Takie spotkania przypominają mi, jak wiele możemy się od siebie nauczyć. Czasem najciekawsza myśl pojawia się podczas prezentacji, a czasem w zwykłej rozmowie pomiędzy kolejnymi punktami programu. Ta możliwość wymiany doświadczeń jest dla mnie ważnym powodem, by uczestniczyć w wydarzeniach za granicą.</p></div></section>
<section class="expert-article-section" id="kwalifikacje"><div class="container event-reading"><h2>Rozmowa o jakości pracy i kwalifikacjach</h2><p>W relacjach medialnych z festiwalu pojawił się również temat standardów pracy oraz certyfikacji kompetencji w Indonezji. Metro TV opisywało rozmowy przedstawicieli branży i instytucji publicznych o formalnym potwierdzaniu umiejętności oraz rozwoju zawodowym praktyków PMU. To kontekst dotyczący indonezyjskiego systemu kwalifikacji. <a href="#zrodla">[2]</a></p><p>Dla osoby wybierającej gabinet ważne są zarówno efekty pracy, jak i przygotowanie specjalisty. Relacja z wydarzenia pokazuje jeden z elementów mojego rozwoju zawodowego. Sposób pracy i estetykę, którą proponuję klientkom, najlepiej poznasz, oglądając realizacje z mojego gabinetu.</p></div></section>
<section class="expert-article-section" id="po-powrocie"><div class="container event-reading"><h2>Co zostaje ze mną po festiwalu</h2><p>Wracam z inspiracjami i wdzięcznością, że mogę łączyć pracę z podróżowaniem oraz poznawaniem innych kultur. To doświadczenie zostanie ze mną na długo. Tym bardziej cieszę się, że mogę podzielić się jego częścią poprzez zdjęcia i nagrania.</p><p>Dziękuję organizatorom PMU Indonesia Festival oraz Ani Śpiewak za zaproszenie i możliwość udziału w wydarzeniu. Dziękuję również wszystkim osobom, z którymi miałam okazję się spotkać i porozmawiać.</p><p>Jeśli chcesz poznać moje podejście do naturalnego makijażu permanentnego, obejrzyj galerię prac i poznaj metody pigmentacji brwi wykonywane w gabinecie w Bielsku-Białej. Przy wyborze zabiegu zaczynamy od Twoich oczekiwań i indywidualnej konsultacji.</p><div class="event-actions"><a class="button-primary" href="/galeria/">Zobacz efekty mojej pracy →</a><a class="event-text-link" href="/makijaz-permanentny-brwi/">Poznaj metody pigmentacji brwi →</a></div></div></section>
<section class="expert-article-section" id="film"><div class="container indonesia-film-story"><div><p class="section-kicker">29 sekund wspomnień</p><h2>Zobacz fragmenty festiwalu.</h2><p>Bogusława Herda podczas PMU Indonesia Festival — krótki film z atmosferą wydarzenia i oryginalnym dźwiękiem.</p><a class="event-text-link" href="#galeria">Dalej: zdjęcia z Indonezji ↓</a></div><IndonesiaVideo /></div></section>
<section class="expert-article-section" id="galeria"><div class="container"><h2>Zdjęcia z PMU Indonesia Festival 2026.</h2><p>Spotkania, finał i drobne pamiątki, które przypominają mi ten czas. Dotknij zdjęcia, aby zobaczyć cały kadr w powiększeniu.</p><div class="indonesia-memories-full"><IndonesiaMemories /></div><h3 class="indonesia-backstage-title">Scena, praca i kulisy festiwalu.</h3><div class="indonesia-gallery">{photos.map(photo => <IndonesiaPhoto photo={photo} />)}</div></div></section>
<section class="expert-article-section" id="zrodla"><div class="container event-reading"><h2>Źródła i materiały.</h2><p>Relację opieram na własnym udziale, zdjęciach i nagraniach. Dane o skali festiwalu pochodzą z informacji organizatorów przytoczonych w mediach.</p><div class="event-source-grid">{sources.map((source, i) => <a href={source.href} target="_blank" rel="noopener noreferrer"><strong>{i + 1}. {source.title} ↗</strong><span>{source.detail}</span></a>)}</div><div class="event-actions"><a class="button-secondary" href="/poradnik/wydarzenia/">← Wszystkie wydarzenia</a></div></div></section>
</main><Footer /></Layout>
<style>
  .indonesia-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 20px}
  .event-reading :global(.indonesia-photo){margin-top:28px}
  .indonesia-jury-pair{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:28px}
  .indonesia-jury-pair :global(.indonesia-photo){margin:0}
  .indonesia-memories-full{margin-top:30px}
  .indonesia-backstage-title{margin:50px 0 24px}
  .indonesia-film-story{display:grid;grid-template-columns:1fr minmax(260px,360px);gap:64px;align-items:center;max-width:1000px}
  .indonesia-film-story :global(.indonesia-video){margin:0;width:100%}
  @media(min-width:641px) and (max-width:1099px) and (orientation:portrait){
    .pmu-event-article .event-hero-grid{grid-template-columns:1fr}
    .pmu-event-article .event-poster{max-width:360px}
    .indonesia-film-story{gap:32px;grid-template-columns:1fr 280px}
  }
  @media(max-width:640px){
    .pmu-event-article .event-poster{max-width:320px}
    .indonesia-film-story{grid-template-columns:1fr;gap:24px}
    .indonesia-film-story :global(.indonesia-video){max-width:360px;justify-self:center}
    .indonesia-jury-pair{gap:12px}
    .indonesia-gallery{align-items:start}
  }
  @media(max-width:640px){.indonesia-gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}}
</style>
