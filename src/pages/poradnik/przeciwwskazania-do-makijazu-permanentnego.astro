---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "przeciwwskazania-do-makijazu-permanentnego",
  title: "Przeciwwskazania do makijażu permanentnego — kiedy zabieg trzeba przełożyć lub skonsultować z lekarzem?",
  category: "Kwalifikacja i bezpieczeństwo",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "12–14 minut",
  description: "Przeciwwskazania do makijażu permanentnego: aktywne choroby skóry, infekcje, ciąża, leczenie immunosupresyjne, zaburzenia krzepnięcia i sytuacje wymagające zgody lekarza.",
  lead: "Nie istnieje jedna krótka lista, która rozstrzyga każdy przypadek. Część sytuacji oznacza po prostu przełożenie zabiegu, a część wymaga indywidualnej konsultacji z lekarzem prowadzącym i oceny ryzyka.",
  shortAnswer: "Zabieg należy przełożyć przy aktywnej infekcji, świeżym stanie zapalnym lub silnym podrażnieniu obszaru pigmentacji. Ciąża jest okresem, w którym zabiegi kosmetyczne o charakterze planowym zazwyczaj się odracza ze względu na ograniczone dane bezpieczeństwa. Choroby przewlekłe, leczenie immunosupresyjne, zaburzenia krzepnięcia czy leki wpływające na krzepnięcie wymagają indywidualnej oceny — nie wolno samodzielnie odstawiać leków przed PMU.",
  canonicalPath: "/poradnik/przeciwwskazania-do-makijazu-permanentnego/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl, headline: article.title, description: article.description,
    datePublished: article.datePublished, dateModified: article.dateModified, inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/25833628/",
      "https://pubmed.ncbi.nlm.nih.gov/28993993/",
      "https://pubmed.ncbi.nlm.nih.gov/24164677/",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy ciąża jest przeciwwskazaniem do makijażu permanentnego?",
        acceptedAnswer: { "@type": "Answer", text: "PMU jest zabiegiem planowym, a dane bezpieczeństwa procedur kosmetycznych w ciąży są ograniczone, dlatego najbezpieczniejszym podejściem jest odroczenie zabiegu." },
      },
      {
        "@type": "Question",
        name: "Czy przy chorobie tarczycy można zrobić PMU?",
        acceptedAnswer: { "@type": "Answer", text: "Sama nazwa choroby nie wystarcza do decyzji. Znaczenie ma jej stabilność, leczenie i ogólny stan zdrowia; w razie wątpliwości potrzebna jest opinia lekarza." },
      },
      {
        "@type": "Question",
        name: "Czy trzeba odstawić leki przeciwkrzepliwe?",
        acceptedAnswer: { "@type": "Answer", text: "Nie wolno samodzielnie odstawiać zaleconych leków dla potrzeb zabiegu kosmetycznego. Decyzję o leczeniu podejmuje lekarz." },
      },
      {
        "@type": "Question",
        name: "Czy aktywna opryszczka wyklucza PMU ust?",
        acceptedAnswer: { "@type": "Answer", text: "Aktywna zmiana w obszarze ust jest powodem do przełożenia zabiegu do czasu wygojenia i oceny sytuacji." },
      },
      {
        "@type": "Question",
        name: "Czy łuszczyca zawsze wyklucza makijaż permanentny?",
        acceptedAnswer: { "@type": "Answer", text: "Nie jest to automatyczna odpowiedź dla każdego przypadku. Aktywna choroba w miejscu pigmentacji i leczenie immunosupresyjne wymagają szczególnej ostrożności i konsultacji medycznej." },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Bogusława Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="expert-article-page">
    <Header />
    <main>
      <section class="expert-article-hero">
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="expert-article-meta"><span>55</span><span>{article.category}</span><span>{article.readingTime}</span></div>
            <h1>{article.title}</h1><p class="expert-article-lead">{article.lead}</p>
          </div>
          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze pytanie brzmi nie „czy masz chorobę”, tylko „czy zabieg jest bezpieczny w Twojej aktualnej sytuacji”.</h2><p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section"><div class="container"><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#przelozyc">Kiedy przełożyć?</a>
            <a href="#lekarz">Kiedy lekarz?</a>
            <a href="#leki">Leki i zabiegi</a>
            <a href="#praktyka">Praktyka gabinetowa</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="expert-article-section" id="przelozyc"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Trzy poziomy decyzji przed PMU</h2><p>Kwalifikacja nie powinna sprowadzać się do automatycznego odhaczania „tak/nie”.</p></div>
        <div class="expert-timeline">
            <article class="expert-timeline-card is-danger">
              <div class="expert-timeline-top"><strong>Aktywna infekcja lub stan zapalny</strong><span>Obszar zabiegowy</span></div>
              <h3>Zabieg odkładamy</h3><p>Pigmentacji nie wykonuje się na aktywnie zmienionej, zakażonej lub silnie podrażnionej skórze bez wyjaśnienia problemu.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top"><strong>Ciąża</strong><span>Zabieg planowy</span></div>
              <h3>Najbezpieczniej odroczyć</h3><p>Przeglądy procedur kosmetycznych wskazują na brak wystarczających danych i zalecają odraczanie planowych zabiegów w ciąży.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top"><strong>Choroba przewlekła lub immunosupresja</strong><span>Nie zawsze bezwzględny zakaz</span></div>
              <h3>Potrzebna indywidualna decyzja</h3><p>W wielu przypadkach ważna jest aktywność choroby, leczenie i opinia lekarza prowadzącego.</p>
            </article>
            <article class="expert-timeline-card is-danger">
              <div class="expert-timeline-top"><strong>Leki wpływające na krzepnięcie</strong><span>Nie odstawiaj samodzielnie</span></div>
              <h3>Najpierw lekarz</h3><p>Odstawienie zaleconych leków tylko po to, aby wykonać zabieg kosmetyczny, może być niebezpieczne.</p>
            </article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-soft" id="lekarz"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Sytuacje, o których trzeba powiedzieć przed pigmentacją</h2></div>
        <div class="expert-factor-grid">
            <article><h3>Choroby skóry w miejscu zabiegu</h3><p>Aktywne wypryski, infekcje, opryszczka, zaostrzenie łuszczycy czy inne zmiany w obszarze pigmentacji wymagają oceny i często przełożenia wizyty.</p></article>
            <article><h3>Leczenie immunosupresyjne</h3><p>Przy lekach obniżających odporność ryzyko infekcji i gojenia powinno być omówione z lekarzem prowadzącym.</p></article>
            <article><h3>Zaburzenia krzepnięcia i leki</h3><p>Istotne są choroby krzepnięcia oraz leki przeciwkrzepliwe lub przeciwpłytkowe. Decyzji o leczeniu nie zmienia się samodzielnie.</p></article>
            <article><h3>Niedawne zabiegi estetyczne</h3><p>Botoks, filler, mocne kuracje dermatologiczne lub podrażniające kosmetyki mogą wpływać na skórę i anatomię. Kolejność ustala się indywidualnie.</p></article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-plan-section" id="leki"><div class="container expert-plan-panel">
        <div class="expert-plan-copy"><p class="section-kicker section-kicker-light">Plan decyzji</p><h2>Jak przygotować się do kwalifikacji bez chaosu?</h2><p>Najlepiej przekazać pełną informację, zamiast próbować samodzielnie oceniać bezpieczeństwo.</p></div>
        <div class="expert-plan-steps">
            <div><span>01</span><strong>Podaj choroby przewlekłe</strong><p>Szczególnie ważne są choroby wpływające na skórę, odporność, gojenie lub krzepnięcie.</p></div>
            <div><span>02</span><strong>Podaj leki i terapie</strong><p>Nie pomijaj leków przeciwkrzepliwych, immunosupresyjnych, retinoidów i innych terapii dermatologicznych.</p></div>
            <div><span>03</span><strong>Powiedz o ostatnich zabiegach</strong><p>Botoks, filler, laser, peelingi i inne procedury mogą mieć znaczenie dla planu PMU.</p></div>
            <div><span>04</span><strong>W razie wątpliwości — lekarz</strong><p>Jeżeli ryzyko zależy od choroby lub leczenia, decyzję o bezpieczeństwie wspieramy opinią lekarza prowadzącego.</p></div>
        </div>
      </div></section>

      <section class="expert-article-section" id="praktyka"><div class="container expert-author-note">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>Nie szukam sposobu, żeby „obejść przeciwwskazanie”. Szukam bezpiecznego momentu na zabieg.</h2><p>Jeśli skóra jest aktywnie zmieniona albo klientka jest w trakcie leczenia, które może wpływać na gojenie, wolę przełożyć zabieg. Przy chorobach przewlekłych nie wydaję medycznych zgód — proszę o konsultację z lekarzem prowadzącym. I nigdy nie zalecam samodzielnego odstawiania leków dla potrzeb PMU.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj moje doświadczenie i podejście →</a></aside>
      </div></section>

      <section class="expert-article-section expert-article-related-section"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="expert-related-grid">
            <a href="/poradnik/retinol-kwasy-a-makijaz-permanentny/"><h3>Retinol i kwasy a PMU</h3><p>Jak aktywne kosmetyki mogą wpływać na skórę przed zabiegiem.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/botoks-a-makijaz-permanentny-brwi/"><h3>Botoks a PMU brwi</h3><p>Jak planować kolejność zabiegów estetycznych.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/kwas-hialuronowy-w-ustach-a-makijaz-permanentny/"><h3>Filler ust a PMU</h3><p>Jak stabilność tkanek wpływa na pigmentację ust.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/opryszczka-a-makijaz-permanentny-ust/"><h3>Opryszczka a PMU ust</h3><p>Kiedy aktywny HSV oznacza przełożenie pigmentacji.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="expert-article-section" id="zrodla"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną, techniczną i praktyczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Gdy nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.</p></div>
        <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/25833628/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Contraindications for tattooing</h3><p>Przegląd omawia m.in. choroby skóry, immunosupresję, zaburzenia krzepnięcia oraz ciążę i karmienie w kontekście tatuowania.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/28993993/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>A practical guide about tattooing in patients with chronic skin disorders and other medical conditions</h3><p>Praktyczny przegląd dotyczący tatuowania u osób z chorobami przewlekłymi i dermatologicznymi.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/24164677/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Safety of cosmetic dermatologic procedures during pregnancy</h3><p>Ze względu na brak kontrolowanych danych autorzy zalecają odraczanie planowych procedur kosmetycznych do czasu po ciąży.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span><h3>Permanent makeup: technique, regulation and complications</h3><p>Aktualny przegląd PMU i możliwych powikłań, ważny dla kwalifikacji zabiegowej.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="expert-medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy problemach zdrowotnych, nasilonych objawach lub wątpliwościach dotyczących leczenia skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="expert-article-section expert-article-faq-section" id="faq"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">FAQ</p><h2>{article.title}</h2></div>
        <div class="expert-faq-list">
            <details><summary><span>Czy ciąża jest przeciwwskazaniem do makijażu permanentnego?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>PMU jest zabiegiem planowym, a dane bezpieczeństwa procedur kosmetycznych w ciąży są ograniczone, dlatego najbezpieczniejszym podejściem jest odroczenie zabiegu.</p></div></details>
            <details><summary><span>Czy przy chorobie tarczycy można zrobić PMU?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Sama nazwa choroby nie wystarcza do decyzji. Znaczenie ma jej stabilność, leczenie i ogólny stan zdrowia; w razie wątpliwości potrzebna jest opinia lekarza.</p></div></details>
            <details><summary><span>Czy trzeba odstawić leki przeciwkrzepliwe?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Nie wolno samodzielnie odstawiać zaleconych leków dla potrzeb zabiegu kosmetycznego. Decyzję o leczeniu podejmuje lekarz.</p></div></details>
            <details><summary><span>Czy aktywna opryszczka wyklucza PMU ust?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Aktywna zmiana w obszarze ust jest powodem do przełożenia zabiegu do czasu wygojenia i oceny sytuacji.</p></div></details>
            <details><summary><span>Czy łuszczyca zawsze wyklucza makijaż permanentny?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Nie jest to automatyczna odpowiedź dla każdego przypadku. Aktywna choroba w miejscu pigmentacji i leczenie immunosupresyjne wymagają szczególnej ostrożności i konsultacji medycznej.</p></div></details>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-final-card">
        <p class="signature cta-signature">Powrót do natury</p><h2>Potrzebujesz indywidualnej oceny przed PMU?</h2>
        <p>Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy. Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od formularza kwalifikacji.</p>
        <div class="expert-final-actions">
          <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy <span aria-hidden="true">→</span></a>
          <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU <span aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
        </div>
        <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
      </div></section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .expert-article-page{min-height:100vh;overflow-x:hidden;background:radial-gradient(circle at 82% 10%,rgba(56,187,181,.10),transparent 28rem),radial-gradient(circle at 12% 42%,rgba(201,127,143,.10),transparent 26rem),linear-gradient(180deg,#fffdfd 0%,#fff8fa 48%,#fff 100%)}
  .expert-article-page*,.expert-article-page *::before,.expert-article-page *::after{box-sizing:border-box}.expert-article-page main,.expert-article-page section,.expert-article-page .container,.expert-article-page article,.expert-article-page div{min-width:0}
  .expert-article-page .section-kicker{display:inline-flex;width:fit-content;max-width:100%;min-height:31px;align-items:center;justify-content:center;margin:0 0 17px;padding:0 12px;border:1px solid rgba(56,187,181,.18);border-radius:999px;background:rgba(219,246,243,.76);color:var(--color-turquoise-dark,#0f7773);font:850 .67rem/1 inherit;letter-spacing:.15em;text-transform:uppercase}.expert-article-page .section-kicker-light{border-color:rgba(255,255,255,.22);background:rgba(255,255,255,.13);color:#fff}
  .expert-article-hero{padding:144px 0 66px}.expert-article-hero-grid{display:grid;grid-template-columns:minmax(0,1.13fr) minmax(340px,.87fr);gap:22px;align-items:stretch}.expert-article-hero-copy,.expert-article-answer,.expert-timeline-card,.expert-article-note,.expert-factor-grid article,.expert-source-inline,.expert-area-grid a,.expert-author-note,.expert-related-grid a,.expert-source-grid a,.expert-faq-list details,.expert-final-card{border:1px solid rgba(183,101,118,.14);box-shadow:0 18px 54px rgba(89,53,67,.065)}
  .expert-article-hero-copy{padding:clamp(34px,5vw,62px);border-radius:38px;background:radial-gradient(circle at 96% 10%,rgba(56,187,181,.07),transparent 16rem),rgba(255,255,255,.84)}.expert-article-meta{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:18px}.expert-article-meta span{display:inline-flex;min-height:29px;align-items:center;padding:0 11px;border-radius:999px;background:rgba(255,248,251,.94);color:var(--color-muted,#6e6670);font-size:.68rem;font-weight:790;letter-spacing:.08em;text-transform:uppercase}.expert-article-meta span:first-child{background:rgba(56,187,181,.12);color:var(--color-turquoise-dark,#0f7773)}
