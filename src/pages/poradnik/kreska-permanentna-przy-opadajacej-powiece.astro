---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-permanentna-przy-opadajacej-powiece",
  title: "Kreska permanentna przy opadającej powiece — kiedy ma sens, a kiedy lepiej wybrać zagęszczenie rzęs?",
  eyebrow: "Poradnik PMU",
  category: "Kreska przy opadającej powiece",
  datePublished: "2026-06-18",
  dateModified: "2026-08-20",
  readingTime: "9–11 minut",
  description: "Kreska permanentna przy opadającej powiece: kiedy wybrać zagęszczenie linii rzęs, kiedy unikać kreski dekoracyjnej i jak dobrać efekt do oka.",
  lead: "Opadająca powieka nie wyklucza makijażu permanentnego oczu, ale bardzo mocno wpływa na wybór kreski. Przy takiej budowie oka często lepiej sprawdza się subtelne zagęszczenie linii rzęs niż długa, gruba kreska dekoracyjna.",
  shortAnswer: "Przy opadającej powiece rodzaj kreski permanentnej dobiera się po analizie oka. Często najlepszym wyborem jest zagęszczenie linii rzęs albo bardzo cienka kreska, bo zbyt gruba i długa kreska może optycznie obciążyć oko, schować się w załamaniu powieki albo zaburzyć proporcje spojrzenia.",
  canonicalPath: "/poradnik/kreska-permanentna-przy-opadajacej-powiece/",
  mainService: {
    href: "/makijaz-permanentny-oczu/",
    title: "Makijaż permanentny oczu",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy można zrobić kreskę permanentną przy opadającej powiece?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Często można, ale rodzaj kreski trzeba dobrać ostrożnie.",
        },
      },
      {
        "@type": "Question",
        name: "Jaka kreska jest najlepsza przy opadającej powiece?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najczęściej najbezpieczniejszym kierunkiem jest delikatne zagęszczenie linii rzęs.",
        },
      },
      {
        "@type": "Question",
        name: "Czy kreska dekoracyjna pasuje do opadającej powieki?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze. Zbyt gruba lub długa kreska może schować się w załamaniu powieki.",
        },
      },
      {
        "@type": "Question",
        name: "Czy kreska dolna jest dobrym pomysłem?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Kreska dolna wymaga osobnej kwalifikacji, bo może optycznie pomniejszyć oko.",
        },
      },
      {
        "@type": "Question",
        name: "Czy zagęszczenie linii rzęs wygląda naturalnie?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak, jeśli jest dobrze wykonane. Celem jest subtelne przyciemnienie nasady rzęs.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#czy-mozna">Kwalifikacja oka</a>
            <a href="#zageszczenie">Najbezpieczniejszy kierunek</a>
            <a href="#dekoracyjna">Kreska dekoracyjna</a>
            <a href="#cieniowana">Softliner i cień</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="czy-mozna">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Kwalifikacja oka</p>
            <h2>Opadająca powieka nie przekreśla kreski, ale wymaga ostrożnego projektu.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Przy opadającej powiece najważniejsze jest to, ile rzeczywiście widać na ruchomej powiece i jak układa się skóra przy otwartym oku.</p>
            <p>Dlatego decyzja nie powinna wynikać z inspiracji zdjęciem. Najpierw trzeba ocenić oko, powiekę, rzęsy i napięcie skóry.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Otwarte oko</h3>
              <p>Projekt trzeba oceniać przy naturalnie otwartym oku.</p>
            </article>
            <article>
              <h3>Załamanie powieki</h3>
              <p>Może ukrywać lub załamywać zbyt mocną kreskę.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="zageszczenie">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Najbezpieczniejszy kierunek</p>
            <h2>Zagęszczenie linii rzęs często wygląda najlepiej przy trudniejszej powiece.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Zagęszczenie linii rzęs nie musi wyglądać jak eyeliner. To subtelna pigmentacja przy nasadzie rzęs, która wzmacnia oprawę oka bez ciężkiej graficznej kreski.</p>
            <p>Celem jest otwarcie spojrzenia, a nie dociążenie powieki.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Naturalne podkreślenie</h3>
              <p>Efekt wzmacnia rzęsy, ale nie dominuje nad twarzą.</p>
            </article>
            <article>
              <h3>Mniej ryzyka ciężkości</h3>
              <p>Cienka pigmentacja rzadziej optycznie zamyka oko.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="dekoracyjna">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Kreska dekoracyjna</p>
            <h2>Kreska dekoracyjna nie zawsze jest dobrym wyborem przy opadającej powiece.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Mocna kreska z wyciągnięciem może wyglądać atrakcyjnie na zdjęciu, ale przy opadającej powiece bywa trudna do zaplanowania.</p>
            <p>Nie oznacza to, że mocniejszy efekt jest zawsze niemożliwy. Oznacza to, że musi być oceniony indywidualnie.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Za gruba kreska</h3>
              <p>Może skrócić optycznie przestrzeń powieki.</p>
            </article>
            <article>
              <h3>Za długi ogonek</h3>
              <p>Może załamywać się pod fałdem skóry.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="cieniowana">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Softliner i cień</p>
            <h2>Kreska cieniowana może być piękna, ale wymaga dobrej anatomii i rozsądnych oczekiwań.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Kreski cieniowane i softliner są popularne, bo wyglądają miękko. Przy opadającej powiece trzeba jednak ocenić, czy cień będzie widoczny i czy nie zamknie oka.</p>
            <p>W okolicy oka niewielka różnica w grubości, długości lub kącie może zmienić cały wyraz twarzy.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Miękki efekt</h3>
              <p>Może być dobry, jeśli powieka daje na to przestrzeń.</p>
            </article>
            <article>
              <h3>Precyzja</h3>
              <p>Przy oku każdy milimetr ma znaczenie.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Nie każda inspiracja z internetu pasuje do każdej powieki</h3>
            <p>Przy opadającej powiece decyzja o kresce powinna wynikać z anatomii oka, a nie z samego zdjęcia.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/makijaz-permanentny-oczu/">
              <h3>Makijaż permanentny oczu</h3>
              <p>Zobacz warianty kresek i zagęszczenia linii rzęs.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/">
              <h3>Jak wybrać rodzaj kreski?</h3>
              <p>Porównaj kreskę górną, dolną i dekoracyjną.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/cennik-makijaz-permanentny/">
              <h3>Cennik PMU</h3>
              <p>Sprawdź orientacyjne ceny makijażu permanentnego.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-oczu-bielsko-biala/">
              <h3>Makijaż permanentny oczu Bielsko-Biała — kreska permanentna i zagęszczenie linii rzęs</h3>
              <p>Rozwinięcie tego zagadnienia w osobnym poradniku.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <h3>Permanent makeup: A review of its technique, regulation, and complications</h3>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoos & Permanent Makeup: Fact Sheet</h3>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Caring for tattooed skin</h3>
              <p>Zalecenia dermatologów dotyczące ochrony i pielęgnacji pigmentowanej skóry.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Czy można zrobić kreskę permanentną przy opadającej powiece?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Często można, ale rodzaj kreski trzeba dobrać ostrożnie.</p></div>
            </details>
            <details>
              <summary>
                <span>Jaka kreska jest najlepsza przy opadającej powiece?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Najczęściej najbezpieczniejszym kierunkiem jest delikatne zagęszczenie linii rzęs.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy kreska dekoracyjna pasuje do opadającej powieki?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie zawsze. Zbyt gruba lub długa kreska może schować się w załamaniu powieki.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy kreska dolna jest dobrym pomysłem?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Kreska dolna wymaga osobnej kwalifikacji, bo może optycznie pomniejszyć oko.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy zagęszczenie linii rzęs wygląda naturalnie?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Tak, jeśli jest dobrze wykonane. Celem jest subtelne przyciemnienie nasady rzęs.</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Chcesz ocenić swój przypadek przed zabiegiem?</h2>
          <p>
            Jeśli wiesz, jakiego zabiegu potrzebujesz — sprawdź terminy.
            Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href={article.mainService.href}>
              {article.mainService.title}
            </a>
          </div>

          <a class="expert-back-link" href="/poradnik/">
            ← Wróć do całego poradnika PMU
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .expert-legacy-copy {
    max-width: 940px;
  }

  .expert-legacy-copy p {
    margin: 16px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.72;
  }

  .expert-legacy-copy p:first-of-type {
    margin-top: 0;
  }

  .expert-legacy-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .expert-legacy-cards article {
    min-height: 150px;
    padding: 23px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 24px;
    background:
      radial-gradient(circle at 94% 10%, rgba(56, 187, 181, 0.07), transparent 11rem),
      rgba(255, 255, 255, 0.90);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.055);
  }

  .expert-legacy-cards h3 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-size: clamp(1.25rem, 1.6vw, 1.72rem);
    font-weight: 770;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .expert-legacy-cards p {
    margin: 11px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .expert-focus-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .expert-focus-links a {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 17px 18px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 18px;
    background: rgba(219, 246, 243, 0.38);
    color: var(--color-text, #17151d);
    font-size: 0.88rem;
    font-weight: 760;
    line-height: 1.35;
    text-decoration: none;
  }

  .expert-focus-links a span {
    color: var(--color-turquoise-dark, #0f7773);
    font-weight: 850;
  }

  @media (max-width: 760px) {
    .expert-legacy-cards,
    .expert-focus-links {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .expert-legacy-cards article {
      min-height: auto;
      padding: 20px;
      border-radius: 21px;
    }

    .expert-focus-links a {
      min-height: 68px;
      padding: 15px 16px;
