---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GuideImage from "../../components/GuideImage.astro";
import cover from "../../assets/poradnik/kreska-cena-okladka-ai.png";
import subtleEye from "../../assets/poradnik/kreska-delikatna-galeria.webp";
import decorativeEye from "../../assets/poradnik/kreska-dekoracyjna-galeria.webp";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const article = {
  title: "Kreska permanentna cena 2026 — ile kosztuje makijaż permanentny oczu?",
  description: "Kreska permanentna cena 2026. Sprawdź, ile kosztuje kreska zagęszczająca, dekoracyjna, dolna i cieniowana, co obejmuje cena oraz od czego zależy dobór kreski PMU.",
  canonicalPath: "/poradnik/kreska-permanentna-cena/",
  datePublished: "2026-06-21",
  dateModified: "2026-09-07",
};
const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;
const coverAlt = "Ilustracja AI: naturalne spojrzenie z delikatnie podkreśloną górną linią rzęs";
const socialCover = await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const socialCoverUrl = new URL(socialCover.src, "https://www.permanentnybielsko.com").toString();

const prices = [
  { name: "Kreska dolna", price: "500 zł", detail: "Podkreślenie dolnej powieki.", href: "#rodzaje-kresek" },
  { name: "Kreska zagęszczająca", price: "800 zł", detail: "Subtelna pigmentacja przy górnej linii rzęs.", href: "/poradnik/kreska-zageszczajaca-linie-rzes/" },
  { name: "Kreska dekoracyjna", price: "1100 zł", detail: "Eyeliner lub kreska cieniowana, po dobraniu efektu do powieki.", href: "/poradnik/kreski-permanentne-cieniowane/" },
  { name: "Kreska dolna + górna zagęszczająca", price: "1100 zł", detail: "Połączenie dolnej kreski z podkreśleniem górnej linii rzęs.", href: "/makijaz-permanentny-oczu/" },
  { name: "Kreska dolna + dekoracyjna", price: "1400 zł", detail: "Połączenie dolnej kreski i górnego eyelinera lub cieniowania.", href: "/makijaz-permanentny-oczu/" },
];
const included = [
  { title: "Rozmowa i kwalifikacja", text: "Ocena budowy oka i powieki, wcześniejszej pigmentacji oraz oczekiwań. Omawiamy też przeciwwskazania i przygotowanie." },
  { title: "Dobór rodzaju kreski", text: "Ustalamy zakres podkreślenia. Subtelne zagęszczenie rzęs i dekoracyjny eyeliner dają inny efekt — wybór powinien pasować do Twojego oka." },
  { title: "Zabieg i zalecenia", text: "Pigmentacja wybranego zakresu oraz indywidualne zalecenia dotyczące pielęgnacji okolicy oka po zabiegu." },
  { title: "Korekta do 2 miesięcy", text: "Przy zabiegu głównym oznaczonym gwiazdką korekta jest w cenie. Wykonujemy ją po wygojeniu, do 2 miesięcy od zabiegu głównego." },
];
const faqItems = [
  { question: "Ile kosztuje kreska permanentna?", answer: "W gabinecie Bogusława Herda w Bielsku-Białej ceny wynoszą od 500 zł za kreskę dolną do 1400 zł za połączenie kreski dolnej i dekoracyjnej. Kreska zagęszczająca kosztuje 800 zł, dekoracyjna 1100 zł, a dolna z górną zagęszczającą 1100 zł." },
  { question: "Ile kosztuje kreska zagęszczająca?", answer: "Kreska zagęszczająca kosztuje 800 zł. To subtelna pigmentacja przy górnej linii rzęs. W cenie zabiegu głównego jest korekta po wygojeniu, do 2 miesięcy od pierwszej pigmentacji." },
  { question: "Ile kosztuje kreska dekoracyjna permanentna?", answer: "Kreska dekoracyjna — eyeliner lub kreska cieniowana — kosztuje 1100 zł. Ostateczny wybór efektu zależy od budowy oka, powieki i kwalifikacji zabiegowej." },
  { question: "Czy cena kreski permanentnej obejmuje korektę?", answer: "Tak. Ceny zabiegów głównych oznaczonych w cenniku gwiazdką obejmują korektę po wygojeniu, do 2 miesięcy od zabiegu głównego. W tym terminie korekta nie wymaga dodatkowej opłaty." },
  { question: "Czy kreska dolna jest dla każdego?", answer: "Nie zawsze. Kreska dolna wymaga indywidualnej kwalifikacji, ponieważ może optycznie zmienić kształt oka. Decyzję podejmujemy po rozmowie i ocenie budowy oka." },
  { question: "Czy poprawienie starej kreski kosztuje tyle samo?", answer: "Wcześniejsza pigmentacja wymaga osobnej oceny. Znaczenie mają jej kolor, kształt, nasycenie i stan skóry. Nie każdą starą kreskę można od razu przykryć nową; zakres postępowania i wycenę ustalamy po kwalifikacji." },
];
const structuredData = [
  {
    "@context": "https://schema.org", "@type": "Article", "@id": `${pageUrl}#article`,
    url: pageUrl, headline: article.title, description: article.description,
    datePublished: article.datePublished, dateModified: article.dateModified, inLanguage: "pl-PL",
    image: { "@type": "ImageObject", url: socialCoverUrl, width: 1200, height: 630, caption: coverAlt },
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    citation: ["https://pubmed.ncbi.nlm.nih.gov/38901732/", "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"],
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map(item => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
  },
];
---

<Layout title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description} canonicalPath={article.canonicalPath}
  ogType="article" ogImage={socialCover.src} ogImageAlt={coverAlt}
  showGuideSocial={false} structuredData={structuredData}>
  <Header />
  <main class="pmu-guide" id="poradnik-kreska-cena">
    <div class="guide-shell">
      <header class="guide-hero">
        <nav class="guide-breadcrumbs" aria-label="Ścieżka strony">
          <a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/poradnik/">Poradnik PMU</a><span aria-hidden="true">/</span><span>Ceny kresek</span>
        </nav>
        <div class="guide-meta"><span>Ceny PMU · Bielsko-Biała</span><span>Aktualizacja: <time datetime={article.dateModified}>7.09.2026</time></span></div>
        <div class="guide-hero-grid">
          <div>
            <h1>{article.title}</h1>
            <p class="guide-lead">Subtelne zagęszczenie rzęs czy wyraźniejszy eyeliner? Zobacz ceny, porównaj zakres zabiegów i sprawdź, co obejmuje korekta.</p>
            <a class="guide-author-link" href="#doswiadczenie">Bogusława Herda <span>· linergistka i trenerka PMU</span></a>
          </div>
          <aside class="guide-answer" aria-label="Cena kreski permanentnej w skrócie">
            <p class="guide-kicker">Odpowiedź w 20 sekund</p>
            <strong class="guide-price-range">500–1400 <span>zł</span></strong>
            <p>W gabinecie Bogusława Herda: dolna <b>500 zł</b>, zagęszczająca <b>800 zł</b>, dekoracyjna <b>1100 zł</b>.</p>
            <p class="guide-answer-note">Korekta zabiegu głównego w cenie — po wygojeniu, <b>do 2 miesięcy</b>.</p>
            <a class="guide-button" href="#ceny-kreski">Porównaj wszystkie warianty <span aria-hidden="true">↓</span></a>
          </aside>
        </div>
      </header>

      <details class="guide-toc">
        <summary>Przejdź do wybranej odpowiedzi <span aria-hidden="true">+</span></summary>
        <nav aria-label="Spis treści poradnika">
          <a href="#ceny-kreski">Ceny kresek PMU</a><a href="#rodzaje-kresek">Różnice i zdjęcia</a>
          <a href="#co-obejmuje-cena">Co obejmuje cena?</a><a href="#dobor">Jak dobrać kreskę?</a>
          <a href="#doswiadczenie">Doświadczenie</a><a href="#praktyka">Stanowisko Bogusława Herda</a>
          <a href="#faq">Pytania i odpowiedzi</a><a href="#zrodla">Źródła</a>
        </nav>
      </details>

      <section class="guide-section" id="ceny-kreski">
        <p class="guide-kicker">01 / Konkretnie o cenach</p>
        <h2>Ile kosztuje kreska permanentna w 2026 roku?</h2>
        <p class="guide-measure">Cena zależy od rodzaju pigmentacji i zakresu pracy. Poniżej znajdziesz ceny z cennika gabinetu Bogusława Herda w Bielsku-Białej — wraz z wariantami łączonymi.</p>
        <div class="guide-price-table-wrap">
          <table class="guide-price-table">
            <caption>Ceny makijażu permanentnego oczu — gabinet Bogusława Herda</caption>
            <thead><tr><th scope="col">Rodzaj kreski</th><th scope="col">Cena*</th></tr></thead>
            <tbody>{prices.map(item => (
              <tr><th scope="row"><a href={item.href}>{item.name}</a><span>{item.detail}</span></th><td>{item.price}</td></tr>
            ))}</tbody>
          </table>
          <p class="guide-price-note">* Zabieg główny wraz z korektą po wygojeniu, do 2 miesięcy od zabiegu głównego. Stare PMU lub praca wykonana w innym gabinecie wymaga indywidualnej kwalifikacji.</p>
        </div>
        <a class="guide-text-link" href="/cennik-makijaz-permanentny/#price-group-2" data-guide-action="price_list">Pełny cennik makijażu permanentnego oczu <span aria-hidden="true">→</span></a>
      </section>

      <div class="guide-cover">
        <GuideImage src={cover} alt={coverAlt} kind="illustration"
          caption="Subtelne podkreślenie spojrzenia — ilustracja poradnika. Indywidualny projekt kreski dobieramy podczas kwalifikacji." />
      </div>

      <section class="guide-section" id="rodzaje-kresek">
        <p class="guide-kicker">02 / Efekt i zakres pracy</p>
        <h2>Kreska zagęszczająca, dekoracyjna, dolna — czym się różnią?</h2>
        <div class="guide-copy-columns">
          <p><b>Kreska zagęszczająca linię rzęs</b> jest zwykle najbardziej subtelna. Pigmentacja przy rzęsach podkreśla spojrzenie bez wyraźnego, szerokiego konturu nad nimi. Jeżeli zależy Ci na dyskretnym efekcie na co dzień, od tego wariantu warto rozpocząć rozmowę.</p>
          <p><b>Kreska dekoracyjna, eyeliner lub cieniowana</b> daje bardziej widoczne podkreślenie. W cenniku należy do zakresu za 1100 zł. Kształt, grubość i zakończenie wymagają dopasowania do konkretnej powieki — zdjęcie inspiracji jest punktem wyjścia do konsultacji.</p>
        </div>
        <div class="guide-photo-grid">
          <GuideImage src={subtleEye} kind="gallery" sizes="(max-width: 600px) calc((100vw - 48px) / 2), 430px"
            alt="Brązowe oko z wąskim podkreśleniem górnej linii rzęs"
            caption="Delikatniejsze podkreślenie przy linii rzęs." />
          <GuideImage src={decorativeEye} kind="gallery" sizes="(max-width: 600px) calc((100vw - 48px) / 2), 430px"
            alt="Niebieskie oko z wyraźniejszą kreską i miękkim zakończeniem w zewnętrznym kąciku"
            caption="Wyraźniejszy kontur i miękkie zakończenie kreski." />
        </div>
        <p class="guide-measure"><b>Kreska dolna</b> jest osobną usługą za 500 zł. Można ją również połączyć z górną zagęszczającą lub dekoracyjną. Nie jest jednak automatycznie najlepszym wyborem dla każdego oka — zakres ustalamy po ocenie proporcji i oczekiwanego rezultatu.</p>
        <a class="guide-text-link" href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/">Zobacz dokładne porównanie rodzajów kresek <span aria-hidden="true">→</span></a>
      </section>

      <aside class="guide-social" aria-label="Porozmawiaj z gabinetem o kresce">
        <div><p class="guide-kicker">Masz swoją inspirację?</p><h2>Porozmawiajmy o Twoim spojrzeniu.</h2><p>Zobacz więcej materiałów z gabinetu i zapytaj o dobór kreski.</p></div>
        <div class="guide-actions">
          <a class="guide-button" href="https://www.instagram.com/permanentnybielsko" target="_blank" rel="noopener noreferrer" data-guide-action="instagram">Instagram <span aria-hidden="true">↗</span></a>
          <a class="guide-button guide-button-light" href="https://www.facebook.com/PermanentnyBielsko" target="_blank" rel="noopener noreferrer" data-guide-action="facebook">Facebook <span aria-hidden="true">↗</span></a>
        </div>
      </aside>

      <section class="guide-section" id="co-obejmuje-cena">
        <p class="guide-kicker">03 / Zabieg i korekta</p>
        <h2>Co obejmuje cena makijażu permanentnego oczu?</h2>
        <p class="guide-measure">Na cenę składa się cały proces: rozmowa, kwalifikacja, dobór kreski, pigmentacja, zalecenia pozabiegowe i korekta. W usługach głównych oznaczonych gwiazdką korekta po wygojeniu jest wliczona w cenę i odbywa się do 2 miesięcy od zabiegu głównego.</p>
        <ol class="guide-process">{included.map((item, index) => (
          <li><span class="guide-step" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>
        ))}</ol>
        <p class="guide-note">Korekta w ramach zabiegu głównego i odświeżenie starszego makijażu to różne zakresy pracy. Przy wcześniejszej pigmentacji najpierw ustalamy, jaki sposób postępowania będzie odpowiedni.</p>
      </section>

      <section class="guide-section" id="dobor">
        <p class="guide-kicker">04 / Świadomy wybór</p>
        <h2>Dlaczego nie warto wybierać kreski tylko po cenie?</h2>
        <div class="guide-copy-columns">
          <p>Makijaż permanentny oczu wymaga precyzji, kwalifikacji i umiaru. Inny zakres pracy ma podkreślenie rzęs, inny rozbudowany eyeliner. Porównując oferty, sprawdź rodzaj kreski, zakres korekty, doświadczenie osoby wykonującej zabieg i sposób kwalifikacji.</p>
          <p>Przy opadającej powiece mocna kreska nie zawsze będzie dobrym kierunkiem. Znaczenie mają również asymetria, wcześniejszy makijaż, wrażliwość okolicy oka oraz oczekiwany efekt. Dobrze dobrana kreska może być subtelna i nadal wyraźnie podkreślać spojrzenie.</p>
        </div>
        <div class="guide-callout"><h3>Masz opadającą powiekę lub wcześniejszą pigmentację?</h3><p>Zacznij od konsultacji. Oceniamy budowę powieki, wcześniejszy pigment i możliwości wykonania nowego projektu.</p><div class="guide-inline-links"><a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/">Kreska przy opadającej powiece →</a><a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu" data-guide-action="qualification">Opisz swój przypadek →</a></div></div>
      </section>

      <section class="guide-section guide-expert" id="doswiadczenie">
        <div><p class="guide-kicker">05 / Doświadczenie ma znaczenie</p><h2>Bogusława Herda</h2><p class="guide-expert-role">Linergistka · trenerka makijażu permanentnego</p></div>
        <div><p>Dyplomowana linergistka, Elite Top Linergist Long-Time-Liner®, trenerka i prelegentka międzynarodowa, wicemistrzyni świata oraz mistrzyni Polski. W makijażu permanentnym oczu najważniejsze są dla niej precyzja, odpowiedzialność i dopasowanie podkreślenia do naturalnej anatomii.</p><a class="guide-text-link" href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie Bogusława Herda →</a></div>
      </section>

      <section class="guide-section" id="praktyka">
        <p class="guide-kicker">Stanowisko Bogusława Herda</p>
        <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
        <blockquote><p>Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki. Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny, naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę i plan postępowania.</p><footer>Bogusława Herda · praktyka gabinetowa</footer></blockquote>
        <p class="guide-measure">Przed rezerwacją warto ustalić, czy interesuje Cię delikatne podkreślenie rzęs, czy bardziej widoczny eyeliner. Ostateczny projekt powstaje po ocenie oka i powieki. Jeśli masz stare PMU, zgłoś je już przy pierwszym kontakcie.</p>
      </section>

      <section class="guide-section" id="faq">
        <p class="guide-kicker">Pytania przed rezerwacją</p><h2>Kreska permanentna — pytania o cenę i korektę</h2>
        <div class="guide-faq">{faqItems.map(item => (<details><summary>{item.question}<span aria-hidden="true">+</span></summary><div><p>{item.answer}</p></div></details>))}</div>
      </section>

      <section class="guide-section" id="zrodla">
        <p class="guide-kicker">Źródła i aktualność</p><h2>Skąd pochodzą ceny i informacje?</h2>
        <p class="guide-measure">Ceny i termin korekty pochodzą z <a href="/cennik-makijaz-permanentny/#price-group-2">cennika gabinetu Bogusława Herda</a>. Ostatnia aktualizacja tego poradnika: <time datetime={article.dateModified}>7 września 2026 r.</time></p>
        <p class="guide-measure">Informacje o specyfice pigmentacji i możliwych powikłaniach uzupełniamy materiałami dermatologicznymi oraz instytucjonalnymi. Źródła te dotyczą PMU i bezpieczeństwa — ceny określa gabinet.</p>
        <ul class="guide-sources">
          <li><a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">Permanent makeup: A review of its technique, regulation, and complications</a><span>Przegląd dermatologiczny · PubMed</span></li>
          <li><a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">Tattoos &amp; Permanent Makeup: Fact Sheet</a><span>Materiały informacyjne · FDA</span></li>
        </ul>
        <p class="guide-small">Treść ma charakter edukacyjny i nie zastępuje indywidualnej kwalifikacji ani konsultacji medycznej. Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.</p>
      </section>

      <section class="guide-booking" aria-labelledby="guide-booking-title">
        <p class="guide-kicker">Twój następny krok</p><h2 id="guide-booking-title">Wybierz kreskę dopasowaną do siebie.</h2><p>Sprawdź terminy albo porozmawiaj z gabinetem o swojej powiece i oczekiwanym efekcie.</p>
        <div class="guide-actions">
          <a class="guide-button" href={booksyUrl} target="_blank" rel="noopener noreferrer" data-guide-action="booksy">Sprawdź terminy w Booksy ↗</a>
          <a class="guide-button guide-button-light" href="tel:+48730900125" data-guide-action="phone">Zadzwoń: 730 900 125</a>
          <a class="guide-text-link" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu" data-guide-action="qualification">Formularz PMU →</a>
        </div>
      </section>

      <nav class="guide-related" aria-label="Czytaj dalej o makijażu permanentnym oczu">
        <a href="/makijaz-permanentny-oczu/">Oferta makijażu permanentnego oczu →</a>
        <a href="/poradnik/kreska-permanentna-gojenie/">Jak goi się kreska permanentna? →</a>
        <a href="/poradnik/kreski-permanentne-cieniowane/">Kreski cieniowane →</a>
        <a href="/poradnik/">← Wszystkie poradniki PMU</a>
      </nav>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Zdarzenie pomocnicze do analizy kliknięć; nie zastępuje istniejących konwersji.
  document.querySelectorAll<HTMLAnchorElement>("[data-guide-action]").forEach(link => {
    link.addEventListener("click", () => {
      const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof gtag === "function") gtag("event", "pmu_guide_cta_click", {
        action: link.dataset.guideAction, page_path: window.location.pathname,
      });
    });
  });
</script>

<style>
  .pmu-guide { --guide-ink: #292323; --guide-muted: #625958; --guide-teal: #126b65; --guide-line: #e8ded8; color: var(--guide-ink); background: linear-gradient(180deg, #fffaf7 0, #fff 1000px); padding: 122px 0 64px; font-size: 1rem; line-height: 1.75; }
  .guide-shell { width: min(1100px, calc(100% - 56px)); margin-inline: auto; }
