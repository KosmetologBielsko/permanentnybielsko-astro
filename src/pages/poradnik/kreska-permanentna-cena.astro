---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-permanentna-cena",
  title: "Kreska permanentna cena 2026 — ile kosztuje makijaż permanentny oczu?",
  eyebrow: "Poradnik PMU",
  category: "Ceny PMU",
  datePublished: "2026-06-21",
  dateModified: "2026-08-20",
  readingTime: "8–10 minut",
  description: "Kreska permanentna cena 2026. Sprawdź, ile kosztuje kreska zagęszczająca, dekoracyjna, dolna i cieniowana, co obejmuje cena oraz od czego zależy dobór kreski PMU.",
  lead: "Cena kreski permanentnej zależy od rodzaju pigmentacji, zakresu pracy i budowy oka. Inaczej wyceniana jest subtelna kreska zagęszczająca linię rzęs, inaczej dekoracyjny eyeliner, kreska dolna albo połączenie kilku zakresów w jednej wizycie.",
  shortAnswer: "W gabinecie Bogusława Herda w Bielsku-Białej kreska permanentna kosztuje od 500 zł za kreskę dolną, 800 zł za kreskę zagęszczającą, 1100 zł za kreskę dekoracyjną lub eyeliner oraz do 1400 zł przy połączeniu kreski dolnej z dekoracyjną. Ceny zabiegów oznaczonych gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące.",
  canonicalPath: "/poradnik/kreska-permanentna-cena/",
  mainService: {
    href: "/makijaz-permanentny-oczu/",
    title: "Makijaż permanentny oczu",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Ile kosztuje kreska permanentna?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Cena zależy od rodzaju kreski. W gabinecie Bogusława Herda kreska dolna kosztuje 500 zł, kreska zagęszczająca 800 zł, kreska dekoracyjna 1100 zł, a połączenie kreski dolnej z dekoracyjną 1400 zł.",
        },
      },
      {
        "@type": "Question",
        name: "Ile kosztuje kreska zagęszczająca?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Kreska zagęszczająca kosztuje 800 zł. To subtelna pigmentacja przy linii rzęs, która ma optycznie zagęścić spojrzenie bez efektu mocnego eyelinera.",
        },
      },
      {
        "@type": "Question",
        name: "Ile kosztuje kreska dekoracyjna permanentna?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Kreska dekoracyjna, eyeliner lub kreska cieniowana kosztuje 1100 zł. Ostateczny wybór efektu zależy od budowy oka, powieki i kwalifikacji zabiegowej.",
        },
      },
      {
        "@type": "Question",
        name: "Czy cena kreski permanentnej obejmuje korektę?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "W przypadku usług oznaczonych gwiazdką cena obejmuje zabieg główny wraz z korektą w terminie 1–3 miesiące.",
        },
      },
      {
        "@type": "Question",
        name: "Czy kreska dolna jest dla każdego?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze. Kreska dolna wymaga ostrożnej kwalifikacji, ponieważ może optycznie zmienić kształt oka. Decyzję najlepiej podjąć po rozmowie i ocenie budowy oka.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#ceny-kreski">Ceny kresek PMU</a>
            <a href="#rodzaje-kresek">Rodzaje kresek</a>
            <a href="#co-obejmuje-cena">Zakres ceny</a>
            <a href="#doswiadczenie">Autorytet</a>
            <a href="#dobor">Dobór zabiegu</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="ceny-kreski">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Ceny kresek PMU</p>
            <h2>Ile kosztuje kreska permanentna w 2026 roku?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Cennik makijażu permanentnego oczu obejmuje kilka rodzajów kresek. Każda z nich ma inny zakres pracy, inny efekt i inną trudność techniczną. Dlatego przed wyborem ceny warto najpierw zrozumieć, czym różnią się poszczególne typy pigmentacji.</p>
            <p>Najdelikatniejszym rozwiązaniem jest kreska zagęszczająca linię rzęs. Bardziej wyrazisty efekt daje kreska dekoracyjna, eyeliner lub kreska cieniowana. Kreska dolna jest osobną usługą, a przy połączeniu dolnej i górnej zakres pracy jest większy.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Kreska dolna</h3>
              <p>500 zł — subtelne podkreślenie dolnej powieki, wymagające ostrożnego doboru efektu.</p>
            </article>
            <article>
              <h3>Kreska zagęszczająca</h3>
              <p>800 zł — pigmentacja przy linii rzęs, która ma optycznie zagęścić spojrzenie bez efektu mocnego eyelinera.</p>
            </article>
            <article>
              <h3>Kreska dekoracyjna</h3>
              <p>1100 zł — eyeliner lub kreska cieniowana, dobierana do powieki i oczekiwanego efektu.</p>
            </article>
            <article>
              <h3>Kreska dolna + dekoracyjna</h3>
              <p>1400 zł — większy zakres pracy obejmujący połączenie dolnej i górnej kreski dekoracyjnej.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="rodzaje-kresek">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Rodzaje kresek</p>
            <h2>Kreska zagęszczająca, dekoracyjna, dolna — czym się różnią?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Kreska zagęszczająca jest zwykle najbardziej subtelna. Jej celem jest optyczne zagęszczenie linii rzęs i podkreślenie oka bez wyraźnego efektu makijażu. To rozwiązanie dla osób, które chcą wyglądać naturalnie i świeżo na co dzień.</p>
            <p>Kreska dekoracyjna lub eyeliner są bardziej widoczne. Mogą mocniej podkreślać oko, ale wymagają bardzo uważnej kwalifikacji, szczególnie przy opadającej powiece, asymetrii, wrażliwej skórze i oczekiwaniu trwałego efektu.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Efekt naturalny</h3>
              <p>Najczęściej uzyskuje się go przy kresce zagęszczającej, która podkreśla oko bez ciężkiego konturu.</p>
            </article>
            <article>
              <h3>Efekt makijażowy</h3>
              <p>Kreska dekoracyjna daje mocniejsze podkreślenie, ale musi być dopasowana do anatomii oka.</p>
            </article>
            <article>
              <h3>Kreska dolna</h3>
              <p>Nie zawsze jest najlepszym wyborem dla każdej osoby. Wymaga oceny budowy oka i oczekiwanego efektu.</p>
            </article>
            <article>
              <h3>Kreska cieniowana</h3>
              <p>Może dawać miększy rezultat niż klasyczny eyeliner, ale wymaga doświadczenia i kontroli techniki.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="co-obejmuje-cena">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Zakres ceny</p>
            <h2>Co obejmuje cena makijażu permanentnego oczu?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Cena kreski permanentnej obejmuje nie tylko samą pigmentację. Ważna jest rozmowa, kwalifikacja, ocena powieki, dobór rodzaju kreski, omówienie przeciwwskazań, wykonanie zabiegu, zalecenia pozabiegowe oraz korekta w terminie 1–3 miesiące, jeśli dana pozycja jest oznaczona gwiazdką w cenniku.</p>
            <p>Przy makijażu permanentnym oczu szczególnie istotne jest bezpieczeństwo i ostrożność. Oko, powieka i linia rzęs są delikatnym obszarem, dlatego cena powinna odzwierciedlać doświadczenie osoby wykonującej zabieg i odpowiedzialność za efekt.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Kwalifikacja oka</h3>
              <p>Przed zabiegiem trzeba ocenić budowę powieki, oczekiwania i możliwość wykonania konkretnego rodzaju kreski.</p>
            </article>
            <article>
              <h3>Dobór kreski</h3>
              <p>Nie każda kreska pasuje do każdego oka. Czasem lepiej wybrać subtelne zagęszczenie niż mocny eyeliner.</p>
            </article>
            <article>
              <h3>Zalecenia po zabiegu</h3>
              <p>Prawidłowe gojenie okolicy oka ma znaczenie dla komfortu, bezpieczeństwa i trwałości efektu.</p>
            </article>
            <article>
              <h3>Korekta po wygojeniu</h3>
              <p>Po czasie można ocenić, jak pigment przyjął się w skórze i czy efekt wymaga dopracowania.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="doswiadczenie">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Autorytet</p>
            <h2>Przy kresce permanentnej doświadczenie ma szczególne znaczenie.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Makijaż permanentny oczu wymaga dużej precyzji i odpowiedzialności. Praca odbywa się w delikatnej okolicy, a efekt powinien być dopasowany do oka, powieki, rzęs i naturalnej mimiki twarzy.</p>
            <p>Bogusława Herda to dyplomowana linergistka i trenerka makijażu permanentnego, Elite Top Linergist Long-Time-Liner®, trenerka i prelegentka międzynarodowa, wicemistrzyni świata oraz mistrzyni Polski. Takie doświadczenie ma znaczenie szczególnie przy zabiegach, gdzie kilka milimetrów może zmienić cały odbiór spojrzenia.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Precyzja techniczna</h3>
              <p>Kreska powinna podkreślać oko, a nie optycznie je obciążać lub postarzać.</p>
            </article>
            <article>
              <h3>Bezpieczna kwalifikacja</h3>
              <p>Nie każdy rodzaj kreski będzie dobrym wyborem przy każdej powiece i każdej skórze.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="dobor">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Dobór zabiegu</p>
            <h2>Dlaczego nie warto wybierać kreski tylko po cenie?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Najniższa cena nie powinna być głównym kryterium przy wyborze kreski permanentnej. To zabieg wykonywany w widocznej i wrażliwej okolicy, dlatego ważniejsze są kwalifikacja, umiar, doświadczenie oraz realne dopasowanie efektu do twarzy.</p>
            <p>Dobrze dobrana kreska nie musi być mocna, żeby była widoczna. Często najlepszy efekt daje subtelne zagęszczenie linii rzęs, które podkreśla spojrzenie, ale nie wygląda ciężko po wygojeniu.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Opadająca powieka</h3>
              <p>Przy opadającej powiece mocna kreska nie zawsze jest dobrym kierunkiem. Czasem lepszy jest delikatniejszy efekt.</p>
            </article>
            <article>
              <h3>Naturalne spojrzenie</h3>
              <p>Kreska powinna współgrać z rzęsami i okiem, a nie dominować nad twarzą.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Kiedy potrzebna jest konsultacja przed kreską permanentną?</h3>
            <p>Konsultacja jest szczególnie ważna przy opadającej powiece, wrażliwych oczach, wcześniejszych pigmentacjach, asymetrii, bliznach, tendencji do obrzęków albo oczekiwaniu mocnej kreski dekoracyjnej. W takich sytuacjach najpierw trzeba ocenić, jaki efekt będzie bezpieczny i estetyczny po wygojeniu.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
