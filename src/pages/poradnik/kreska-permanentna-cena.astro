---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-permanentna-cena",
  title: "Kreska permanentna cena 2026 — ile kosztuje makijaż permanentny oczu?",
  eyebrow: "Poradnik PMU",
  category: "Ceny PMU",
  datePublished: "2026-06-21",
  dateModified: "2026-08-20",
  readingTime: "8–10 minut",
  description:
    "Kreska permanentna cena 2026. Sprawdź, ile kosztuje kreska zagęszczająca, dekoracyjna, dolna i cieniowana, co obejmuje cena oraz od czego zależy dobór kreski PMU.",
  lead:
    "Cena kreski permanentnej zależy od rodzaju pigmentacji, zakresu pracy i budowy oka. Inaczej wyceniana jest subtelna kreska zagęszczająca linię rzęs, inaczej dekoracyjny eyeliner, kreska dolna albo połączenie kilku zakresów w jednej wizycie.",
  shortAnswer:
    "W gabinecie Bogusława Herda w Bielsku-Białej kreska permanentna kosztuje od 500 zł za kreskę dolną, 800 zł za kreskę zagęszczającą, 1100 zł za kreskę dekoracyjną lub eyeliner oraz do 1400 zł przy połączeniu kreski dolnej z dekoracyjną. Ceny zabiegów oznaczonych gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące.",
  canonicalPath: "/poradnik/kreska-permanentna-cena/",
  mainService: {
    href: "/makijaz-permanentny-oczu/",
    title: "Makijaż permanentny oczu",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const priceCards = [
  {
    label: "Kreska dolna",
    price: "500 zł",
    text: "subtelne podkreślenie dolnej powieki, wymagające ostrożnego doboru efektu.",
  },
  {
    label: "Kreska zagęszczająca",
    price: "800 zł",
    text: "pigmentacja przy linii rzęs, która ma optycznie zagęścić spojrzenie bez efektu mocnego eyelinera.",
  },
  {
    label: "Kreska dekoracyjna",
    price: "1100 zł",
    text: "eyeliner lub kreska cieniowana, dobierana do powieki i oczekiwanego efektu.",
  },
  {
    label: "Kreska dolna + dekoracyjna",
    price: "1400 zł",
    text: "większy zakres pracy obejmujący połączenie dolnej i górnej kreski dekoracyjnej.",
  },
];

const kinds = [
  {
    title: "Efekt naturalny",
    text: "Najczęściej uzyskuje się go przy kresce zagęszczającej, która podkreśla oko bez ciężkiego konturu.",
  },
  {
    title: "Efekt makijażowy",
    text: "Kreska dekoracyjna daje mocniejsze podkreślenie, ale musi być dopasowana do anatomii oka.",
  },
  {
    title: "Kreska dolna",
    text: "Nie zawsze jest najlepszym wyborem dla każdej osoby. Wymaga oceny budowy oka i oczekiwanego efektu.",
  },
  {
    title: "Kreska cieniowana",
    text: "Może dawać miększy rezultat niż klasyczny eyeliner, ale wymaga doświadczenia i kontroli techniki.",
  },
];

const included = [
  {
    title: "Kwalifikacja oka",
    text: "Przed zabiegiem trzeba ocenić budowę powieki, oczekiwania i możliwość wykonania konkretnego rodzaju kreski.",
  },
  {
    title: "Dobór kreski",
    text: "Nie każda kreska pasuje do każdego oka. Czasem lepiej wybrać subtelne zagęszczenie niż mocny eyeliner.",
  },
  {
    title: "Zalecenia po zabiegu",
    text: "Prawidłowe gojenie okolicy oka ma znaczenie dla komfortu, bezpieczeństwa i trwałości efektu.",
  },
  {
    title: "Korekta po wygojeniu",
    text: "Po czasie można ocenić, jak pigment przyjął się w skórze i czy efekt wymaga dopracowania.",
  },
];

const authorityCards = [
  {
    title: "Precyzja techniczna",
    text: "Kreska powinna podkreślać oko, a nie optycznie je obciążać lub postarzać.",
  },
  {
    title: "Bezpieczna kwalifikacja",
    text: "Nie każdy rodzaj kreski będzie dobrym wyborem przy każdej powiece i każdej skórze.",
  },
];

const choiceCards = [
  {
    title: "Opadająca powieka",
    text: "Przy opadającej powiece mocna kreska nie zawsze jest dobrym kierunkiem. Czasem lepszy jest delikatniejszy efekt.",
  },
  {
    title: "Naturalne spojrzenie",
    text: "Kreska powinna współgrać z rzęsami i okiem, a nie dominować nad twarzą.",
  },
];

const faqItems = [
  {
    question: "Ile kosztuje kreska permanentna?",
    answer:
      "Cena zależy od rodzaju kreski. W gabinecie Bogusława Herda kreska dolna kosztuje 500 zł, kreska zagęszczająca 800 zł, kreska dekoracyjna 1100 zł, a połączenie kreski dolnej z dekoracyjną 1400 zł.",
  },
  {
    question: "Ile kosztuje kreska zagęszczająca?",
    answer:
      "Kreska zagęszczająca kosztuje 800 zł. To subtelna pigmentacja przy linii rzęs, która ma optycznie zagęścić spojrzenie bez efektu mocnego eyelinera.",
  },
  {
    question: "Ile kosztuje kreska dekoracyjna permanentna?",
    answer:
      "Kreska dekoracyjna, eyeliner lub kreska cieniowana kosztuje 1100 zł. Ostateczny wybór efektu zależy od budowy oka, powieki i kwalifikacji zabiegowej.",
  },
  {
    question: "Czy cena kreski permanentnej obejmuje korektę?",
    answer:
      "W przypadku usług oznaczonych gwiazdką cena obejmuje zabieg główny wraz z korektą w terminie 1–3 miesiące.",
  },
  {
    question: "Czy kreska dolna jest dla każdego?",
    answer:
      "Nie zawsze. Kreska dolna wymaga ostrożnej kwalifikacji, ponieważ może optycznie zmienić kształt oka. Decyzję najlepiej podjąć po rozmowie i ocenie budowy oka.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="price-guide-page">
    <Header />

    <main>
      <section class="price-hero">
        <div class="price-glow price-glow-one" aria-hidden="true"></div>
        <div class="price-glow price-glow-two" aria-hidden="true"></div>

        <div class="container price-hero-grid">
          <div class="price-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="price-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="price-lead">{article.lead}</p>

            <div class="price-hero-actions">
              <a class="price-primary" href="#ceny-kreski">
                Ceny kresek PMU <span aria-hidden="true">→</span>
              </a>
              <a class="price-secondary" href={article.mainService.href}>
                {article.mainService.title}
              </a>
            </div>
          </div>

          <aside class="price-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="price-answer-label">Odpowiedź w 20 sekund</p>
            <strong class="price-big">500–1400 zł</strong>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="price-nav-section">
        <div class="container">
          <nav class="price-nav" aria-label="Spis treści artykułu">
            <a href="#ceny-kreski">Ceny kresek PMU</a>
            <a href="#rodzaje-kresek">Rodzaje kresek</a>
            <a href="#co-obejmuje-cena">Zakres ceny</a>
            <a href="#doswiadczenie">Autorytet</a>
            <a href="#dobor">Dobór zabiegu</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
          </nav>
        </div>
      </section>

      <section class="price-section" id="ceny-kreski">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Ceny kresek PMU</p>
            <h2>Ile kosztuje kreska permanentna w 2026 roku?</h2>
          </div>

          <div class="decision-copy">
            <p>
              Cennik makijażu permanentnego oczu obejmuje kilka rodzajów kresek. Każda z nich ma inny zakres pracy, inny efekt i inną trudność techniczną. Dlatego przed wyborem ceny warto najpierw zrozumieć, czym różnią się poszczególne typy pigmentacji.
            </p>
            <p>
              Najdelikatniejszym rozwiązaniem jest kreska zagęszczająca linię rzęs. Bardziej wyrazisty efekt daje kreska dekoracyjna, eyeliner lub kreska cieniowana. Kreska dolna jest osobną usługą, a przy połączeniu dolnej i górnej zakres pracy jest większy.
            </p>
          </div>

          <div class="scenario-scroll" aria-label="Ceny kresek permanentnych">
            {priceCards.map((item) => (
              <article class="scenario-card">
                <span>{item.label}</span>
                <strong>{item.price}</strong>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="rodzaje-kresek">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Rodzaje kresek</p>
            <h2>Kreska zagęszczająca, dekoracyjna, dolna — czym się różnią?</h2>
          </div>

          <div class="decision-copy">
            <p>
              Kreska zagęszczająca jest zwykle najbardziej subtelna. Jej celem jest optyczne zagęszczenie linii rzęs i podkreślenie oka bez wyraźnego efektu makijażu. To rozwiązanie dla osób, które chcą wyglądać naturalnie i świeżo na co dzień.
            </p>
            <p>
              Kreska dekoracyjna lub eyeliner są bardziej widoczne. Mogą mocniej podkreślać oko, ale wymagają bardzo uważnej kwalifikacji, szczególnie przy opadającej powiece, asymetrii, wrażliwej skórze i oczekiwaniu trwałego efektu.
            </p>
          </div>

          <div class="included-grid">
            {kinds.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section" id="co-obejmuje-cena">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Zakres ceny</p>
            <h2>Co obejmuje cena makijażu permanentnego oczu?</h2>
          </div>

          <div class="decision-copy">
            <p>
              Cena kreski permanentnej obejmuje nie tylko samą pigmentację. Ważna jest rozmowa, kwalifikacja, ocena powieki, dobór rodzaju kreski, omówienie przeciwwskazań, wykonanie zabiegu, zalecenia pozabiegowe oraz korekta w terminie 1–3 miesiące, jeśli dana pozycja jest oznaczona gwiazdką w cenniku.
            </p>
            <p>
              Przy makijażu permanentnym oczu szczególnie istotne jest bezpieczeństwo i ostrożność. Oko, powieka i linia rzęs są delikatnym obszarem, dlatego cena powinna odzwierciedlać doświadczenie osoby wykonującej zabieg i odpowiedzialność za efekt.
            </p>
          </div>

          <div class="included-grid">
            {included.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="doswiadczenie">
        <div class="container expert-card">
          <div>
            <p class="section-kicker">Autorytet</p>
            <h2>Przy kresce permanentnej doświadczenie ma szczególne znaczenie.</h2>
            <p>
              Makijaż permanentny oczu wymaga dużej precyzji i odpowiedzialności. Praca odbywa się w delikatnej okolicy, a efekt powinien być dopasowany do oka, powieki, rzęs i naturalnej mimiki twarzy.
            </p>
            <p>
              Bogusława Herda to dyplomowana linergistka i trenerka makijażu permanentnego, Elite Top Linergist Long-Time-Liner®, trenerka i prelegentka międzynarodowa, wicemistrzyni świata oraz mistrzyni Polski. Takie doświadczenie ma znaczenie szczególnie przy zabiegach, gdzie kilka milimetrów może zmienić cały odbiór spojrzenia.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            {authorityCards.map((item) => (
              <>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </>
            ))}
          </aside>
        </div>
      </section>

      <section class="price-section" id="dobor">
        <div class="container decision-grid">
          <div class="decision-copy">
            <p class="section-kicker">Dobór zabiegu</p>
            <h2>Dlaczego nie warto wybierać kreski tylko po cenie?</h2>
            <p>
              Najniższa cena nie powinna być głównym kryterium przy wyborze kreski permanentnej. To zabieg wykonywany w widocznej i wrażliwej okolicy, dlatego ważniejsze są kwalifikacja, umiar, doświadczenie oraz realne dopasowanie efektu do twarzy.
            </p>
            <p>
              Dobrze dobrana kreska nie musi być mocna, żeby była widoczna. Często najlepszy efekt daje subtelne zagęszczenie linii rzęs, które podkreśla spojrzenie, ale nie wygląda ciężko po wygojeniu.
            </p>
          </div>

          <div class="decision-cards">
            {choiceCards.map((item) => (
              <article>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section price-soft">
        <div class="container">
          <div class="qualification-strip">
            <div>
              <span>Ważne</span>
              <strong>Kiedy potrzebna jest konsultacja przed kreską permanentną?</strong>
              <p>
                Konsultacja jest szczególnie ważna przy opadającej powiece, wrażliwych oczach, wcześniejszych pigmentacjach, asymetrii, bliznach, tendencji do obrzęków albo oczekiwaniu mocnej kreski dekoracyjnej. W takich sytuacjach najpierw trzeba ocenić, jaki efekt będzie bezpieczny i estetyczny po wygojeniu.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="price-section expert-section" id="praktyka">
        <div class="container expert-card">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="price-section price-soft">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="related-scroll">
            <a href="/makijaz-permanentny-oczu/">
              <span>Makijaż permanentny oczu</span>
              <strong>Makijaż permanentny oczu</strong>
              <p>Poznaj rodzaje kresek permanentnych i sposób doboru efektu.</p>
            </a>

            <a href="/cennik-makijaz-permanentny/">
              <span>Cennik PMU</span>
              <strong>Cennik PMU</strong>
              <p>Zobacz ceny brwi, ust, kresek, odświeżeń i usuwania PMU.</p>
            </a>

            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/">
              <span>Jak wybrać rodzaj kreski?</span>
              <strong>Jak wybrać rodzaj kreski?</strong>
              <p>Sprawdź, czym różni się kreska zagęszczająca, dekoracyjna i cieniowana.</p>
            </a>

            <a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/">
              <span>Kreska przy opadającej powiece</span>
              <strong>Kreska przy opadającej powiece</strong>
              <p>Zobacz, dlaczego przy opadającej powiece dobór kreski wymaga ostrożności.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="price-section sources-section" id="zrodla">
        <div class="container">
          <div class="sources-card">
            <div>
              <p class="section-kicker">Źródła i materiały odniesienia</p>
              <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
              <p>
                Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
                Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
              </p>
            </div>
          </div>

          <div class="related-scroll">
            <a href="/cennik-makijaz-permanentny/">
              <span>PermanentnyBielsko.com</span>
              <strong>Aktualny cennik makijażu permanentnego</strong>
              <p>Źródło aktualnych cen usług publikowanych przez gabinet.</p>
            </a>

            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <strong>Permanent makeup: A review of its technique, regulation, and complications</strong>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
            </a>

            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <strong>Tattoos & Permanent Makeup: Fact Sheet</strong>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="price-section" id="faq">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div><p>{item.answer}</p></div>
              </details>
