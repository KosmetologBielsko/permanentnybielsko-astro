---
import { getImage } from "astro:assets";
import GuideSeriesByline from "../../components/GuideSeriesByline.astro";
import GuideArticleMedia from "../../components/GuideArticleMedia.astro";
import GuideArticleSocial from "../../components/GuideArticleSocial.astro";
import GuideAssistant from "../../components/GuideAssistant.astro";
import { guideMedia } from "../../data/guide-series-05";
import "../../styles/guide-article.css";
import "../../styles/guide-series-next.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-oczu-bielsko-biala",
  title: "Makijaż permanentny oczu Bielsko-Biała — kreska permanentna i zagęszczenie linii rzęs",
  eyebrow: "Poradnik PMU",
  category: "Kreski permanentne Bielsko-Biała",
  datePublished: "2026-07-05",
  dateModified: "2026-09-09",
  readingTime: "8–10 minut",
  description: "Makijaż permanentny oczu Bielsko-Biała: kreska permanentna, zagęszczenie linii rzęs, kreska górna i dolna, opadająca powieka, gojenie i dobór efektu.",
  lead: "Makijaż permanentny oczu najczęściej wybierany jest nie po to, żeby zastąpić mocny eyeliner, ale żeby subtelnie zagęścić linię rzęs i podkreślić spojrzenie. W Bielsku-Białej klientki często pytają o kreskę permanentną, kreskę w linii rzęs, kreskę górną, dolną i o to, czy taki zabieg ma sens przy opadającej powiece.",
  shortAnswer: "Makijaż permanentny oczu w Bielsku-Białej powinien być dobrany do budowy oka, powieki, rzęs i oczekiwanego efektu. Najbezpieczniejszym i najbardziej uniwersalnym wyborem jest często subtelne zagęszczenie linii rzęs, a nie ciężka dekoracyjna kreska.",
  canonicalPath: "/poradnik/makijaz-permanentny-oczu-bielsko-biala/",
  mainService: {
    href: "/makijaz-permanentny-oczu/",
    title: "Makijaż permanentny oczu",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy kreska permanentna musi być mocna?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. Bardzo często najlepszy efekt daje subtelne zagęszczenie linii rzęs, które podkreśla spojrzenie bez ciężkiego eyelinera.",
        },
      },
      {
        "@type": "Question",
        name: "Czy kreska permanentna pasuje przy opadającej powiece?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Czasem tak, ale zwykle wymaga delikatniejszego projektu. Przy opadającej powiece mocna kreska może obciążać oko.",
        },
      },
      {
        "@type": "Question",
        name: "Czym różni się kreska od zagęszczenia linii rzęs?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Zagęszczenie jest subtelniejsze i pracuje bliżej linii rzęs. Kreska dekoracyjna jest bardziej widoczna i wymaga większej ostrożności w doborze.",
        },
      },
      {
        "@type": "Question",
        name: "Czy po PMU oczu można od razu robić makijaż?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie należy nakładać makijażu na świeżo pigmentowaną okolicę. Trzeba przestrzegać zaleceń pozabiegowych i dać skórze czas na wygojenie.",
        },
      },
      {
        "@type": "Question",
        name: "Czy klientki spoza Bielska-Białej umawiają się na kreski permanentne?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Do Bielska-Białej mogą wygodnie dojechać klientki z Czechowic-Dziedzic, Jaworza, Kóz, Żywca, Szczyrku, Skoczowa, Kęt i okolic.",
        },
      }
    ],
  },
];

const media = guideMedia["makijaz-permanentny-oczu-bielsko-biala"];
const socialImage = await getImage({ src: media.cover.src, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const articleWithImages = structuredData.map(item => item["@type"] === "Article"
  ? { ...item, image: [new URL(socialImage.src, "https://www.permanentnybielsko.com").href] } : item);
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={articleWithImages}
  ogImage={socialImage.src}
  ogImageAlt={media.cover.alt}
  ogType="article"
  showGuideSocial={false}
  inlineGuideAssistant
>
  <div class="expert-article-page">
    <Header compact />

    <main class="pmu-guide-v3 pmu-guide-v4">
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
            <GuideSeriesByline />
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <details class="guide-toc" open><summary>Przejdź do wybranej odpowiedzi</summary><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#rodzaje">Rodzaje kresek</a>
            <a href="#powieka">Analiza oka</a>
            <a href="#gojenie">Po zabiegu</a>
            <a href="#region">Lokalnie</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav></details>
        </div>
      </section>
<div class:list={["guide-series-cover", { "portrait-cover": media.cover.src.height > media.cover.src.width }]}>
  <GuideArticleMedia photos={[media.cover]} cover />
</div>


      <section class="expert-article-section" id="rodzaje">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Rodzaje kresek</p>
            <h2>Kreska permanentna nie zawsze oznacza mocny eyeliner.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Najczęściej najbardziej elegancki efekt daje kreska w linii rzęs, czyli subtelne zagęszczenie, które optycznie podkreśla oko bez ciężkiej, widocznej linii. Taki efekt sprawdza się u osób, które chcą wyglądać świeżo również bez codziennego makijażu.</p>
            <p>Kreska dekoracyjna, górna, dolna albo bardziej widoczna wymaga dokładniejszej analizy. Liczy się kształt oka, powieka, asymetria, kierunek rzęs, codzienny styl makijażu i to, czy efekt będzie dobrze wyglądał także po kilku miesiącach.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Zagęszczenie linii rzęs</h3>
              <p>Subtelny, naturalny efekt dla osób, które chcą podkreślić spojrzenie bez ciężkiej kreski.</p>
            </article>
            <article>
              <h3>Kreska górna</h3>
              <p>Może być delikatna lub bardziej widoczna, ale zawsze powinna wynikać z budowy oka.</p>
            </article>
            <article>
              <h3>Kreska dolna</h3>
              <p>Wymaga ostrożności i dobrego dopasowania, żeby nie obciążyć spojrzenia.</p>
            </article>
            <article>
              <h3>Kreska dekoracyjna</h3>
              <p>Nie każdej osobie będzie pasować. Decyzja wymaga spokojnej analizy powieki.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="powieka">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Analiza oka</p>
            <h2>Opadająca powieka zmienia decyzję o rodzaju kreski.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Przy opadającej powiece mocna kreska może chować się w załamaniu, optycznie obciążać oko albo wyglądać inaczej niż na inspiracji. Dlatego w wielu przypadkach lepszym kierunkiem jest subtelne zagęszczenie linii rzęs zamiast dekoracyjnego eyelinera.</p>
            <p>Dobór kreski powinien uwzględniać nie tylko to, co podoba się na zdjęciu, ale też realną budowę oka i to, jak klientka wygląda bez makijażu. Celem jest podkreślenie spojrzenia, a nie stworzenie efektu, który będzie trudny do noszenia na co dzień.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Mniej może znaczyć lepiej</h3>
              <p>Przy oku z opadającą powieką delikatniejszy efekt bywa bardziej elegancki i bezpieczny wizualnie.</p>
            </article>
            <article>
              <h3>Projekt i rozmowa</h3>
              <p>Przed zabiegiem warto omówić styl, przyzwyczajenia i ograniczenia wynikające z budowy oka.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="gojenie">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Po zabiegu</p>
            <h2>Gojenie kreski wymaga delikatności.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Po makijażu permanentnym oczu może pojawić się tkliwość, delikatny obrzęk albo uczucie napięcia. To okolica bardzo wrażliwa, dlatego po zabiegu ważne jest przestrzeganie zaleceń, higiena i unikanie drażnienia powiek.</p>
            <p>W okresie gojenia nie należy przyspieszać złuszczania, trzeć oczu, nakładać makijażu na świeżo pigmentowaną okolicę ani używać przypadkowych kosmetyków. Ostateczny efekt ocenia się po wygojeniu, gdy pigment i skóra się ustabilizują.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Bez tarcia</h3>
              <p>Okolica oka po pigmentacji wymaga szczególnej delikatności i czystych nawyków.</p>
            </article>
            <article>
              <h3>Bez pośpiechu</h3>
              <p>Finalny efekt kreski ocenia się po wygojeniu, nie w pierwszych dniach po zabiegu.</p>
            </article>
          </div>
        </div>
      </section>
<GuideArticleMedia photos={media.photos} label={media.label} />


      <section class="expert-article-section expert-article-soft" id="region">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Lokalnie</p>
            <h2>Makijaż permanentny oczu w Bielsku-Białej i regionie.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Frazy makijaż permanentny oczu Bielsko-Biała, kreska permanentna Bielsko-Biała czy zagęszczenie linii rzęs Bielsko zwykle oznaczają potrzebę subtelnego, bezpiecznego podkreślenia spojrzenia. W tym temacie szczególnie ważna jest analiza oka, nie tylko cena.</p>
            <p>Na konsultacje i zabiegi do Bielska-Białej mogą dojechać klientki z Czechowic-Dziedzic, Kóz, Jaworza, Wilkowic, Żywca, Szczyrku, Skoczowa, Kęt, Pszczyny i okolic. Przy kreskach permanentnych warto wybrać miejsce, które umie odmówić zbyt ciężkiego efektu, jeśli nie będzie korzystny.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Bielsko-Biała</h3>
              <p>Kreski permanentne, zagęszczenie linii rzęs i konsultacja przed pigmentacją oczu.</p>
            </article>
            <article>
              <h3>Okolice</h3>
              <p>Czechowice-Dziedzice, Kozy, Jaworze, Żywiec, Szczyrk, Skoczów, Kęty i region.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Kiedy kreska permanentna może nie być dobrym wyborem?</h3>
            <p>Jeśli powieka jest mocno podrażniona, występuje stan zapalny, świeży zabieg w okolicy oka, problem okulistyczny albo oczekiwana kreska nie pasuje do budowy powieki, lepiej rozpocząć od konsultacji i spokojnie dobrać bezpieczniejszy wariant.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/">
              <h3>Kreska permanentna — rodzaje</h3>
              <p>Jak dobrać zagęszczenie linii rzęs, kreskę górną i dolną.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/">
              <h3>Kreska przy opadającej powiece</h3>
              <p>Kiedy wybrać delikatniejsze rozwiązanie i czego unikać.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kreska-permanentna-gojenie/">
              <h3>Gojenie kreski permanentnej</h3>
              <p>Pielęgnacja powiek po PMU i najważniejsze ograniczenia.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-bielsko-biala/">
              <h3>Makijaż permanentny Bielsko-Biała</h3>
              <p>Przewodnik po brwiach, ustach, kreskach i wyborze gabinetu.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <h3>Permanent makeup: A review of its technique, regulation, and complications</h3>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoos & Permanent Makeup: Fact Sheet</h3>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Caring for tattooed skin</h3>
              <p>Zalecenia dermatologów dotyczące ochrony i pielęgnacji pigmentowanej skóry.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <GuideArticleSocial />
<section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Czy kreska permanentna musi być mocna?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie. Bardzo często najlepszy efekt daje subtelne zagęszczenie linii rzęs, które podkreśla spojrzenie bez ciężkiego eyelinera.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy kreska permanentna pasuje przy opadającej powiece?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Czasem tak, ale zwykle wymaga delikatniejszego projektu. Przy opadającej powiece mocna kreska może obciążać oko.</p></div>
            </details>
            <details>
              <summary>
                <span>Czym różni się kreska od zagęszczenia linii rzęs?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Zagęszczenie jest subtelniejsze i pracuje bliżej linii rzęs. Kreska dekoracyjna jest bardziej widoczna i wymaga większej ostrożności w doborze.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy po PMU oczu można od razu robić makijaż?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie należy nakładać makijażu na świeżo pigmentowaną okolicę. Trzeba przestrzegać zaleceń pozabiegowych i dać skórze czas na wygojenie.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy klientki spoza Bielska-Białej umawiają się na kreski permanentne?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
