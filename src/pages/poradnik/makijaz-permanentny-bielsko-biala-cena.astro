            <div class="guide-answer-price">
              <span>Brwi permanentne</span>
              <strong>od 1200 zł</strong>
            </div>

            <p>{article.shortAnswer}</p>

            <a href="#ceny-brwi">Zobacz ceny ↓</a>
          </aside>
