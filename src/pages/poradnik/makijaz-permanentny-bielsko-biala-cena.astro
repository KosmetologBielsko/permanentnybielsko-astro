---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-bielsko-biala-cena",
  title: "Makijaż permanentny Bielsko-Biała cena — ile kosztują brwi, usta i kreski?",
  eyebrow: "Poradnik PMU",
  category: "Ceny PMU Bielsko-Biała",
  datePublished: "2026-07-05",
  dateModified: "2026-08-20",
  readingTime: "8–10 minut",
  description: "Makijaż permanentny Bielsko-Biała cena: ile kosztują brwi permanentne, usta permanentne i kreski permanentne? Sprawdź, co obejmuje cena i od czego zależy wycena PMU.",
  lead: "Cena makijażu permanentnego w Bielsku-Białej nie powinna być analizowana wyłącznie jako kwota za sam zabieg. Przy brwiach, ustach i kreskach liczy się konsultacja, rysunek wstępny, dobór techniki, praca ze skórą, bezpieczeństwo i ocena efektu po wygojeniu.",
  shortAnswer: "Cena PMU w Bielsku-Białej zależy od obszaru zabiegu, metody, skóry, wcześniejszych pigmentacji i zakresu pracy. Warto porównywać nie tylko kwoty, ale też to, czy cena obejmuje konsultację, projekt, korektę, zalecenia i doświadczenie linergistki.",
  canonicalPath: "/poradnik/makijaz-permanentny-bielsko-biala-cena/",
  mainService: {
    href: "/cennik-makijaz-permanentny/",
    title: "Cennik makijażu permanentnego",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Ile kosztuje makijaż permanentny w Bielsku-Białej?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Cena zależy od obszaru zabiegu, techniki i zakresu pracy. Inaczej wycenia się brwi, usta, kreski, odświeżenie i korektę starego pigmentu.",
        },
      },
      {
        "@type": "Question",
        name: "Czy korekta jest w cenie zabiegu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "W wielu zabiegach głównych korekta po wygojeniu jest elementem procesu, ale zawsze warto sprawdzić konkretny cennik i termin wykonania korekty.",
        },
      },
      {
        "@type": "Question",
        name: "Dlaczego metoda włoskowa brwi może kosztować więcej?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Wymaga bardzo precyzyjnej pracy, kwalifikacji skóry, kontroli kierunku włosa i doświadczenia w uzyskiwaniu naturalnego efektu.",
        },
      },
      {
        "@type": "Question",
        name: "Czy tani makijaż permanentny to zły wybór?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze, ale sama niska cena nie wystarczy. Trzeba sprawdzić doświadczenie, zdjęcia wygojonych efektów, higienę, konsultację i zasady korekty.",
        },
      },
      {
        "@type": "Question",
        name: "Gdzie sprawdzić aktualne ceny PMU?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najlepiej w aktualnym cenniku na stronie oraz podczas konsultacji, jeśli zabieg dotyczy starego pigmentu, korekty albo indywidualnego przypadku.",
        },
      }
    ],
  },
];
---

