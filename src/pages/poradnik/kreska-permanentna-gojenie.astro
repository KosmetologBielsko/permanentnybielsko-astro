---
import { getImage } from "astro:assets";
import GuideSeriesByline from "../../components/GuideSeriesByline.astro";
import GuideArticleMedia from "../../components/GuideArticleMedia.astro";
import GuideArticleSocial from "../../components/GuideArticleSocial.astro";
import GuideAssistant from "../../components/GuideAssistant.astro";
import { guideMedia } from "../../data/guide-series-04";
import "../../styles/guide-article.css";
import "../../styles/guide-series-next.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-permanentna-gojenie",
  title: "Kreska permanentna — gojenie, pielęgnacja i czego unikać po zabiegu",
  eyebrow: "Poradnik PMU",
  category: "Kreski permanentne",
  datePublished: "2026-06-22",
  dateModified: "2026-09-09",
  readingTime: "10–13 minut",
  description: "Jak goi się kreska permanentna? Zobacz pielęgnację powiek po PMU oczu, obrzęk, strupki, makijaż, tusz do rzęs, soczewki i czego unikać po zabiegu.",
  lead: "Okolica oka jest delikatna, dlatego po kresce permanentnej trzeba szczególnie uważać na tarcie, makijaż, kosmetyki, soczewki, pocieranie powiek i przypadkowe preparaty. Efekt kreski ocenia się dopiero po wygojeniu.",
  shortAnswer: "Po kresce permanentnej powieka może być wrażliwa, lekko opuchnięta i bardziej napięta. Świeża kreska może wyglądać mocniej niż efekt po wygojeniu. W trakcie gojenia nie należy trzeć oczu, odrywać strupków, nakładać makijażu na świeżą pigmentację ani stosować przypadkowych kosmetyków w okolicy powiek.",
  canonicalPath: "/poradnik/kreska-permanentna-gojenie/",
  mainService: {
    href: "/makijaz-permanentny-oczu/",
    title: "Kreski permanentne",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/tattoo-skin-reactions",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Jak goi się kreska permanentna?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Powieka może być wrażliwa, lekko opuchnięta i napięta. Świeża kreska może wyglądać intensywniej, a efekt ocenia się po wygojeniu.",
        },
      },
      {
        "@type": "Question",
        name: "Czy po kresce permanentnej można malować oczy?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Makijaż oczu trzeba odłożyć na czas zalecony przez gabinet. Tusz, eyeliner i demakijaż mogą drażnić świeżą pigmentację.",
        },
      },
      {
        "@type": "Question",
        name: "Czy można pocierać oko po zabiegu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. Pocieranie powieki może zaburzyć gojenie i podrażnić delikatną okolicę oka.",
        },
      },
      {
        "@type": "Question",
        name: "Czy po kresce permanentnej pojawiają się strupki?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Może pojawić się delikatne złuszczanie. Nie wolno odrywać skórek ani przyspieszać tego procesu.",
        },
      },
      {
        "@type": "Question",
        name: "Kiedy można wrócić do tuszu do rzęs?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Dopiero po okresie wskazanym przez gabinet, gdy powieka jest spokojna i nie ma aktywnego gojenia.",
        },
      }
    ],
  },
];

const media = guideMedia["kreska-permanentna-gojenie"];
const socialImage = await getImage({ src: media.cover.src, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const articleWithImages = structuredData.map(item => item["@type"] === "Article"
  ? { ...item, image: [new URL(socialImage.src, "https://www.permanentnybielsko.com").href] } : item);
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={articleWithImages}
  ogImage={socialImage.src}
  ogImageAlt={media.cover.alt}
  ogType="article"
  showGuideSocial={false}
  inlineGuideAssistant
>
  <div class="expert-article-page">
    <Header compact />

    <main class="pmu-guide-v3 pmu-guide-v4">
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
            <GuideSeriesByline />
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <details class="guide-toc" open><summary>Przejdź do wybranej odpowiedzi</summary><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#pierwsze-dni">Pierwsze dni</a>
            <a href="#pielegnacja">Pielęgnacja powieki</a>
            <a href="#makijaz">Codzienność</a>
            <a href="#efekt">Efekt po czasie</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav></details>
        </div>
      </section>
<div class:list={["guide-series-cover", { "portrait-cover": media.cover.src.height > media.cover.src.width }]}>
  <GuideArticleMedia photos={[media.cover]} cover />
</div>


      <section class="expert-article-section" id="pierwsze-dni">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Pierwsze dni</p>
            <h2>Jak wygląda powieka po kresce permanentnej?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Po zabiegu powieka może być wrażliwa, delikatnie opuchnięta, napięta albo tkliwa. Kreska może wyglądać wyraźniej niż po wygojeniu, bo pigment jest świeży, a skóra dopiero zaczyna regenerację.</p>
            <p>Nie jest to moment na ocenę finalnej grubości i intensywności. Okolica oka potrzebuje czasu, a każda powieka reaguje indywidualnie.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Wrażliwość</h3>
              <p>Oko i powieka mogą reagować delikatnym obrzękiem lub napięciem.</p>
            </article>
            <article>
              <h3>Intensywność</h3>
              <p>Świeża kreska może wydawać się mocniejsza niż efekt końcowy.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="pielegnacja">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Pielęgnacja powieki</p>
            <h2>Najważniejsza zasada: nie trzeć i nie podrażniać.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Po kresce permanentnej nie należy pocierać oczu, odrywać strupków, drapać powieki ani próbować przyspieszać złuszczania. Skóra w tej okolicy jest cienka i delikatna, dlatego mechaniczne drażnienie może pogorszyć gojenie.</p>
            <p>Pielęgnacja powinna być zgodna z zaleceniami gabinetu. Nie stosuj przypadkowych maści, kremów pod oczy, olejków, serum do rzęs ani aktywnych kosmetyków blisko świeżej pigmentacji.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Bez tarcia</h3>
              <p>Nie pocieraj powiek nawet wtedy, gdy pojawi się swędzenie.</p>
            </article>
            <article>
              <h3>Bez kosmetyków aktywnych</h3>
              <p>Serum, kremy pod oczy i olejki zostaw na później.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="makijaz">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Codzienność</p>
            <h2>Makijaż oczu, tusz, soczewki i demakijaż po kresce.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>W pierwszym okresie po zabiegu trzeba unikać makijażu na świeżej pigmentacji. Tusz do rzęs, eyeliner, cienie, płyny do demakijażu i pocieranie wacikiem mogą niepotrzebnie drażnić powiekę.</p>
            <p>Jeśli nosisz soczewki kontaktowe, omów to z gabinetem przed zabiegiem i trzymaj się zaleceń po pigmentacji. Każde oko reaguje indywidualnie, dlatego komfort i higiena są najważniejsze.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Bez tuszu na start</h3>
              <p>Tusz i demakijaż mogą drażnić okolicę pigmentacji.</p>
            </article>
            <article>
              <h3>Soczewki</h3>
              <p>Ustal zasady z gabinetem, szczególnie przy wrażliwych oczach.</p>
            </article>
          </div>
        </div>
      </section>
<GuideArticleMedia photos={media.photos} label={media.label} />


      <section class="expert-article-section expert-article-soft" id="efekt">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Efekt po czasie</p>
            <h2>Kiedy ocenić kreskę permanentną po wygojeniu?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Kreskę ocenia się po wygojeniu, kiedy powieka jest spokojna, a pigment stabilizuje się w skórze. W połowie gojenia efekt może wydawać się zbyt mocny albo miejscami delikatniejszy.</p>
            <p>Jeśli skóra przyjmie pigment nierównomiernie, dopigmentowanie pozwala dopracować efekt. Dlatego w makijażu permanentnym oczu ważna jest cierpliwość i kontrola po wygojeniu.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Nie oceniaj od razu</h3>
              <p>Świeża kreska nie pokazuje jeszcze finalnego efektu.</p>
            </article>
            <article>
              <h3>Kontrola</h3>
              <p>Po wygojeniu można ocenić, czy efekt wymaga dopracowania.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Objawy, których nie ignoruj</h3>
            <p>Jeśli pojawia się silny ból oka, pogorszenie widzenia, ropienie, narastający obrzęk, reakcja alergiczna albo nietypowe objawy, skontaktuj się z gabinetem i lekarzem. Okolica oka wymaga ostrożności.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/">
              <h3>Jak wybrać rodzaj kreski?</h3>
              <p>Porównanie zagęszczenia rzęs, kreski górnej, dolnej i dekoracyjnej.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/">
              <h3>Kreska przy opadającej powiece</h3>
              <p>Sprawdź, kiedy mocna kreska może obciążać oko.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/makijaz-permanentny-oczu/">
              <h3>Makijaż permanentny oczu</h3>
              <p>Zobacz ofertę kresek permanentnych.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-oczu-bielsko-biala/">
              <h3>Makijaż permanentny oczu Bielsko-Biała — kreska permanentna i zagęszczenie linii rzęs</h3>
              <p>Rozwinięcie tego zagadnienia w osobnym poradniku.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Caring for tattooed skin</h3>
              <p>Zalecenia dermatologów dotyczące ochrony i pielęgnacji pigmentowanej skóry.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/tattoo-skin-reactions" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Tattoos: skin reactions and what to do about them</h3>
              <p>Opis typowych reakcji świeżej skóry oraz sygnałów, które mogą wymagać konsultacji dermatologicznej.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <h3>Permanent makeup: A review of its technique, regulation, and complications</h3>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <GuideArticleSocial />
<section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Jak goi się kreska permanentna?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Powieka może być wrażliwa, lekko opuchnięta i napięta. Świeża kreska może wyglądać intensywniej, a efekt ocenia się po wygojeniu.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy po kresce permanentnej można malować oczy?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Makijaż oczu trzeba odłożyć na czas zalecony przez gabinet. Tusz, eyeliner i demakijaż mogą drażnić świeżą pigmentację.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy można pocierać oko po zabiegu?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie. Pocieranie powieki może zaburzyć gojenie i podrażnić delikatną okolicę oka.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy po kresce permanentnej pojawiają się strupki?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Może pojawić się delikatne złuszczanie. Nie wolno odrywać skórek ani przyspieszać tego procesu.</p></div>
            </details>
            <details>
              <summary>
                <span>Kiedy można wrócić do tuszu do rzęs?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Dopiero po okresie wskazanym przez gabinet, gdy powieka jest spokojna i nie ma aktywnego gojenia.</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Chcesz ocenić swój przypadek przed zabiegiem?</h2>
          <p>
            Jeśli wiesz, jakiego zabiegu potrzebujesz — sprawdź terminy.
            Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href={article.mainService.href}>
              {article.mainService.title}
            </a>
          </div>

          <a class="expert-back-link" href="/poradnik/">
            ← Wróć do całego poradnika PMU
          </a>
        </div>
      </section>
    <div class="container guide-help"><GuideAssistant /></div>
    </main>

    <Footer />
  </div>
</Layout>



