---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-a-rezonans-magnetyczny-mri",
  title: "Makijaż permanentny a rezonans magnetyczny — czy PMU jest bezpieczne przy MRI?",
  category: "Bezpieczeństwo PMU",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "6–8 minut",
  description: "Makijaż permanentny a rezonans magnetyczny: czy PMU jest przeciwwskazaniem do MRI, co powiedzieć radiologowi i dlaczego przy kreskach permanentnych warto poinformować pracownię.",
  lead: "Makijaż permanentny nie jest powodem, żeby rezygnować z potrzebnego rezonansu magnetycznego. FDA opisuje jednak rzadkie przypadki pieczenia lub obrzęku w obrębie tatuażu oraz możliwość zakłócenia obrazu — szczególnie przy permanentnym eyelinerze w badaniach okolicy oczu.",
  shortAnswer: "FDA podkreśla, że ryzyko związane z niewykonaniem zalecanego rezonansu jest zwykle znacznie większe niż rzadkie problemy związane z tatuażem lub PMU. Przed badaniem powiedz technikowi lub radiologowi o brwiach, kreskach lub innych tatuażach, szczególnie jeśli badana jest okolica twarzy i oczu.",
  canonicalPath: "/poradnik/makijaz-permanentny-a-rezonans-magnetyczny-mri/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.fda.gov/radiation-emitting-products/mri-magnetic-resonance-imaging/what-patients-should-know-having-mri-exam",
      "https://www.fda.gov/consumers/consumer-updates/think-you-ink-tattoo-safety"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy makijaż permanentny jest przeciwwskazaniem do rezonansu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. PMU nie jest powodem do rezygnacji z MRI. Należy poinformować personel pracowni.",
        },
      },
      {
        "@type": "Question",
        name: "Czy kreski permanentne mogą się nagrzać podczas MRI?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "FDA opisuje rzadkie przypadki pieczenia lub obrzęku w obszarze tatuażu lub PMU. Jeśli podczas badania czujesz nietypowe ciepło, zgłoś to technikowi.",
        },
      },
      {
        "@type": "Question",
        name: "Czy pigment może zepsuć obraz MRI?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Rzadko opisywano artefakty obrazu, szczególnie przy permanentnym eyelinerze i obrazowaniu okolicy oczu.",
        },
      },
      {
        "@type": "Question",
        name: "Czy trzeba znać markę pigmentu przed MRI?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Zwykle najważniejsza jest informacja, że masz PMU. Jeśli pracownia potrzebuje dodatkowych danych, powie Ci, czego dokładnie wymaga.",
        },
      },
      {
        "@type": "Question",
        name: "Czy świeże PMU zmienia coś przed MRI?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Przy świeżej pigmentacji dodatkowo istnieje proces gojenia skóry. Jeśli MRI jest pilne, decyzję prowadzi zespół medyczny; jeśli planowe, poinformuj pracownię o dacie zabiegu.",
        },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Bogusława Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="expert-article-page">
    <Header />
    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="expert-article-meta"><span>49</span><span>{article.category}</span><span>{article.readingTime}</span></div>
            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>
          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Nie odwołuj MRI z powodu PMU. Poinformuj personel pracowni.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section"><div class="container"><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#bezpieczenstwo">Czy MRI jest bezpieczne?</a>
            <a href="#objawy">Co może się zdarzyć?</a>
            <a href="#kreski">Kreski permanentne</a>
            <a href="#co-zrobic">Co powiedzieć przed MRI?</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="expert-article-section" id="bezpieczenstwo"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Co FDA mówi o tatuażach i permanent makeup podczas MRI?</h2><p>Najważniejsze są dwie informacje: zjawisko jest rzadkie, a PMU nie jest powodem do unikania potrzebnego badania.</p></div>
        <div class="expert-timeline">
            <article class="expert-timeline-card is-best">
              <div class="expert-timeline-top">
                <strong>MRI zalecane</strong>
                <span>Nie rezygnuj</span>
              </div>
              <h3>Nie rezygnuj</h3>
              <p>FDA podkreśla, że ryzyko zaniechania potrzebnego MRI jest prawdopodobnie większe niż ryzyko interakcji z tatuażem lub PMU.</p>
            </article>
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top">
                <strong>Przed badaniem</strong>
                <span>Powiedz o PMU</span>
              </div>
              <h3>Powiedz o PMU</h3>
              <p>Technik lub radiolog powinien wiedzieć o pigmentacji, tak jak o innych tatuażach i elementach mogących mieć znaczenie w środowisku MR.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top">
                <strong>W trakcie</strong>
                <span>Pieczenie lub ciepło</span>
              </div>
              <h3>Pieczenie lub ciepło</h3>
              <p>Rzadko opisywano przejściowe pieczenie, obrzęk lub uczucie ciepła w obszarze pigmentacji.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top">
                <strong>Eyeliner</strong>
                <span>Możliwy artefakt obrazu</span>
              </div>
              <h3>Możliwy artefakt obrazu</h3>
              <p>FDA zwraca uwagę, że pigment permanentnego eyelinera może czasem wpływać na jakość obrazowania okolicy oczu.</p>
            </article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-soft" id="objawy"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Czego nie warto robić przed MRI?</h2></div>
        <div class="expert-factor-grid">
            <article><h3>Nie ukrywaj PMU</h3><p>Informacja o permanentnym makijażu jest elementem wywiadu przed badaniem i powinna być przekazana personelowi.</p></article>
            <article><h3>Nie rezygnuj z badania na własną rękę</h3><p>Jeśli lekarz zalecił MRI, decyzja o jego wykonaniu należy do zespołu medycznego, nie do salonu PMU.</p></article>
            <article><h3>Nie zakładaj, że nowe pigmenty na pewno nie reagują</h3><p>Skład pigmentów jest złożony, dlatego najlepiej przekazać informację i pozwolić pracowni zastosować własny protokół bezpieczeństwa.</p></article>
            <article><h3>Nie ignoruj nietypowego ciepła</h3><p>Jeśli podczas badania czujesz pieczenie lub nagrzewanie w obszarze PMU, zgłoś to personelowi zgodnie z instrukcją pracowni.</p></article>
        </div>
      </div></section>

      <section class="expert-article-section" id="kreski"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">W praktyce</p><h2>Które obszary warto szczególnie zgłosić?</h2></div>
        <div class="expert-area-grid">
            <a href="/makijaz-permanentny-oczu/">
              <span>01</span><h3>Kreski permanentne</h3><p>Permanentny eyeliner znajduje się bardzo blisko badanej okolicy w MRI głowy i oczu, dlatego informacja dla radiologa jest szczególnie istotna.</p><strong>Czytaj / zobacz →</strong>
            </a>
            <a href="/makijaz-permanentny-brwi/">
              <span>02</span><h3>Brwi</h3><p>Także brwi są tatuażem kosmetycznym — warto uwzględnić je w formularzu bezpieczeństwa pracowni.</p><strong>Czytaj / zobacz →</strong>
            </a>
            <a href="/poradnik/">
              <span>03</span><h3>Inne tatuaże</h3><p>MRI pyta nie tylko o PMU, ale również o klasyczne tatuaże i inne elementy mogące mieć znaczenie w środowisku magnetycznym.</p><strong>Czytaj / zobacz →</strong>
            </a>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-plan-section" id="co-zrobic"><div class="container expert-plan-panel">
        <div class="expert-plan-copy"><p class="section-kicker section-kicker-light">Plan krok po kroku</p><h2>Jak przygotować się do MRI, jeśli masz PMU?</h2><p>To bardzo proste — nie potrzebujesz specjalnego zaświadczenia z salonu.</p></div>
        <div class="expert-plan-steps">
            <div><span>01</span><strong>Wypełnij formularz uczciwie</strong><p>Zaznacz tatuaże / permanent makeup, jeśli pracownia o to pyta.</p></div>
            <div><span>02</span><strong>Powiedz technikowi</strong><p>Szczególnie przy kreskach i badaniu okolicy głowy lub oczu.</p></div>
            <div><span>03</span><strong>Postępuj według instrukcji pracowni</strong><p>To zespół MRI odpowiada za ocenę bezpieczeństwa badania.</p></div>
            <div><span>04</span><strong>Zgłoś nietypowe odczucia</strong><p>Jeśli pojawi się pieczenie, ciepło lub dyskomfort w pigmentowanej okolicy, poinformuj personel.</p></div>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-author-note">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>Czy odradzam MRI klientkom z PMU?</h2><p>Nie. Salon makijażu permanentnego nie powinien zniechęcać do diagnostyki zaleconej przez lekarza. Jeśli klientka pyta mnie o rezonans, mówię jej przede wszystkim, żeby poinformowała pracownię o PMU. Szczególnie ważne jest to przy kreskach permanentnych i badaniach okolicy oczu.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Przejdź do kwalifikacji PMU →</a></aside>
      </div></section>

      <section class="expert-article-section expert-article-related-section"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="expert-related-grid">
            <a href="/makijaz-permanentny-oczu/"><h3>Kreski permanentne</h3><p>Informacje o pigmentacji powiek.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/reakcja-alergiczna-czy-normalne-gojenie-po-pmu/"><h3>Reakcje po PMU</h3><p>Kiedy objawy skóry wymagają konsultacji medycznej.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/"><h3>Poradnik PMU</h3><p>Pozostałe artykuły o bezpieczeństwie.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="expert-article-section" id="zrodla"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną i techniczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Jeżeli źródła nie dają jednej sztywnej reguły, nie udajemy, że taka reguła istnieje.</p></div>
        <div class="expert-source-grid">
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span><h3>Tattoos & Permanent Makeup: Fact Sheet</h3><p>FDA opisuje rzadkie przypadki obrzęku lub pieczenia w obszarze tatuażu podczas MRI i zaleca informowanie personelu.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/radiation-emitting-products/mri-magnetic-resonance-imaging/what-patients-should-know-having-mri-exam" target="_blank" rel="noopener noreferrer">
              <span>FDA</span><h3>What Patients Should Know Before Having an MRI Exam</h3><p>FDA zaleca poinformowanie technika lub radiologa o tatuażach, ponieważ mogą rzadko powodować podrażnienie lub oparzenie skóry.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/consumers/consumer-updates/think-you-ink-tattoo-safety" target="_blank" rel="noopener noreferrer">
              <span>FDA</span><h3>Think Before You Ink: Tattoo Safety</h3><p>FDA ponownie wskazuje, że rzadkie reakcje podczas MRI są zwykle przejściowe i nie powinny prowadzić do unikania potrzebnej diagnostyki.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="expert-medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="expert-article-section expert-article-faq-section" id="faq"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">FAQ</p><h2>Makijaż permanentny a rezonans magnetyczny — czy PMU jest bezpieczne przy MRI?</h2></div>
        <div class="expert-faq-list">
            <details><summary><span>Czy makijaż permanentny jest przeciwwskazaniem do rezonansu?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Nie. PMU nie jest powodem do rezygnacji z MRI. Należy poinformować personel pracowni.</p></div></details>
            <details><summary><span>Czy kreski permanentne mogą się nagrzać podczas MRI?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>FDA opisuje rzadkie przypadki pieczenia lub obrzęku w obszarze tatuażu lub PMU. Jeśli podczas badania czujesz nietypowe ciepło, zgłoś to technikowi.</p></div></details>
            <details><summary><span>Czy pigment może zepsuć obraz MRI?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Rzadko opisywano artefakty obrazu, szczególnie przy permanentnym eyelinerze i obrazowaniu okolicy oczu.</p></div></details>
            <details><summary><span>Czy trzeba znać markę pigmentu przed MRI?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Zwykle najważniejsza jest informacja, że masz PMU. Jeśli pracownia potrzebuje dodatkowych danych, powie Ci, czego dokładnie wymaga.</p></div></details>
            <details><summary><span>Czy świeże PMU zmienia coś przed MRI?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Przy świeżej pigmentacji dodatkowo istnieje proces gojenia skóry. Jeśli MRI jest pilne, decyzję prowadzi zespół medyczny; jeśli planowe, poinformuj pracownię o dacie zabiegu.</p></div></details>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-final-card">
        <p class="signature cta-signature">Powrót do natury</p><h2>Potrzebujesz indywidualnej oceny przed PMU?</h2>
        <p>Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy. Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od formularza kwalifikacji.</p>
        <div class="expert-final-actions">
          <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy <span aria-hidden="true">→</span></a>
          <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU <span aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
        </div>
        <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
      </div></section>
    </main>
    <Footer />
  </div>
</Layout>

