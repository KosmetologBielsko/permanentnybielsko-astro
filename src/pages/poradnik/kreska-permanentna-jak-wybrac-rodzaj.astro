---
import "../../styles/guide-article.css";
import { getImage } from "astro:assets";
import GuideArticleByline from "../../components/GuideArticleByline.astro";
import GuideArticleMedia from "../../components/GuideArticleMedia.astro";
import GuideArticleSocial from "../../components/GuideArticleSocial.astro";
import GuideAssistant from "../../components/GuideAssistant.astro";
import { guideMedia } from "../../data/guide-series-01";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-permanentna-jak-wybrac-rodzaj",
  title: "Kreska permanentna — jak wybrać rodzaj kreski do oka?",
  eyebrow: "Poradnik PMU",
  category: "Kreski permanentne",
  dateModified: "2026-09-08",
  readingTime: "9–11 minut",
  description:
    "Kreska permanentna — jak wybrać rodzaj? Porównaj zagęszczenie linii rzęs, kreskę dekoracyjną, cieniowaną i dolną. Zobacz, jak budowa oka i powieki wpływa na wybór.",
  lead:
    "Nie każda kreska pasuje do każdego oka. Najpierw ocenia się powiekę, linię rzęs, asymetrię i oczekiwany efekt, a dopiero później wybiera zagęszczenie, kreskę dekoracyjną, cieniowaną lub dolną.",
  shortAnswer:
    "Jeśli zależy Ci na najbardziej naturalnym efekcie, najczęstszym kierunkiem jest zagęszczenie linii rzęs. Kreska dekoracyjna lub cieniowana daje bardziej widoczny efekt i wymaga odpowiedniej budowy powieki. Kreska dolna powinna być dobierana szczególnie ostrożnie. Przy opadającej powiece nie wybiera się kreski ze zdjęcia — najpierw potrzebna jest analiza oka.",
  canonicalPath: "/poradnik/kreska-permanentna-jak-wybrac-rodzaj/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const types = [
  {
    no: "01",
    title: "Zagęszczenie linii rzęs",
    tag: "najbardziej naturalne",
    price: "800 zł",
    text:
      "Pigmentacja prowadzona bardzo blisko nasady rzęs. Wzmacnia oprawę oka bez efektu klasycznego, graficznego eyelinera.",
    href: "/poradnik/kreska-zageszczajaca-linie-rzes/",
  },
  {
    no: "02",
    title: "Kreska dekoracyjna",
    tag: "bardziej widoczna",
    price: "1100 zł",
    text:
      "Wyraźniejsza linia przypominająca eyeliner. Jej długość i grubość muszą współpracować z ruchomą powieką i naturalnym kierunkiem oka.",
    href: "/makijaz-permanentny-oczu/#efekty-kresek",
  },
  {
    no: "03",
    title: "Kreska cieniowana",
    tag: "miękki efekt",
    price: "1100 zł",
    text:
      "Miększy, bardziej rozproszony kierunek niż klasyczny eyeliner. Nadal wymaga analizy powieki i świadomego zaplanowania kształtu.",
    href: "/poradnik/kreski-permanentne-cieniowane/",
  },
  {
    no: "04",
    title: "Kreska dolna",
    tag: "ostrożna kwalifikacja",
    price: "500 zł",
    text:
      "Podkreśla dolną powiekę, ale nie jest automatycznie dobrym wyborem dla każdego oka. Źle dobrana może optycznie obciążyć spojrzenie.",
    href: "/makijaz-permanentny-oczu/#zakres-kresek",
  },
];

const decisionRows = [
  {
    need: "Chcę tylko optycznie zagęścić rzęsy",
    direction: "Zagęszczenie linii rzęs",
    note: "Najsubtelniejszy kierunek bez efektu klasycznego eyelinera.",
  },
  {
    need: "Na co dzień maluję eyeliner",
    direction: "Kreska dekoracyjna",
    note: "Tylko jeśli budowa powieki pozwala na stabilną i lekką linię.",
  },
  {
    need: "Chcę miękkiego podkreślenia bez ostrej krawędzi",
    direction: "Kreska cieniowana",
    note: "Daje bardziej rozproszony efekt niż klasyczna kreska dekoracyjna.",
  },
  {
    need: "Chcę podkreślić dolną powiekę",
    direction: "Kreska dolna",
    note: "Wymaga oceny proporcji oka; nie dobieramy jej automatycznie.",
  },
  {
    need: "Mam opadającą lub wiotką powiekę",
    direction: "Najpierw kwalifikacja",
    note: "Często bezpieczniejszym estetycznie kierunkiem jest subtelniejsze zagęszczenie.",
  },
];

const eyeCases = [
  {
    question: "Mam opadającą powiekę",
    answer:
      "Przy opadającej powiece najważniejsza jest ocena tego, co dzieje się z linią przy otwartym oku. Zbyt długa lub zbyt gruba kreska może zostać częściowo ukryta w fałdzie i optycznie obciążać spojrzenie. Dlatego najpierw ocenia się anatomię powieki, a dopiero potem zakres pigmentacji.",
    link: "/poradnik/kreska-permanentna-przy-opadajacej-powiece/",
    label: "Pełny poradnik o opadającej powiece →",
  },
  {
    question: "Mam mało widocznej ruchomej powieki",
    answer:
      "Im mniej widocznej przestrzeni na powiece, tym ostrożniej trzeba zwiększać grubość kreski. W wielu takich przypadkach lepszy efekt daje praca bliżej linii rzęs niż szeroki, graficzny eyeliner.",
  },
  {
    question: "Mam asymetrię powiek",
    answer:
      "Kreska nie powinna być kopiowana lustrzanie milimetr w milimetr. Liczy się to, jak obie strony wyglądają przy otwartych oczach i naturalnej mimice. Projekt może wymagać drobnych różnic, aby efekt był wizualnie zrównoważony.",
  },
  {
    question: "Mam wrażliwe lub suche oczy",
    answer:
      "Wrażliwość oczu, przewlekłe dolegliwości powierzchni oka albo wcześniejsze problemy okulistyczne powinny być zgłoszone przed zabiegiem. Jeśli pojawiają się aktywne objawy lub wątpliwość co do bezpieczeństwa, właściwym krokiem jest konsultacja medyczna zamiast wykonywania pigmentacji na siłę.",
  },
  {
    question: "Noszę soczewki albo mam przedłużane rzęsy",
    answer:
      "Poinformuj o tym przed wizytą i zastosuj się do aktualnych zaleceń gabinetu dotyczących przygotowania. Okolica zabiegu musi być dostępna do bezpiecznej oceny i pracy; nie warto samodzielnie ustalać terminu zdejmowania rzęs lub powrotu do soczewek bez odniesienia do konkretnej sytuacji.",
    link: "/poradnik/kreska-permanentna-gojenie/",
    label: "Zobacz zasady gojenia i pielęgnacji →",
  },
];

const faqItems = [
  {
    question: "Jaka kreska permanentna wygląda najbardziej naturalnie?",
    answer:
      "Najbardziej naturalnym wariantem jest zwykle zagęszczenie linii rzęs. Pigmentacja wzmacnia nasadę rzęs i oprawę oka bez wyraźnego efektu klasycznego eyelinera.",
  },
  {
    question: "Kreska zagęszczająca czy dekoracyjna — co wybrać?",
    answer:
      "Zagęszczenie jest subtelniejsze. Kreska dekoracyjna jest bardziej widoczna i wymaga odpowiedniej budowy powieki. Wybór powinien wynikać z analizy oka i tego, jak mocny efekt chcesz widzieć bez codziennego makijażu.",
  },
  {
    question: "Jaka kreska permanentna przy opadającej powiece?",
    answer:
      "Nie ma jednego wzoru dla każdej opadającej powieki. Często lepszym kierunkiem jest subtelniejsze zagęszczenie linii rzęs, ale ostateczny zakres zależy od fałdu powieki, napięcia skóry i widocznej przestrzeni przy otwartym oku.",
  },
  {
    question: "Czy kreska permanentna powiększa oko?",
    answer:
      "Dobrze zaprojektowana kreska może optycznie porządkować i podkreślać spojrzenie, ale nie każda linia daje efekt powiększenia. Zbyt ciężka lub źle poprowadzona kreska może działać odwrotnie.",
  },
  {
    question: "Czy można zrobić tylko kreskę w linii rzęs?",
    answer:
      "Tak. Zagęszczenie linii rzęs jest osobnym, subtelnym wariantem makijażu permanentnego oczu i nie musi być łączone z kreską dekoracyjną.",
  },
  {
    question: "Ile kosztuje kreska permanentna?",
    answer:
      "Kreska dolna kosztuje 500 zł, zagęszczenie linii rzęs 800 zł, a kreska dekoracyjna lub cieniowana 1100 zł. Wariant dolna plus dekoracyjna kosztuje 1400 zł.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://pubmed.ncbi.nlm.nih.gov/33950961/",
      "https://pubmed.ncbi.nlm.nih.gov/39939003/",
      "https://pubmed.ncbi.nlm.nih.gov/31263720/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
const media = guideMedia["kreska-permanentna-jak-wybrac-rodzaj"];
const socialImage = await getImage({ src: media.cover.src, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const articleWithImages = structuredData.map(item => item["@type"] === "Article"
  ? { ...item, image: [new URL(socialImage.src, "https://www.permanentnybielsko.com").href] } : item);

---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={articleWithImages} ogImage={socialImage.src} ogImageAlt={media.cover.alt} ogType="article" showGuideSocial={false} inlineGuideAssistant
>
  <div class="eye-guide-page">
    <Header compact />

    <main class="pmu-guide-v3">
      <section class="eye-guide-hero">
        <div class="eye-guide-glow eye-guide-glow-one" aria-hidden="true"></div>
        <div class="eye-guide-glow eye-guide-glow-two" aria-hidden="true"></div>

        <div class="container eye-guide-hero-grid">
          <div class="eye-guide-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="eye-guide-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="eye-guide-lead">{article.lead}</p>
<GuideArticleByline />
          </div>

          <aside class="eye-guide-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najpierw oko. Potem kreska.</h2>
            <p>{article.shortAnswer}</p>

            <div class="answer-actions">
              <a href="#szybki-wybor">Dobierz kierunek ↓</a>
              <a href="/makijaz-permanentny-oczu/#efekty-kresek">Zobacz efekty →</a>
            </div>
          </aside>
        </div>
      </section><section class="guide-navigation"><div class="container"><details class="guide-toc" open><summary>Przejdź do wybranej odpowiedzi</summary><nav aria-label="Spis treści artykułu"><a href="#szybki-wybor">Rodzaje kresek</a><a href="#porownanie">Porównanie</a><a href="#budowa-oka">Budowa oka</a><a href="#opadajaca-powieka">Najczęstsze sytuacje</a><a href="#cieniowana">Kreska cieniowana</a><a href="#cena">Ceny</a><a href="#bezpieczenstwo">Bezpieczeństwo</a><a href="#praktyka">Praktyka</a><a href="#zrodla">Źródła</a><a href="#faq">Pytania i odpowiedzi</a></nav></details></div></section>
<GuideArticleMedia photos={[media.cover]} cover />

      <section class="type-swipe-section" id="szybki-wybor">
        <div class="container">
          <div class="type-swipe-heading">
            <div>
              <p class="section-kicker">4 główne kierunki</p>
              <h2>Najpierw zobacz różnicę. Szczegóły możesz rozwinąć później.</h2>
            </div>
            <p>Na telefonie przesuń karty palcem.</p>
          </div>

          <div class="type-swipe" aria-label="Rodzaje kresek permanentnych">
            {types.map((item) => (
              <article class="type-card">
                <div class="type-card-top">
                  <span>{item.no}</span>
                  <em>{item.price}</em>
                </div>

                <small>{item.tag}</small>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a href={item.href}>Dowiedz się więcej →</a>
              </article>
            ))}
          </div>

          <div class="top-bridge">
            <a href="/makijaz-permanentny-oczu/#efekty-kresek">
              <span>Efekty</span>
              <strong>Zobacz realne kreski →</strong>
            </a>

            <a href="/cennik-makijaz-permanentny/#price-group-2">
              <span>Ceny</span>
              <strong>Przejdź prosto do oczu →</strong>
            </a>

            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              <span>Nie wiesz?</span>
              <strong>Formularz kwalifikacji PMU →</strong>
            </a>
          </div>
        </div>
      </section>

      <section class="eye-guide-section eye-guide-section-soft" id="porownanie">
        <div class="container">
          <div class="eye-guide-heading">
            <p class="section-kicker">Którą kreskę wybrać?</p>
            <h2>Wybór zaczyna się od efektu, którego naprawdę potrzebujesz.</h2>
            <p>
              Nie wybieramy techniki na podstawie samej nazwy. Najpierw określamy cel,
              a później sprawdzamy, czy anatomia oka pozwala go bezpiecznie i estetycznie zrealizować.
            </p>
          </div>

          <div class="decision-table" role="table" aria-label="Dobór rodzaju kreski permanentnej">
            {decisionRows.map((row) => (
              <div class="decision-row" role="row">
                <div role="cell">
                  <span>Jeśli chcesz…</span>
                  <strong>{row.need}</strong>
                </div>
                <div role="cell">
                  <span>Najczęstszy kierunek</span>
                  <strong>{row.direction}</strong>
                </div>
                <p role="cell">{row.note}</p>
              </div>
            ))}
          </div>

          <p class="decision-note">
            To nie jest automatyczna kwalifikacja. Ten sam cel może wymagać innego rozwiązania
            przy innej powiece, asymetrii, stanie skóry albo wcześniejszym PMU.
          </p>
        </div>
      </section>
<GuideArticleMedia photos={media.photos} label={media.label} />

      <section class="eye-guide-section" id="budowa-oka">
        <div class="container">
          <div class="eye-guide-heading">
            <p class="section-kicker">Budowa oka i powieki</p>
            <h2>Zdjęcie inspiracji nie mówi, czy dana kreska będzie dobra dla Twojego oka.</h2>
            <p>
              W kreskach permanentnych milimetry mają znaczenie. Liczy się ruchoma powieka,
              fałd skóry, kierunek kącika oka, asymetria i ilość miejsca widocznego po otwarciu oczu.
            </p>
          </div>

          <div class="eye-factors">
            <article>
              <span>01</span>
              <h3>Fałd powieki</h3>
              <p>Linia musi wyglądać dobrze także wtedy, gdy oko jest otwarte i powieka naturalnie się układa.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Widoczna przestrzeń</h3>
              <p>Przy małej przestrzeni szeroki eyeliner może zabierać lekkość zamiast ją budować.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Asymetria</h3>
              <p>Obie powieki nie zawsze wymagają identycznego przebiegu linii, żeby efekt wyglądał harmonijnie.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Codzienny styl</h3>
              <p>Kreska powinna wyglądać dobrze również bez pełnego makijażu twarzy i mocno wytuszowanych rzęs.</p>
            </article>
          </div>

          <a class="wide-service-link" href="/makijaz-permanentny-oczu/#zakres-kresek">
            Zobacz wszystkie warianty kresek na stronie usługi <span>→</span>
          </a>
        </div>
      </section>

      <section class="eye-guide-section eye-guide-section-soft" id="opadajaca-powieka">
        <div class="container">
          <div class="eye-guide-heading">
            <p class="section-kicker">Najczęstsze sytuacje</p>
            <h2>Co zmienia wybór kreski?</h2>
            <p>
              Zamiast tworzyć osobne krótkie artykuły na każde pytanie, tutaj zbieramy najważniejsze
              scenariusze i odsyłamy do szczegółowego poradnika tylko tam, gdzie temat tego wymaga.
            </p>
          </div>

          <div class="case-accordion">
            {eyeCases.map((item, index) => (
              <details open={index === 0}>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item.question}</strong>
                  <i aria-hidden="true"></i>
                </summary>
                <div>
                  <p>{item.answer}</p>
                  {item.link && <a href={item.link}>{item.label}</a>}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="eye-guide-section" id="cieniowana">
        <div class="container split-panel">
          <div>
            <p class="section-kicker">Kreska cieniowana</p>
            <h2>Miękko nie znaczy przypadkowo.</h2>
            <p>
              Kreska cieniowana może dawać łagodniejsze przejście i mniej graficzny efekt niż klasyczny eyeliner.
              Nadal wymaga jednak zaplanowania granic pigmentacji, kierunku oraz tego, jak cień będzie wyglądał
              na konkretnej powiece po wygojeniu.
            </p>
            <p>
              Jeśli szukasz właśnie tego wariantu, nie powtarzamy tutaj całego tematu — mamy dla niego osobny poradnik.
            </p>
            <a href="/poradnik/kreski-permanentne-cieniowane/">Kreski permanentne cieniowane — pełny poradnik →</a>
          </div>

          <aside>
            <span>W skrócie</span>
            <strong>cieniowana ≠ gruba kreska</strong>
            <strong>miękki efekt ≠ brak projektu</strong>
            <strong>inspiracja ≠ kwalifikacja</strong>
          </aside>
        </div>
      </section>

      <section class="eye-guide-section eye-guide-section-soft" id="cena">
        <div class="container">
          <div class="eye-guide-heading">
            <p class="section-kicker">Ceny kresek</p>
            <h2>Ile kosztują poszczególne warianty?</h2>
            <p>
              Cena zależy od zakresu pigmentacji. Poniżej szybkie zestawienie; szczegóły prowadzą
              bezpośrednio do sekcji „Oczy” w aktualnym cenniku.
            </p>
          </div>

          <div class="price-list">
            <div><span>Kreska dolna</span><strong>500 zł</strong></div>
            <div><span>Zagęszczenie linii rzęs</span><strong>800 zł</strong></div>
            <div><span>Dekoracyjna / eyeliner / cieniowana</span><strong>1100 zł</strong></div>
            <div><span>Dolna + górna zagęszczająca</span><strong>1100 zł</strong></div>
            <div><span>Dolna + dekoracyjna</span><strong>1400 zł</strong></div>
          </div>

          <div class="price-actions">
            <a href="/cennik-makijaz-permanentny/#price-group-2">Cennik kresek →</a>
            <a href="/poradnik/kreska-permanentna-cena/">Jak rozumieć cenę kreski? →</a>
          </div>
        </div>
      </section>

      <section class="eye-guide-section" id="bezpieczenstwo">
        <div class="container safety-panel">
          <div>
            <p class="section-kicker">Okolica oka</p>
            <h2>Przy powiece estetyka nie może być ważniejsza od kwalifikacji.</h2>
            <p>
              Permanentny eyeliner jest pigmentacją wykonywaną w szczególnie delikatnej okolicy.
              Literatura okulistyczna opisuje możliwe działania niepożądane permanentnego makijażu powiek,
              a nowsze badania wskazują również na związek tatuażu linii powiek z parametrami powierzchni oka
              i funkcją gruczołów Meiboma.
            </p>
            <p>
