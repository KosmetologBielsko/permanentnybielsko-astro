---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreska-zageszczajaca-linie-rzes",
  title: "Kreska zagęszczająca linię rzęs — subtelny makijaż permanentny oczu bez efektu eyelinera",
  category: "Kreski permanentne",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "8–10 minut",
  description: "Kreska zagęszczająca linię rzęs: dla kogo, jak wygląda, czym różni się od klasycznej kreski permanentnej, jak się goi i ile kosztuje w gabinecie Bogusławy Herda.",
  lead: "To najsubtelniejszy wariant makijażu permanentnego oczu. Pigment pracuje blisko nasady rzęs, dzięki czemu spojrzenie może wyglądać wyraźniej, ale bez efektu narysowanego eyelinera na powiece.",
  shortAnswer: "Kreska zagęszczająca nie ma tworzyć dekoracyjnego skrzydełka. Jej zadaniem jest optycznie podkreślić nasadę rzęs. Jest dobrym wyborem dla klientek, które chcą bardzo naturalnego efektu lub mają powiekę, na której szeroka kreska nie wyglądałaby lekko. W aktualnym cenniku gabinetu zabieg ma zaplanowane około 120 minut i kosztuje 800 zł.",
  canonicalPath: "/poradnik/kreska-zageszczajaca-linie-rzes/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl, headline: article.title, description: article.description,
    datePublished: article.datePublished, dateModified: article.dateModified, inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/16418666/",
      "https://pubmed.ncbi.nlm.nih.gov/33933438/",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy kreska zagęszczająca wygląda jak eyeliner?",
        acceptedAnswer: { "@type": "Answer", text: "Nie. Jej zadaniem jest podkreślenie samej nasady rzęs, bez tworzenia wyraźnej dekoracyjnej linii na powiece." },
      },
      {
        "@type": "Question",
        name: "Czy zagęszczenie linii rzęs pasuje do opadającej powieki?",
        acceptedAnswer: { "@type": "Answer", text: "Często jest rozważane właśnie wtedy, gdy większa kreska byłaby zbyt ciężka. Ostateczna decyzja zależy od anatomii oka." },
      },
      {
        "@type": "Question",
        name: "Ile kosztuje kreska zagęszczająca?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku gabinetu kosztuje 800 zł." },
      },
      {
        "@type": "Question",
        name: "Ile trwa zabieg?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku na kreskę zagęszczającą przewidziano około 120 minut." },
      },
      {
        "@type": "Question",
        name: "Czy kreska zagęszczająca wymaga dopigmentowania?",
        acceptedAnswer: { "@type": "Answer", text: "Ocena potrzeby dopigmentowania odbywa się po wygojeniu, gdy można zobaczyć stabilne nasycenie i równomierność pigmentu." },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Bogusława Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="expert-article-page">
    <Header />
    <main>
      <section class="expert-article-hero">
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="expert-article-meta"><span>57</span><span>{article.category}</span><span>{article.readingTime}</span></div>
            <h1>{article.title}</h1><p class="expert-article-lead">{article.lead}</p>
          </div>
          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>To kreska dla osób, które chcą wyglądać „bardziej wyraziście”, ale nie „bardziej pomalowanie”.</h2><p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section"><div class="container"><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#efekt">Jak wygląda?</a>
            <a href="#dla-kogo">Dla kogo?</a>
            <a href="#projekt">Jak projektujemy?</a>
            <a href="#praktyka">Praktyka gabinetowa</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="expert-article-section" id="efekt"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Gdzie leży granica między zagęszczeniem a eyelinerem?</h2><p>Różnica nie sprowadza się tylko do grubości linii.</p></div>
        <div class="expert-timeline">
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Zagęszczenie rzęs</strong><span>Przy nasadzie</span></div>
              <h3>Bardzo subtelny efekt</h3><p>Pigment pozostaje blisko linii rzęs i ma przede wszystkim zwiększyć optyczny kontrast ich nasady.</p>
            </article>
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Klasyczna kreska</strong><span>Widoczna na powiece</span></div>
              <h3>Bardziej makijażowy efekt</h3><p>Linia jest czytelna ponad rzęsami i staje się wyraźnym elementem codziennego wyglądu.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top"><strong>Kreska dekoracyjna</strong><span>Większa forma</span></div>
              <h3>Projekt zależny od powieki</h3><p>Skrzydełko lub cieniowanie wymaga większej przestrzeni i stabilnej anatomii powieki.</p>
            </article>
            <article class="expert-timeline-card is-danger">
              <div class="expert-timeline-top"><strong>Zbyt szeroka forma</strong><span>Przy małej lub opadającej powiece</span></div>
              <h3>Może obciążyć oko</h3><p>Jeżeli powieka ma mało widocznej przestrzeni, duży eyeliner może dać odwrotny efekt od zamierzonego.</p>
            </article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-soft" id="dla-kogo"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Kiedy szczególnie warto rozważyć zagęszczenie linii rzęs?</h2></div>
        <div class="expert-factor-grid">
            <article><h3>Naturalny styl</h3><p>Dla klientek, które na co dzień nie noszą mocnego eyelinera i chcą efektu możliwie dyskretnego.</p></article>
            <article><h3>Opadająca powieka</h3><p>Przy ograniczonej widoczności powieki mała forma przy rzęsach często starzeje się wizualnie lepiej niż szeroka kreska.</p></article>
            <article><h3>Jasna lub delikatna oprawa oka</h3><p>Subtelne podkreślenie nasady rzęs może zwiększyć kontrast bez budowania ciężkiej linii.</p></article>
            <article><h3>Pierwszy PMU oczu</h3><p>Dla wielu osób jest to bezpieczniejszy estetycznie pierwszy krok niż duża kreska dekoracyjna.</p></article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-plan-section" id="projekt"><div class="container expert-plan-panel">
        <div class="expert-plan-copy"><p class="section-kicker section-kicker-light">Plan decyzji</p><h2>Najważniejsze jest to, jak kreska wygląda przy otwartym oku.</h2><p>Projekt oceniamy w naturalnej pozycji twarzy i powieki.</p></div>
        <div class="expert-plan-steps">
            <div><span>01</span><strong>Analiza linii rzęs</strong><p>Sprawdzamy gęstość rzęs, budowę oka i miejsce, w którym pigment może dać subtelny efekt.</p></div>
            <div><span>02</span><strong>Ocena powieki przy otwartym oku</strong><p>To, co wygląda dobrze przy zamkniętej powiece, musi pozostać harmonijne po jej otwarciu.</p></div>
            <div><span>03</span><strong>Ustalenie intensywności</strong><p>Zagęszczenie nie musi być maksymalnie czarne. Intensywność powinna pasować do oprawy oka i skóry.</p></div>
            <div><span>04</span><strong>Plan gojenia</strong><p>Po zabiegu powieka może być przejściowo delikatna lub lekko obrzęknięta; finalny efekt oceniamy po wygojeniu.</p></div>
        </div>
      </div></section>

      <section class="expert-article-section" id="praktyka"><div class="container expert-author-note">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>To jedna z tych technik, w których dyskrecja jest zaletą, nie brakiem efektu.</h2><p>Jeżeli klientka mówi, że chce „coś przy oczach, ale żeby nie było widać kreski”, bardzo często właśnie zagęszczenie linii rzęs jest dobrym kierunkiem. Szczególnie lubię tę opcję przy delikatnej oprawie oka i tam, gdzie większy eyeliner mógłby po kilku latach wyglądać zbyt ciężko.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj moje doświadczenie i podejście →</a></aside>
      </div></section>

      <section class="expert-article-section expert-article-related-section"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="expert-related-grid">
            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/"><h3>Jak wybrać rodzaj kreski?</h3><p>Porównanie zagęszczenia, klasycznej i dekoracyjnej kreski.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/"><h3>Kreska przy opadającej powiece</h3><p>Dlaczego subtelniejsza forma bywa lepszym wyborem.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/kreska-permanentna-gojenie/"><h3>Gojenie kreski permanentnej</h3><p>Pielęgnacja powiek i czego unikać po zabiegu.</p><span>Czytaj dalej →</span></a>
            <a href="/makijaz-permanentny-oczu/"><h3>Makijaż permanentny oczu</h3><p>Zobacz usługę, ceny i cały proces pigmentacji oka.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="expert-article-section" id="zrodla"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną, techniczną i praktyczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Gdy nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.</p></div>
        <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/16418666/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Adverse reactions to permanent eyeliner tattoo</h3><p>Opisane są rzadkie zapalne reakcje powiek po permanentnym eyelinerze, co podkreśla znaczenie ostrożnej pracy w tej okolicy.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/33933438/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Complications and adverse effects of periocular aesthetic treatments</h3><p>Przegląd zwraca uwagę na specyfikę i potencjalne powikłania zabiegów estetycznych w okolicy oka.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span><h3>Permanent makeup: technique, regulation and complications</h3><p>Aktualny przegląd PMU i jego możliwych powikłań.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="expert-medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy problemach zdrowotnych, nasilonych objawach lub wątpliwościach dotyczących leczenia skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="expert-article-section expert-article-faq-section" id="faq"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">FAQ</p><h2>{article.title}</h2></div>
        <div class="expert-faq-list">
            <details><summary><span>Czy kreska zagęszczająca wygląda jak eyeliner?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Nie. Jej zadaniem jest podkreślenie samej nasady rzęs, bez tworzenia wyraźnej dekoracyjnej linii na powiece.</p></div></details>
            <details><summary><span>Czy zagęszczenie linii rzęs pasuje do opadającej powieki?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Często jest rozważane właśnie wtedy, gdy większa kreska byłaby zbyt ciężka. Ostateczna decyzja zależy od anatomii oka.</p></div></details>
            <details><summary><span>Ile kosztuje kreska zagęszczająca?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku gabinetu kosztuje 800 zł.</p></div></details>
            <details><summary><span>Ile trwa zabieg?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku na kreskę zagęszczającą przewidziano około 120 minut.</p></div></details>
            <details><summary><span>Czy kreska zagęszczająca wymaga dopigmentowania?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Ocena potrzeby dopigmentowania odbywa się po wygojeniu, gdy można zobaczyć stabilne nasycenie i równomierność pigmentu.</p></div></details>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-final-card">
        <p class="signature cta-signature">Powrót do natury</p><h2>Potrzebujesz indywidualnej oceny przed PMU?</h2>
        <p>Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy. Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od formularza kwalifikacji.</p>
        <div class="expert-final-actions">
          <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy <span aria-hidden="true">→</span></a>
          <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU <span aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
        </div>
        <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
      </div></section>
    </main>
    <Footer />
  </div>
</Layout>

