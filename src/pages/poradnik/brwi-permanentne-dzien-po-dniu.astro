const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "brwi-permanentne-dzien-po-dniu",
  title: "Brwi permanentne dzień po dniu — jak zmieniają się po zabiegu?",
  eyebrow: "Poradnik PMU",
  category: "Gojenie brwi",
  datePublished: "2026-06-22",
  dateModified: "2026-08-20",
  readingTime: "12–15 minut",
  description: "Jak zmieniają się brwi permanentne dzień po dniu? Zobacz etapy gojenia, kolor po zabiegu, złuszczanie, wpływ skóry, pigmentów i dopigmentowanie po PMU brwi.",
  lead: "Brwi permanentne nie wyglądają tak samo w dniu zabiegu, po tygodniu i po pełnym wygojeniu. Najpierw mogą być mocniejsze i bardziej wyraźne, później zaczynają się złuszczać, chwilowo jaśnieją, a dopiero po czasie kolor stabilizuje się w skórze.",
  shortAnswer: "Brwi permanentne zwykle przechodzą przez kilka etapów: świeżą intensywność koloru, delikatne napięcie skóry, złuszczanie, chwilowe rozjaśnienie i stabilizację pigmentu. Na efekt wpływa skóra, technika pracy, głębokość pigmentacji, dobrany kolor i jakość pigmentu. W gabinecie Bogusławy Herda przed zabiegiem wykonywana jest konsultacja i rysunek wstępny, a bezpłatne dopigmentowanie do 2 miesięcy pozwala dopracować efekt po wygojeniu.",
  canonicalPath: "/poradnik/brwi-permanentne-dzien-po-dniu/",
  mainService: {
    href: "/makijaz-permanentny-brwi/",
    title: "Brwi permanentne",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/tattoo-skin-reactions",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Jak zmieniają się brwi permanentne dzień po dniu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najczęściej najpierw są mocniejsze, potem pojawia się napięcie i złuszczanie, następnie chwilowe rozjaśnienie, a po kilku tygodniach stabilizacja koloru. Dokładny przebieg zależy od skóry, techniki i pielęgnacji.",
        },
      },
      {
        "@type": "Question",
        name: "Czy brwi po zabiegu zawsze są bardzo ciemne?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze, ale świeże brwi zwykle są wyraźniejsze niż efekt końcowy. Kolor po wygojeniu łagodnieje i osiada w skórze.",
        },
      },
      {
        "@type": "Question",
        name: "Czy brwi mogą wyglądać nierówno po złuszczeniu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Nierówność w połowie gojenia nie musi oznaczać problemu. Ostateczną ocenę wykonuje się po pełniejszej stabilizacji skóry.",
        },
      },
      {
        "@type": "Question",
        name: "Dlaczego skóra tłusta inaczej przyjmuje pigment?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Skóra tłusta lub porowata może szybciej rozpraszać pigment i wymagać innego stylu pracy niż skóra sucha, cienka lub pergaminowa. Dlatego metoda dobierana jest po konsultacji.",
        },
      },
      {
        "@type": "Question",
        name: "Po co jest dopigmentowanie brwi?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Dopigmentowanie służy dopracowaniu efektu po wygojeniu: nasycenia, drobnych ubytków i miejsc, w których skóra przyjęła pigment słabiej.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
