      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#dlaczego-sie-zmieniaja">Proces gojenia</a>
            <a href="#dzien-po-dniu">Etapy dzień po dniu</a>
            <a href="#pigmenty-i-skora">Pigment i skóra</a>
            <a href="#dopigmentowanie">Dopigmentowanie</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
