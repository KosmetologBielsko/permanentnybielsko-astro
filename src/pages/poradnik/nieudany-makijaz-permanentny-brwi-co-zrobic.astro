---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "nieudany-makijaz-permanentny-brwi-co-zrobic",
  title: "Nieudany makijaż permanentny brwi — co zrobić, kiedy rozjaśniać, a kiedy korygować?",
  eyebrow: "Poradnik PMU",
  category: "Nieudany PMU brwi",
  datePublished: "2026-06-18",
  dateModified: "2026-08-20",
  readingTime: "9–11 minut",
  description: "Nieudany makijaż permanentny brwi: zbyt ciemne brwi, zły kształt, chłodny odcień, rozjaśnianie laserem lub removerem i plan korekty PMU.",
  lead: "Nieudany makijaż permanentny brwi to nie tylko kwestia estetyki. Zbyt ciemny pigment, niekorzystny kształt, chłodny odcień albo źle położona wcześniejsza pigmentacja mogą ograniczać możliwość wykonania nowego, naturalnego efektu.",
  shortAnswer: "Przy nieudanym makijażu permanentnym brwi nie należy działać domowymi sposobami ani przykrywać problemu kolejną pigmentacją bez kwalifikacji. Najpierw trzeba ocenić kolor, głębokość, kształt i stan skóry. Czasem możliwa jest korekta, a czasem potrzebne jest etapowe rozjaśnianie laserem lub removerem.",
  canonicalPath: "/poradnik/nieudany-makijaz-permanentny-brwi-co-zrobic/",
  mainService: {
    href: "/usuwanie-makijazu-permanentnego/",
    title: "Usuwanie makijażu permanentnego",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://www.fda.gov/consumers/consumer-updates/tattoo-removal-options-and-results",
      "https://pubmed.ncbi.nlm.nih.gov/39337100/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Co zrobić, jeśli makijaż permanentny brwi się nie udał?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najpierw trzeba poczekać na wygojenie, jeśli zabieg był świeży. Potem warto wykonać kwalifikację.",
        },
      },
      {
        "@type": "Question",
        name: "Czy można rozjaśnić brwi permanentne domowym sposobem?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie należy stosować domowych metod, kwasów, peelingów ani mechanicznego ścierania skóry.",
        },
      },
      {
        "@type": "Question",
        name: "Czy nieudane brwi permanentne można przykryć nowymi?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Czasem tak, ale nie zawsze. Jeśli pigment jest zbyt ciemny lub źle ułożony, bezpieczniej może być najpierw go rozjaśnić.",
        },
      },
      {
        "@type": "Question",
        name: "Co jest lepsze: laser czy remover?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie ma jednej odpowiedzi dla każdej osoby. Metodę dobiera się po ocenie pigmentu i skóry.",
        },
      },
      {
        "@type": "Question",
        name: "Ile zabiegów potrzeba, żeby rozjaśnić stary PMU?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Liczba zabiegów zależy od pigmentu, głębokości, nasycenia, koloru i reakcji skóry.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#co-oznacza">Ocena sytuacji</a>
            <a href="#czego-nie-robic">Nie działaj samodzielnie</a>
            <a href="#korekta-czy-usuwanie">Plan pracy</a>
            <a href="#laser-remover">Metody rozjaśniania</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="co-oznacza">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Ocena sytuacji</p>
            <h2>Nieudany PMU może oznaczać różne problemy — i każdy wymaga innego planu.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Dla jednej osoby problemem jest zbyt ciemny kolor, dla innej zbyt gruby kształt, asymetria, chłodny odcień albo pigment, który po czasie zmienił barwę.</p>
            <p>Nowy makijaż permanentny nie zawsze przykryje starą pracę. Jeśli pigment jest zbyt ciemny, głęboki lub źle ułożony, kolejna pigmentacja może pogłębić problem.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Zbyt ciemne brwi</h3>
              <p>Mogą wymagać rozjaśnienia przed nowym projektem.</p>
            </article>
            <article>
              <h3>Nieodpowiedni kształt</h3>
              <p>Stary rysunek może blokować naturalną korektę.</p>
            </article>
            <article>
              <h3>Chłodny odcień</h3>
              <p>Szary lub sinawy pigment wymaga oceny.</p>
            </article>
            <article>
              <h3>Nierówna praca</h3>
              <p>Nierówny kolor może wymagać planu etapowego.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="czego-nie-robic">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Nie działaj samodzielnie</p>
            <h2>Domowe rozjaśnianie brwi permanentnych może zrobić więcej szkody niż pożytku.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>W internecie można znaleźć porady o kwasach, peelingach, rozjaśniaczach, olejkach albo agresywnym ścieraniu skóry. To nie są bezpieczne metody usuwania PMU.</p>
            <p>Jeśli brwi po PMU nie wyglądają dobrze, nie należy panikować ani działać na świeżej skórze.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Nie używaj kwasów</h3>
              <p>Agresywne preparaty mogą uszkodzić skórę.</p>
            </article>
            <article>
              <h3>Nie ścieraj skóry</h3>
              <p>Mechaniczne tarcie nie usuwa pigmentu w kontrolowany sposób.</p>
            </article>
            <article>
              <h3>Nie przykrywaj od razu</h3>
              <p>Nowy pigment na starym może pogłębić problem.</p>
            </article>
            <article>
              <h3>Nie oceniaj zbyt wcześnie</h3>
              <p>Świeże brwi różnią się od efektu po wygojeniu.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="korekta-czy-usuwanie">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Plan pracy</p>
            <h2>Kiedy korygować, a kiedy najpierw rozjaśniać?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Korekta ma sens wtedy, gdy stary pigment nie jest zbyt ciemny, kształt daje możliwość poprawy, a skóra pozwala na bezpieczną pracę.</p>
            <p>Jeśli stara pigmentacja dominuje nad twarzą, jest chłodna, gruba lub źle położona, często lepszym pierwszym krokiem jest rozjaśnienie.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Korekta</h3>
              <p>Gdy stary pigment pozwala na bezpieczne dopracowanie.</p>
            </article>
            <article>
              <h3>Rozjaśnianie</h3>
              <p>Gdy pigment blokuje nowy kształt.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="laser-remover">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Metody rozjaśniania</p>
            <h2>Laser i remover to różne narzędzia — wybór zależy od pigmentu i skóry.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Laserowe rozjaśnianie i remover nie są tym samym. Ważny jest kolor pigmentu, głębokość, obszar, stan skóry i plan dalszej korekty.</p>
            <p>Usuwanie PMU zwykle wymaga etapów, przerw i obserwacji reakcji skóry.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Laser</h3>
              <p>Może rozbijać wybrane pigmenty, ale wymaga kwalifikacji i przerw.</p>
            </article>
            <article>
              <h3>Remover</h3>
              <p>Może być rozwiązaniem w wybranych przypadkach punktowej pracy.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Nie próbuj usuwać pigmentu domowymi sposobami</h3>
            <p>Domowe rozjaśnianie, kwasy, peelingi i agresywne ścieranie skóry mogą doprowadzić do podrażnień, przebarwień lub blizn. Przy nieudanym PMU zacznij od kwalifikacji.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/usuwanie-makijazu-permanentnego/">
              <h3>Usuwanie makijażu permanentnego</h3>
              <p>Zobacz, jak wygląda kwalifikacja do laserowego rozjaśniania lub removera.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kiedy-usuwac-stary-makijaz-permanentny/">
              <h3>Kiedy rozjaśniać stary PMU?</h3>
              <p>Przeczytaj, kiedy nie przykrywać starego pigmentu.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/makijaz-permanentny-brwi/">
              <h3>Brwi permanentne</h3>
              <p>Sprawdź naturalne podejście do nowego projektu brwi.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/laserowe-usuwanie-brwi-permanentnych/">
              <h3>Laserowe usuwanie brwi permanentnych — kiedy warto rozjaśnić stary pigment?</h3>
              <p>Rozwinięcie tego zagadnienia w osobnym poradniku.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://www.fda.gov/consumers/consumer-updates/tattoo-removal-options-and-results" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoo Removal: Options and Results</h3>
              <p>FDA opisuje laserowe usuwanie pigmentu, ograniczenia metody oraz możliwe ryzyka.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/39337100/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span>
              <h3>Permanent Makeup Removal Severe Complication — case report</h3>
              <p>Opis kliniczny powikłania związanego z usuwaniem PMU i znaczenia właściwej kwalifikacji.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoos & Permanent Makeup: Fact Sheet</h3>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Co zrobić, jeśli makijaż permanentny brwi się nie udał?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Najpierw trzeba poczekać na wygojenie, jeśli zabieg był świeży. Potem warto wykonać kwalifikację.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy można rozjaśnić brwi permanentne domowym sposobem?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie należy stosować domowych metod, kwasów, peelingów ani mechanicznego ścierania skóry.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy nieudane brwi permanentne można przykryć nowymi?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Czasem tak, ale nie zawsze. Jeśli pigment jest zbyt ciemny lub źle ułożony, bezpieczniej może być najpierw go rozjaśnić.</p></div>
            </details>
            <details>
              <summary>
                <span>Co jest lepsze: laser czy remover?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie ma jednej odpowiedzi dla każdej osoby. Metodę dobiera się po ocenie pigmentu i skóry.</p></div>
            </details>
            <details>
              <summary>
                <span>Ile zabiegów potrzeba, żeby rozjaśnić stary PMU?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Liczba zabiegów zależy od pigmentu, głębokości, nasycenia, koloru i reakcji skóry.</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Chcesz ocenić swój przypadek przed zabiegiem?</h2>
          <p>
            Jeśli wiesz, jakiego zabiegu potrzebujesz — sprawdź terminy.
            Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href={article.mainService.href}>
              {article.mainService.title}
            </a>
          </div>

          <a class="expert-back-link" href="/poradnik/">
            ← Wróć do całego poradnika PMU
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

