---
import { getImage } from "astro:assets";
import GuideSeriesByline from "../../components/GuideSeriesByline.astro";
import GuideArticleMedia from "../../components/GuideArticleMedia.astro";
import GuideArticleSocial from "../../components/GuideArticleSocial.astro";
import GuideAssistant from "../../components/GuideAssistant.astro";
import { guideMedia } from "../../data/guide-series-05";
import "../../styles/guide-article.css";
import "../../styles/guide-series-next.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-bielsko-biala",
  title: "Makijaż permanentny Bielsko-Biała — jak wybrać brwi, usta albo kreski?",
  eyebrow: "Poradnik PMU",
  category: "Makijaż permanentny Bielsko-Biała",
  datePublished: "2026-07-05",
  dateModified: "2026-09-09",
  readingTime: "9–11 minut",
  description: "Makijaż permanentny Bielsko-Biała: brwi permanentne, makijaż permanentny ust, kreski permanentne, cena, konsultacja, rysunek wstępny, gojenie i wybór gabinetu PMU.",
  lead: "Makijaż permanentny w Bielsku-Białej warto potraktować nie jak szybki zabieg z cennika, ale jak decyzję dotyczącą twarzy, skóry i codziennego wyglądu. Brwi, usta i kreski permanentne mogą wyglądać bardzo naturalnie, jeśli są poprzedzone konsultacją, rysunkiem wstępnym, analizą skóry i spokojnym doborem techniki.",
  shortAnswer: "Jeśli szukasz makijażu permanentnego w Bielsku-Białej, zacznij od wyboru efektu: brwi, usta, kreski lub korekta starego PMU. Najważniejsze są nie tylko cena i wolny termin, ale doświadczenie linergistki, rysunek wstępny, kwalifikacja skóry, dobór pigmentu oraz to, jak efekt będzie wyglądał po wygojeniu.",
  canonicalPath: "/poradnik/makijaz-permanentny-bielsko-biala/",
  mainService: {
    href: "/",
    title: "Makijaż permanentny Bielsko-Biała",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy makijaż permanentny w Bielsku-Białej może wyglądać naturalnie?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Naturalny efekt zależy od rysunku wstępnego, dobrania techniki do skóry, doświadczenia linergistki, pigmentu i spokojnej oceny efektu po wygojeniu.",
        },
      },
      {
        "@type": "Question",
        name: "Co najczęściej wybierają klientki: brwi, usta czy kreski?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najczęściej wybierane są brwi permanentne, ale dużo zależy od potrzeb. Usta poprawiają świeżość koloru, a kreski subtelnie podkreślają spojrzenie.",
        },
      },
      {
        "@type": "Question",
        name: "Czy warto dojechać do Bielska-Białej z okolicznych miejscowości?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Warto, jeśli ważne są doświadczenie, naturalny efekt, konsultacja i bezpieczeństwo. Klientki często dojeżdżają z Czechowic-Dziedzic, Jaworza, Kóz, Żywca, Szczyrku, Skoczowa czy Kęt.",
        },
      },
      {
        "@type": "Question",
        name: "Czy najniższa cena PMU to dobry wybór?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze. Cena jest ważna, ale przy PMU liczą się także doświadczenie, rysunek wstępny, higiena, kwalifikacja skóry i przewidywalność gojenia.",
        },
      },
      {
        "@type": "Question",
        name: "Gdzie sprawdzić terminy makijażu permanentnego?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najwygodniej sprawdzić dostępne terminy przez Booksy albo umówić konsultację, jeśli potrzebna jest ocena skóry, starego pigmentu lub przeciwwskazań.",
        },
      }
    ],
  },
];

const media = guideMedia["makijaz-permanentny-bielsko-biala"];
const socialImage = await getImage({ src: media.cover.src, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const articleWithImages = structuredData.map(item => item["@type"] === "Article"
  ? { ...item, image: [new URL(socialImage.src, "https://www.permanentnybielsko.com").href] } : item);
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={articleWithImages}
  ogImage={socialImage.src}
  ogImageAlt={media.cover.alt}
  ogType="article"
  showGuideSocial={false}
  inlineGuideAssistant
>
  <div class="expert-article-page">
    <Header compact />

    <main class="pmu-guide-v3 pmu-guide-v4">
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
