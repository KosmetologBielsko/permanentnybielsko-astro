---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "ile-trwa-zabieg-makijazu-permanentnego",
  title: "Ile trwa zabieg makijażu permanentnego? Brwi, usta i kreski krok po kroku",
  category: "Przed zabiegiem",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "8–10 minut",
  description: "Ile trwa makijaż permanentny brwi, ust i kresek? Sprawdź orientacyjny czas wizyty, rysunku wstępnego, pigmentacji i korekty w gabinecie Bogusławy Herda.",
  lead: "Czas wizyty to nie tylko samo wprowadzanie pigmentu. W dobrze zaplanowanym PMU część czasu zajmuje rozmowa, kwalifikacja, analiza twarzy lub oka, rysunek wstępny i dopiero później właściwa pigmentacja.",
  shortAnswer: "W aktualnym cenniku gabinetu konsultacja PMU trwa 30 minut, brwi cieniowane około 120 minut, metoda włoskowa i włos z cieniem około 130 minut, makijaż permanentny ust około 120 minut, a większość górnych kresek około 120 minut. Kreska dolna ma zaplanowane około 90 minut. Czas jest orientacyjny i może zależeć od zakresu pracy oraz kwalifikacji.",
  canonicalPath: "/poradnik/ile-trwa-zabieg-makijazu-permanentnego/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl, headline: article.title, description: article.description,
    datePublished: article.datePublished, dateModified: article.dateModified, inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Ile trwa makijaż permanentny brwi?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku gabinetu brwi cieniowane mają zaplanowane około 120 minut, a metoda włoskowa i włos z cieniem około 130 minut." },
      },
      {
        "@type": "Question",
        name: "Ile trwa makijaż permanentny ust?",
        acceptedAnswer: { "@type": "Answer", text: "Aktualny cennik przewiduje około 120 minut na makijaż permanentny ust." },
      },
      {
        "@type": "Question",
        name: "Ile trwa kreska permanentna?",
        acceptedAnswer: { "@type": "Answer", text: "Kreska dolna ma zaplanowane około 90 minut, a górne warianty zagęszczające i dekoracyjne zwykle około 120 minut." },
      },
      {
        "@type": "Question",
        name: "Czy w czas zabiegu wliczony jest rysunek wstępny?",
        acceptedAnswer: { "@type": "Answer", text: "Tak, plan wizyty obejmuje kwalifikację i projekt przed właściwą pigmentacją." },
      },
      {
        "@type": "Question",
        name: "Ile trwa odświeżenie PMU?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku odświeżenia brwi, oczu i ust mają orientacyjnie około 60 minut." },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Bogusława Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="expert-article-page">
    <Header />
    <main>
      <section class="expert-article-hero">
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="expert-article-meta"><span>56</span><span>{article.category}</span><span>{article.readingTime}</span></div>
            <h1>{article.title}</h1><p class="expert-article-lead">{article.lead}</p>
          </div>
          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Dwie godziny wizyty nie oznaczają dwóch godzin ciągłej pigmentacji.</h2><p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section"><div class="container"><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#czasy">Orientacyjne czasy</a>
            <a href="#etapy">Co zajmuje czas?</a>
            <a href="#dlaczego">Dlaczego nie przyspieszać?</a>
            <a href="#praktyka">Praktyka gabinetowa</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="expert-article-section" id="czasy"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Ile czasu zarezerwować na konkretny zabieg?</h2><p>Poniższe wartości wynikają z aktualnego cennika gabinetu i są dobrym punktem orientacyjnym przy planowaniu dnia.</p></div>
        <div class="expert-timeline">
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Brwi cieniowane</strong><span>około 120 min</span></div>
              <h3>Projekt + pigmentacja</h3><p>Wizyta obejmuje kwalifikację, rysunek wstępny, dobór koloru i właściwy zabieg.</p>
            </article>
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Brwi włoskowe / włos + cień</strong><span>około 130 min</span></div>
              <h3>Więcej pracy detalicznej</h3><p>Techniki włoskowe wymagają bardzo precyzyjnego projektu kierunku i rytmu włosa.</p>
            </article>
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Usta</strong><span>około 120 min</span></div>
              <h3>Kolor + kontur + pigmentacja</h3><p>Czas obejmuje przygotowanie projektu i pracę na całej czerwieni wargowej.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top"><strong>Kreski</strong><span>90–120 min</span></div>
              <h3>Zależnie od wariantu</h3><p>Kreska dolna ma krótszy czas, a górne warianty zagęszczające i dekoracyjne zwykle około 120 minut.</p>
            </article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-soft" id="etapy"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Co właściwie dzieje się podczas tych 120 minut?</h2></div>
        <div class="expert-factor-grid">
            <article><h3>Rozmowa i kwalifikacja</h3><p>Sprawdzamy oczekiwania, stan skóry, wcześniejsze PMU oraz przeciwwskazania i zabiegi, które mogą mieć znaczenie.</p></article>
            <article><h3>Rysunek wstępny</h3><p>To etap projektowania kształtu, proporcji i kierunku. Przy brwiach i kreskach może mieć większe znaczenie niż samo „wybranie koloru”.</p></article>
            <article><h3>Dobór koloru i techniki</h3><p>Kolor i metoda są dopasowywane do skóry, urody i efektu, a nie wybierane wyłącznie z katalogu.</p></article>
            <article><h3>Pigmentacja i kontrola efektu</h3><p>Właściwy zabieg jest wykonywany etapowo z kontrolą skóry, symetrii i stopnia nasycenia.</p></article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-plan-section" id="dlaczego"><div class="container expert-plan-panel">
        <div class="expert-plan-copy"><p class="section-kicker section-kicker-light">Plan decyzji</p><h2>Nie planuj PMU „na szybko między spotkaniami”.</h2><p>Nawet jeśli sama pigmentacja przebiega sprawnie, warto zostawić sobie komfort czasowy.</p></div>
        <div class="expert-plan-steps">
            <div><span>01</span><strong>Przyjdź bez presji czasu</strong><p>Rysunek i decyzja o kształcie nie powinny być podejmowane pod presją kolejnego spotkania.</p></div>
            <div><span>02</span><strong>Nie zakładaj sztywnego końca co do minuty</strong><p>Czas z cennika jest orientacyjny; skóra i zakres pracy mogą wymagać spokojniejszego tempa.</p></div>
            <div><span>03</span><strong>Uwzględnij rozmowę po zabiegu</strong><p>Na końcu omawiamy pielęgnację, gojenie i moment oceny efektu.</p></div>
            <div><span>04</span><strong>Korekta to osobna wizyta</strong><p>Po wygojeniu może być potrzebne dopigmentowanie; odświeżenia w cenniku mają zwykle około 60 minut.</p></div>
        </div>
      </div></section>

      <section class="expert-article-section" id="praktyka"><div class="container expert-author-note">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>Najwięcej czasu chcę mieć na decyzję, której nie da się „cofnąć gumką”.</h2><p>Nie skracam rysunku wstępnego tylko po to, żeby szybciej przejść do pigmentacji. Jeżeli potrzebujemy więcej czasu na proporcje, wybór intensywności albo ocenę starego PMU, poświęcamy go przed zabiegiem. Dla mnie sprawna wizyta to taka, w której klientka rozumie plan, a nie taka, która kończy się jak najszybciej.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj moje doświadczenie i podejście →</a></aside>
      </div></section>

      <section class="expert-article-section expert-article-related-section"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="expert-related-grid">
            <a href="/poradnik/rysunek-wstepny-przed-makijazem-permanentnym/"><h3>Rysunek wstępny przed PMU</h3><p>Dlaczego projekt jest kluczowym etapem wizyty.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/jak-przygotowac-sie-do-makijazu-permanentnego-brwi/"><h3>Jak przygotować się do brwi?</h3><p>Co zrobić przed wizytą, żeby nie tracić czasu na niepotrzebne niespodzianki.</p><span>Czytaj dalej →</span></a>
            <a href="/cennik-makijaz-permanentny/"><h3>Aktualny cennik PMU</h3><p>Czasy i ceny zabiegów w gabinecie.</p><span>Czytaj dalej →</span></a>
            <a href="/makijaz-permanentny-bielsko/"><h3>Makijaż permanentny Bielsko-Biała</h3><p>Zobacz cały proces kwalifikacji i pigmentacji.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="expert-article-section" id="zrodla"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną, techniczną i praktyczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Gdy nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.</p></div>
        <div class="expert-source-grid">
            <a href="/cennik-makijaz-permanentny/">
              <span>PermanentnyBielsko.com</span><h3>Aktualny cennik makijażu permanentnego</h3><p>Źródło aktualnych czasów usług: konsultacja 30 min, brwi 120–130 min, usta 120 min, kreski 90–120 min.</p><strong>Zobacz na stronie →</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span><h3>Permanent makeup: technique, regulation and complications</h3><p>Przegląd opisuje PMU jako procedurę kosmetycznego tatuowania wymagającą właściwej techniki i uwzględnienia ryzyk.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="expert-medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy problemach zdrowotnych, nasilonych objawach lub wątpliwościach dotyczących leczenia skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="expert-article-section expert-article-faq-section" id="faq"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">FAQ</p><h2>{article.title}</h2></div>
        <div class="expert-faq-list">
            <details><summary><span>Ile trwa makijaż permanentny brwi?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku gabinetu brwi cieniowane mają zaplanowane około 120 minut, a metoda włoskowa i włos z cieniem około 130 minut.</p></div></details>
            <details><summary><span>Ile trwa makijaż permanentny ust?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Aktualny cennik przewiduje około 120 minut na makijaż permanentny ust.</p></div></details>
            <details><summary><span>Ile trwa kreska permanentna?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Kreska dolna ma zaplanowane około 90 minut, a górne warianty zagęszczające i dekoracyjne zwykle około 120 minut.</p></div></details>
            <details><summary><span>Czy w czas zabiegu wliczony jest rysunek wstępny?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Tak, plan wizyty obejmuje kwalifikację i projekt przed właściwą pigmentacją.</p></div></details>
            <details><summary><span>Ile trwa odświeżenie PMU?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku odświeżenia brwi, oczu i ust mają orientacyjnie około 60 minut.</p></div></details>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-final-card">
        <p class="signature cta-signature">Powrót do natury</p><h2>Potrzebujesz indywidualnej oceny przed PMU?</h2>
        <p>Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy. Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od formularza kwalifikacji.</p>
        <div class="expert-final-actions">
          <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy <span aria-hidden="true">→</span></a>
          <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU <span aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
        </div>
        <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
      </div></section>
    </main>
    <Footer />
  </div>
</Layout>

