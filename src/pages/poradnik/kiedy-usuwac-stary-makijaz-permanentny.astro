---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kiedy-usuwac-stary-makijaz-permanentny",
  title: "Kiedy usuwać stary makijaż permanentny, a kiedy można go poprawić?",
  eyebrow: "Poradnik PMU",
  category: "Usuwanie PMU",
  datePublished: "2026-06-08",
  dateModified: "2026-08-27",
  readingTime: "9–12 minut",
  description:
    "Kiedy usuwać stary makijaż permanentny, a kiedy można go poprawić? Sprawdź, kiedy potrzebne jest rozjaśnianie laserem, remover, korekta lub plan etapowy.",
  lead:
    "Stary makijaż permanentny nie zawsze trzeba usuwać do zera — ale nie każdy można też bezpiecznie przykryć kolejną pigmentacją. Najważniejsze są kolor, nasycenie, kształt, liczba warstw, stan skóry i plan nowego efektu.",
  shortAnswer:
    "Starego PMU nie warto poprawiać na siłę, gdy pigment jest zbyt ciemny, bardzo nasycony, zmienił kolor, ma niekorzystny kształt albo blokuje nowy projekt. Wtedy pierwszym krokiem może być kontrolowane rozjaśnianie laserem, remover albo plan etapowy. Jeśli pigment jest lekki, kształt nadal współpracuje z twarzą, a skóra daje dobre warunki, czasem możliwa jest korekta bez wcześniejszego usuwania.",
  canonicalPath: "/poradnik/kiedy-usuwac-stary-makijaz-permanentny/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const scenarios = [
  {
    label: "Pigment lekki i równy",
    price: "możliwa korekta",
    text: "Jeśli stary PMU jest delikatny, kształt nadal ma sens, a kolor nie blokuje nowego efektu, czasem można zaplanować korektę bez wcześniejszego rozjaśniania.",
    href: "#kiedy-mozna-poprawic",
    cta: "Kiedy można poprawić?",
  },
  {
    label: "Pigment zbyt ciemny",
    price: "rozjaśnianie",
    text: "Mocne nasycenie ogranicza możliwość uzyskania lekkiego nowego efektu. Dokładanie kolejnej warstwy może tylko zwiększyć ciężkość pigmentacji.",
    href: "#kiedy-rozjasniac",
    cta: "Kiedy rozjaśniać?",
  },
  {
    label: "Kolor się zmienił",
    price: "najpierw diagnoza",
    text: "Szary, grafitowy, czerwony, pomarańczowy lub inny niekorzystny ton wymaga oceny przed wyborem kolejnego etapu.",
    href: "#kolor-pigmentu",
    cta: "Jak ocenić kolor?",
  },
  {
    label: "Kształt blokuje nowy projekt",
    price: "plan etapowy",
    text: "Jeśli stary rysunek wychodzi poza dobry projekt, nowa pigmentacja może nie być w stanie go estetycznie przykryć.",
    href: "#plan",
    cta: "Zobacz plan etapowy",
  },
];

const assessmentItems = [
  {
    title: "Kolor pigmentu",
    text: "Sprawdzamy, czy stary PMU jest neutralny, chłodny, czerwony, pomarańczowy, szary lub grafitowy i jak wpływa to na dalszy plan.",
  },
  {
    title: "Nasycenie",
    text: "Im więcej pigmentu pozostaje w skórze, tym mniej przestrzeni na nowy, lekki efekt.",
  },
  {
    title: "Kształt",
    text: "Oceniamy, czy stara pigmentacja mieści się w projekcie, który byłby dziś korzystny dla twarzy.",
  },
  {
    title: "Liczba warstw",
    text: "Wielokrotnie dopigmentowywane PMU może wymagać ostrożniejszego i bardziej etapowego podejścia.",
  },
  {
    title: "Stan skóry",
    text: "Dalszą pracę planuje się tylko wtedy, gdy skóra daje do tego warunki i jest odpowiednio wygojona.",
  },
  {
    title: "Cel końcowy",
    text: "Inaczej planuje się częściowe rozjaśnienie przed nowymi brwiami, a inaczej przypadek, w którym celem jest możliwie duża redukcja pigmentu.",
  },
];

const faqItems = [
  {
    question: "Czy każdy stary makijaż permanentny trzeba usuwać?",
    answer:
      "Nie. Jeśli pigment jest lekki, kształt nadal współpracuje z twarzą, a kolor i nasycenie nie blokują nowego projektu, czasem możliwa jest korekta bez wcześniejszego rozjaśniania.",
  },
  {
    question: "Kiedy lepiej rozjaśnić stary PMU przed nową pigmentacją?",
    answer:
      "Rozjaśnianie warto rozważyć, gdy pigment jest bardzo ciemny lub nasycony, zmienił kolor, ma niekorzystny kształt albo ogranicza możliwość wykonania nowego, lżejszego projektu.",
  },
  {
    question: "Czy laserowe usuwanie PMU usuwa pigment całkowicie?",
    answer:
      "Nie można zagwarantować całkowitego usunięcia ani określonej liczby zabiegów. Reakcja zależy od pigmentu, skóry, głębokości, nasycenia i przebiegu kolejnych etapów. Często celem jest rozjaśnienie wystarczające do dalszej korekty.",
  },
  {
    question: "Laser czy remover — co jest lepsze?",
    answer:
      "Nie ma jednej metody najlepszej dla każdego przypadku. Wybór zależy od koloru i charakteru pigmentu, obszaru zabiegowego, skóry, historii wcześniejszych prac oraz celu dalszego postępowania.",
  },
  {
    question: "Czy można przykryć czerwone albo szare brwi permanentne?",
    answer:
      "Czasem tak, ale nie powinno się tego zakładać bez oceny. Przy zmienionym kolorze najpierw trzeba sprawdzić nasycenie, kształt i to, czy korekta koloru nie stworzy zbyt ciężkiego efektu.",
  },
  {
    question: "Kiedy można zrobić nowy makijaż permanentny po rozjaśnianiu?",
    answer:
      "Dopiero po wygojeniu skóry i ocenie efektu poprzedniego etapu. Nie ma jednego uniwersalnego terminu dla wszystkich przypadków.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://www.fda.gov/consumers/consumer-updates/tattoo-removal-options-and-results",
      "https://pubmed.ncbi.nlm.nih.gov/39337100/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="price-guide-page">
    <Header />

    <main>
      <section class="price-hero">
        <div class="price-glow price-glow-one" aria-hidden="true"></div>
        <div class="price-glow price-glow-two" aria-hidden="true"></div>

        <div class="container price-hero-grid">
          <div class="price-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="price-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
              <span>Aktualizacja: 27.08.2026</span>
            </div>

            <h1>{article.title}</h1>
            <p class="price-lead">{article.lead}</p>

            <div class="price-hero-actions">
              <a class="price-primary" href="#decyzja">Sprawdź decyzję <span aria-hidden="true">→</span></a>
              <a class="price-secondary" href="/usuwanie-makijazu-permanentnego/">Zobacz usługę usuwania PMU</a>
            </div>
          </div>

          <aside class="price-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="price-answer-label">Odpowiedź w 20 sekund</p>
            <strong class="price-big price-big-text">Nie przykrywaj w ciemno</strong>
            <h2>Najpierw oceń, co naprawdę znajduje się w skórze.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="price-nav-section">
        <div class="container">
          <nav class="price-nav" aria-label="Spis treści">
            <a href="#decyzja">Usuwać czy poprawiać?</a>
            <a href="#kiedy-rozjasniac">Kiedy rozjaśniać?</a>
            <a href="#laser-remover">Laser czy remover?</a>
            <a href="#plan">Plan etapowy</a>
            <a href="#nowe-pmu">Nowy makijaż</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="price-section" id="decyzja">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Usuwać czy poprawiać?</p>
            <h2>Nie każdy stary makijaż permanentny trzeba usuwać — ale nie każdy warto przykrywać.</h2>
            <p>
              Najważniejsze jest znalezienie właściwej ścieżki dla konkretnego pigmentu.
              Przy jednym przypadku możliwa będzie korekta, przy innym rozsądniejsze będzie najpierw rozjaśnienie,
              a przy jeszcze innym potrzebny będzie plan kilku etapów.
            </p>
          </div>

          <div class="scenario-scroll" aria-label="Scenariusze przy starym makijażu permanentnym">
            {scenarios.map((item) => (
              <article class="scenario-card">
                <span>{item.label}</span>
                <strong>{item.price}</strong>
                <p>{item.text}</p>
                <a href={item.href}>{item.cta} →</a>
              </article>
            ))}
          </div>

          <div class="price-service-bridge">
            <div>
              <span>Główna strona usługi</span>
              <strong>Laser, remover, cena 200–400 zł i kwalifikacja starego PMU.</strong>
            </div>
            <div class="price-service-actions">
              <a href="/usuwanie-makijazu-permanentnego/#laser">Laser</a>
              <a href="/usuwanie-makijazu-permanentnego/#remover">Remover</a>
            </div>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="ocena">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Co oceniamy?</p>
            <h2>Sześć elementów decyduje o tym, czy stare PMU można poprawić.</h2>
            <p>
              Zdjęcie pomaga w pierwszej ocenie, ale nie zawsze pokazuje realne nasycenie, liczbę warstw ani stan skóry.
              Dlatego kwalifikacja powinna obejmować więcej niż sam kolor widoczny na ekranie telefonu.
            </p>
          </div>

          <div class="included-grid">
            {assessmentItems.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section" id="kiedy-rozjasniac">
        <div class="container decision-grid">
          <div class="decision-copy">
            <p class="section-kicker">Kiedy rozjaśniać?</p>
            <h2>Gdy stary pigment zabiera przestrzeń potrzebną do nowego efektu.</h2>
            <p>
              Jeśli pigment jest zbyt ciemny, bardzo nasycony, ma niekorzystny kolor albo stary kształt
              wychodzi poza nowy projekt, przykrywanie go kolejną warstwą może pogłębić problem.
            </p>
            <p>
              Rozjaśnienie nie zawsze oznacza dążenie do całkowitego usunięcia pigmentu.
              Często celem jest odzyskanie wystarczającej przestrzeni do bezpieczniejszej i lżejszej korekty.
            </p>
          </div>

          <div class="decision-cards">
            <article>
              <span>Nie przykrywaj</span>
              <strong>Zbyt duże nasycenie</strong>
              <p>Kolejna warstwa nie rozjaśni starego pigmentu i może ograniczyć możliwości późniejszej korekty.</p>
            </article>
            <article>
              <span>Rozważ rozjaśnienie</span>
              <strong>Kształt blokuje projekt</strong>
              <p>Jeśli stary rysunek wychodzi poza dobry kształt, najpierw trzeba odzyskać miejsce na nową pracę.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="kolor-pigmentu">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Zmiana koloru</p>
            <h2>Szary, czerwony czy grafitowy pigment nie mówi jeszcze sam, którą metodę wybrać.</h2>
            <p>
              Kolor jest ważnym sygnałem, ale decyzja nie powinna opierać się wyłącznie na nazwaniu odcienia.
              Liczą się także nasycenie, głębokość, historia pigmentacji, kształt i to, jaki efekt ma powstać później.
            </p>
          </div>

          <div class="triage-grid">
            <article>
              <span>01</span>
              <h3>Chłodny / szary</h3>
              <p>Najpierw ocena nasycenia i możliwości korekty bez dokładania ciężkiej warstwy koloru.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Czerwony / pomarańczowy</h3>
              <p>Nie każdy ciepły ton powinien być automatycznie przykrywany neutralizatorem bez oceny całego przypadku.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Bardzo ciemny / grafitowy</h3>
              <p>Przy wysokim nasyceniu często najważniejsze jest najpierw kontrolowane rozjaśnienie starego PMU.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section" id="laser-remover">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Laser czy remover?</p>
            <h2>To dwie różne ścieżki — żadna nie jest automatycznie najlepsza dla wszystkich.</h2>
            <p>
              Metodę dobiera się po ocenie pigmentu, skóry, obszaru zabiegowego, wcześniejszych prac
              i tego, czy celem jest rozjaśnienie przed nowym PMU, czy inny zakres redukcji starej pigmentacji.
            </p>
          </div>

          <div class="compare-list">
            <div><strong>Laser</strong><span>Może być elementem kontrolowanego rozjaśniania wybranych pigmentów. Reakcja koloru i tempo redukcji nie są identyczne u każdej osoby.</span></div>
            <div><strong>Remover</strong><span>Może być rozważany w innych sytuacjach klinicznych i technicznych, zależnie od pigmentu, skóry i planu dalszej pracy.</span></div>
            <div><strong>Liczba zabiegów</strong><span>Nie można uczciwie zagwarantować jednej liczby sesji. Każdy etap ocenia się po wygojeniu i reakcji pigmentu.</span></div>
            <div><strong>Cel</strong><span>Nie zawsze trzeba usuwać pigment do zera. Czasem wystarczające jest rozjaśnienie umożliwiające nowy, lżejszy projekt.</span></div>
          </div>

          <div class="qualification-strip">
            <div>
              <span>Potrzebujesz oceny metody?</span>
              <strong>Najpierw kwalifikacja starego pigmentu, później laser lub remover.</strong>
            </div>
            <a href="/usuwanie-makijazu-permanentnego/#kwalifikacja">Przejdź do kwalifikacji →</a>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="plan">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Plan etapowy</p>
            <h2>Stare PMU często wymaga cierpliwości bardziej niż kolejnej szybkiej pigmentacji.</h2>
            <p>
              Po każdym etapie skóra potrzebuje regeneracji, a efekt rozjaśnienia trzeba ponownie ocenić.
              Dopiero wtedy można zdecydować, czy potrzebny jest kolejny zabieg, przerwa czy przygotowanie do nowego PMU.
            </p>
          </div>

          <div class="included-grid">
            <article>
              <span>01</span>
              <h3>Kwalifikacja</h3>
              <p>Kolor, nasycenie, kształt, warstwy pigmentu, stan skóry i cel końcowy.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Pierwszy etap</h3>
              <p>Dobór metody i wykonanie wyłącznie zakresu ustalonego dla konkretnego przypadku.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Gojenie</h3>
              <p>Skóra musi się zregenerować, zanim uczciwie ocenimy rezultat i następny krok.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Ponowna ocena</h3>
              <p>Sprawdzamy, jak zmienił się pigment i czy cel został osiągnięty w wystarczającym stopniu.</p>
            </article>
            <article>
              <span>05</span>
              <h3>Kolejny etap lub przerwa</h3>
              <p>Nie przyspieszamy kolejnych działań tylko dlatego, że poprzedni zabieg już się odbył.</p>
            </article>
            <article>
              <span>06</span>
              <h3>Nowy projekt</h3>
              <p>Nowe PMU planujemy dopiero wtedy, gdy stan skóry i pozostały pigment dają dobre warunki.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section" id="nowe-pmu">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Co dalej?</p>
            <h2>Nowy makijaż permanentny planujemy dopiero na realnym stanie skóry.</h2>
            <p>
              Po rozjaśnieniu wracamy do projektu: kształtu, koloru, techniki i efektu,
              który ma wyglądać dobrze po wygojeniu — a nie tylko przykryć poprzednią pracę.
            </p>
          </div>

          <div class="triage-grid">
            <article>
              <span>Brwi</span>
              <h3>Naturalniejszy projekt</h3>
              <p>Po odzyskaniu przestrzeni można ponownie ocenić metodę włoskową, cieniowanie lub inny kierunek.</p>
            </article>
            <article>
              <span>Usta</span>
              <h3>Kolor i kontur</h3>
              <p>Wcześniejszy pigment ust wymaga osobnej oceny przed kolejną pigmentacją.</p>
            </article>
            <article>
              <span>Kreski</span>
              <h3>Budowa oka i powieki</h3>
              <p>Stara linia może ograniczać nowy projekt, dlatego każdy przypadek kwalifikuje się indywidualnie.</p>
            </article>
          </div>

          <div class="price-service-bridge">
            <div>
              <span>Masz stare brwi permanentne?</span>
              <strong>Zobacz też poradnik o brwiach po latach i osobny przewodnik po laserowym rozjaśnianiu.</strong>
            </div>
            <div class="price-service-actions">
              <a href="/poradnik/brwi-permanentne-po-latach/">Brwi po latach</a>
              <a href="/poradnik/laserowe-usuwanie-brwi-permanentnych/">Laserowe usuwanie brwi</a>
            </div>
          </div>
        </div>
      </section>

      <section class="price-section expert-section">
        <div class="container expert-card">
          <div>
            <p class="section-kicker">Ekspert PMU</p>
            <h2>Przy starym PMU najważniejsza bywa decyzja, czego nie robić za szybko.</h2>
            <p>
              Bogusława Herda jest kosmetologiem i linergistką z ponad 10-letnim doświadczeniem,
              8-krotną mistrzynią PMU, wicemistrzynią świata oraz europejskim trenerem Long-Time-Liner®.
              W pracy ze starym pigmentem liczy się nie tylko technologia, ale również ocena warstw,
              skóry, kształtu i planu nowego efektu.
            </p>
          </div>
          <aside>
            <span>Bogusława Herda</span>
            <strong>8× mistrzyni PMU</strong>
            <strong>Wicemistrzyni świata</strong>
            <strong>Europejski trener Long-Time-Liner®</strong>
            <a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie →</a>
