---
import { getImage } from "astro:assets";
import GuideSeriesByline from "../../components/GuideSeriesByline.astro";
import GuideArticleMedia from "../../components/GuideArticleMedia.astro";
import GuideArticleSocial from "../../components/GuideArticleSocial.astro";
import GuideAssistant from "../../components/GuideAssistant.astro";
import { guideMedia } from "../../data/guide-series-05";
import "../../styles/guide-article.css";
import "../../styles/guide-series-next.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-brwi-cena",
  title: "Makijaż permanentny brwi cena 2026 — ile kosztują brwi permanentne?",
  eyebrow: "Poradnik PMU",
  category: "Ceny PMU",
  datePublished: "2026-06-21",
  dateModified: "2026-09-09",
  readingTime: "9–11 minut",
  description:
    "Makijaż permanentny brwi cena 2026. Sprawdź ceny cieniowania, metody włoskowej, włosa z cieniem, korekty i odświeżenia brwi oraz co obejmuje cena zabiegu.",
  lead:
    "Ile kosztują brwi permanentne? Najważniejsza różnica wynika z metody, zakresu pracy i tego, czy mówimy o pierwszym zabiegu, odświeżeniu czy pracy ze starym PMU. Poniżej znajdziesz aktualne ceny i krótkie wyjaśnienie, za co realnie płacisz.",
  shortAnswer:
    "W gabinecie Bogusławy Herda w Bielsku-Białej brwi cieniowane kosztują 1200 zł, metoda włoskowa 1400 zł, a włos z cieniem 1400 zł. Cena zabiegu głównego obejmuje korektę do 2 miesięcy od zabiegu głównego. Odświeżenie brwi wykonanych w gabinecie do 2 lat kosztuje 500–700 zł. Stare lub wykonane w innym gabinecie PMU wymaga indywidualnej kwalifikacji.",
  canonicalPath: "/poradnik/makijaz-permanentny-brwi-cena/",
  mainService: {
    href: "/makijaz-permanentny-brwi/",
    title: "Brwi permanentne",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const faqItems = [
  {
    question: "Ile kosztuje makijaż permanentny brwi?",
    answer:
      "Brwi cieniowane kosztują 1200 zł, a metoda włoskowa oraz włos z cieniem 1400 zł. Cena zabiegu głównego obejmuje korektę do 2 miesięcy od zabiegu głównego.",
  },
  {
    question: "Ile kosztują brwi permanentne metodą włoskową?",
    answer:
      "Makijaż permanentny brwi metodą włoskową kosztuje 1400 zł. Technika wymaga precyzyjnego zaplanowania kierunku włosa oraz kwalifikacji skóry.",
  },
  {
    question: "Czy korekta brwi permanentnych jest w cenie?",
    answer:
      "Tak. W cenie zabiegu głównego uwzględniona jest korekta do 2 miesięcy od zabiegu głównego. Jej celem jest ocena wygojonego efektu i ewentualne dopracowanie nasycenia lub detalu.",
  },
  {
    question: "Ile kosztuje odświeżenie brwi permanentnych?",
    answer:
      "Odświeżenie makijażu permanentnego brwi wykonanego w gabinecie do 2 lat kosztuje 500–700 zł. Starsze pigmentacje lub prace z innego gabinetu wymagają indywidualnej oceny.",
  },
  {
    question: "Dlaczego metoda włoskowa kosztuje więcej niż cieniowanie?",
    answer:
      "Metoda włoskowa wymaga większej precyzji, kontroli kierunku i rytmu włosa oraz odpowiedniej kwalifikacji skóry. Nie każda skóra nadaje się do efektu włoskowego.",
  },
  {
    question: "Ile kosztuje poprawa brwi permanentnych po innym gabinecie?",
    answer:
      "Nie ma jednej stałej ceny. Najpierw trzeba ocenić kolor, nasycenie, kształt, stan skóry i możliwość wykonania nowej pigmentacji. Czasem konieczne jest wcześniejsze rozjaśnienie starego PMU.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];

const media = guideMedia["makijaz-permanentny-brwi-cena"];
const socialImage = await getImage({ src: media.cover.src, width: 1200, height: 630, fit: "cover", format: "webp", quality: 82 });
const articleWithImages = structuredData.map(item => item["@type"] === "Article"
  ? { ...item, image: [new URL(socialImage.src, "https://www.permanentnybielsko.com").href] } : item);
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={articleWithImages}
  ogImage={socialImage.src}
  ogImageAlt={media.cover.alt}
  ogType="article"
  showGuideSocial={false}
  inlineGuideAssistant
>
  <div class="brow-price-guide">
    <Header compact />

    <main class="pmu-guide-v3 pmu-guide-v4">
      <section class="expert-article-hero">
        <div class="expert-article-glow guide-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow guide-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
            <GuideSeriesByline />
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>

            <div class="guide-answer-price">
              <span>Brwi permanentne</span>
              <strong>od 1200 zł</strong>
            </div>

            <p>{article.shortAnswer}</p>

            <a href="#ceny-brwi">Zobacz ceny ↓</a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section" aria-label="Najważniejsze ceny brwi permanentnych">
        <div class="container">
          <div class="quick-price-scroll">
            <article>
              <span>01</span>
              <strong>Cieniowanie</strong>
              <em>1200 zł</em>
              <p>Miękkie wypełnienie i uporządkowany kształt.</p>
            </article>

            <article>
              <span>02</span>
              <strong>Metoda włoskowa</strong>
              <em>1400 zł</em>
              <p>Efekt pojedynczych włosków przy odpowiednich warunkach skóry.</p>
            </article>

            <article>
              <span>03</span>
              <strong>Włos + cień</strong>
              <em>1400 zł</em>
              <p>Połączenie struktury włosa z delikatnym wypełnieniem.</p>
            </article>

            <article>
              <span>04</span>
              <strong>Odświeżenie</strong>
              <em>500–700 zł</em>
              <p>Dotyczy brwi wykonanych w gabinecie do 2 lat.</p>
            </article>
          </div>

          <p class="quick-price-note">
            Zabieg główny obejmuje korektę do 2 miesięcy od zabiegu głównego. Stare PMU lub pigmentacja wykonana w innym gabinecie wymaga indywidualnej kwalifikacji.
          </p>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <details class="guide-toc" open><summary>Przejdź do wybranej odpowiedzi</summary><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#ceny-brwi">Ceny brwi</a>
            <a href="#co-obejmuje-cena">Co jest w cenie</a>
            <a href="#metody">1200 czy 1400 zł?</a>
            <a href="#korekta-odswiezenie">Korekta i odświeżenie</a>
            <a href="#stare-pmu">Stare PMU</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#faq">FAQ</a>
          </nav></details>
        </div>
      </section>
<div class:list={["guide-series-cover", { "portrait-cover": media.cover.src.height > media.cover.src.width }]}>
  <GuideArticleMedia photos={[media.cover]} cover />
</div>


      <section class="expert-article-section" id="ceny-brwi">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Ceny brwi PMU</p>
            <h2>Ile kosztują brwi permanentne w 2026 roku?</h2>
            <p>
              Najważniejsze jest rozróżnienie pierwszego zabiegu, techniki oraz odświeżenia starszej pigmentacji. Samo słowo „brwi permanentne” może więc oznaczać kilka różnych zakresów pracy.
            </p>
          </div>

          <div class="price-compare" aria-label="Porównanie cen metod brwi permanentnych">
            <article class="price-card">
              <div>
                <span>Cieniowanie</span>
                <strong>1200 zł</strong>
              </div>
              <h3>Brwi cieniowane</h3>
              <p>
                Miękki, pudrowy lub bardziej nasycony efekt. Dobre rozwiązanie, gdy celem jest uporządkowanie kształtu i równomierne wypełnienie.
              </p>
              <a href="/makijaz-permanentny-brwi/#metody-brwi">Zobacz metodę →</a>
            </article>

            <article class="price-card price-card-accent">
              <div>
                <span>Włos maszynowy</span>
                <strong>1400 zł</strong>
              </div>
              <h3>Metoda włoskowa</h3>
              <p>
                Efekt pojedynczych włosków prowadzonych zgodnie z naturalnym kierunkiem brwi. Technika wymaga odpowiednich warunków skóry.
              </p>
              <a href="/poradnik/czy-kazda-skora-nadaje-sie-do-metody-wloskowej/">Czy moja skóra się nadaje? →</a>
            </article>

            <article class="price-card">
              <div>
                <span>Technika łączona</span>
                <strong>1400 zł</strong>
              </div>
              <h3>Włos z cieniem</h3>
              <p>
                Łączy strukturę włosa z lekkim cieniem. Może dać pełniejszą oprawę oka bez ciężkiej, graficznej formy.
              </p>
              <a href="/poradnik/metody-brwi-permanentnych-ombre-pudrowe-wloskowe/">Porównaj techniki →</a>
            </article>

            <article class="price-card price-card-soft">
              <div>
                <span>Do 2 lat</span>
                <strong>500–700 zł</strong>
              </div>
              <h3>Odświeżenie brwi</h3>
              <p>
                Dotyczy makijażu permanentnego wykonanego w gabinecie, kiedy po czasie efekt wymaga ponownego nasycenia.
              </p>
              <a href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">Korekta czy odświeżenie? →</a>
            </article>
          </div>

          <div class="decision-bridge">
            <div>
              <span>Nie wiesz, którą metodę wybrać?</span>
              <strong>Nie wybieraj techniki tylko po cenie.</strong>
            </div>

            <div class="decision-actions">
              <a href="/makijaz-permanentny-brwi/">Zobacz brwi</a>
              <a href="/cennik-makijaz-permanentny/#price-group-1">Pełny cennik</a>
            </div>
          </div>
        </div>
      </section>

      <section class="expert-article-section guide-section-soft" id="co-obejmuje-cena">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Co obejmuje cena?</p>
            <h2>1200 lub 1400 zł to nie tylko moment pigmentacji.</h2>
            <p>
              Cena zabiegu obejmuje cały proces prowadzący do efektu: od kwalifikacji i projektu brwi po ocenę wygojenia i korektę.
            </p>
          </div>

          <div class="included-grid">
            <article>
              <span>01</span>
              <h3>Konsultacja i kwalifikacja</h3>
              <p>Ocena skóry, naturalnych brwi, wcześniejszych zabiegów i oczekiwanego efektu.</p>
            </article>

            <article>
              <span>02</span>
              <h3>Rysunek wstępny</h3>
              <p>Kształt, proporcje i kierunek brwi są omawiane przed rozpoczęciem pigmentacji.</p>
            </article>

            <article>
              <span>03</span>
              <h3>Dobór metody i koloru</h3>
              <p>Technika i pigment wynikają ze skóry, urody, naturalnego włosa i oczekiwanej intensywności.</p>
            </article>

            <article>
              <span>04</span>
              <h3>Pigmentacja</h3>
              <p>Precyzyjna praca z kontrolą nasycenia, kształtu i reakcji skóry.</p>
            </article>

            <article>
              <span>05</span>
              <h3>Zalecenia po zabiegu</h3>
              <p>Pielęgnacja po pigmentacji i informacje o tym, czego spodziewać się podczas gojenia.</p>
            </article>

            <article>
              <span>06</span>
              <h3>Korekta do 2 miesięcy</h3>
              <p>Ocena wygojonego efektu i ewentualne dopracowanie nasycenia, koloru lub detalu.</p>
            </article>
          </div>

          <div class="article-link-row">
            <a href="/poradnik/rysunek-wstepny-przed-makijazem-permanentnym/">
              <span>Rysunek wstępny</span>
              <strong>Dlaczego jest tak ważny? →</strong>
            </a>

            <a href="/poradnik/jak-goja-sie-brwi-permanentne/">
              <span>Po zabiegu</span>
              <strong>Zobacz, jak goją się brwi →</strong>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="metody">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">1200 czy 1400 zł?</p>
            <h2>Dlaczego metoda włoskowa kosztuje więcej niż cieniowanie?</h2>
            <p>
              Różnica nie wynika z samej nazwy techniki. Włos maszynowy wymaga planowania każdego kierunku, odpowiedniej kwalifikacji skóry i bardzo precyzyjnej kontroli pracy.
            </p>
          </div>

          <div class="method-accordion">
            <details open>
              <summary>
                <span>01</span>
                <strong>Cieniowanie — 1200 zł</strong>
                <em>+</em>
              </summary>
              <div>
                <p>
                  Cieniowanie buduje miękkie wypełnienie. Może być bardzo delikatne albo bardziej wyraźne, ale nie wymaga imitowania każdego pojedynczego włosa.
                </p>
                <a href="/makijaz-permanentny-brwi/#metody-brwi">Zobacz opis metody →</a>
              </div>
            </details>

            <details>
              <summary>
                <span>02</span>
                <strong>Metoda włoskowa — 1400 zł</strong>
                <em>+</em>
              </summary>
              <div>
                <p>
                  Każdy włosek jest projektowany pod kątem kierunku, długości, odstępu i naturalnego wzrostu. Technika nie jest automatycznie najlepsza dla każdego typu skóry.
                </p>
                <a href="/poradnik/czy-kazda-skora-nadaje-sie-do-metody-wloskowej/">Sprawdź kwalifikację skóry →</a>
              </div>
            </details>

            <details>
              <summary>
                <span>03</span>
                <strong>Włos z cieniem — 1400 zł</strong>
                <em>+</em>
              </summary>
              <div>
                <p>
                  To połączenie struktury włosa z delikatnym cieniem. Stosuje się je wtedy, gdy sama metoda włoskowa byłaby zbyt lekka dla oczekiwanego efektu.
                </p>
                <a href="/poradnik/metody-brwi-permanentnych-ombre-pudrowe-wloskowe/">Porównaj wszystkie metody →</a>
              </div>
            </details>
          </div>

          <div class="expert-note">
            <p class="section-kicker">Ważne</p>
            <h3>Droższa metoda nie oznacza automatycznie lepszej metody dla Ciebie.</h3>
            <p>
              Jeśli skóra nie daje dobrych warunków do stabilnego efektu włoskowego, bardziej przewidywalnym kierunkiem może być cieniowanie lub technika łączona. Metodę warto dobierać do skóry i efektu, nie do samej ceny.
            </p>
          </div>
        </div>
      </section>
<GuideArticleMedia photos={media.photos} label={media.label} />


      <section class="expert-article-section guide-section-soft" id="korekta-odswiezenie">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Korekta, dopigmentowanie, odświeżenie</p>
            <h2>To trzy różne sytuacje — i nie powinny być wrzucane do jednego worka.</h2>
          </div>

          <div class="scenario-grid">
            <article>
              <span>Korekta</span>
              <h3>Po pierwszym zabiegu</h3>
              <p>
                Oceniamy wygojony efekt i w razie potrzeby dopracowujemy drobne elementy. W zabiegu głównym jest uwzględniona w cenie i wykonywana do 2 miesięcy od zabiegu głównego.
              </p>
            </article>

            <article>
              <span>Dopigmentowanie</span>
              <h3>Dopracowanie efektu po gojeniu</h3>
              <p>
                W języku klientek słowo „dopigmentowanie” często oznacza etap korekty. Kluczowe jest to, że decyzję podejmuje się po ocenie skóry i przyjęcia pigmentu.
              </p>
            </article>

            <article>
              <span>Odświeżenie</span>
              <h3>Powrót do pigmentacji po czasie</h3>
              <p>
                Gdy starsze brwi tracą intensywność, można rozważyć odświeżenie. Dla prac wykonanych w gabinecie do 2 lat cena wynosi 500–700 zł.
              </p>
            </article>
          </div>

          <a class="wide-link" href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">
            Korekta czy odświeżenie? Zobacz pełne wyjaśnienie <span>→</span>
          </a>
        </div>
      </section>

      <section class="expert-article-section" id="stare-pmu">
        <div class="container old-pmu-panel">
          <div>
            <p class="section-kicker">Stare PMU</p>
            <h2>Brwi po innym gabinecie nie mają jednej stałej ceny.</h2>
            <p>
              Jeśli pigment jest stary, ciemny, chłodny, nierówny albo wychodzi poza korzystny kształt, nie powinno się automatycznie dokładać kolejnej warstwy. Najpierw trzeba ocenić, czy możliwa jest korekta, czy lepszym pierwszym krokiem będzie rozjaśnienie.
            </p>

            <div class="old-pmu-actions">
              <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU →</a>
              <a href="/usuwanie-makijazu-permanentnego/">Usuwanie starego PMU →</a>
            </div>
          </div>

          <div class="old-pmu-list">
            <div>
              <strong>Kolor</strong>
              <span>czy pigment jest chłodny, czerwony, szary lub bardzo ciemny</span>
            </div>
            <div>
              <strong>Nasycenie</strong>
              <span>czy skóra ma jeszcze przestrzeń na nową, estetyczną pigmentację</span>
            </div>
            <div>
              <strong>Kształt</strong>
              <span>czy stare PMU mieści się w planowanym projekcie nowych brwi</span>
            </div>
            <div>
              <strong>Stan skóry</strong>
              <span>czy skóra jest gotowa na kolejny zabieg i jaki kierunek jest bezpieczny</span>
            </div>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam cenę na realny plan zabiegu?</h2>
            <p>
              Nie zaczynam od pytania „którą metodę Pani wybiera?”. Najpierw oceniam naturalne brwi, skórę, rysy twarzy, wcześniejsze pigmentacje i oczekiwany efekt. Dopiero później dobieramy technikę.
            </p>
            <p>
              Dzięki temu cena wynika z konkretnego zakresu pracy, a nie z przypadkowo wybranej nazwy zabiegu.
