---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "opryszczka-a-makijaz-permanentny-ust",
  title: "Opryszczka a makijaż permanentny ust — co zrobić i jak się przygotować?",
  eyebrow: "Poradnik PMU",
  category: "Opryszczka i PMU ust",
  datePublished: "2026-06-18",
  dateModified: "2026-08-20",
  readingTime: "9–11 minut",
  description: "Opryszczka a makijaż permanentny ust: kiedy przełożyć zabieg, co powiedzieć przed wizytą, dlaczego nie działać samodzielnie i kiedy skonsultować lekarza.",
  lead: "Opryszczka przy makijażu permanentnym ust to temat, którego nie można bagatelizować. Aktywna zmiana na ustach jest przeciwwskazaniem do zabiegu, a osoby ze skłonnością do nawrotów powinny powiedzieć o tym podczas kwalifikacji.",
  shortAnswer: "Aktywna opryszczka oznacza, że makijaż permanentny ust trzeba przełożyć. Jeśli masz skłonność do opryszczki, poinformuj o tym przed zabiegiem. Ewentualna profilaktyka przeciwwirusowa powinna być ustalona z lekarzem, a nie stosowana samodzielnie na podstawie porad z internetu.",
  canonicalPath: "/poradnik/opryszczka-a-makijaz-permanentny-ust/",
  mainService: {
    href: "/makijaz-permanentny-ust/",
    title: "Makijaż permanentny ust",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://www.aad.org/public/diseases/a-z/cold-sores-causes",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy można zrobić makijaż permanentny ust z opryszczką?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. Aktywna opryszczka, pęcherzyki, ranki lub świeże zmiany w okolicy ust są powodem do przełożenia zabiegu.",
        },
      },
      {
        "@type": "Question",
        name: "Co zrobić, jeśli opryszczka pojawi się dzień przed zabiegiem?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Należy skontaktować się z gabinetem i przełożyć termin. Warto też skonsultować się z lekarzem.",
        },
      },
      {
        "@type": "Question",
        name: "Czy trzeba brać Heviran przed PMU ust?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Decyzję o leku, dawkowaniu i czasie stosowania powinien podjąć lekarz.",
        },
      },
      {
        "@type": "Question",
        name: "Czy opryszczka może pojawić się po PMU ust?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "U osób ze skłonnością do nawrotów jest to możliwe.",
        },
      },
      {
        "@type": "Question",
        name: "Kiedy można wykonać PMU ust po opryszczce?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Zabieg można rozważyć dopiero po pełnym wygojeniu zmian i ocenie skóry.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#dlaczego-wazne">Bezpieczeństwo</a>
            <a href="#aktywna-opryszczka">Przełożenie zabiegu</a>
            <a href="#profilaktyka">Profilaktyka lekowa</a>
            <a href="#po-zabiegu">Po pigmentacji</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="dlaczego-wazne">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Bezpieczeństwo</p>
            <h2>Opryszczka przy PMU ust to ważny element kwalifikacji.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Makijaż permanentny ust wykonywany jest na delikatnej czerwieni wargowej. Zabieg narusza naskórek i może być dla tej okolicy bodźcem drażniącym.</p>
            <p>Nie chodzi o straszenie klientki, ale o rozsądny plan. Jeśli opryszczka pojawia się często, przy stresie, infekcji, słońcu albo zabiegach w okolicy ust, trzeba to omówić przed pigmentacją.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Powiedz o nawrotach</h3>
              <p>Nawet jeśli aktualnie nie masz zmiany, historia opryszczki ma znaczenie.</p>
            </article>
            <article>
              <h3>Nie ukrywaj objawów</h3>
              <p>Pieczenie, mrowienie lub pęcherzyk przed wizytą trzeba zgłosić.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="aktywna-opryszczka">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Przełożenie zabiegu</p>
            <h2>Z aktywną opryszczką nie wykonuje się makijażu permanentnego ust.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Aktywna opryszczka, pęcherzyki, ranki, sączenie lub świeże zmiany w obrębie ust są powodem do przełożenia zabiegu.</p>
            <p>Jeśli objawy pojawią się tuż przed wizytą, najlepiej skontaktować się z gabinetem. To nie jest powód do wstydu, tylko normalna sytuacja wymagająca zmiany planu.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Mrowienie i pieczenie</h3>
              <p>To mogą być pierwsze sygnały nawrotu — zgłoś je przed zabiegiem.</p>
            </article>
            <article>
              <h3>Pęcherzyki i ranki</h3>
              <p>Przy aktywnej zmianie termin należy przełożyć.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="profilaktyka">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Profilaktyka lekowa</p>
            <h2>Profilaktykę przeciwwirusową ustala lekarz, nie internet.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Wiele osób szuka informacji o Heviranie, acyklowirze albo lekach przeciwwirusowych przed makijażem permanentnym ust. Ważne: gabinet może przypomnieć o konieczności konsultacji, ale nie powinien zastępować lekarza w decyzji o leczeniu i dawkowaniu.</p>
            <p>Jeśli masz częste nawroty opryszczki, skonsultuj temat z lekarzem odpowiednio wcześniej.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Nie dobieraj dawki sama</h3>
              <p>Leki przeciwwirusowe powinny być stosowane zgodnie z zaleceniem lekarza.</p>
            </article>
            <article>
              <h3>Zapytaj wcześniej</h3>
              <p>Nie zostawiaj tematu opryszczki na dzień zabiegu.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="po-zabiegu">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Po pigmentacji</p>
            <h2>Co zrobić, jeśli opryszczka pojawi się po PMU ust?</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Jeśli po zabiegu pojawią się objawy opryszczki, najlepiej szybko skontaktować się z gabinetem i lekarzem. Nie warto czekać ani nakładać przypadkowych preparatów.</p>
            <p>W czasie gojenia ust ważne jest, aby nie odrywać skórek, nie drażnić czerwieni wargowej i nie próbować maskować problemu kosmetykami kolorowymi.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Reaguj szybko</h3>
              <p>Przy pęcherzykach lub silnym pieczeniu skontaktuj się z lekarzem.</p>
            </article>
            <article>
              <h3>Nie maskuj kosmetykami</h3>
              <p>Makijaż na świeżej zmianie może pogorszyć komfort i higienę.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">To poradnik informacyjny, nie zalecenie lekarskie</h3>
            <p>Przy aktywnej opryszczce, częstych nawrotach, lekach przeciwwirusowych lub niepokojących objawach skontaktuj się z lekarzem. Gabinet może przełożyć zabieg ze względów bezpieczeństwa.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/makijaz-permanentny-ust/">
              <h3>Makijaż permanentny ust</h3>
              <p>Zobacz opis zabiegu i naturalnego efektu.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/">
              <h3>Gojenie ust po PMU</h3>
              <p>Sprawdź, jak wygląda proces gojenia ust.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-ust-jak-wybrac-kolor/">
              <h3>Jak wybrać kolor ust?</h3>
              <p>Dowiedz się, jak dobiera się pigment.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/makijaz-permanentny-ust-bielsko-biala/">
              <h3>Makijaż permanentny ust Bielsko-Biała — naturalny kolor, miękki kontur i gojenie</h3>
              <p>Rozwinięcie tego zagadnienia w osobnym poradniku.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://www.aad.org/public/diseases/a-z/cold-sores-causes" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Cold sores: Who gets and causes</h3>
              <p>AAD opisuje HSV oraz czynniki mogące wyzwalać nawroty opryszczki, w tym uraz okolicy i zabiegi kosmetyczne.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <h3>Permanent makeup: A review of its technique, regulation, and complications</h3>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoos & Permanent Makeup: Fact Sheet</h3>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Czy można zrobić makijaż permanentny ust z opryszczką?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie. Aktywna opryszczka, pęcherzyki, ranki lub świeże zmiany w okolicy ust są powodem do przełożenia zabiegu.</p></div>
            </details>
            <details>
              <summary>
                <span>Co zrobić, jeśli opryszczka pojawi się dzień przed zabiegiem?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Należy skontaktować się z gabinetem i przełożyć termin. Warto też skonsultować się z lekarzem.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy trzeba brać Heviran przed PMU ust?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Decyzję o leku, dawkowaniu i czasie stosowania powinien podjąć lekarz.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy opryszczka może pojawić się po PMU ust?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>U osób ze skłonnością do nawrotów jest to możliwe.</p></div>
            </details>
            <details>
              <summary>
                <span>Kiedy można wykonać PMU ust po opryszczce?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Zabieg można rozważyć dopiero po pełnym wygojeniu zmian i ocenie skóry.</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Chcesz ocenić swój przypadek przed zabiegiem?</h2>
          <p>
            Jeśli wiesz, jakiego zabiegu potrzebujesz — sprawdź terminy.
            Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href={article.mainService.href}>
              {article.mainService.title}
            </a>
          </div>

          <a class="expert-back-link" href="/poradnik/">
            ← Wróć do całego poradnika PMU
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .expert-legacy-copy {
    max-width: 940px;
  }

  .expert-legacy-copy p {
    margin: 16px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.72;
  }

  .expert-legacy-copy p:first-of-type {
    margin-top: 0;
  }

  .expert-legacy-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .expert-legacy-cards article {
    min-height: 150px;
    padding: 23px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 24px;
    background:
      radial-gradient(circle at 94% 10%, rgba(56, 187, 181, 0.07), transparent 11rem),
      rgba(255, 255, 255, 0.90);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.055);
  }

  .expert-legacy-cards h3 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-size: clamp(1.25rem, 1.6vw, 1.72rem);
    font-weight: 770;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .expert-legacy-cards p {
    margin: 11px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .expert-focus-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .expert-focus-links a {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 17px 18px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 18px;
    background: rgba(219, 246, 243, 0.38);
    color: var(--color-text, #17151d);
    font-size: 0.88rem;
