---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "rysunek-wstepny-przed-makijazem-permanentnym",
  title: "Dlaczego rysunek wstępny jest najważniejszy przed pigmentacją?",
  eyebrow: "Poradnik PMU",
  category: "Rysunek wstępny",
  datePublished: "2026-06-08",
  dateModified: "2026-08-20",
  readingTime: "7–9 minut",
  description: "Rysunek wstępny przed makijażem permanentnym to etap decyzji o kształcie, proporcji i naturalnym efekcie. Sprawdź, dlaczego nie warto go pomijać.",
  lead: "Rysunek wstępny to jeden z najważniejszych etapów makijażu permanentnego. To tutaj klientka widzi kierunek przyszłego efektu, a linergistka analizuje twarz, asymetrię, mimikę, naturalne brwi, usta albo powieki. Bez dobrego projektu pigmentacja staje się zbyt przypadkowa.",
  shortAnswer: "Rysunek wstępny pozwala zaplanować kształt, proporcję, symetrię i intensywność makijażu permanentnego przed wprowadzeniem pigmentu. Chroni przed zbyt pochopną decyzją i pomaga dopasować brwi, usta lub kreski do twarzy, a nie do przypadkowego trendu.",
  canonicalPath: "/poradnik/rysunek-wstepny-przed-makijazem-permanentnym/",
  mainService: {
    href: "/makijaz-permanentny-bielsko/",
    title: "Makijaż permanentny",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czy rysunek wstępny wykonuje się przed każdym zabiegiem PMU?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak, projekt jest podstawą świadomej decyzji przed pigmentacją brwi, ust lub kresek.",
        },
      },
      {
        "@type": "Question",
        name: "Czy można zmienić rysunek przed zabiegiem?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Rysunek jest po to, aby omówić i dopracować kierunek przed rozpoczęciem pigmentacji.",
        },
      },
      {
        "@type": "Question",
        name: "Czy rysunek musi być idealnie symetryczny?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie zawsze. Twarz naturalnie pracuje i ma asymetrie. Celem jest harmonia, a nie sztuczna identyczność za wszelką cenę.",
        },
      },
      {
        "@type": "Question",
        name: "Czy przy starym PMU rysunek jest trudniejszy?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Często tak, ponieważ stary pigment narzuca ograniczenia kształtu, koloru i szerokości.",
        },
      },
      {
        "@type": "Question",
        name: "Czy mogę przyjść ze zdjęciem inspiracji?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak, ale inspiracja powinna być punktem rozmowy, nie gotowym szablonem do skopiowania.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="expert-article-glow expert-article-glow-one" aria-hidden="true"></div>
        <div class="expert-article-glow expert-article-glow-two" aria-hidden="true"></div>

        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="expert-article-meta">
              <span>Ekspercki poradnik</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>

            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Najważniejsze bez powtarzania.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#decyzja">Etap decyzji</a>
            <a href="#twarz">Twarz i proporcje</a>
            <a href="#zgoda">Akceptacja projektu</a>
            <a href="#stary-pmu">Stary PMU</a>
            <a href="#praktyka">Praktyka</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="decyzja">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Etap decyzji</p>
            <h2>Rysunek wstępny nie jest dodatkiem do zabiegu.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>W makijażu permanentnym najważniejsza decyzja zapada przed pigmentacją. Rysunek wstępny pozwala zobaczyć kierunek kształtu, szerokość, długość, łuk, kontur albo przebieg kreski, zanim pigment znajdzie się w skórze.</p>
            <p>To etap, w którym można spokojnie rozmawiać, korygować i tłumaczyć, dlaczego pewne rozwiązanie będzie korzystne, a inne może dać zbyt ciężki efekt. Dobrze wykonany projekt zmniejsza ryzyko przypadkowego rezultatu.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Widoczna decyzja</h3>
              <p>Klientka widzi projekt przed pigmentacją, a nie dopiero po zabiegu.</p>
            </article>
            <article>
              <h3>Bez pośpiechu</h3>
              <p>Kształt powinien być zaakceptowany spokojnie i świadomie.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="twarz">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Twarz i proporcje</p>
            <h2>Dobry projekt wynika z twarzy, nie z szablonu.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Nie ma jednej idealnej brwi, jednego idealnego konturu ust ani jednej kreski dobrej dla każdej osoby. Twarz ma naturalne asymetrie, mimikę, różny układ mięśni, inną budowę powieki i inny kształt czerwieni wargowej.</p>
            <p>Rysunek wstępny pozwala te elementy uporządkować. Celem nie jest matematyczna identyczność, ale harmonijny efekt, który wygląda dobrze w codziennym życiu i nie dominuje nad urodą.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Asymetria</h3>
              <p>Naturalna asymetria twarzy nie zawsze powinna być korygowana na siłę.</p>
            </article>
            <article>
              <h3>Mimika</h3>
              <p>Projekt musi wyglądać dobrze nie tylko w bezruchu, ale też przy naturalnej ekspresji.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zgoda">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Akceptacja projektu</p>
            <h2>Klientka powinna wiedzieć, na co się decyduje.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Rysunek wstępny daje przestrzeń na pytania. To dobry moment, aby powiedzieć, czy efekt ma być bardzo subtelny, bardziej widoczny, miękki, naturalny albo bardziej uporządkowany.</p>
            <p>Dobra komunikacja przed pigmentacją jest ważniejsza niż szybkie przejście do zabiegu. Jeśli projekt budzi wątpliwości, trzeba je omówić przed rozpoczęciem pracy, a nie po wykonaniu makijażu permanentnego.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Jasne oczekiwania</h3>
              <p>Projekt pomaga połączyć oczekiwania klientki z realnymi możliwościami skóry.</p>
            </article>
            <article>
              <h3>Bez niespodzianek</h3>
              <p>Im lepiej omówiony rysunek, tym spokojniejszy przebieg zabiegu.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="stary-pmu">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Stary PMU</p>
            <h2>Rysunek pokazuje też ograniczenia starego pigmentu.</h2>
          </div>

          <div class="expert-legacy-copy">
            <p>Przy wcześniejszym makijażu permanentnym rysunek wstępny jest szczególnie ważny. Stary pigment może być zbyt szeroki, zbyt ciemny, przesunięty, szary, czerwony albo nierówny. Nie zawsze da się go przykryć tak, aby uzyskać lekki i naturalny efekt.</p>
            <p>W takiej sytuacji projekt pomaga ocenić, czy nowa pigmentacja ma sens, czy najpierw lepszym rozwiązaniem będzie rozjaśnianie laserem, removerem albo etapowa korekta.</p>
          </div>
          <div class="expert-legacy-cards">
            <article>
              <h3>Granice korekty</h3>
              <p>Nie każdy stary kształt da się bezpiecznie przykryć nowym.</p>
            </article>
            <article>
              <h3>Plan etapowy</h3>
              <p>Czasem najlepszy efekt wymaga najpierw rozjaśnienia pigmentu.</p>
            </article>
          </div>
        </div>
      </section>


      <section class="expert-article-section">
        <div class="container">
          <div class="expert-source-inline">
            <span>Ważne</span>
            <h3 style="margin:0 0 9px;color:var(--color-text,#17151d);font-size:1.25rem;">Kiedy nie warto zaczynać pigmentacji od razu?</h3>
            <p>Jeśli projekt nie jest zaakceptowany, skóra jest podrażniona, oczekiwania są niejasne albo stary pigment ogranicza możliwość uzyskania naturalnego efektu, lepiej zatrzymać się na konsultacji i zaplanować dalsze kroki.</p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="praktyka">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak przekładam tę wiedzę na realny zabieg?</h2>
            <p>
              Nie stosuję jednej odpowiedzi dla każdej skóry i każdej klientki.
              Najpierw oceniam aktualny stan skóry, wcześniejszy makijaż permanentny,
              naturalną anatomię oraz oczekiwany efekt. Dopiero potem wybieramy metodę
              i plan postępowania.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Powiązane tematy</p>
            <h2>Nie opisujemy wszystkiego drugi raz — przejdź do właściwego zagadnienia.</h2>
          </div>

          <div class="expert-related-grid">
            <a href="/makijaz-permanentny-bielsko/">
              <h3>Makijaż permanentny Bielsko-Biała</h3>
              <p>Zobacz główną ofertę PMU i podejście do naturalnej pigmentacji.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/makijaz-permanentny-brwi/">
              <h3>Brwi permanentne</h3>
              <p>Sprawdź, jak rysunek wpływa na efekt brwi.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/kiedy-usuwac-stary-makijaz-permanentny/">
              <h3>Stary makijaż permanentny</h3>
              <p>Dowiedz się, kiedy najpierw warto rozjaśnić pigment.</p>
              <span>Czytaj dalej →</span>
            </a>
            <a href="/poradnik/jak-przygotowac-sie-do-makijazu-permanentnego-brwi/">
              <h3>Jak przygotować się do makijażu permanentnego brwi?</h3>
              <p>Rozwinięcie tego zagadnienia w osobnym poradniku.</p>
              <span>Czytaj dalej →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła i materiały odniesienia</p>
            <h2>Na czym opieramy informacje medyczne i techniczne?</h2>
            <p>
              Wiedzę gabinetową oddzielamy od informacji dermatologicznych i instytucjonalnych.
              Tam, gdzie nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.
            </p>
          </div>

          <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span>
              <h3>Permanent makeup: A review of its technique, regulation, and complications</h3>
              <p>Przegląd dermatologiczny PMU: technika, regulacje oraz możliwe powikłania.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span>
              <h3>Tattoos & Permanent Makeup: Fact Sheet</h3>
              <p>Informacje instytucjonalne o permanent makeup jako formie pigmentacji skóry, bezpieczeństwie i możliwych reakcjach.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin" target="_blank" rel="noopener noreferrer">
              <span>American Academy of Dermatology</span>
              <h3>Caring for tattooed skin</h3>
              <p>Zalecenia dermatologów dotyczące ochrony i pielęgnacji pigmentowanej skóry.</p>
              <strong>Otwórz źródło ↗</strong>
            </a>
          </div>

          <p class="expert-medical-note">
            Treść ma charakter edukacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej.
            Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania związane z tym tematem.</h2>
          </div>

          <div class="expert-faq-list">
            <details>
              <summary>
                <span>Czy rysunek wstępny wykonuje się przed każdym zabiegiem PMU?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Tak, projekt jest podstawą świadomej decyzji przed pigmentacją brwi, ust lub kresek.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy można zmienić rysunek przed zabiegiem?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Tak. Rysunek jest po to, aby omówić i dopracować kierunek przed rozpoczęciem pigmentacji.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy rysunek musi być idealnie symetryczny?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Nie zawsze. Twarz naturalnie pracuje i ma asymetrie. Celem jest harmonia, a nie sztuczna identyczność za wszelką cenę.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy przy starym PMU rysunek jest trudniejszy?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Często tak, ponieważ stary pigment narzuca ograniczenia kształtu, koloru i szerokości.</p></div>
            </details>
            <details>
              <summary>
                <span>Czy mogę przyjść ze zdjęciem inspiracji?</span>
                <span class="expert-faq-icon" aria-hidden="true"></span>
              </summary>
              <div><p>Tak, ale inspiracja powinna być punktem rozmowy, nie gotowym szablonem do skopiowania.</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Chcesz ocenić swój przypadek przed zabiegiem?</h2>
          <p>
            Jeśli wiesz, jakiego zabiegu potrzebujesz — sprawdź terminy.
            Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href={article.mainService.href}>
              {article.mainService.title}
            </a>
          </div>

          <a class="expert-back-link" href="/poradnik/">
            ← Wróć do całego poradnika PMU
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .expert-legacy-copy {
    max-width: 940px;
  }

  .expert-legacy-copy p {
    margin: 16px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(0.98rem, 1.1vw, 1.06rem);
    line-height: 1.72;
  }

  .expert-legacy-copy p:first-of-type {
    margin-top: 0;
  }

  .expert-legacy-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .expert-legacy-cards article {
    min-height: 150px;
    padding: 23px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 24px;
    background:
      radial-gradient(circle at 94% 10%, rgba(56, 187, 181, 0.07), transparent 11rem),
      rgba(255, 255, 255, 0.90);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.055);
  }

  .expert-legacy-cards h3 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-size: clamp(1.25rem, 1.6vw, 1.72rem);
    font-weight: 770;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .expert-legacy-cards p {
    margin: 11px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .expert-focus-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .expert-focus-links a {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
