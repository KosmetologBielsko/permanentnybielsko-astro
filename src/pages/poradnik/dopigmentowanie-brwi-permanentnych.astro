---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "dopigmentowanie-brwi-permanentnych",
  title: "Dopigmentowanie brwi permanentnych — kiedy jest potrzebne i ile trwa?",
  eyebrow: "Poradnik PMU",
  category: "Brwi permanentne",
  datePublished: "2026-08-27",
  dateModified: "2026-08-27",
  readingTime: "8–10 minut",
  description:
    "Dopigmentowanie brwi permanentnych: kiedy jest potrzebne, ile trwa, czy zawsze trzeba je robić, ile kosztuje i czym różni się od odświeżenia brwi.",
  lead:
    "Dopigmentowanie nie oznacza wykonywania brwi od początku. To etap oceny wygojonego efektu i precyzyjnego uzupełnienia miejsc, w których pigment rzeczywiście wymaga dopracowania.",
  shortAnswer:
    "W gabinecie Bogusławy Herda dopigmentowanie po pierwszym zabiegu brwi jest bezpłatne do 2 miesięcy. Nie zawsze jest konieczne — zakres ocenia się po wygojeniu skóry. Dopigmentowanie domyka pierwszy proces pigmentacji, natomiast późniejszy powrót koloru po miesiącach lub latach jest odświeżeniem.",
  canonicalPath: "/poradnik/dopigmentowanie-brwi-permanentnych/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const scenarios = [
  {
    label: "Wygojenie jest równe",
    price: "może nie być potrzebne",
    text: "Jeśli pigment przyjął się równomiernie, kolor i kształt są zgodne z planem, dodatkowa praca może być minimalna albo zbędna.",
    href: "#czy-zawsze",
    cta: "Czy zawsze trzeba?",
  },
  {
    label: "Są jaśniejsze miejsca",
    price: "dopigmentowanie",
    text: "Po wygojeniu mogą pojawić się drobne obszary, w których pigment przyjął się słabiej i wymaga precyzyjnego uzupełnienia.",
    href: "#kiedy",
    cta: "Kiedy ma sens?",
  },
  {
    label: "Brwi zbledły po czasie",
    price: "odświeżenie",
    text: "Po miesiącach lub latach nie mówimy już o dopigmentowaniu pierwszego zabiegu. To osobna decyzja dotycząca odświeżenia.",
    href: "/poradnik/odswiezenie-makijazu-permanentnego-cena/",
    cta: "Sprawdź odświeżenie",
  },
  {
    label: "Masz stare PMU",
    price: "kwalifikacja",
    text: "Przy starej, ciemnej lub zmienionej kolorystycznie pigmentacji najpierw ocenia się kształt, nasycenie i możliwość dalszej pracy.",
    href: "/makijaz-permanentny-bielsko/#kwalifikacja-pmu",
    cta: "Wyślij kwalifikację",
  },
];

const processItems = [
  {
    title: "Ocena wygojenia",
    text: "Sprawdzamy skórę, kolor, nasycenie i równomierność efektu po pierwszym zabiegu.",
  },
  {
    title: "Porównanie z planem",
    text: "Oceniamy, czy wygojony kształt i intensywność odpowiadają efektowi ustalonemu przed pigmentacją.",
  },
  {
    title: "Precyzyjne uzupełnienie",
    text: "Pigmentowane są tylko miejsca, które rzeczywiście wymagają dodatkowej pracy.",
  },
  {
    title: "Kontrola nasycenia",
    text: "Celem nie jest automatyczne przyciemnienie całych brwi, tylko dopracowanie wygojonego efektu.",
  },
  {
    title: "Ponowne gojenie",
    text: "Skóra ponownie się regeneruje, dlatego rezultat ocenia się po jej uspokojeniu.",
  },
  {
    title: "Decyzja po wygojeniu",
    text: "O potrzebie dopigmentowania decyduje stan skóry i efekt po gojeniu, a nie sam fakt wykonania pierwszego zabiegu.",
  },
];

const faqItems = [
  {
    question: "Co to jest dopigmentowanie brwi permanentnych?",
    answer:
      "Dopigmentowanie to etap oceny i dopracowania efektu po wygojeniu pierwszej pigmentacji. Uzupełnia się tylko miejsca, w których kolor, nasycenie lub równomierność wymagają dodatkowej pracy.",
  },
  {
    question: "Czy dopigmentowanie brwi jest zawsze konieczne?",
    answer:
      "Nie zawsze. Jeśli pigment przyjął się równomiernie, a kolor i kształt są zgodne z planem, zakres dodatkowej pracy może być minimalny albo może nie być potrzebny.",
  },
  {
    question: "Kiedy robi się dopigmentowanie brwi?",
    answer:
      "Potrzebę dopigmentowania ocenia się po wygojeniu skóry. W gabinecie Bogusławy Herda dopigmentowanie po pierwszym zabiegu brwi jest bezpłatne do 2 miesięcy.",
  },
  {
    question: "Ile trwa dopigmentowanie brwi?",
    answer:
      "Nie ma jednej stałej długości wizyty. Zwykle zakres jest mniejszy niż podczas pierwszej pigmentacji, ponieważ brwi nie są projektowane od początku. Czas zależy od techniki, skóry i liczby miejsc wymagających uzupełnienia.",
  },
  {
    question: "Ile kosztuje dopigmentowanie brwi?",
    answer:
      "W gabinecie Bogusławy Herda dopigmentowanie będące częścią pierwszego procesu pigmentacji brwi jest bezpłatne do 2 miesięcy. Późniejszy powrót koloru po dłuższym czasie jest odświeżeniem i stanowi inną usługę.",
  },
  {
    question: "Dopigmentowanie a odświeżenie brwi — jaka jest różnica?",
    answer:
      "Dopigmentowanie domyka pierwszy proces pigmentacji po wygojeniu. Odświeżenie wykonuje się po dłuższym czasie, gdy wcześniej wygojony makijaż permanentny stopniowo traci intensywność.",
  },
  {
    question: "Czy podczas dopigmentowania można całkowicie zmienić kształt brwi?",
    answer:
      "Dopigmentowanie służy przede wszystkim dopracowaniu wcześniej zaplanowanego efektu. Większa zmiana kształtu, koloru albo praca na starym PMU wymaga osobnej oceny i może oznaczać inny plan postępowania.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="price-guide-page">
    <Header />

    <main>
      <section class="price-hero">
        <div class="price-glow price-glow-one" aria-hidden="true"></div>
        <div class="price-glow price-glow-two" aria-hidden="true"></div>

        <div class="container price-hero-grid">
          <div class="price-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="price-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
              <span>Aktualizacja: 27.08.2026</span>
            </div>

            <h1>{article.title}</h1>
            <p class="price-lead">{article.lead}</p>

            <div class="price-hero-actions">
              <a class="price-primary" href="#kiedy">Kiedy dopigmentować? <span aria-hidden="true">→</span></a>
              <a class="price-secondary" href="/makijaz-permanentny-brwi/#efekty-brwi">Zobacz efekty brwi</a>
            </div>
          </div>

          <aside class="price-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="price-answer-label">Odpowiedź w 20 sekund</p>
            <strong class="price-big">0 zł*</strong>
            <h2>Dopigmentowanie domyka pierwszy proces po wygojeniu.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="price-nav-section">
        <div class="container">
          <nav class="price-nav" aria-label="Spis treści">
            <a href="#kiedy">Kiedy jest potrzebne?</a>
            <a href="#czy-zawsze">Czy zawsze trzeba?</a>
            <a href="#ile-trwa">Ile trwa?</a>
            <a href="#cena">Cena</a>
            <a href="#dopigmentowanie-czy-odswiezenie">Dopigmentowanie czy odświeżenie?</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="price-section" id="kiedy">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Kiedy dopigmentować brwi?</p>
            <h2>Po wygojeniu — jeśli są miejsca, które rzeczywiście wymagają uzupełnienia.</h2>
            <p>
              Bezpośrednio po pigmentacji brwi są intensywniejsze, a skóra przechodzi kolejne etapy regeneracji.
              Dlatego sens dopigmentowania ocenia się dopiero po wygojeniu, kiedy widać realne nasycenie,
              równomierność koloru i to, jak pigment przyjął się w poszczególnych miejscach.
            </p>
          </div>

          <div class="scenario-scroll" aria-label="Scenariusze po wygojeniu brwi permanentnych">
            {scenarios.map((item) => (
              <article class="scenario-card">
                <span>{item.label}</span>
                <strong>{item.price}</strong>
                <p>{item.text}</p>
                <a href={item.href}>{item.cta} →</a>
              </article>
            ))}
          </div>

          <div class="price-service-bridge">
            <div>
              <span>Główna strona usługi</span>
              <strong>Chcesz zobaczyć realne efekty i metody brwi?</strong>
            </div>
            <div class="price-service-actions">
              <a href="/makijaz-permanentny-brwi/#efekty-brwi">Efekty brwi</a>
              <a href="/makijaz-permanentny-brwi/#metody-brwi">Metody</a>
            </div>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="jak-wyglada">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Jak wygląda dopigmentowanie?</p>
            <h2>Nie wykonujemy całych brwi od początku.</h2>
            <p>
              Punktem wyjścia jest efekt pierwszej pigmentacji po wygojeniu. Najpierw ocenia się, co wymaga dopracowania,
              a później pracuje tylko w tych miejscach, w których kolejna pigmentacja ma realny sens.
            </p>
          </div>

          <div class="included-grid">
            {processItems.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section" id="dopigmentowanie-czy-odswiezenie">
        <div class="container decision-grid">
          <div class="decision-copy">
            <p class="section-kicker">Dopigmentowanie ≠ odświeżenie</p>
            <h2>Dwa podobne słowa, ale dwa różne etapy.</h2>
            <p>
              Dopigmentowanie domyka pierwszy proces pigmentacji po wygojeniu. Odświeżenie dotyczy wcześniej wygojonych brwi,
              które po miesiącach lub latach stopniowo straciły intensywność.
            </p>
            <p>
              Jeżeli problemem jest stary kształt, zmieniony kolor albo mocne nasycenie wcześniejszego PMU,
              nie należy traktować tego jak zwykłego dopigmentowania.
            </p>
          </div>

          <div class="decision-cards">
            <article>
              <span>Dopigmentowanie</span>
              <strong>Po pierwszym zabiegu</strong>
              <p>Ocena wygojenia i uzupełnienie tylko tego, co wymaga dopracowania.</p>
            </article>
            <article>
              <span>Odświeżenie</span>
              <strong>Po dłuższym czasie</strong>
              <p>Nowa decyzja po ocenie koloru, nasycenia, kształtu i stanu wcześniejszego PMU.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="czy-zawsze">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Czy zawsze trzeba?</p>
            <h2>Nie każda dobrze wygojona pigmentacja wymaga dokładania koloru.</h2>
            <p>
              Celem nie jest wykonanie drugiego pełnego zabiegu tylko dlatego, że istnieje możliwość dopigmentowania.
              Jeżeli skóra przyjęła pigment równomiernie, a kolor i kształt są zgodne z planem,
              zakres dodatkowej pracy może być minimalny albo może nie być potrzebny.
            </p>
          </div>

          <div class="triage-grid">
            <article>
              <span>01</span>
              <h3>Efekt jest równy</h3>
              <p>Brak widocznych ubytków może oznaczać, że dodatkowa pigmentacja nie wniesie istotnej poprawy.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Są drobne prześwity</h3>
              <p>Można uzupełnić tylko wybrane miejsca bez niepotrzebnego zwiększania nasycenia całych brwi.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Chcesz mocniejszy efekt</h3>
              <p>Najpierw trzeba ocenić, czy większe nasycenie nadal będzie dobre dla skóry, twarzy i wybranej techniki.</p>
            </article>
          </div>

          <div class="qualification-strip">
            <div>
              <span>Nie wiesz, czy potrzebujesz dopigmentowania?</span>
              <strong>Najpierw oceńmy wygojony efekt.</strong>
            </div>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz kwalifikacji PMU →</a>
          </div>
        </div>
      </section>

      <section class="price-section" id="ile-trwa">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Ile trwa dopigmentowanie?</p>
            <h2>Zwykle krócej niż pierwszy zabieg, ale nie ma jednej uczciwej liczby minut dla każdego.</h2>
            <p>
              Przy dopigmentowaniu nie projektuje się brwi od początku. Zakres pracy zależy od techniki,
              skóry, liczby miejsc wymagających uzupełnienia i tego, jak wygoił się pierwszy zabieg.
              Dlatego czas wizyty najlepiej traktować jako indywidualny.
            </p>
          </div>

          <div class="compare-list">
            <div><strong>Projekt od początku?</strong><span>Nie. Punktem wyjścia jest zaakceptowany i wygojony efekt pierwszej pigmentacji.</span></div>
            <div><strong>Zakres pracy</strong><span>Najczęściej mniejszy niż podczas pierwszego zabiegu, bo uzupełnia się konkretne miejsca.</span></div>
            <div><strong>Co wpływa na czas?</strong><span>Technika, skóra, równomierność pigmentu i liczba obszarów wymagających dopracowania.</span></div>
            <div><strong>Czy można podać jedną liczbę?</strong><span>Nie byłoby to uczciwe, ponieważ dwa wygojone przypadki mogą wymagać zupełnie innego zakresu pracy.</span></div>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="cena">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Cena dopigmentowania</p>
            <h2>W pierwszym procesie brwi — 0 zł do 2 miesięcy.</h2>
            <p>
              W gabinecie Bogusławy Herda dopigmentowanie po pierwszym zabiegu brwi jest bezpłatne do 2 miesięcy.
              Późniejszy powrót koloru po dłuższym czasie jest już odświeżeniem i stanowi inną usługę.
            </p>
          </div>

          <div class="scenario-scroll" aria-label="Cena dopigmentowania i powiązanych usług">
            <article class="scenario-card">
              <span>Dopigmentowanie</span>
              <strong>0 zł*</strong>
              <p>Bez opłaty do 2 miesięcy po pierwszym zabiegu wykonanym w gabinecie Bogusławy Herda.</p>
              <a href="/cennik-makijaz-permanentny/#price-group-1">Sprawdź cennik →</a>
            </article>

            <article class="scenario-card">
              <span>Brwi pudrowe / cieniowane</span>
              <strong>1200 zł</strong>
              <p>Nowa pigmentacja brwi wykonywana od początku po kwalifikacji i projekcie.</p>
              <a href="/makijaz-permanentny-brwi/#metody-brwi">Zobacz metody →</a>
            </article>

            <article class="scenario-card">
              <span>Metoda włoskowa</span>
              <strong>1400 zł</strong>
              <p>Nowa pigmentacja metodą włoskową wykonywana po ocenie skóry i naturalnych brwi.</p>
              <a href="/makijaz-permanentny-brwi/#metody-brwi">Zobacz metodę →</a>
            </article>

            <article class="scenario-card">
              <span>Odświeżenie</span>
              <strong>osobna usługa</strong>
              <p>Dotyczy wcześniej wygojonych brwi, które po dłuższym czasie wymagają przywrócenia koloru.</p>
              <a href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">Sprawdź odświeżenie →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section" id="stare-pmu">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Wcześniejsza pigmentacja</p>
            <h2>Stare PMU nie jest zwykłym dopigmentowaniem.</h2>
            <p>
              Jeśli brwi są zbyt ciemne, zmieniły kolor, mają niekorzystny kształt albo wiele warstw pigmentu,
              dokładanie kolejnej warstwy nie powinno być automatyczną decyzją.
            </p>
          </div>

          <div class="triage-grid">
            <article>
              <span>01</span>
              <h3>Pigment jest lekki</h3>
              <p>Możliwa jest dalsza praca, ale nadal trzeba ocenić kolor, kształt i poziom nasycenia.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Kolor się zmienił</h3>
              <p>Czerwony, pomarańczowy, szary lub grafitowy ton wymaga najpierw diagnozy pigmentu i planu korekty.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Kształt blokuje nowy projekt</h3>
              <p>Czasem przed kolejną pigmentacją lepszym etapem jest rozjaśnienie starego PMU.</p>
            </article>
          </div>

          <div class="qualification-strip">
            <div>
              <span>Masz stare brwi permanentne?</span>
              <strong>Najpierw kwalifikacja, później decyzja: korekta, odświeżenie czy rozjaśnienie.</strong>
            </div>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz kwalifikacji PMU →</a>
          </div>
        </div>
      </section>

      <section class="price-section expert-section">
        <div class="container expert-card">
          <div>
            <p class="section-kicker">Ekspert PMU</p>
            <h2>Dopigmentowanie ma dopracować efekt, a nie automatycznie go przyciemnić.</h2>
            <p>
              Bogusława Herda jest kosmetologiem i linergistką z ponad 10-letnim doświadczeniem,
              8-krotną mistrzynią PMU, wicemistrzynią świata oraz europejskim trenerem Long-Time-Liner®.
              Przy dopigmentowaniu najważniejsza jest ocena wygojonej skóry i świadoma decyzja,
              gdzie kolejna praca rzeczywiście poprawi efekt.
            </p>
          </div>
          <aside>
            <span>Bogusława Herda</span>
            <strong>8× mistrzyni PMU</strong>
            <strong>Wicemistrzyni świata</strong>
            <strong>Europejski trener Long-Time-Liner®</strong>
            <a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie →</a>
          </aside>
        </div>
      </section>

      <section class="price-section price-soft" id="powiazane">
        <div class="container">
          <div class="price-heading">
