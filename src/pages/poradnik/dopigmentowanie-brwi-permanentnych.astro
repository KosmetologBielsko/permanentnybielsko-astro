  /* === ALIGN 2026: ten sam jezyk wizualny co Brwi po latach / Laser === */
  .dop-page *, .dop-page *::before, .dop-page *::after { box-sizing: border-box; }
  .dop-page main, .dop-page section, .dop-page .container, .dop-page article, .dop-page div, .dop-page aside { min-width: 0; }

  .dop-hero { position: relative; overflow: hidden; padding: 144px 0 48px; }
  .dop-hero-glow { position:absolute; border-radius:999px; pointer-events:none; }
  .dop-hero-glow-one { top:2rem; right:-12rem; width:38rem; height:38rem; background:radial-gradient(circle,rgba(56,187,181,.18),transparent 68%); }
  .dop-hero-glow-two { left:-10rem; bottom:-12rem; width:34rem; height:34rem; background:radial-gradient(circle,rgba(201,127,143,.14),transparent 68%); }
  .dop-hero-grid { position:relative; z-index:1; grid-template-columns:minmax(0,1.12fr) minmax(340px,.88fr); gap:18px; align-items:stretch; }
  .dop-hero-copy, .dop-answer, .dop-nav a, .dop-decision-card, .dop-price-grid article, .dop-process-grid article, .dop-checklist>div, .dop-problem-card, .dop-old-grid, .dop-related-grid a, .dop-faq-list details, .dop-final-card { border:1px solid rgba(183,101,118,.14); box-shadow:0 16px 48px rgba(89,53,67,.055); }
  .dop-hero-copy { padding:clamp(32px,4.8vw,58px); border-radius:36px; background:rgba(255,255,255,.88); }
  .dop-meta { gap:6px; margin-bottom:16px; }
  .dop-meta span { min-height:28px; display:inline-flex; align-items:center; padding:0 10px; background:rgba(255,248,251,.94); color:var(--color-muted,#6e6670); font-size:.63rem; font-weight:790; letter-spacing:.07em; }
  .dop-meta span:first-child { background:rgba(56,187,181,.12); color:var(--color-turquoise-dark,#0f7773); }
  .dop-hero h1 { max-width:1000px; font-size:clamp(2.72rem,4.55vw,5rem); font-weight:780; line-height:1.01; letter-spacing:-.071em; }
  .dop-lead { max-width:860px; margin-top:21px; font-size:clamp(1.02rem,1.2vw,1.14rem); line-height:1.65; }

  .dop-answer { display:flex; flex-direction:column; justify-content:flex-end; padding:clamp(27px,3.7vw,42px); border-color:rgba(183,101,118,.14); border-radius:36px; color:#fff; background:radial-gradient(circle at 88% 12%,rgba(255,255,255,.22),transparent 13rem),linear-gradient(145deg,#0f7773 0%,#1aa5a0 48%,#138a86 100%); box-shadow:0 26px 68px rgba(35,156,150,.18); }
  .dop-answer>span { margin:0 auto 38px 0; color:rgba(255,255,255,.72); font-size:.67rem; font-weight:850; letter-spacing:.14em; }
  .dop-answer h2 { margin:0; color:#fff; font-size:clamp(2rem,3vw,3.1rem); font-weight:790; line-height:1; letter-spacing:-.06em; }
  .dop-answer p { margin:16px 0 0; color:rgba(255,255,255,.9); font-size:.89rem; line-height:1.57; }
  .dop-answer strong { color:#fff; }
  .dop-hero-actions { gap:7px; margin-top:17px; }
  .dop-hero-actions a { min-height:40px; padding:0 13px; border:1px solid rgba(255,255,255,.24); background:rgba(255,255,255,.11); color:#fff; font-size:.7rem; }
  .dop-primary, .dop-secondary { background:rgba(255,255,255,.11); color:#fff; }

  .dop-nav-section { padding:0 0 35px; scroll-margin-top:96px; }
  .dop-nav-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin-bottom:17px; }
  .dop-nav-heading h2, .dop-heading h2, .dop-content-copy h2, .dop-soft-card h2, .dop-old-grid h2, .dop-problem-card h2, .dop-final-card h2 { margin:0; color:var(--color-text,#17151d); font-size:clamp(2.05rem,3.45vw,3.7rem); font-weight:770; line-height:1.02; letter-spacing:-.066em; }
  .dop-nav-heading>p { margin:0 0 4px; color:var(--color-muted,#6e6670); font-size:.78rem; }
  .dop-nav { grid-template-columns:repeat(4,minmax(0,1fr)); gap:9px; }
  .dop-nav a { min-height:190px; padding:20px; border-radius:23px; background:radial-gradient(circle at 92% 8%,rgba(56,187,181,.07),transparent 11rem),rgba(255,255,255,.91); }
  .dop-nav span { color:#9d5c70; font-size:.58rem; font-weight:820; }
  .dop-nav strong { margin-top:auto; color:var(--color-text,#17151d); font-size:1.22rem; font-weight:780; line-height:1.08; letter-spacing:-.04em; }

  .dop-decision-section,.dop-content-section,.dop-price-section,.dop-process-section,.dop-related-section,.dop-faq-section { padding:58px 0; }
  .dop-soft-section,.dop-problem-section,.dop-old-section { padding:58px 0; }
  .dop-decision-card,.dop-price-grid article,.dop-process-grid article { border-radius:23px; box-shadow:0 16px 48px rgba(89,53,67,.045); }
  .dop-decision-card { min-height:250px; display:flex; flex-direction:column; }
  .dop-decision-card a { margin-top:auto; padding-top:16px; }
  .dop-price-grid article { min-height:230px; }
  .dop-price-featured { background:linear-gradient(145deg,rgba(219,246,243,.76),rgba(255,255,255,.94)); }
  .dop-process-grid article { min-height:205px; }
  .dop-problem-card,.dop-old-grid { border-radius:28px; background:rgba(255,255,255,.9); }
  .dop-faq-list details { border-radius:18px; background:rgba(255,255,255,.91); }

  .dop-final-card { max-width:1040px; padding:clamp(30px,5vw,58px); border-radius:34px; background:radial-gradient(circle at 85% 15%,rgba(56,187,181,.11),transparent 16rem),rgba(255,255,255,.94); text-align:center; }
  .dop-final-card>p:not(.section-kicker) { max-width:760px; margin:16px auto 0; }
  .dop-final-actions { max-width:900px; margin:24px auto 0; }
  .dop-final-secondary { display:flex; justify-content:center; flex-wrap:wrap; gap:7px; margin-top:12px; }
  .dop-final-secondary a { display:inline-flex; min-height:38px; align-items:center; padding:0 12px; border:1px solid rgba(56,187,181,.14); border-radius:999px; background:rgba(255,255,255,.62); color:#0f7773; font-size:.69rem; font-weight:800; text-decoration:none; }
  .dop-back-link { display:inline-flex; margin-top:18px; color:var(--color-muted,#6e6670); font-size:.7rem; font-weight:760; text-decoration:none; }

