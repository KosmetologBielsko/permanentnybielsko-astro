    .dop-nav-heading h2,.dop-heading h2,.dop-content-copy h2,.dop-soft-card h2,.dop-old-grid h2,.dop-problem-card h2,.dop-final-card h2{font-size:clamp(1.84rem,8.3vw,2.55rem);line-height:1.04;letter-spacing:-.057em}
    .dop-nav-heading>p{margin-top:9px;font-size:.7rem}
    .dop-nav{display:grid;grid-auto-flow:column;grid-auto-columns:min(78vw,300px);grid-template-columns:none;gap:8px;margin-inline:-16px;padding:2px 16px 9px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .dop-nav::-webkit-scrollbar{display:none}
    .dop-nav a{min-height:230px;padding:17px;border-radius:20px;scroll-snap-align:start}
    .dop-nav strong{font-size:1.27rem}
    .dop-decision-section,.dop-content-section,.dop-price-section,.dop-process-section,.dop-related-section,.dop-faq-section,.dop-soft-section,.dop-problem-section,.dop-old-section{padding:44px 0}
    .dop-three-grid,.dop-price-grid,.dop-process-grid{grid-template-columns:1fr}
    .dop-content-grid,.dop-content-grid-reverse,.dop-old-grid{grid-template-columns:1fr}
    .dop-decision-card,.dop-price-grid article,.dop-process-grid article{min-height:0;padding:18px;border-radius:20px}
    .dop-problem-card,.dop-old-grid{padding:18px;border-radius:22px}
    .dop-final-card{padding:24px 16px;border-radius:24px}
    .dop-final-secondary{display:grid;grid-template-columns:1fr 1fr}
    .dop-final-secondary a{justify-content:center;text-align:center}
  }
  @media(max-width:390px){.dop-nav{grid-auto-columns:81vw}.dop-final-secondary{grid-template-columns:1fr}}
</style>
'@

Set-Content -Path $articlePath -Value $article -Encoding UTF8
Write-Host "OK - utworzono nowy artykul: $articlePath" -ForegroundColor Green

# ------------------------------------------------------------
# 2. PORADNIK HUB — dodaj nowy wpis do articleCards automatycznie
# ------------------------------------------------------------
$hubPath = $null
if (Test-Path "src\pages\poradnik.astro") {
  $hubPath = "src\pages\poradnik.astro"
} elseif (Test-Path "src\pages\poradnik\index.astro") {
  $hubPath = "src\pages\poradnik\index.astro"
}

if ($hubPath) {
  $hub = Get-Content -Raw -Encoding UTF8 $hubPath

  if ($hub -notmatch '/poradnik/dopigmentowanie-brwi-permanentnych/') {
    $cardsMatch = [regex]::Match($hub, '(?s)const articleCards\s*=\s*\[(.*?)\];')

    if ($cardsMatch.Success) {
      $cardsBlock = $cardsMatch.Value
      $numberMatches = [regex]::Matches($cardsBlock, '"number"\s*:\s*"(\d+)"')
      $maxNumber = 0
      foreach ($m in $numberMatches) {
        $n = [int]$m.Groups[1].Value
        if ($n -gt $maxNumber) { $maxNumber = $n }
      }
      $nextNumber = ($maxNumber + 1).ToString("00")

      $newCard = @"
,
  {
    "slug": "dopigmentowanie-brwi-permanentnych",
    "title": "Dopigmentowanie brwi permanentnych — kiedy jest potrzebne i ile trwa?",
    "category": "Gojenie i dopigmentowanie",
    "description": "Dopigmentowanie brwi permanentnych: kiedy jest potrzebne, czy zawsze trzeba je robić, ile trwa, ile kosztuje i czym różni się od odświeżenia brwi.",
    "href": "/poradnik/dopigmentowanie-brwi-permanentnych/",
    "readingTime": "8–10 minut",
    "number": "$nextNumber",
    "groups": [
      "brwi",
      "gojenie",
      "korekta"
    ],
    "featured": false
  }
"@

      $newCardsBlock = $cardsBlock.Substring(0, $cardsBlock.LastIndexOf("];")) + $newCard + "`r`n];"
      $hub = $hub.Substring(0, $cardsMatch.Index) + $newCardsBlock + $hub.Substring($cardsMatch.Index + $cardsMatch.Length)
      Set-Content -Path $hubPath -Value $hub -Encoding UTF8
      Write-Host "OK - dodano wpis do Poradnika jako numer $nextNumber" -ForegroundColor Green
    } else {
      Write-Warning "Nie znaleziono tablicy articleCards w $hubPath. Artykul zostal utworzony, ale hub nie zostal zmieniony."
    }
  } else {
    Write-Host "INFO - wpis juz istnieje w Poradniku, pomijam." -ForegroundColor DarkGray
  }
} else {
  Write-Warning "Nie znaleziono $hubPath"
}

# ------------------------------------------------------------
# 3. SITEMAP — dodaj nowy URL bez usuwania obecnych wpisow
# ------------------------------------------------------------
$sitemapPath = "src\pages\sitemap.xml.ts"
if (Test-Path $sitemapPath) {
  $sitemap = Get-Content -Raw -Encoding UTF8 $sitemapPath
  $newUrl = '/poradnik/dopigmentowanie-brwi-permanentnych/'

  if (-not $sitemap.Contains($newUrl)) {
    $needle = '    path: "/sercemmalowane/",'
    $idx = $sitemap.IndexOf($needle)

    if ($idx -ge 0) {
      $start = $sitemap.LastIndexOf("  {", $idx)
      if ($start -lt 0) { throw "Nie znaleziono poczatku wpisu /sercemmalowane/ w sitemap." }

      $sitemapEntry = @'
  {
    path: "/poradnik/dopigmentowanie-brwi-permanentnych/",
    priority: "0.82",
    changefreq: "monthly"
  },
'@

      $sitemap = $sitemap.Substring(0, $start) + $sitemapEntry + "`r`n" + $sitemap.Substring($start)
      Set-Content -Path $sitemapPath -Value $sitemap -Encoding UTF8
      Write-Host "OK - dodano URL do sitemap.xml.ts" -ForegroundColor Green
    } else {
      Write-Warning "Nie znaleziono markera /sercemmalowane/ w sitemap."
    }
  } else {
    Write-Host "INFO - URL juz istnieje w sitemap, pomijam." -ForegroundColor DarkGray
  }
} else {
  Write-Warning "Nie znaleziono $sitemapPath"
}

# ------------------------------------------------------------
# 4. BRWI SERVICE — dodaj mocny internal link z glownej uslugi
# ------------------------------------------------------------
$browPath = "src\pages\makijaz-permanentny-brwi.astro"
if (Test-Path $browPath) {
  $brow = Get-Content -Raw -Encoding UTF8 $browPath

  if ($brow -notmatch '/poradnik/dopigmentowanie-brwi-permanentnych/') {
    $hrefMarker = 'href: "/poradnik/brwi-permanentne-po-latach/" },'
    $idxHref = $brow.IndexOf($hrefMarker)

    if ($idxHref -ge 0) {
      $lineEnd = $brow.IndexOf("`n", $idxHref)
      if ($lineEnd -lt 0) { $lineEnd = $brow.Length }
      $insert = '            { label: "Dopigmentowanie", title: "Kiedy jest potrzebne? ->", href: "/poradnik/dopigmentowanie-brwi-permanentnych/" },' + "`r`n"
      $brow = $brow.Insert($lineEnd + 1, $insert)
      Set-Content -Path $browPath -Value $brow -Encoding UTF8
      Write-Host "OK - dodano link Dopigmentowanie do sekcji szybkiej decyzji na stronie Brwi" -ForegroundColor Green
    } else {
      Write-Warning "Nie znaleziono linku Brwi po latach w stronie Brwi. Artykul i sitemap nadal zostana wdrozone."
    }
  } else {
    Write-Host "INFO - strona Brwi juz linkuje do dopigmentowania, pomijam." -ForegroundColor DarkGray
  }
} else {
  Write-Warning "Nie znaleziono $browPath"
}

# ------------------------------------------------------------
# 5. WALIDACJA PLIKU / PODSUMOWANIE
# ------------------------------------------------------------
$created = Get-Content -Raw -Encoding UTF8 $articlePath
$required = @(
  'canonicalPath="/poradnik/dopigmentowanie-brwi-permanentnych/"',
  'id="odpowiedz"',
  'id="kiedy"',
  'id="czy-konieczne"',
  'id="ile-trwa"',
  'id="cena"',
  'id="faq"',
  'class="final-form"',
  'class="final-phone"',
  'class="final-booksy"',
  '/poradnik/odswiezenie-makijazu-permanentnego-cena/',
  '/poradnik/brwi-permanentne-po-latach/',
  '/poradnik/laserowe-usuwanie-brwi-permanentnych/'
)

foreach ($item in $required) {
  if (-not $created.Contains($item)) {
    throw "Walidacja nieudana. Brakuje: $item"
  }
}

Write-Host "" 
Write-Host "GOTOWE." -ForegroundColor Green
Write-Host "Patch zrobil wszystko sam:" -ForegroundColor Cyan
Write-Host "- utworzyl osobny artykul dopigmentowanie brwi"
Write-Host "- dodal go do Poradnika"
Write-Host "- dodal URL do sitemap"
Write-Host "- dodal internal link z glownej strony Brwi"
Write-Host "- zachowal osobne intencje: dopigmentowanie / odswiezenie / stare PMU"
Write-Host "" 
Write-Host "Teraz uruchom: npm.cmd run build" -ForegroundColor Yellow