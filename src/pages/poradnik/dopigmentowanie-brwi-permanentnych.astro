---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/poradnik/dopigmentowanie-brwi-permanentnych/";

const pageTitle =
  "Dopigmentowanie brwi permanentnych — kiedy jest potrzebne i ile trwa?";

const pageDescription =
  "Dopigmentowanie brwi permanentnych: kiedy jest potrzebne, czy zawsze trzeba je robić, ile trwa, ile kosztuje i czym różni się od odświeżenia brwi.";

const faqItems = [
  {
    question: "Co to jest dopigmentowanie brwi permanentnych?",
    answer:
      "Dopigmentowanie to etap oceny i dopracowania efektu po wygojeniu pierwszej pigmentacji. Uzupełnia się tylko miejsca, w których kolor, nasycenie lub równomierność wymagają dodatkowej pracy."
  },
  {
    question: "Czy dopigmentowanie brwi jest zawsze konieczne?",
    answer:
      "Nie zawsze. Decyzję podejmuje się po wygojeniu skóry. Jeśli pigment przyjął się równomiernie, a kolor i kształt są zgodne z planem, zakres dodatkowej pracy może być minimalny albo może nie być potrzebny."
  },
  {
    question: "Kiedy robi się dopigmentowanie brwi?",
    answer:
      "Potrzebę dopigmentowania ocenia się po wygojeniu, a nie na świeżych brwiach. Termin zależy od stanu skóry i stabilizacji efektu. W gabinecie Bogusławy Herda dopigmentowanie po pierwszym zabiegu brwi jest bezpłatne do 2 miesięcy."
  },
  {
    question: "Ile trwa dopigmentowanie brwi?",
    answer:
      "Nie ma jednej stałej długości wizyty. Zwykle zakres jest mniejszy niż podczas pierwszej pigmentacji, ponieważ brwi nie są projektowane od początku. Czas zależy od techniki, skóry i liczby miejsc wymagających uzupełnienia."
  },
  {
    question: "Ile kosztuje dopigmentowanie brwi?",
    answer:
      "W gabinecie Bogusławy Herda dopigmentowanie będące częścią pierwszego procesu pigmentacji brwi jest bezpłatne do 2 miesięcy. Późniejszy powrót koloru po dłuższym czasie jest odświeżeniem i stanowi inną usługę."
  },
  {
    question: "Dopigmentowanie a odświeżenie brwi — jaka jest różnica?",
    answer:
      "Dopigmentowanie domyka pierwszy proces pigmentacji po wygojeniu. Odświeżenie wykonuje się po dłuższym czasie, gdy wcześniej wygojony makijaż permanentny stopniowo traci intensywność."
  },
  {
    question: "Czy podczas dopigmentowania można całkowicie zmienić kształt brwi?",
    answer:
      "Dopigmentowanie służy przede wszystkim dopracowaniu wcześniej zaplanowanego efektu. Większa zmiana kształtu, koloru albo praca na starym PMU wymaga osobnej oceny i może oznaczać inny plan postępowania."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: pageTitle,
    description: pageDescription,
    datePublished: "2026-08-27",
    dateModified: "2026-08-27",
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda"
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Dopigmentowanie brwi permanentnych",
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={`${pageTitle} | Poradnik PMU Bogusławy Herda`}
  description={pageDescription}
  canonicalPath="/poradnik/dopigmentowanie-brwi-permanentnych/"
  structuredData={structuredData}
>
  <div class="guide-page">
    <Header />

    <main>
      <!-- HERO — dokładnie ten sam język wizualny co poradnik Cena Ust -->
      <section class="guide-hero">
        <div class="container">
          <div class="guide-hero-card">
            <p class="guide-eyebrow">Poradnik PMU</p>

            <div class="guide-meta">
              <span>Brwi permanentne</span>
              <span>8–10 minut</span>
              <span>Aktualizacja: 27.08.2026</span>
            </div>

            <h1>Dopigmentowanie brwi permanentnych — kiedy jest potrzebne i ile trwa?</h1>

            <p class="guide-lead">
              Dopigmentowanie nie oznacza wykonywania brwi od początku. To etap oceny wygojonego efektu
              i precyzyjnego uzupełnienia miejsc, w których pigment rzeczywiście wymaga dopracowania.
            </p>

            <div class="guide-hero-actions">
              <a class="guide-btn-primary" href="#odpowiedz">Odpowiedź w 20 sekund ↓</a>
              <a class="guide-btn-secondary" href="/makijaz-permanentny-brwi/#efekty-brwi">Zobacz efekty brwi</a>
            </div>
          </div>

          <aside class="guide-answer" id="odpowiedz">
            <span class="guide-answer-label">Odpowiedź w 20 sekund</span>
            <strong class="guide-answer-value">0 zł*</strong>
            <h2>Dopigmentowanie domyka pierwszy proces po wygojeniu.</h2>
            <p>
              Służy wyrównaniu drobnych ubytków i nasycenia tam, gdzie skóra przyjęła pigment słabiej.
              <strong>Nie zawsze oznacza dużą poprawkę i nie zawsze jest potrzebne.</strong>
              W gabinecie Bogusławy Herda dopigmentowanie po pierwszym zabiegu brwi jest bezpłatne do 2 miesięcy.
            </p>
            <small>* Dotyczy dopigmentowania po pierwszym zabiegu wykonanym w gabinecie.</small>
          </aside>

          <nav class="guide-anchor-nav" aria-label="Najważniejsze informacje o dopigmentowaniu brwi">
            <a href="#kiedy">Kiedy jest potrzebne?</a>
            <a href="#czy-konieczne">Czy zawsze trzeba?</a>
            <a href="#ile-trwa">Ile trwa?</a>
            <a href="#cena">Cena</a>
            <a href="#roznice">Dopigmentowanie czy odświeżenie?</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="guide-section" id="roznice">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Najważniejsze rozróżnienie</p>
            <h2>Dopigmentowanie, odświeżenie i korekta starego PMU to trzy różne sytuacje.</h2>
            <p>
              Te pojęcia bywają używane zamiennie, ale opisują inny etap pracy. Rozdzielenie ich pomaga
              zrozumieć, czego naprawdę potrzebują brwi.
            </p>
          </div>

          <div class="guide-cards guide-cards-three">
            <article class="guide-card guide-card-accent">
              <span>Dopigmentowanie</span>
              <h3>Domknięcie pierwszego procesu</h3>
              <p>Ocena wygojenia i uzupełnienie tylko tego, co po pierwszej pigmentacji wymaga dopracowania.</p>
              <a href="#kiedy">Sprawdź, kiedy ma sens →</a>
            </article>

            <article class="guide-card">
              <span>Odświeżenie</span>
              <h3>Powrót koloru po czasie</h3>
              <p>Dotyczy wcześniej wygojonych brwi, które po miesiącach lub latach stopniowo straciły intensywność.</p>
              <a href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">Odświeżenie — cena i zasady →</a>
            </article>

            <article class="guide-card">
              <span>Stare PMU</span>
              <h3>Najpierw ocena pigmentu</h3>
              <p>Jeśli problemem jest kształt, kolor lub wysokie nasycenie starej pigmentacji, samo dopigmentowanie nie jest rozwiązaniem.</p>
              <a href="/poradnik/brwi-permanentne-po-latach/">Brwi permanentne po latach →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section guide-section-soft" id="kiedy">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Kiedy dopigmentować?</p>
            <h2>Decyzję podejmuje się po wygojeniu, nie na podstawie świeżych brwi.</h2>
            <p>
              Bezpośrednio po zabiegu kolor jest intensywniejszy, a później przechodzi przez kolejne etapy gojenia.
              Dopiero po uspokojeniu skóry można ocenić, co faktycznie wymaga dodatkowej pracy.
            </p>
          </div>

          <div class="guide-number-grid">
            <article>
              <span>01</span>
              <h3>Pojedyncze jaśniejsze miejsca</h3>
              <p>Po wygojeniu widać drobne obszary, w których pigment przyjął się słabiej.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Nierówne nasycenie</h3>
              <p>Jedna część brwi wygląda subtelniej i wymaga delikatnego wyrównania.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Detal techniki</h3>
              <p>Po ocenie skóry linergistka może dopracować element włosa, cieniowania albo przejścia koloru.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Efekt nadal jest zgodny z projektem</h3>
              <p>Dopigmentowanie powinno rozwijać zaakceptowany plan, a nie projektować zupełnie nowe brwi.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section" id="czy-konieczne">
        <div class="container">
          <div class="guide-split">
            <div class="guide-heading">
              <p class="guide-eyebrow">Czy zawsze jest konieczne?</p>
              <h2>Nie każda dobrze wygojona pigmentacja wymaga dokładania koloru.</h2>
            </div>

            <div class="guide-text-card">
              <p>
                Celem nie jest wykonanie drugiego pełnego zabiegu tylko dlatego, że istnieje możliwość dopigmentowania.
                Jeśli skóra przyjęła pigment równomiernie, kształt jest spójny, a intensywność zgodna z planem,
                zakres dodatkowej pracy może być bardzo mały.
              </p>
              <p>
                Ważniejsza od automatycznego przyciemniania brwi jest ocena, czy dodatkowy pigment rzeczywiście poprawi efekt.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-section guide-section-soft" id="ile-trwa">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Ile trwa?</p>
            <h2>Zwykle krócej niż pierwszy zabieg — ale nie ma jednej uczciwej liczby minut dla każdego.</h2>
            <p>
              Przy dopigmentowaniu nie projektujemy brwi od początku. Punkt wyjścia już istnieje, dlatego pracujemy
              tylko w miejscach, które po wygojeniu wymagają uzupełnienia.
            </p>
          </div>

          <div class="guide-feature-row">
            <div class="guide-feature-value">
              <span>Czas wizyty</span>
              <strong>indywidualnie</strong>
            </div>
            <p>
              Zakres zależy od techniki, liczby miejsc do uzupełnienia, reakcji skóry i tego, jak wygoił się pierwszy zabieg.
              Dlatego nie obiecujemy jednej sztucznej długości wizyty.
            </p>
          </div>
        </div>
      </section>

      <section class="guide-section" id="cena">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Cena dopigmentowania</p>
            <h2>W pierwszym procesie brwi — 0 zł do 2 miesięcy.</h2>
            <p>
              Późniejszy powrót koloru po dłuższym czasie jest już inną usługą — odświeżeniem.
              To ważne rozróżnienie przy czytaniu cennika.
            </p>
          </div>

          <div class="guide-cards guide-price-cards">
            <article class="guide-card">
              <span>Pierwsza pigmentacja</span>
              <strong class="guide-price">1200–1400 zł</strong>
              <p>Cena zależy od metody brwi permanentnych.</p>
              <a href="/cennik-makijaz-permanentny/#price-group-1">Aktualny cennik brwi →</a>
            </article>

            <article class="guide-card guide-card-accent">
              <span>Dopigmentowanie</span>
              <strong class="guide-price">0 zł*</strong>
              <p>Bez opłaty do 2 miesięcy po pierwszym zabiegu wykonanym w gabinecie.</p>
              <a href="/makijaz-permanentny-brwi/#efekty-brwi">Zobacz efekty brwi →</a>
            </article>

            <article class="guide-card">
              <span>Odświeżenie po czasie</span>
              <strong class="guide-price guide-price-text">osobna usługa</strong>
              <p>Dotyczy wcześniej wygojonych brwi, które z czasem zbledły.</p>
              <a href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">Sprawdź odświeżenie →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-bridge">
        <div class="container">
          <div class="guide-bridge-card">
            <div>
              <p class="guide-eyebrow">Główna strona usługi</p>
              <h2>Chcesz zobaczyć realne efekty i metody brwi?</h2>
            </div>
            <div class="guide-bridge-actions">
              <a href="/makijaz-permanentny-brwi/#efekty-brwi">Efekty brwi →</a>
              <a href="/makijaz-permanentny-brwi/#metody-brwi">Metody brwi →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-section guide-section-soft" id="proces">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Jak wygląda dopigmentowanie?</p>
            <h2>Najpierw ocena. Potem tylko tyle pigmentu, ile naprawdę potrzeba.</h2>
          </div>

          <div class="guide-number-grid">
            <article>
              <span>01</span>
              <h3>Ocena wygojenia</h3>
              <p>Sprawdzamy skórę, kolor, nasycenie i równomierność efektu.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Porównanie z planem</h3>
              <p>Oceniamy, czy kształt i intensywność odpowiadają efektowi ustalonemu przed pierwszym zabiegiem.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Precyzyjne uzupełnienie</h3>
              <p>Pigmentowane są tylko miejsca, które faktycznie wymagają dodatkowej pracy.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Ponowne gojenie</h3>
              <p>Skóra znów się regeneruje, dlatego rezultat ocenia się po jej uspokojeniu.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section">
        <div class="container">
          <div class="guide-split">
            <div class="guide-heading">
              <p class="guide-eyebrow">Pigment miejscami zniknął?</p>
              <h2>Nierówny efekt po gojeniu nie zawsze oznacza źle wykonane brwi.</h2>
            </div>

            <div class="guide-text-card guide-text-card-link">
              <p>
                Skóra jest żywą tkanką i nie w każdym miejscu musi przyjąć pigment identycznie.
                Znaczenie mają m.in. typ skóry, ilość sebum, sposób gojenia i indywidualna reakcja.
              </p>
              <a href="/poradnik/dlaczego-pigment-po-wygojeniu-miejscami-znika/">
                Dlaczego pigment po wygojeniu miejscami „znika”? →
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-section guide-section-soft" id="stare-pmu">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Wcześniejsza pigmentacja</p>
            <h2>Stare brwi permanentne nie są zwykłym dopigmentowaniem.</h2>
            <p>
              Jeśli brwi są zbyt ciemne, zmieniły kolor, mają niekorzystny kształt albo wiele warstw pigmentu,
              najpierw potrzebna jest kwalifikacja. Czasem właściwą decyzją jest korekta, a czasem wcześniejsze rozjaśnienie.
            </p>
          </div>

          <div class="guide-cards guide-cards-two">
            <article class="guide-card">
              <span>Stary pigment</span>
              <h3>Brwi permanentne po latach</h3>
              <p>Jak ocenić kolor, kształt i nasycenie starego PMU przed kolejną decyzją.</p>
              <a href="/poradnik/brwi-permanentne-po-latach/">Przeczytaj poradnik →</a>
            </article>
            <article class="guide-card">
              <span>Rozjaśnianie</span>
              <h3>Laserowe usuwanie brwi</h3>
              <p>Kiedy stary pigment warto najpierw rozjaśnić zamiast dokładać kolejną warstwę.</p>
              <a href="/poradnik/laserowe-usuwanie-brwi-permanentnych/">Zobacz możliwości →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section">
        <div class="container">
          <div class="guide-expert">
            <div>
              <p class="guide-eyebrow">Ekspert PMU</p>
              <h2>Dopigmentowanie ma dopracować efekt — nie automatycznie go przyciemnić.</h2>
              <p>
                Bogusława Herda jest kosmetologiem i linergistką z ponad 10-letnim doświadczeniem,
                8-krotną mistrzynią PMU, wicemistrzynią świata oraz europejskim trenerem Long-Time-Liner®.
                W praktyce PMU najważniejsza jest ocena wygojonej skóry i świadoma decyzja, gdzie kolejna praca rzeczywiście poprawi efekt.
              </p>
            </div>
            <aside>
              <span>Bogusława Herda</span>
              <strong>8× mistrzyni PMU</strong>
              <strong>Wicemistrzyni świata</strong>
              <strong>Europejski trener Long-Time-Liner®</strong>
              <a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie →</a>
            </aside>
          </div>
        </div>
      </section>

      <section class="guide-section guide-section-soft" id="powiazane">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Powiązane odpowiedzi</p>
            <h2>Jeśli jesteś po zabiegu, te poradniki będą najbardziej przydatne.</h2>
          </div>

          <div class="guide-related">
            <a href="/poradnik/jak-goja-sie-brwi-permanentne/">
              <span>Gojenie</span><strong>Jak goją się brwi permanentne? →</strong>
            </a>
            <a href="/poradnik/brwi-permanentne-dzien-po-dniu/">
              <span>Dzień po dniu</span><strong>Jak zmieniają się brwi po zabiegu? →</strong>
            </a>
            <a href="/poradnik/odswiezenie-makijazu-permanentnego-cena/">
              <span>Odświeżenie</span><strong>Kiedy to już nie dopigmentowanie? →</strong>
            </a>
            <a href="/cennik-makijaz-permanentny/#price-group-1">
              <span>Cennik</span><strong>Aktualne ceny brwi →</strong>
            </a>
          </div>
        </div>
      </section>

      <section class="guide-section" id="faq">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">FAQ</p>
            <h2>Najczęstsze pytania o dopigmentowanie brwi.</h2>
          </div>

          <div class="guide-faq">
            {faqItems.map((item) => (
              <details>
                <summary>
                  {item.question}
                  <span aria-hidden="true">+</span>
                </summary>
                <div>
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-section guide-sources">
        <div class="container">
          <div class="guide-heading">
            <p class="guide-eyebrow">Źródła i aktualność</p>
            <h2>Cena i zasady odnoszą się do aktualnej oferty gabinetu.</h2>
            <p>
              Informacja o bezpłatnym dopigmentowaniu do 2 miesięcy dotyczy pierwszego procesu pigmentacji brwi
              wykonywanego w gabinecie Bogusławy Herda. Szczegóły cen nowych zabiegów znajdują się w aktualnym cenniku.
            </p>
          </div>
          <div class="guide-source-links">
            <a href="/cennik-makijaz-permanentny/#price-group-1">Aktualny cennik PMU →</a>
            <a href="/makijaz-permanentny-brwi/#metody-brwi">Metody brwi →</a>
            <a href="/poradnik/jak-goja-sie-brwi-permanentne/">Gojenie brwi →</a>
          </div>
