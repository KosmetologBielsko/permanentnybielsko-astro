---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-przed-wakacjami",
  title: "Makijaż permanentny przed wakacjami — ile wcześniej zrobić zabieg?",
  eyebrow: "Poradnik PMU",
  category: "Planowanie zabiegu",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "7–9 minut",
  description:
    "Makijaż permanentny przed wakacjami: ile czasu zostawić przed wyjazdem, słońcem, basenem i morzem? Praktyczny plan dla brwi, ust i kresek.",
  lead:
    "Jeśli urlop ma oznaczać słońce, basen, morze, saunę albo intensywną aktywność, nie planuj makijażu permanentnego na ostatnią chwilę. Świeżo pigmentowana skóra potrzebuje czasu na regenerację, a w pierwszych tygodniach trzeba ograniczyć część typowo wakacyjnych aktywności.",
  shortAnswer:
    "Najrozsądniej zostawić wyraźny zapas przed wyjazdem. Przy urlopie nastawionym na plażę, basen i słońce tydzień przed wylotem to zwykle zbyt mało. W praktyce warto myśleć o minimum kilku tygodniach zapasu, a przy intensywnym urlopie — jeszcze większym. Dokładny termin zależy od obszaru PMU, skóry, sposobu gojenia i zaleceń po zabiegu.",
  canonicalPath: "/poradnik/makijaz-permanentny-przed-wakacjami/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const timeline = [
  {
    range: "0–7 dni",
    status: "Nie polecam",
    tone: "danger",
    title: "Za mało czasu na plażowy urlop",
    text: "To okres świeżego gojenia. Jeśli wyjazd oznacza kąpiele, mocne słońce, częste pocenie albo saunę, zabieg tuż przed urlopem komplikuje pielęgnację.",
  },
  {
    range: "8–14 dni",
    status: "Nadal ciasno",
    tone: "warning",
    title: "Skóra może być jeszcze w procesie gojenia",
    text: "Łuszczenie i stabilizacja efektu nie zawsze kończą się identycznie u każdej osoby. Dwa tygodnie nie dają dużego marginesu na indywidualną reakcję skóry.",
  },
  {
    range: "3–4 tygodnie",
    status: "Rozsądny zapas",
    tone: "good",
    title: "Lepszy punkt wyjścia do planowania",
    text: "To praktyczny przedział, który daje znacznie więcej czasu na uspokojenie skóry. Nadal trzeba uwzględnić indywidualne gojenie i zalecenia dotyczące konkretnego obszaru.",
  },
  {
    range: "6+ tygodni",
    status: "Największy komfort",
    tone: "best",
    title: "Więcej marginesu przed intensywnym wyjazdem",
    text: "Dłuższy odstęp daje większy spokój, szczególnie gdy urlop ma być mocno plażowy, aktywny albo planujesz wiele dni w wodzie i słońcu.",
  },
];

const vacationFactors = [
  {
    title: "Słońce i UV",
    text: "Świeżo pigmentowana skóra jest w trakcie regeneracji. Ekspozycja na UV nie jest dobrym momentem na testowanie świeżego PMU, a w dalszej perspektywie UV może przyspieszać blaknięcie pigmentu.",
  },
  {
    title: "Basen, jacuzzi i długie moczenie",
    text: "Do czasu wygojenia należy unikać zanurzania świeżo tatuowanej skóry w basenach, wannach i jacuzzi. To jedna z głównych przyczyn, dla których zabieg tuż przed urlopem jest niewygodny.",
  },
  {
    title: "Morze i plaża",
    text: "Słona woda, piasek, wiatr, wysoka temperatura i intensywne słońce tworzą środowisko, którego trudno uniknąć podczas typowego urlopu nad morzem.",
  },
  {
    title: "Sport i pot",
    text: "Intensywny trening, wysoka temperatura i częste pocenie mogą utrudniać spokojną pielęgnację świeżo pigmentowanej okolicy. W pierwszym etapie warto planować aktywność rozsądniej.",
  },
];

const areaNotes = [
  {
    number: "01",
    title: "Brwi",
    href: "/makijaz-permanentny-brwi/",
    text: "Brwi mogą przechodzić etap mocniejszego koloru, przesuszenia i złuszczania. Wakacje tuż po zabiegu oznaczają pilnowanie skóry zamiast swobodnego korzystania z plaży czy basenu.",
  },
  {
    number: "02",
    title: "Usta",
    href: "/makijaz-permanentny-ust/",
    text: "Usta są szczególnie narażone na słońce, wysuszenie i kontakt z wodą. Jeśli masz skłonność do opryszczki, kwalifikacja przed zabiegiem jest dodatkowo ważna.",
  },
  {
    number: "03",
    title: "Kreski",
    href: "/makijaz-permanentny-oczu/",
    text: "Okolica oka wymaga spokojnego gojenia. Jeśli wakacje mają oznaczać basen, morze, intensywny makijaż lub dużo aktywności, lepiej nie zostawiać zabiegu na ostatnie dni.",
  },
];

const practicalPlan = [
  ["Najpierw data wyjazdu", "Sprawdź, czy urlop będzie oznaczał basen, morze, saunę, intensywne słońce albo treningi."],
  ["Potem obszar PMU", "Brwi, usta i kreski mają różną lokalizację i różne codzienne obciążenia."],
  ["Zostaw margines", "Nie zakładaj, że skóra wygoi się książkowo co do dnia. Zapas jest ważniejszy niż zdążenie przed wyjazdem."],
  ["Dopiero potem rezerwacja", "Jeżeli termin jest zbyt blisko wyjazdu, lepiej przełożyć PMU niż budować cały urlop wokół ograniczeń."],
];

const sourceItems = [
  {
    label: "American Academy of Dermatology",
    title: "Caring for tattooed skin",
    href: "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin",
    text: "AAD wskazuje m.in. na ochronę pigmentowanej skóry przed UV oraz znaczenie właściwej pielęgnacji.",
  },
  {
    label: "Cleveland Clinic",
    title: "Tattoo Aftercare Tips From a Dermatologist",
    href: "https://health.clevelandclinic.org/tattoo-aftercare",
    text: "Materiał dermatologiczny opisuje etapy gojenia oraz zaleca unikanie słońca i zanurzania świeżego tatuażu w wodzie do czasu wygojenia.",
  },
  {
    label: "U.S. Food & Drug Administration",
    title: "Think Before You Ink: Tattoo Safety",
    href: "https://www.fda.gov/consumers/consumer-updates/think-you-ink-tattoo-safety",
    text: "FDA traktuje permanent makeup jako formę tatuażu i opisuje ryzyka związane m.in. z infekcjami i reakcjami skórnymi.",
  },
];

const relatedLinks = [
  {
    href: "/poradnik/czego-nie-wolno-po-makijazu-permanentnym-brwi/",
    title: "Czego nie wolno po makijażu permanentnym brwi?",
    text: "Gdy interesują Cię konkretne ograniczenia po pigmentacji brwi.",
  },
  {
    href: "/poradnik/jak-goja-sie-brwi-permanentne/",
    title: "Jak goją się brwi permanentne?",
    text: "Jeśli chcesz zobaczyć przebieg gojenia brwi krok po kroku.",
  },
  {
    href: "/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/",
    title: "Makijaż permanentny ust — gojenie dzień po dniu",
    text: "Osobny poradnik o tym, jak zachowują się usta po zabiegu.",
  },
  {
    href: "/poradnik/kreska-permanentna-gojenie-pielegnacja/",
    title: "Kreska permanentna — gojenie i pielęgnacja",
    text: "Szczegóły dotyczące okolicy oka po pigmentacji.",
  },
];

const faqItems = [
  {
    question: "Czy można zrobić makijaż permanentny tydzień przed wakacjami?",
    answer: "Jeśli wakacje oznaczają słońce, morze, basen, jacuzzi lub intensywną aktywność, tydzień to zwykle bardzo mały zapas. Lepiej zostawić skórze więcej czasu na spokojną regenerację.",
  },
  {
    question: "Ile wcześniej zrobić brwi permanentne przed urlopem?",
    answer: "Nie ma jednej liczby odpowiedniej dla każdej skóry. Przy plażowym urlopie rozsądniej myśleć o kilku tygodniach zapasu niż o kilku dniach. Dokładny termin warto ustalić po uwzględnieniu sposobu spędzania urlopu i indywidualnego gojenia.",
  },
  {
    question: "Czy po PMU można wejść do basenu?",
    answer: "Świeżo pigmentowanej skóry nie powinno się zanurzać w basenie, jacuzzi ani wannie do czasu wygojenia. Konkretne zalecenia po zabiegu powinny pochodzić od osoby wykonującej PMU.",
  },
  {
    question: "Czy słońce może wpływać na makijaż permanentny?",
    answer: "Tak. Dermatolodzy zalecają ochronę tatuowanej skóry przed UV, ponieważ promieniowanie może wpływać na wygląd i blaknięcie pigmentu. Świeżo gojąca się skóra wymaga szczególnej ostrożności.",
  },
  {
    question: "Lepiej zrobić PMU przed czy po wakacjach?",
    answer: "Jeśli wyjazd jest bardzo blisko i ma być intensywnie plażowy lub basenowy, często wygodniej wykonać zabieg po powrocie. Jeśli masz kilka tygodni zapasu, termin można ocenić indywidualnie.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: sourceItems.map((source) => source.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Layout
  title={`${article.title} | Bogusława Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>
            <div class="expert-article-meta">
              <span>36</span>
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
            </div>
            <h1>{article.title}</h1>
            <p class="expert-article-lead">{article.lead}</p>
          </div>

          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Nie planuj PMU na ostatnią chwilę przed urlopem.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section">
        <div class="container">
          <nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#kalendarz">Ile wcześniej?</a>
            <a href="#dlaczego">Dlaczego?</a>
            <a href="#obszary">Brwi / Usta / Kreski</a>
            <a href="#plan">Jak zaplanować?</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="expert-article-section" id="kalendarz">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Najbardziej praktyczna odpowiedź</p>
            <h2>Wyjazd za 3, 7, 14 czy 30 dni? Tak wygląda sensowny margines.</h2>
            <p>
              To nie jest medyczna tabela gwarancji gojenia. To praktyczny sposób
              planowania zabiegu wokół typowego wakacyjnego trybu: słońca, wody,
              wysokiej temperatury i aktywności.
            </p>
          </div>

          <div class="expert-timeline">
            {timeline.map((item) => (
              <article class:list={["expert-timeline-card", `is-${item.tone}`]}>
                <div class="expert-timeline-top">
                  <strong>{item.range}</strong>
                  <span>{item.status}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>

          <div class="expert-article-note">
            <strong>Najważniejsze:</strong>
            <p>
              Im bardziej plażowy ma być urlop, tym większy sens ma zostawienie
              dodatkowego zapasu. Spokojny city break to inna sytuacja niż tydzień
              nad morzem z codziennym basenem.
            </p>
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-soft" id="dlaczego">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Dlaczego termin ma znaczenie?</p>
            <h2>Problemem nie jest sam wyjazd. Problemem jest to, co robimy na wakacjach.</h2>
            <p>
              PMU jest formą pigmentacji skóry. Po zabiegu skóra przechodzi proces
              gojenia, dlatego część aktywności typowych dla urlopu jest niepraktyczna
              w pierwszym okresie.
            </p>
          </div>

          <div class="expert-factor-grid">
            {vacationFactors.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>

          <div class="expert-source-inline">
            <span>Co mówią źródła?</span>
            <p>
              American Academy of Dermatology zaleca ochronę tatuowanej skóry przed UV,
              a Cleveland Clinic wskazuje, aby do czasu pełnego wygojenia unikać
              zanurzania świeżego tatuażu w basenie, wannie czy jacuzzi. FDA klasyfikuje
              permanent makeup jako formę tatuażu i opisuje możliwe reakcje oraz infekcje.
            </p>
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="obszary">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Brwi · Usta · Kreski</p>
            <h2>Ten sam urlop może oznaczać inny problem dla każdego obszaru PMU.</h2>
          </div>

          <div class="expert-area-grid">
            {areaNotes.map((item) => (
              <a href={item.href}>
                <span>{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <strong>Zobacz usługę →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="expert-article-section expert-article-plan-section" id="plan">
        <div class="container expert-plan-panel">
          <div class="expert-plan-copy">
            <p class="section-kicker section-kicker-light">Plan bez nerwów</p>
            <h2>Najpierw urlop. Potem termin PMU.</h2>
            <p>
              Zamiast pytać tylko „czy zdążę?”, przejdź przez cztery proste kroki.
              Dzięki temu zabieg nie staje się ograniczeniem całego wyjazdu.
            </p>
          </div>

          <div class="expert-plan-steps">
            {practicalPlan.map((item, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item[0]}</strong>
                <p>{item[1]}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-author-note">
          <div>
            <p class="section-kicker">Praktyka gabinetowa</p>
            <h2>Jak podchodzę do tego w gabinecie?</h2>
            <p>
              Przed wakacyjnym terminem nie patrzę wyłącznie na liczbę dni do wyjazdu.
              Pytam również o kierunek podróży, ekspozycję na słońce, basen lub morze,
              aktywność i obszar zabiegowy. Jeśli klientka ma za mało czasu na spokojne
              gojenie, wolę zaproponować późniejszy termin niż utrudniać jej urlop.
            </p>
          </div>

          <aside>
            <span>Bogusława Herda</span>
            <strong>Trenerka Long-Time-Liner®</strong>
            <strong>Autorka Silky Hairstroke Brows</strong>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">
              Przejdź do kwalifikacji PMU →
            </a>
          </aside>
        </div>
      </section>

      <section class="expert-article-section expert-article-related-section">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Nie powtarzamy — kierujemy dalej</p>
            <h2>Potrzebujesz szczegółów o gojeniu? Są już w osobnych poradnikach.</h2>
            <p>
              Ten artykuł odpowiada wyłącznie na pytanie o planowanie PMU przed urlopem.
              Mycie, pielęgnację i gojenie konkretnych obszarów rozwijamy w osobnych tekstach.
            </p>
          </div>

          <div class="expert-related-grid">
            {relatedLinks.map((item) => (
              <a href={item.href}>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <span>Czytaj dalej →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="expert-article-section" id="zrodla">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">Źródła</p>
            <h2>Na czym opieramy część medyczno-pielęgnacyjną?</h2>
            <p>
              Praktyczne rekomendacje gabinetowe oddzielamy od informacji pochodzących
              ze źródeł dermatologicznych i instytucjonalnych.
            </p>
          </div>

          <div class="expert-source-grid">
            {sourceItems.map((source) => (
              <a href={source.href} target="_blank" rel="noopener noreferrer">
                <span>{source.label}</span>
                <h3>{source.title}</h3>
                <p>{source.text}</p>
                <strong>Otwórz źródło ↗</strong>
              </a>
            ))}
          </div>

          <p class="expert-medical-note">
            Treść poradnika ma charakter informacyjny i nie zastępuje indywidualnej
            konsultacji medycznej. Jeżeli po zabiegu pojawiają się objawy sugerujące
            nieprawidłowe gojenie, nasilający się ból, ropienie, gorączka lub silna
            reakcja skórna, skontaktuj się z lekarzem.
          </p>
        </div>
      </section>

      <section class="expert-article-section expert-article-faq-section" id="faq">
        <div class="container">
          <div class="expert-article-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Makijaż permanentny przed wakacjami — najczęstsze pytania.</h2>
          </div>

          <div class="expert-faq-list">
            {faqItems.map((item) => (
              <details>
                <summary>
                  <span>{item.question}</span>
                  <span class="expert-faq-icon" aria-hidden="true"></span>
                </summary>
                <div><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="expert-article-section">
        <div class="container expert-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Masz już datę wyjazdu? Dobierzmy do niej rozsądny termin PMU.</h2>
          <p>
            Jeśli termin jest bezpiecznie oddalony — sprawdź Booksy. Jeśli wyjazd jest
            blisko albo nie wiesz, czy wybrać brwi, usta czy kreski, zacznij od kwalifikacji.
          </p>

          <div class="expert-final-actions">
            <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy →</a>
            <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU →</a>
            <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
          </div>

          <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

