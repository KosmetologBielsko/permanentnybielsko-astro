---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "jak-wybrac-gabinet-makijazu-permanentnego-bielsko-biala",
  title: "Jak wybrać gabinet makijażu permanentnego w Bielsku-Białej?",
  eyebrow: "Poradnik PMU",
  category: "Makijaż permanentny Bielsko-Biała",
  datePublished: "2026-07-05",
  dateModified: "2026-08-20",
  readingTime: "9–12 minut",
  description: "Jak wybrać gabinet makijażu permanentnego w Bielsku-Białej? Sprawdź, na co zwrócić uwagę: doświadczenie, zdjęcia wygojonych prac, rysunek wstępny, cena, opinie i bezpieczeństwo PMU.",
  lead: "Wybór gabinetu makijażu permanentnego w Bielsku-Białej nie powinien opierać się tylko na cenie, wolnym terminie albo jednym zdjęciu z Instagrama. To decyzja dotycząca twarzy, skóry i efektu, który zostaje na długo, dlatego najważniejsze są doświadczenie, kwalifikacja, rysunek wstępny i naturalna estetyka pracy.",
  shortAnswer: "Dobry gabinet PMU w Bielsku-Białej warto oceniać przez cały proces: konsultację, analizę skóry, rysunek wstępny, dobór techniki, zdjęcia wygojonych efektów, jasne zasady korekty i spokojne omówienie przeciwwskazań. Cena i opinie są ważne, ale nie powinny być jedynym kryterium wyboru.",
  canonicalPath: "/poradnik/jak-wybrac-gabinet-makijazu-permanentnego-bielsko-biala/",
  mainService: {
    href: "/makijaz-permanentny-bielsko/",
    title: "Makijaż permanentny Bielsko-Biała",
  },
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
      "https://www.aad.org/public/everyday-care/skin-care-basics/tattoos/caring-for-tattooed-skin"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Jak wybrać gabinet makijażu permanentnego w Bielsku-Białej?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Warto sprawdzić doświadczenie linergistki, styl prac, zdjęcia wygojonych efektów, sposób prowadzenia konsultacji, zasady korekty, informację o przeciwwskazaniach i pielęgnacji po zabiegu.",
        },
      },
      {
        "@type": "Question",
        name: "Czy cena jest najważniejsza przy wyborze PMU?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. Cena jest ważna, ale przy makijażu permanentnym liczą się również bezpieczeństwo, rysunek wstępny, kwalifikacja skóry, naturalny efekt i przewidywalne gojenie.",
        },
      },
      {
        "@type": "Question",
        name: "Czy warto pytać o zdjęcia po wygojeniu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Efekt bezpośrednio po zabiegu może być ciemniejszy i bardziej wyraźny. Wygojone zdjęcia lepiej pokazują finalną estetykę pracy.",
        },
      },
      {
        "@type": "Question",
        name: "Co zrobić, jeśli mam stary makijaż permanentny?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Najpierw warto umówić konsultację. Stary, zbyt ciemny albo nierówny pigment nie zawsze można bezpiecznie przykryć nową pigmentacją.",
        },
      },
      {
        "@type": "Question",
        name: "Czy gabinet może odmówić wykonania zabiegu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Tak. Przy przeciwwskazaniach, aktywnych zmianach skóry, świeżych zabiegach albo niekorzystnym starym pigmencie odmowa lub przełożenie zabiegu może być bezpieczną decyzją.",
        },
      }
    ],
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="expert-article-page">
    <Header />

    <main>
      <section class="expert-article-hero">
