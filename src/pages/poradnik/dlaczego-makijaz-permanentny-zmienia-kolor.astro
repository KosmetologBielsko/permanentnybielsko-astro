---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "dlaczego-makijaz-permanentny-zmienia-kolor",
  title: "Dlaczego makijaż permanentny zmienia kolor z czasem?",
  category: "Kolor i pigment",
  datePublished: "2026-08-20",
  dateModified: "2026-08-27",
  readingTime: "8–10 minut",
  description: "Dlaczego makijaż permanentny zmienia kolor? Wyjaśniamy wpływ pigmentu, skóry, UV, techniki i starego PMU na chłodnienie, ocieplenie i blaknięcie efektu.",
  lead: "Stare PMU nie zawsze po prostu „robi się jaśniejsze”. Czasem zaczyna wyglądać chłodniej, cieplej, bardziej szaro albo bardziej czerwono. To dlatego, że widziany kolor jest wynikiem pigmentu, skóry, głębokości, nasycenia oraz zmian zachodzących przez lata.",
  shortAnswer: "Różne składniki pigmentu nie muszą zmieniać się wizualnie w identycznym tempie, a skóra nad pigmentacją także się zmienia. UV, ilość pigmentu, technika, typ skóry i kolejne dopigmentowania mogą wpływać na końcowy odbiór barwy. Dlatego przed odświeżeniem najpierw ocenia się kolor, który realnie pozostał w skórze.",
  canonicalPath: "/poradnik/dlaczego-makijaz-permanentny-zmienia-kolor/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/37263219/",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet"
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Dlaczego stare brwi permanentne robią się szare?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Może na to wpływać skład pigmentu, ilość barwnika, sposób pracy, skóra i zmiany wizualne w czasie. Nie da się wiarygodnie wskazać jednej przyczyny bez obejrzenia pigmentacji.",
        },
      },
      {
        "@type": "Question",
        name: "Czy czerwone brwi można przykryć nowym pigmentem?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Czasem korekta kolorystyczna jest możliwa, ale przy dużym nasyceniu dokładanie kolejnych warstw może nie być dobrym rozwiązaniem.",
        },
      },
      {
        "@type": "Question",
        name: "Czy UV zmienia kolor PMU?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "UV wpływa na skórę i może przyspieszać starzenie oraz wizualne zmiany pigmentacji.",
        },
      },
      {
        "@type": "Question",
        name: "Czy każdy pigment PMU z czasem robi się czerwony?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nie. Kierunek starzenia się koloru zależy od wielu czynników i nie można go sprowadzić do jednej reguły.",
        },
      },
      {
        "@type": "Question",
        name: "Kiedy lepiej usuwać niż neutralizować?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Gdy pigment jest mocno nasycony, ma niekorzystny kształt lub kolor, a skóra nie daje dobrych warunków na kolejną warstwę.",
        },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Poradnik PMU Bogusławy Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="price-guide-page">
    <Header />
    <main>
      <section class="price-hero">
        <div class="price-glow price-glow-one" aria-hidden="true"></div>
        <div class="price-glow price-glow-two" aria-hidden="true"></div>
        <div class="container price-hero-grid">
          <div class="price-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="price-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
              <span>Aktualizacja: 27.08.2026</span>
            </div>
            <h1>{article.title}</h1>
            <p class="price-lead">{article.lead}</p>

            <div class="price-hero-actions">
              <a class="price-primary" href="#kolor">Sprawdź, co wpływa na kolor <span aria-hidden="true">→</span></a>
              <a class="price-secondary" href="/poradnik/brwi-permanentne-po-latach/">Brwi po latach</a>
            </div>
          </div>
          <aside class="price-answer" aria-label="Odpowiedź w skrócie">
            <p class="price-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Kolor PMU to pigment + skóra + czas.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="price-nav-section"><div class="container"><nav class="price-nav" aria-label="Spis treści artykułu">
            <a href="#kolor">Skąd bierze się kolor?</a>
            <a href="#zmiany">Dlaczego się zmienia?</a>
            <a href="#obszary">Brwi / Usta / Usuwanie</a>
            <a href="#co-robic">Co robić ze starym PMU?</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="price-section" id="kolor"><div class="container">
        <div class="price-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Cztery elementy, które wpływają na odbiór starego koloru.</h2><p>Nie każdy chłodny lub ciepły odcień oznacza błąd pigmentu. Czasem problemem jest suma kilku czynników.</p></div>
        <div class="scenario-scroll">
            <article class="scenario-card">
              <div class="scenario-top">
                <strong>Pigment</strong>
                <span>Skład i proporcje barwników</span>
              </div>
              <h3>Skład i proporcje barwników</h3>
              <p>PMU jest zwykle mieszaniną pigmentów. Zmiana wizualnej dominacji części składowych może zmienić odbiór całego koloru.</p>
            </article>
            <article class="scenario-card">
              <div class="scenario-top">
                <strong>Skóra</strong>
                <span>Naturalny filtr optyczny</span>
              </div>
              <h3>Naturalny filtr optyczny</h3>
              <p>Pigment oglądamy przez skórę, dlatego jej koloryt, grubość i zmiany z wiekiem wpływają na to, co widzi oko.</p>
            </article>
            <article class="scenario-card">
              <div class="scenario-top">
                <strong>UV</strong>
                <span>Fotostarzenie i ekspozycja</span>
              </div>
              <h3>Fotostarzenie i ekspozycja</h3>
              <p>Promieniowanie wpływa na skórę i może przyspieszać zmiany wizualne pigmentacji.</p>
            </article>
            <article class="scenario-card">
              <div class="scenario-top">
                <strong>Warstwy</strong>
                <span>Kolejne odświeżenia</span>
              </div>
              <h3>Kolejne odświeżenia</h3>
              <p>Dokładanie kolejnych warstw bez oceny starego pigmentu może zwiększać nasycenie i utrudniać przyszłą korektę.</p>
            </article>
        </div>
      </div></section>

      <section class="price-section price-soft" id="zmiany"><div class="container">
        <div class="price-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Dlaczego stara brew bywa szara, czerwonawa albo pomarańczowa?</h2></div>
        <div class="included-grid">
            <article><h3>Zmiana proporcji widocznych barw</h3><p>Gdy część składników jest wizualnie mniej dominująca niż wcześniej, kolor może zacząć wyglądać inaczej niż świeżo po wygojeniu.</p></article>
            <article><h3>Zbyt duże nasycenie</h3><p>Duża ilość pigmentu może sprawić, że stara praca wygląda ciężko nawet wtedy, gdy ogólny kolor zblednie.</p></article>
            <article><h3>Tło skóry</h3><p>Kolor skóry oraz naczynia krwionośne wpływają na to, jak postrzegamy barwnik znajdujący się w skórze.</p></article>
            <article><h3>Nie każdą zmianę naprawia neutralizator</h3><p>Jeżeli w skórze jest dużo niekorzystnego pigmentu, dokładanie kolejnego koloru może tylko zwiększyć problem. Czasem lepszym etapem jest rozjaśnianie.</p></article>
        </div>
      </div></section>

      <section class="price-section" id="obszary"><div class="container">
        <div class="price-heading"><p class="section-kicker">W praktyce</p><h2>Kolor starzeje się inaczej w zależności od obszaru.</h2></div>
        <div class="triage-grid">
            <a href="/makijaz-permanentny-brwi/">
              <span>01</span><h3>Brwi</h3><p>Najbardziej widoczne bywają chłodne, szare lub ciepłe pozostałości starej pigmentacji. Przed odświeżeniem oceniam ilość pigmentu i kierunek koloru.</p><strong>Czytaj / zobacz →</strong>
            </a>
            <a href="/makijaz-permanentny-ust/">
              <span>02</span><h3>Usta</h3><p>Pigment jest widziany na tle naturalnej czerwieni wargowej, więc zmiana nasycenia może dawać zupełnie inny odbiór niż na brwiach.</p><strong>Czytaj / zobacz →</strong>
            </a>
            <a href="/usuwanie-makijazu-permanentnego/">
              <span>03</span><h3>Usuwanie</h3><p>Gdy kolor jest niekorzystny, a pigmentu jest dużo, rozjaśnienie może dać lepsze warunki do nowej pracy niż kolejne krycie.</p><strong>Czytaj / zobacz →</strong>
            </a>
        </div>
      </div></section>

      <section class="price-section price-soft" id="co-robic"><div class="container plan-panel">
        <div class="plan-copy"><p class="section-kicker">Plan krok po kroku</p><h2>Co zrobić, gdy stary PMU zmienił kolor?</h2><p>Najpierw diagnoza estetyczna. Dopiero potem pigment.</p></div>
        <div class="plan-steps">
            <div><span>01</span><strong>Zrób zdjęcie w dziennym świetle</strong><p>Filtry i ciepłe oświetlenie potrafią bardzo zmienić odbiór starego PMU.</p></div>
            <div><span>02</span><strong>Oceń nasycenie</strong><p>Inaczej pracuje się ze śladowym, jasnym pigmentem, a inaczej z mocno nasyconą starą pigmentacją.</p></div>
            <div><span>03</span><strong>Nie wybieraj korektora samodzielnie</strong><p>„Dodać pomarańczowy na szary” to zbyt proste podejście do skóry i wieloletniej pigmentacji.</p></div>
            <div><span>04</span><strong>Ustal: korekta czy rozjaśnianie</strong><p>Celem jest czysta baza pod przyszły efekt, a nie jak największa liczba warstw.</p></div>
        </div>
      </div></section>

      <section class="price-section"><div class="container expert-card">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>Jak podchodzę do niekorzystnego koloru starego PMU?</h2><p>Najpierw oceniam ilość pigmentu. Jeśli stary kolor jest lekki i skóra ma przestrzeń na nową pracę, można rozważać korektę kolorystyczną. Jeśli pigment jest ciężki i nasycony, dokładanie kolejnego koloru często tylko pogłębia problem. Wtedy wolę zacząć od rozjaśnienia.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Przejdź do kwalifikacji PMU →</a></aside>
      </div></section>

      <section class="price-section price-soft"><div class="container">
        <div class="price-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="related-scroll">
            <a href="/poradnik/jak-dlugo-utrzymuje-sie-makijaz-permanentny/"><h3>Jak długo utrzymuje się PMU?</h3><p>Trwałość, blaknięcie i moment odświeżenia.</p><span>Czytaj dalej →</span></a>
            <a href="/usuwanie-makijazu-permanentnego/"><h3>Usuwanie makijażu permanentnego</h3><p>Laser i remover przy starej, niekorzystnej pigmentacji.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/"><h3>Poradnik PMU</h3><p>Wróć do centrum wiedzy.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="price-section" id="zrodla"><div class="container">
        <div class="price-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną i techniczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Jeżeli źródła nie dają jednej sztywnej reguły, nie udajemy, że taka reguła istnieje.</p></div>
        <div class="source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/37263219/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Color Biophysics and Human Color Perception in Tattooed Skin</h3><p>Przegląd opisuje złożoność postrzegania pigmentu w skórze i znaczenie doboru barwnika w PMU.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span><h3>Permanent makeup: A review of its technique, regulation, and complications</h3><p>Aktualny przegląd techniki PMU i możliwych problemów kosmetycznych.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">
              <span>FDA</span><h3>Tattoos & Permanent Makeup: Fact Sheet</h3><p>FDA opisuje złożoność pigmentów, możliwe reakcje i problemy związane z trwałą pigmentacją.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy nasilonych, nietypowych lub utrzymujących się objawach skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="price-section price-faq-section" id="faq"><div class="container">
        <div class="price-heading"><p class="section-kicker">FAQ</p><h2>Dlaczego makijaż permanentny zmienia kolor z czasem?</h2></div>
        <div class="faq-list">
            <details><summary><span>Dlaczego stare brwi permanentne robią się szare?</span><span class="faq-icon" aria-hidden="true"></span></summary><div><p>Może na to wpływać skład pigmentu, ilość barwnika, sposób pracy, skóra i zmiany wizualne w czasie. Nie da się wiarygodnie wskazać jednej przyczyny bez obejrzenia pigmentacji.</p></div></details>
            <details><summary><span>Czy czerwone brwi można przykryć nowym pigmentem?</span><span class="faq-icon" aria-hidden="true"></span></summary><div><p>Czasem korekta kolorystyczna jest możliwa, ale przy dużym nasyceniu dokładanie kolejnych warstw może nie być dobrym rozwiązaniem.</p></div></details>
            <details><summary><span>Czy UV zmienia kolor PMU?</span><span class="faq-icon" aria-hidden="true"></span></summary><div><p>UV wpływa na skórę i może przyspieszać starzenie oraz wizualne zmiany pigmentacji.</p></div></details>
            <details><summary><span>Czy każdy pigment PMU z czasem robi się czerwony?</span><span class="faq-icon" aria-hidden="true"></span></summary><div><p>Nie. Kierunek starzenia się koloru zależy od wielu czynników i nie można go sprowadzić do jednej reguły.</p></div></details>
            <details><summary><span>Kiedy lepiej usuwać niż neutralizować?</span><span class="faq-icon" aria-hidden="true"></span></summary><div><p>Gdy pigment jest mocno nasycony, ma niekorzystny kształt lub kolor, a skóra nie daje dobrych warunków na kolejną warstwę.</p></div></details>
        </div>
      </div></section>

      <section class="price-final-cta">
        <div class="container final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Stary PMU zmienił kolor?</h2>
          <p>Nie dokładaj kolejnej warstwy pigmentu w ciemno. Najpierw warto ocenić kolor, nasycenie, kształt i ilość starego pigmentu, a dopiero potem zdecydować o korekcie, odświeżeniu lub rozjaśnianiu.</p>
          <div class="final-actions">
            <a class="final-form" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU →</a>
            <a class="final-phone" href="tel:+48730900125">Zadzwoń</a>
            <a class="final-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy →</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>


