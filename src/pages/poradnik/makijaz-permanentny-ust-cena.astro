---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "makijaz-permanentny-ust-cena",
  title: "Makijaż permanentny ust cena 2026 — ile kosztują usta permanentne?",
  eyebrow: "Poradnik PMU",
  category: "Ceny PMU",
  datePublished: "2026-08-27",
  dateModified: "2026-08-27",
  readingTime: "8–10 minut",
  description:
    "Makijaż permanentny ust cena 2026: sprawdź, ile kosztują usta permanentne w Bielsku-Białej, co obejmuje cena 1400 zł, korekta, odświeżenie i kwalifikacja.",
  lead:
    "Cena makijażu permanentnego ust ma sens dopiero wtedy, gdy wiadomo, co obejmuje zabieg. Warto odróżnić nową pigmentację, korektę po wygojeniu, późniejsze odświeżenie oraz pracę na wcześniejszym PMU.",
  shortAnswer:
    "W gabinecie Bogusławy Herda w Bielsku-Białej makijaż permanentny ust kosztuje 1400 zł. Aktualny cennik wskazuje, że pozycje oznaczone gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące. Stare PMU, korekta pracy z innego gabinetu lub konieczność wcześniejszego rozjaśnienia wymagają osobnej kwalifikacji.",
  canonicalPath: "/poradnik/makijaz-permanentny-ust-cena/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const priceScenarios = [
  {
    label: "Nowa pigmentacja",
    price: "1400 zł",
    text: "Makijaż permanentny ust wykonywany od początku po kwalifikacji, analizie czerwieni wargowej, doborze koloru i rysunku wstępnym.",
    href: "/makijaz-permanentny-ust/",
    cta: "Zobacz usługę",
  },
  {
    label: "Korekta po wygojeniu",
    price: "w cenie*",
    text: "W aktualnym cenniku pozycje oznaczone gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące.",
    href: "/cennik-makijaz-permanentny/#price-group-3",
    cta: "Sprawdź cennik",
  },
  {
    label: "Odświeżenie po czasie",
    price: "osobny etap",
    text: "To nie jest ta sama sytuacja co korekta po zabiegu. Po miesiącach lub latach najpierw ocenia się kolor, nasycenie i aktualny kształt PMU.",
    href: "/poradnik/odswiezenie-makijazu-permanentnego-cena/",
    cta: "Cena odświeżenia",
  },
  {
    label: "Stare PMU z innego gabinetu",
    price: "kwalifikacja",
    text: "Nie każdą wcześniejszą pigmentację można bezpiecznie przykryć. Czasem potrzebna jest korekta koloru, plan etapowy albo wcześniejsze rozjaśnienie.",
    href: "/makijaz-permanentny-bielsko/#kwalifikacja-pmu",
    cta: "Wyślij kwalifikację",
  },
];

const includedItems = [
  {
    title: "Kwalifikacja i rozmowa",
    text: "Ocena oczekiwań, naturalnego koloru ust, wcześniejszych pigmentacji i istotnych informacji przed zabiegiem.",
  },
  {
    title: "Analiza koloru",
    text: "Pigment nie jest wybierany wyłącznie z próbnika. Liczy się czerwień wargowa, skóra, uroda i efekt oczekiwany po wygojeniu.",
  },
  {
    title: "Rysunek wstępny",
    text: "Zakres pigmentacji i miękki kontur są omawiane przed rozpoczęciem pracy.",
  },
  {
    title: "Pigmentacja",
    text: "Właściwy zabieg wykonywany z kontrolą nasycenia, symetrii, koloru i reakcji skóry.",
  },
  {
    title: "Zalecenia po zabiegu",
    text: "Instrukcja dotycząca gojenia i pielęgnacji ust po pigmentacji.",
  },
  {
    title: "Korekta zgodnie z cennikiem*",
    text: "Dla pozycji oznaczonych gwiazdką aktualny cennik obejmuje korektę w terminie 1–3 miesiące.",
  },
];

const faqItems = [
  {
    question: "Ile kosztuje makijaż permanentny ust w 2026 roku?",
    answer:
      "W gabinecie Bogusławy Herda w Bielsku-Białej makijaż permanentny ust kosztuje 1400 zł.",
  },
  {
    question: "Czy cena 1400 zł obejmuje korektę ust?",
    answer:
      "Aktualny cennik wskazuje, że ceny oznaczone gwiazdką obejmują zabieg główny wraz z korektą w terminie 1–3 miesiące. Przed rezerwacją warto sprawdzić bieżący cennik.",
  },
  {
    question: "Czy Natural Lips, kontur z cieniowaniem i pełniejsze nasycenie mają inną cenę?",
    answer:
      "Na stronie usługi usta permanentne są wycenione na 1400 zł. Kierunek pigmentacji dobierany jest do ust i oczekiwanego efektu, a nie wyłącznie do nazwy techniki.",
  },
  {
    question: "Czy poprawa starego makijażu permanentnego ust kosztuje tyle samo?",
    answer:
      "Nie należy zakładać tego automatycznie. Wcześniejszy pigment trzeba najpierw ocenić pod kątem koloru, nasycenia, kształtu i możliwości dalszej pracy. Czasem potrzebny jest inny plan niż nowa pigmentacja.",
  },
  {
    question: "Czy odświeżenie ust permanentnych to to samo co korekta?",
    answer:
      "Nie. Korekta jest etapem związanym z oceną efektu po wygojeniu zabiegu głównego, natomiast odświeżenie wykonuje się później, gdy pigment z czasem wyblakł lub zmienił intensywność.",
  },
  {
    question: "Czy cena powinna być najważniejszym kryterium wyboru linergistki?",
    answer:
      "Nie. Przy PMU ust równie ważne są doświadczenie, sposób kwalifikacji, analiza koloru, rysunek wstępny, zdjęcia realnych efektów i plan postępowania przy wcześniejszym pigmentowaniu.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: article.title,
    description: article.description,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: "pl-PL",
    author: {
      "@type": "Person",
      name: "Bogusława Herda",
      url: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/#boguslawa-herda",
    },
    publisher: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
    },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/38901732/",
      "https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: "https://www.permanentnybielsko.com/poradnik/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${article.title} | Poradnik PMU Bogusławy Herda`}
  description={article.description}
  canonicalPath={article.canonicalPath}
  structuredData={structuredData}
>
  <div class="price-guide-page">
    <Header />

    <main>
      <section class="price-hero">
        <div class="price-glow price-glow-one" aria-hidden="true"></div>
        <div class="price-glow price-glow-two" aria-hidden="true"></div>

        <div class="container price-hero-grid">
          <div class="price-hero-copy">
            <p class="section-kicker">{article.eyebrow}</p>

            <div class="price-meta">
              <span>{article.category}</span>
              <span>{article.readingTime}</span>
              <span>Aktualizacja: 27.08.2026</span>
            </div>

            <h1>{article.title}</h1>
            <p class="price-lead">{article.lead}</p>

            <div class="price-hero-actions">
              <a class="price-primary" href="#cena-ust">Zobacz cenę <span aria-hidden="true">→</span></a>
              <a class="price-secondary" href="/makijaz-permanentny-ust/#efekty-ust">Zobacz efekty ust</a>
            </div>
          </div>

          <aside class="price-answer" aria-label="Odpowiedź w 20 sekund">
            <p class="price-answer-label">Odpowiedź w 20 sekund</p>
            <strong class="price-big">1400 zł</strong>
            <h2>Tyle kosztuje nowy makijaż permanentny ust.</h2>
            <p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="price-nav-section">
        <div class="container">
          <nav class="price-nav" aria-label="Spis treści">
            <a href="#cena-ust">Cena 1400 zł</a>
            <a href="#co-obejmuje">Co obejmuje?</a>
            <a href="#korekta-czy-odswiezenie">Korekta czy odświeżenie?</a>
            <a href="#stare-pmu">Stare PMU</a>
            <a href="#jak-porownywac">Jak porównywać ceny?</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </section>

      <section class="price-section" id="cena-ust">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Cena PMU ust</p>
            <h2>1400 zł — ale ważniejsze jest, co dokładnie oznacza ta cena.</h2>
            <p>
              Dla nowego makijażu permanentnego ust cena bazowa w aktualnej ofercie wynosi 1400 zł.
              Nie rozbijamy jej na „tańszy naturalny kolor” i „droższą technikę”, ponieważ kierunek pigmentacji
              powinien wynikać z ust, skóry i oczekiwanego efektu po wygojeniu.
            </p>
          </div>

          <div class="scenario-scroll" aria-label="Scenariusze cenowe makijażu permanentnego ust">
            {priceScenarios.map((item) => (
              <article class="scenario-card">
                <span>{item.label}</span>
                <strong>{item.price}</strong>
                <p>{item.text}</p>
                <a href={item.href}>{item.cta} →</a>
              </article>
            ))}
          </div>

          <div class="price-service-bridge">
            <div>
              <span>Główna strona usługi</span>
              <strong>Chcesz zobaczyć realne efekty i metody ust?</strong>
            </div>
            <div class="price-service-actions">
              <a href="/makijaz-permanentny-ust/#efekty-ust">Efekty ust</a>
              <a href="/makijaz-permanentny-ust/#zakres-ust">Metody</a>
            </div>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="co-obejmuje">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Co obejmuje cena?</p>
            <h2>Nie płacisz wyłącznie za czas pigmentacji.</h2>
            <p>
              W dobrze zaplanowanym PMU ust większość ważnych decyzji zapada jeszcze przed pierwszym przejściem maszyną.
              Kolor, kontur, stan skóry i wcześniejsze zabiegi wpływają na cały plan pracy.
            </p>
          </div>

          <div class="included-grid">
            {includedItems.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section" id="korekta-czy-odswiezenie">
        <div class="container decision-grid">
          <div class="decision-copy">
            <p class="section-kicker">Korekta ≠ odświeżenie</p>
            <h2>Dwa podobne słowa, ale dwa różne etapy.</h2>
            <p>
              Korekta po wygojeniu służy ocenie i dopracowaniu świeżo wykonanego makijażu permanentnego.
              Odświeżenie dotyczy pigmentacji, która po dłuższym czasie straciła intensywność albo zmieniła charakter.
            </p>
            <p>
              To rozróżnienie jest ważne przy porównywaniu cenników. Oferta, która wygląda taniej na pierwszym ekranie,
              może mieć inaczej rozliczony etap korekty albo późniejsze dopigmentowanie.
            </p>
          </div>

          <div class="decision-cards">
            <article>
              <span>Korekta</span>
              <strong>Po zabiegu głównym</strong>
              <p>Ocena wygojonego koloru, równomierności i tego, jak skóra przyjęła pigment.</p>
            </article>
            <article>
              <span>Odświeżenie</span>
              <strong>Po dłuższym czasie</strong>
              <p>Nowa decyzja po ocenie koloru, nasycenia, kształtu i stanu wcześniejszego PMU.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="price-section price-soft" id="stare-pmu">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Wcześniejsza pigmentacja</p>
            <h2>Stare usta permanentne nie zawsze są „zwykłym nowym zabiegiem”.</h2>
            <p>
              Jeżeli na ustach znajduje się wcześniejszy pigment, cena nie powinna być jedyną rzeczą ustalaną przed wizytą.
              Najpierw trzeba sprawdzić jego kolor, nasycenie, granice oraz to, czy nowa praca rzeczywiście ma dobre warunki.
            </p>
          </div>

          <div class="triage-grid">
            <article>
              <span>01</span>
              <h3>Pigment jest lekki i równy</h3>
              <p>Możliwe, że plan będzie prostszy, ale nadal wymaga oceny koloru i kształtu.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Kolor jest nierówny lub zmieniony</h3>
              <p>Najpierw potrzebna jest diagnoza tego, co rzeczywiście znajduje się w skórze i jaki efekt można osiągnąć.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Kontur lub nasycenie blokują nowy plan</h3>
              <p>Przykrywanie problemu kolejną warstwą nie powinno być automatyczną decyzją.</p>
            </article>
          </div>

          <div class="qualification-strip">
            <div>
              <span>Masz wcześniejsze PMU ust?</span>
              <strong>Najpierw kwalifikacja, później wycena właściwego planu.</strong>
            </div>
            <a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz kwalifikacji PMU →</a>
          </div>
        </div>
      </section>

      <section class="price-section" id="jak-porownywac">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Jak porównywać oferty?</p>
            <h2>Porównuj zakres i doświadczenie, nie tylko liczbę przy „zł”.</h2>
            <p>
              Przy trwałej pigmentacji efekt pozostaje z Tobą znacznie dłużej niż jednorazowy makijaż. Dlatego sensowne porównanie ofert powinno obejmować nie tylko cenę bazową.
            </p>
          </div>

          <div class="compare-list">
            <div><strong>Czy cena obejmuje korektę?</strong><span>Sprawdź, czy korekta po wygojeniu jest wliczona, czy rozliczana osobno.</span></div>
            <div><strong>Czy oglądasz realne efekty?</strong><span>Zdjęcia prac pomagają ocenić styl, miękkość konturu i poziom nasycenia.</span></div>
            <div><strong>Czy jest rysunek wstępny i analiza koloru?</strong><span>To część procesu decyzyjnego, a nie dodatek marketingowy.</span></div>
            <div><strong>Co dzieje się przy wcześniejszym PMU?</strong><span>Dobra oferta powinna przewidywać kwalifikację zamiast automatycznego przykrywania starego pigmentu.</span></div>
            <div><strong>Kto wykonuje zabieg?</strong><span>Doświadczenie, praktyka i sposób prowadzenia trudniejszych przypadków mają znaczenie dla decyzji.</span></div>
          </div>
        </div>
      </section>

      <section class="price-section expert-section">
        <div class="container expert-card">
          <div>
            <p class="section-kicker">Ekspert PMU</p>
            <h2>Cena jest prosta. Dobór efektu już nie.</h2>
            <p>
              Bogusława Herda jest kosmetologiem i linergistką z ponad 10-letnim doświadczeniem,
              8-krotną mistrzynią PMU, wicemistrzynią świata oraz europejskim trenerem Long-Time-Liner®.
              W pigmentacji ust najważniejszy jest plan dopasowany do czerwieni wargowej, twarzy i efektu po wygojeniu.
            </p>
          </div>
          <aside>
            <span>Bogusława Herda</span>
            <strong>8× mistrzyni PMU</strong>
            <strong>Wicemistrzyni świata</strong>
            <strong>Europejski trener Long-Time-Liner®</strong>
            <a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie →</a>
          </aside>
        </div>
      </section>

      <section class="price-section price-soft" id="powiazane">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">Powiązane odpowiedzi</p>
            <h2>Jeśli cena jest już jasna, następna decyzja dotyczy efektu.</h2>
          </div>

          <div class="related-scroll">
            <a href="/makijaz-permanentny-ust/">
              <span>Usługa</span>
              <strong>Makijaż permanentny ust</strong>
              <p>Efekty, metody, proces i kwalifikacja.</p>
            </a>
            <a href="/poradnik/makijaz-permanentny-ust-jak-wybrac-kolor/">
              <span>Kolor</span>
              <strong>Jak dobrać kolor ust?</strong>
              <p>Naturalna czerwień, pigment i efekt po wygojeniu.</p>
            </a>
            <a href="/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/">
              <span>Gojenie</span>
              <strong>Usta dzień po dniu</strong>
              <p>Etapy gojenia i pielęgnacja po zabiegu.</p>
            </a>
            <a href="/poradnik/usta-permanentne-po-wygojeniu/">
              <span>Efekt</span>
              <strong>Usta po wygojeniu</strong>
              <p>Kiedy naprawdę oceniać kolor i nasycenie.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="price-section" id="faq">
        <div class="container">
          <div class="price-heading">
            <p class="section-kicker">FAQ</p>
            <h2>Najczęstsze pytania o cenę makijażu permanentnego ust.</h2>
          </div>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="price-section sources-section" id="zrodla">
        <div class="container sources-card">
          <div>
            <p class="section-kicker">Źródła i aktualność</p>
            <h2>Cena pochodzi z aktualnego cennika gabinetu.</h2>
            <p>
              Informacje o cenie 1400 zł i zasadzie korekty odnoszą się do aktualnej oferty PermanentnyBielsko.
              Źródła medyczne poniżej służą wyłącznie jako ogólne tło dotyczące makijażu permanentnego jako procedury pigmentacji skóry.
            </p>
          </div>
          <div class="source-links">
            <a href="/cennik-makijaz-permanentny/#price-group-3">Aktualny cennik PMU →</a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">Przegląd PMU — PubMed →</a>
            <a href="https://www.fda.gov/cosmetics/cosmetic-products/tattoos-permanent-makeup-fact-sheet" target="_blank" rel="noopener noreferrer">FDA — Tattoos & Permanent Makeup →</a>
          </div>
        </div>
      </section>

      <section class="price-final-cta">
        <div class="container final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>1400 zł jest już jasne. Teraz sprawdź, jaki efekt będzie właściwy dla Twoich ust.</h2>
          <p>
            Jeśli nie masz wcześniejszej pigmentacji, możesz przejść do efektów i terminów. Jeśli masz stare PMU,
            wypełniacze, skłonność do opryszczki lub wątpliwości dotyczące koloru — zacznij od kwalifikacji.
          </p>

          <div class="final-actions">
            <a class="final-form" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU →</a>
            <a class="final-phone" href="tel:+48730900125">Zadzwoń</a>
            <a class="final-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy →</a>
          </div>
