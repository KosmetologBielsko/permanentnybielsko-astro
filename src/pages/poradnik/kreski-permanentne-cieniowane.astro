---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/pmu-guide-system.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const article = {
  slug: "kreski-permanentne-cieniowane",
  title: "Kreski permanentne cieniowane — dla kogo, jaki efekt i czym różnią się od klasycznej kreski?",
  category: "Kreski permanentne",
  datePublished: "2026-08-20",
  dateModified: "2026-08-20",
  readingTime: "9–11 minut",
  description: "Kreski permanentne cieniowane: czym różnią się od klasycznego eyelinera i zagęszczenia rzęs, dla kogo są odpowiednie i kiedy lepiej wybrać subtelniejszy efekt.",
  lead: "Kreska cieniowana nie jest po prostu „grubszym eyelinerem”. Jej charakter buduje miękkie przejście pigmentu nad linią rzęs. Dobrze zaprojektowana ma otwierać spojrzenie, a nie tworzyć ciężką plamę na powiece.",
  shortAnswer: "Kreska cieniowana daje bardziej miękki, rozproszony efekt niż klasyczny eyeliner. Najlepiej sprawdza się wtedy, gdy budowa powieki pozwala na bezpieczne pokazanie cienia. Przy opadającej, bardzo wiotkiej lub mocno pracującej powiece subtelniejsze zagęszczenie linii rzęs może wyglądać lepiej i starzeć się łagodniej.",
  canonicalPath: "/poradnik/kreski-permanentne-cieniowane/",
};

const pageUrl = `https://www.permanentnybielsko.com${article.canonicalPath}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    url: pageUrl, headline: article.title, description: article.description,
    datePublished: article.datePublished, dateModified: article.dateModified, inLanguage: "pl-PL",
    author: { "@type": "Person", name: "Bogusława Herda", url: "https://www.permanentnybielsko.com/" },
    publisher: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
    mainEntityOfPage: { "@type": "WebPage", "@id": `${pageUrl}#webpage` },
    citation: [
      "https://pubmed.ncbi.nlm.nih.gov/16418666/",
      "https://pubmed.ncbi.nlm.nih.gov/33933438/",
      "https://pubmed.ncbi.nlm.nih.gov/38901732/"
    ],
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://www.permanentnybielsko.com/" },
      { "@type": "ListItem", position: 2, name: "Poradnik PMU", item: "https://www.permanentnybielsko.com/poradnik/" },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", "@id": `${pageUrl}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Czym różni się kreska cieniowana od klasycznej?",
        acceptedAnswer: { "@type": "Answer", text: "Klasyczna kreska ma bardziej wyraźną linię, a cieniowana buduje miękkie, rozproszone przejście pigmentu nad linią rzęs." },
      },
      {
        "@type": "Question",
        name: "Czy kreska cieniowana pasuje do opadającej powieki?",
        acceptedAnswer: { "@type": "Answer", text: "Nie zawsze. Przy opadającej lub wiotkiej powiece trzeba ocenić, czy cień będzie widoczny i czy nie stworzy ciężkiego efektu." },
      },
      {
        "@type": "Question",
        name: "Czy cieniowana kreska jest bardziej naturalna?",
        acceptedAnswer: { "@type": "Answer", text: "Może być miękka, ale nadal jest bardziej widoczna niż samo zagęszczenie linii rzęs. Naturalność zależy od wielkości i intensywności projektu." },
      },
      {
        "@type": "Question",
        name: "Ile trwa wykonanie kreski cieniowanej?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku gabinetu kreska dekoracyjna — eyeliner lub cieniowana — ma zaplanowane około 120 minut." },
      },
      {
        "@type": "Question",
        name: "Ile kosztuje kreska cieniowana?",
        acceptedAnswer: { "@type": "Answer", text: "W aktualnym cenniku gabinetu kreska dekoracyjna — eyeliner lub cieniowana — kosztuje 1100 zł i obejmuje zabieg zgodnie z zasadami cennika." },
      }
    ],
  },
];
---

<Layout title={`${article.title} | Bogusława Herda`} description={article.description} canonicalPath={article.canonicalPath} structuredData={structuredData}>
  <div class="expert-article-page">
    <Header />
    <main>
      <section class="expert-article-hero">
        <div class="container expert-article-hero-grid">
          <div class="expert-article-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>
            <div class="expert-article-meta"><span>53</span><span>{article.category}</span><span>{article.readingTime}</span></div>
            <h1>{article.title}</h1><p class="expert-article-lead">{article.lead}</p>
          </div>
          <aside class="expert-article-answer" aria-label="Odpowiedź w skrócie">
            <p class="expert-article-answer-label">Odpowiedź w 20 sekund</p>
            <h2>Cieniowanie ma zmiękczać spojrzenie — nie zastępować ciężkiego codziennego makijażu.</h2><p>{article.shortAnswer}</p>
          </aside>
        </div>
      </section>

      <section class="expert-article-nav-section"><div class="container"><nav class="expert-article-nav" aria-label="Spis treści artykułu">
            <a href="#porownanie">3 rodzaje efektu</a>
            <a href="#dobor">Dla kogo?</a>
            <a href="#projekt">Jak projektować?</a>
            <a href="#praktyka">Praktyka gabinetowa</a>
            <a href="#zrodla">Źródła</a>
            <a href="#faq">FAQ</a>
      </nav></div></section>

      <section class="expert-article-section" id="porownanie"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Praktyczna odpowiedź</p><h2>Zagęszczenie, klasyczna kreska czy cieniowanie?</h2><p>To trzy różne poziomy widoczności i trzy różne decyzje projektowe.</p></div>
        <div class="expert-timeline">
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Zagęszczenie linii rzęs</strong><span>Najsubtelniejszy wariant</span></div>
              <h3>Efekt bez „narysowanej kreski”</h3><p>Pigment pracuje przy samej linii rzęs i ma głównie optycznie zagęścić ich nasadę.</p>
            </article>
            <article class="expert-timeline-card is-good">
              <div class="expert-timeline-top"><strong>Klasyczna kreska</strong><span>Wyraźniejsza linia</span></div>
              <h3>Czytelny eyeliner</h3><p>Ma ostrzejszą, bardziej zdefiniowaną formę i wymaga dobrego dopasowania do budowy powieki.</p>
            </article>
            <article class="expert-timeline-card is-warning">
              <div class="expert-timeline-top"><strong>Kreska cieniowana</strong><span>Miękkie przejście</span></div>
              <h3>Efekt softliner</h3><p>Nad linią rzęs pojawia się delikatnie rozproszony pigment, który daje bardziej miękki rezultat.</p>
            </article>
            <article class="expert-timeline-card is-danger">
              <div class="expert-timeline-top"><strong>Zbyt ciężki projekt</strong><span>Za dużo pigmentu</span></div>
              <h3>Ryzyko przytłoczenia oka</h3><p>Im większy i ciemniejszy projekt, tym ważniejsza jest stabilność powieki i bardzo ostrożna kwalifikacja.</p>
            </article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-soft" id="dobor"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Co ma znaczenie?</p><h2>Co decyduje, czy cieniowana kreska będzie dobrym wyborem?</h2></div>
        <div class="expert-factor-grid">
            <article><h3>Budowa powieki</h3><p>Znaczenie ma ilość widocznej powieki, jej opadanie, wiotkość i sposób, w jaki skóra układa się przy otwartym oku.</p></article>
            <article><h3>Kierunek oka</h3><p>Cieniowanie powinno wspierać naturalny kierunek spojrzenia, a nie mechanicznie kopiować trend z innej twarzy.</p></article>
            <article><h3>Codzienny makijaż</h3><p>Jeśli klientka na co dzień nie nosi eyelinera, duża cieniowana forma może być zbyt mocna. Projekt powinien pasować do realnego stylu życia.</p></article>
            <article><h3>Stara pigmentacja</h3><p>Przy wcześniejszej kresce trzeba ocenić jej kolor, położenie i szerokość. Czasem najpierw potrzebny jest plan korekty lub rozjaśnienia.</p></article>
        </div>
      </div></section>

      <section class="expert-article-section expert-article-plan-section" id="projekt"><div class="container expert-plan-panel">
        <div class="expert-plan-copy"><p class="section-kicker section-kicker-light">Plan decyzji</p><h2>Dobry projekt kreski zaczyna się od oka, nie od nazwy techniki.</h2><p>Przed pigmentacją warto odpowiedzieć sobie na cztery pytania.</p></div>
        <div class="expert-plan-steps">
            <div><span>01</span><strong>Ile powieki naprawdę widać?</strong><p>Projekt trzeba oceniać przy otwartym oku, w naturalnej mimice.</p></div>
            <div><span>02</span><strong>Czy cień ma być widoczny codziennie?</strong><p>Im bardziej dekoracyjna forma, tym ważniejsze jest świadome zaakceptowanie jej stałej obecności.</p></div>
            <div><span>03</span><strong>Jak zachowuje się skóra?</strong><p>Wiotkość, opadanie i ruchomość powieki wpływają na to, ile cieniowania można bezpiecznie pokazać.</p></div>
            <div><span>04</span><strong>Czy istnieje stary eyeliner?</strong><p>Nowy projekt nie powinien automatycznie przykrywać starego, jeśli poprzednia pigmentacja jest szeroka lub niekorzystna.</p></div>
        </div>
      </div></section>

      <section class="expert-article-section" id="praktyka"><div class="container expert-author-note">
        <div><p class="section-kicker">Praktyka gabinetowa</p><h2>Przy kreskach „mniej” bardzo często daje bardziej elegancki efekt na lata.</h2><p>W praktyce gabinetowej najpierw patrzę na oko przy otwartej powiece. Jeżeli cieniowanie ma naturalną przestrzeń i naprawdę pasuje do stylu klientki, może pięknie zmiękczyć spojrzenie. Jeżeli powieka mocno opada albo klientka chce bardzo naturalny efekt, często proponuję samo zagęszczenie rzęs zamiast dużej formy dekoracyjnej.</p></div>
        <aside><span>Bogusława Herda</span><strong>Trenerka Long-Time-Liner®</strong><strong>Autorka Silky Hairstroke Brows</strong><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj moje doświadczenie i podejście →</a></aside>
      </div></section>

      <section class="expert-article-section expert-article-related-section"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Powiązane tematy</p><h2>Nie powtarzamy tego samego — kierujemy do właściwego poradnika lub usługi.</h2></div>
        <div class="expert-related-grid">
            <a href="/poradnik/kreska-permanentna-jak-wybrac-rodzaj/"><h3>Jak wybrać rodzaj kreski permanentnej?</h3><p>Porównanie podstawowych wariantów makijażu permanentnego oczu.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/"><h3>Kreska przy opadającej powiece</h3><p>Kiedy subtelniejszy projekt jest lepszym rozwiązaniem.</p><span>Czytaj dalej →</span></a>
            <a href="/poradnik/kreska-permanentna-cena/"><h3>Kreska permanentna — cena</h3><p>Aktualne ceny wariantów kreski i zakres usług.</p><span>Czytaj dalej →</span></a>
            <a href="/makijaz-permanentny-oczu/"><h3>Makijaż permanentny oczu</h3><p>Zobacz usługę, etapy i dostępne warianty kreski.</p><span>Czytaj dalej →</span></a>
        </div>
      </div></section>

      <section class="expert-article-section" id="zrodla"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">Źródła</p><h2>Na czym opieramy część medyczną, techniczną i praktyczną?</h2><p>Informacje medyczne oddzielamy od praktyki gabinetowej. Gdy nie istnieje jedna uniwersalna reguła, nie przedstawiamy jej jako pewnika.</p></div>
        <div class="expert-source-grid">
            <a href="https://pubmed.ncbi.nlm.nih.gov/16418666/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Adverse reactions to permanent eyeliner tattoo</h3><p>Opisano zapalne reakcje powiek po permanentnym eyelinerze, co podkreśla znaczenie prawidłowej kwalifikacji i higieny.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/33933438/" target="_blank" rel="noopener noreferrer">
              <span>PubMed</span><h3>Complications and adverse effects of periocular aesthetic treatments</h3><p>Przegląd omawia możliwe powikłania estetycznych zabiegów w okolicy oka.</p><strong>Otwórz źródło ↗</strong>
            </a>
            <a href="https://pubmed.ncbi.nlm.nih.gov/38901732/" target="_blank" rel="noopener noreferrer">
              <span>JAAD / PubMed</span><h3>Permanent makeup: technique, regulation and complications</h3><p>Aktualny przegląd PMU, w tym możliwych powikłań infekcyjnych, alergicznych i zapalnych.</p><strong>Otwórz źródło ↗</strong>
            </a>
        </div>
        <p class="expert-medical-note">Treść ma charakter informacyjny i nie zastępuje diagnozy ani indywidualnej konsultacji medycznej. Przy problemach zdrowotnych, nasilonych objawach lub wątpliwościach dotyczących leczenia skontaktuj się z lekarzem.</p>
      </div></section>

      <section class="expert-article-section expert-article-faq-section" id="faq"><div class="container">
        <div class="expert-article-heading"><p class="section-kicker">FAQ</p><h2>{article.title}</h2></div>
        <div class="expert-faq-list">
            <details><summary><span>Czym różni się kreska cieniowana od klasycznej?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Klasyczna kreska ma bardziej wyraźną linię, a cieniowana buduje miękkie, rozproszone przejście pigmentu nad linią rzęs.</p></div></details>
            <details><summary><span>Czy kreska cieniowana pasuje do opadającej powieki?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Nie zawsze. Przy opadającej lub wiotkiej powiece trzeba ocenić, czy cień będzie widoczny i czy nie stworzy ciężkiego efektu.</p></div></details>
            <details><summary><span>Czy cieniowana kreska jest bardziej naturalna?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>Może być miękka, ale nadal jest bardziej widoczna niż samo zagęszczenie linii rzęs. Naturalność zależy od wielkości i intensywności projektu.</p></div></details>
            <details><summary><span>Ile trwa wykonanie kreski cieniowanej?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku gabinetu kreska dekoracyjna — eyeliner lub cieniowana — ma zaplanowane około 120 minut.</p></div></details>
            <details><summary><span>Ile kosztuje kreska cieniowana?</span><span class="expert-faq-icon" aria-hidden="true"></span></summary><div><p>W aktualnym cenniku gabinetu kreska dekoracyjna — eyeliner lub cieniowana — kosztuje 1100 zł i obejmuje zabieg zgodnie z zasadami cennika.</p></div></details>
        </div>
      </div></section>

      <section class="expert-article-section"><div class="container expert-final-card">
        <p class="signature cta-signature">Powrót do natury</p><h2>Potrzebujesz indywidualnej oceny przed PMU?</h2>
        <p>Jeśli wiesz, jaki zabieg chcesz wykonać — sprawdź terminy. Jeśli masz stare PMU, wcześniejsze zabiegi albo wątpliwości, zacznij od formularza kwalifikacji.</p>
        <div class="expert-final-actions">
          <a class="expert-booksy" href={booksyUrl} target="_blank" rel="noopener noreferrer">Booksy <span aria-hidden="true">→</span></a>
          <a class="button-primary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Formularz PMU <span aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/cennik-makijaz-permanentny/">Cennik</a>
        </div>
        <a class="expert-back-link" href="/poradnik/">← Wróć do całego poradnika PMU</a>
      </div></section>
    </main>
    <Footer />
  </div>
</Layout>

