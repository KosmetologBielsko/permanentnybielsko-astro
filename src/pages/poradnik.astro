    "answer": "Nie. Biblioteka obejmuje 58 poradników o brwiach, ustach, kreskach, przygotowaniu, bólu i komforcie, gojeniu, pielęgnacji, skórze, bezpieczeństwie, zabiegach łączonych, korektach, usuwaniu, cenach, Bielsku-Białej i szkoleniach PMU."
  },
  {
    "question": "Od czego zacząć przed pierwszym makijażem permanentnym?",
    "answer": "Najpierw sprawdź przygotowanie do zabiegu, sposób wyboru metody i gabinetu oraz rysunek wstępny. Jeśli stosujesz retinol, miałaś botoks, filler albo planujesz wakacje, znajdziesz również osobne poradniki do tych sytuacji."
  },
  {
    "question": "Gdzie szukać informacji, jeśli jestem już po zabiegu?",
    "answer": "Wybierz kategorię „Gojenie”. Zebrane są tam osobne odpowiedzi dotyczące brwi, ust, kresek, mycia, smarowania, ciemnego koloru, nierównego przyjęcia pigmentu i aktywności fizycznej."
  },
  {
    "question": "Co zrobić przy starym lub nieudanym PMU?",
    "answer": "Przejdź do kategorii „Korekta i usuwanie”. Nie każdy stary pigment powinien być przykrywany kolejną warstwą — poradniki pomagają rozróżnić odświeżenie, korektę, rozjaśnienie i usuwanie."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#collection`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: { "@id": "https://www.permanentnybielsko.com/#website" },
    about: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${pageUrl}#articles`,
    name: "Ekspercki poradnik PMU Bogusławy Herda",
    numberOfItems: articleCards.length,
    itemListElement: articleCards.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      url: `https://www.permanentnybielsko.com${item.href}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/poradnik/"
  structuredData={structuredData}
>
  <!-- PORADNIK PMU: FINAL 58 wpisów | bez wstępnych kafelków | wyszukiwarka + filtry -->
  <div class="guide-page">
    <Header />

    <main>
      <section class="guide-hero">
        <div class="guide-glow guide-glow-one" aria-hidden="true"></div>
        <div class="guide-glow guide-glow-two" aria-hidden="true"></div>

        <div class="container guide-hero-grid">
          <div class="guide-hero-copy">
            <p class="section-kicker">Ekspercki poradnik PMU</p>

            <h1>
              Znajdź odpowiedź
              <span>zanim podejmiesz decyzję o PMU.</span>
            </h1>

            <p class="guide-hero-lead">
              58 konkretnych poradników o brwiach, ustach, kreskach,
              przygotowaniu, gojeniu, skórze, bezpieczeństwie i starym makijażu permanentnym.
              Bez przeglądania przypadkowych artykułów — wybierasz swoją sytuację i przechodzisz do odpowiedzi.
            </p>

            <div class="guide-hero-actions">
              <a class="button-primary" href="#biblioteka-pmu">
                Znajdź odpowiedź <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>
          </div>

          <aside class="guide-hero-card" aria-label="Centrum wiedzy PMU">
            <span class="guide-hero-card-mark" aria-hidden="true">PMU</span>

            <div class="guide-hero-card-content">
              <p>Centrum wiedzy</p>
              <h2>Jedno miejsce. Konkretne pytanie. Konkretna odpowiedź.</h2>

              <div class="guide-hero-stats">
                <div>
                  <strong>{articleCards.length}</strong>
                  <span>artykułów</span>
                </div>
                <div>
                  <strong>9</strong>
                  <span>obszarów wiedzy</span>
                </div>
                <div>
                  <strong>1–2</strong>
                  <span>kliknięcia do tematu</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="guide-proof-section" aria-label="Zakres poradnika PMU">
        <div class="container guide-proof-grid">
          <div>
            <strong>Brwi · Usta · Kreski</strong>
            <span>wybór metody i efektu</span>
          </div>
          <div>
            <strong>Przed i po zabiegu</strong>
            <span>przygotowanie, gojenie, pielęgnacja</span>
          </div>
          <div>
            <strong>Skóra i bezpieczeństwo</strong>
            <span>realne sytuacje wymagające oceny</span>
          </div>
          <div>
            <strong>Stare PMU</strong>
            <span>korekta, rozjaśnianie, usuwanie</span>
          </div>
        </div>
      </section>

      <section class="guide-library-section" id="biblioteka-pmu">
        <div class="container">
          <div class="guide-section-heading guide-library-heading">
            <div>
              <p class="section-kicker">Biblioteka wiedzy</p>
              <h2>Wyszukaj temat albo wybierz kategorię.</h2>
              <p>
                Nie musisz znać fachowych nazw. Wpisz problem lub jedno słowo:
                <strong>gojenie, przeciwwskazania, ból, opryszczka, stary pigment, cena...</strong>
              </p>
            </div>

            <div class="guide-library-count">
              <strong id="guideResultCount">{articleCards.length}</strong>
              <span>widocznych poradników</span>
            </div>
          </div>

          <div class="guide-search-card">
            <label class="guide-search-field" for="guideSearchInput">
              <span class="guide-search-label">Czego szukasz?</span>
              <span class="guide-search-box">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path>
                </svg>
                <input
                  id="guideSearchInput"
                  type="search"
                  inputmode="search"
                  autocomplete="off"
                  placeholder="np. przeciwwskazania, ból, kreska cieniowana, stary pigment..."
                />
                <button type="button" id="guideSearchClear" aria-label="Wyczyść wyszukiwanie">
                  Wyczyść
                </button>
              </span>
            </label>

            <div class="guide-search-presets" aria-label="Popularne wyszukiwania">
              <span>Popularne:</span>
              <button type="button" data-search-preset="gojenie brwi">gojenie brwi</button>
              <button type="button" data-search-preset="opryszczka">opryszczka</button>
              <button type="button" data-search-preset="przeciwwskazania">przeciwwskazania</button>
              <button type="button" data-search-preset="stary pigment">stary pigment</button>
              <button type="button" data-search-preset="cena">cena</button>
            </div>
          </div>

          <div class="guide-library-layout">
            <aside class="guide-filter-panel" aria-label="Kategorie poradnika">
              <p>Filtruj poradniki</p>

              <div class="guide-filter-list" role="group" aria-label="Filtry kategorii">
                {categoryFilters.map((filter, index) => (
                  <button
                    type="button"
                    class:list={["guide-filter-button", index === 0 && "is-active"]}
                    data-guide-filter={filter.id}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    <span>{filter.label}</span>
                    <strong>{filter.count}</strong>
                  </button>
                ))}
              </div>

              <div class="guide-filter-help">
                <strong>Nie wiesz, co wybrać?</strong>
                <p>Zacznij od wyszukiwarki. Jedno słowo zwykle wystarczy.</p>
              </div>
            </aside>

            <div class="guide-library-content">
              <div class="guide-library-toolbar">
                <p id="guideActiveLabel">Wszystkie poradniki</p>
                <button type="button" id="guideResetFilters">Pokaż wszystko</button>
              </div>

              <div class="guide-article-grid" id="guideArticleGrid">
                {articleCards.map((article) => (
                  <a
                    class:list={[
                      "guide-article-card",
                      article.featured && "guide-article-card--featured",
                    ]}
                    href={article.href}
                    data-article-card
                    data-groups={article.groups.join(" ")}
                    data-search={`${article.title} ${article.description} ${article.category} ${article.groups.join(" ")}`}
                  >
                    <div class="guide-article-top">
                      <span class="guide-article-number">{article.number}</span>
                      <span class="guide-article-meta">
                        {article.category}
                        {article.readingTime && <em> · {article.readingTime}</em>}
                      </span>
                    </div>

                    <h3>{article.title}</h3>
                    <p>{article.description}</p>

                    <div class="guide-article-bottom">
                      {article.featured ? <span>Polecany start</span> : <span>Poradnik PMU</span>}
                      <strong>Czytaj →</strong>
                    </div>
                  </a>
                ))}
              </div>

              <div class="guide-empty-state" id="guideEmptyState" hidden>
                <span>Brak wyniku</span>
                <h3>Nie znaleźliśmy poradnika dla tego hasła.</h3>
                <p>
                  Spróbuj krótszego zapytania, np. „brwi”, „usta”, „gojenie”
                  albo wybierz kategorię z filtrów.
                </p>
                <button type="button" id="guideEmptyReset">Wyczyść wyszukiwanie</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-expert-section">
        <div class="container guide-expert-panel">
          <div class="guide-expert-copy">
            <p class="section-kicker section-kicker-light">Ekspercki charakter poradnika</p>
            <h2>Wiedza gabinetowa jest oddzielona od informacji medycznych.</h2>
            <p>
              W nowych i zaktualizowanych artykułach praktyczne doświadczenie
              Bogusławy Herda jest opisane osobno, a tematy dotyczące skóry,
              bezpieczeństwa i powikłań prowadzą również do źródeł dermatologicznych
              i instytucjonalnych.
            </p>
          </div>

          <div class="guide-expert-points">
            <div>
              <span>01</span>
              <strong>Jedno pytanie = jeden temat</strong>
              <p>Bez powtarzania tej samej odpowiedzi w kilku sekcjach.</p>
            </div>
            <div>
              <span>02</span>
              <strong>Linkowanie między zagadnieniami</strong>
              <p>Gdy temat ma osobny poradnik, kierujemy do niego zamiast przepisywać treść.</p>
            </div>
            <div>
              <span>03</span>
              <strong>Praktyka + źródła</strong>
              <p>Rozróżniamy doświadczenie gabinetowe od informacji medycznych.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-services-section">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Od wiedzy do właściwej usługi</p>
            <h2>Masz już odpowiedź? Zobacz konkretny zabieg.</h2>
            <p>
              Poradnik pomaga zrozumieć sytuację. Podstrony usługowe pokazują
              efekty, techniki, kwalifikację i aktualny sposób pracy.
            </p>
          </div>

          <div class="guide-service-grid">
            {serviceCards.map((item, index) => (
              <a class="guide-service-card" href={item.href}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{item.label}</p>
                <h3>{item.title}</h3>
                <em>{item.text}</em>
                <strong>Zobacz usługę →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-faq-section">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Jak korzystać z poradnika?</p>
            <h2>Najczęstsze pytania o centrum wiedzy PMU.</h2>
          </div>

          <div class="guide-faq-list">
            {faqItems.map((item) => (
              <details class="guide-faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="guide-faq-icon" aria-hidden="true"></span>
                </summary>
                <div><p>{item.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-final-cta">
        <div class="container guide-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Poradnik dał Ci odpowiedź? Teraz możesz wybrać kolejny krok.</h2>
          <p>
            Sprawdź terminy, ceny albo przejdź do formularza kwalifikacji,
            jeśli masz stare PMU, wcześniejsze zabiegi lub nie wiesz,
            która metoda będzie właściwa dla Twojej skóry.
          </p>

          <div class="guide-final-actions">
            <a
              class="button-booksy"
              href={booksyUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a
              class="button-primary"
              href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu"
            >
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href="/cennik-makijaz-permanentny/">
              Cennik
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .guide-page {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 80% 9%, rgba(56, 187, 181, 0.10), transparent 30rem),
      radial-gradient(circle at 10% 37%, rgba(201, 127, 143, 0.10), transparent 28rem),
      linear-gradient(180deg, #fffdfd 0%, #fff8fa 50%, #ffffff 100%);
  }

  .guide-page *,
  .guide-page *::before,
  .guide-page *::after {
    box-sizing: border-box;
  }

  .guide-page main,
  .guide-page section,
  .guide-page .container,
  .guide-page div,
  .guide-page aside,
  .guide-page nav {
    min-width: 0;
  }

  .guide-page [hidden] {
    display: none !important;
  }

  .guide-page .section-kicker {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 31px;
    align-items: center;
    justify-content: center;
    margin: 0 0 17px;
    padding: 0 12px;
    border: 1px solid rgba(56, 187, 181, 0.18);
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.76);
    color: var(--color-turquoise-dark, #0f7773);
    font-family: inherit;
    font-size: 0.67rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .guide-page .section-kicker-light {
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .guide-hero {
    position: relative;
    overflow: hidden;
    padding: 144px 0 68px;
  }

  .guide-glow {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .guide-glow-one {
    top: -2rem;
    right: -15rem;
    width: 45rem;
    height: 45rem;
    background: radial-gradient(circle, rgba(56, 187, 181, 0.18), transparent 68%);
  }

  .guide-glow-two {
    left: -14rem;
    bottom: -17rem;
    width: 42rem;
    height: 42rem;
    background: radial-gradient(circle, rgba(201, 127, 143, 0.15), transparent 68%);
  }

  .guide-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.13fr) minmax(350px, 0.87fr);
    gap: 22px;
    align-items: stretch;
  }

  .guide-hero-copy,
  .guide-hero-card,
  .guide-route-card,
  .guide-search-card,
  .guide-filter-panel,
  .guide-article-card,
  .guide-expert-panel,
  .guide-service-card,
  .guide-faq-item,
  .guide-final-card {
    border: 1px solid rgba(183, 101, 118, 0.14);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.065);
  }

  .guide-hero-copy {
    padding: clamp(35px, 5vw, 64px);
    border-radius: 39px;
    background:
      radial-gradient(circle at 94% 12%, rgba(56, 187, 181, 0.07), transparent 16rem),
      rgba(255, 255, 255, 0.86);
  }

  .guide-hero-copy h1 {
    max-width: 1030px;
    margin: 0;
    color: var(--color-text, #17151d);
    font-family: inherit;
    font-size: clamp(2.85rem, 4.9vw, 5.55rem);
    font-weight: 780;
    line-height: 1;
    letter-spacing: -0.074em;
  }

  .guide-hero-copy h1 span {
    display: block;
    margin-top: 4px;
    background: linear-gradient(120deg, #0d6a67, #1aa5a0 48%, #63d7cf 74%, #0f7773);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .guide-hero-lead {
    max-width: 850px;
    margin: 24px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(1.02rem, 1.25vw, 1.14rem);
    line-height: 1.69;
  }

  .guide-hero-actions,
  .guide-final-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    margin-top: 28px;
  }

  .guide-hero-actions > a,
  .guide-final-actions > a {
    display: inline-flex;
    width: 100%;
    min-height: 57px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 17px;
    border-radius: 999px;
    font-family: inherit !important;
    font-size: 0.95rem !important;
    font-weight: 820 !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    text-align: center;
    text-decoration: none;
    text-transform: none !important;
    -webkit-tap-highlight-color: transparent;
  }

  .button-booksy {
    border: 1px solid rgba(8, 111, 91, 0.16);
    background: linear-gradient(135deg, #18a889 0%, #0f8f78 55%, #0b7868 100%);
    color: #ffffff;
    box-shadow: 0 14px 34px rgba(15, 143, 120, 0.16);
  }

  .guide-hero-card {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    border-radius: 39px;
    color: #ffffff;
    background:
      radial-gradient(circle at 17% 15%, rgba(255, 255, 255, 0.24), transparent 12rem),
      linear-gradient(145deg, #0f7773 0%, #1aa5a0 45%, #138a86 75%, #0d6a67 100%);
    box-shadow: 0 28px 74px rgba(35, 156, 150, 0.19);
  }

  .guide-hero-card-mark {
    position: absolute;
    top: 24px;
    right: 28px;
    color: rgba(255, 255, 255, 0.12);
    font-size: clamp(5rem, 8vw, 8.2rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.11em;
  }

  .guide-hero-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(31px, 4vw, 48px);
  }

  .guide-hero-card-content > p:first-child {
    margin: 0 0 auto;
    color: rgba(255, 255, 255, 0.70);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .guide-hero-card h2 {
    margin: 88px 0 0;
    color: #ffffff;
    font-size: clamp(2rem, 3vw, 3.25rem);
    font-weight: 780;
    line-height: 1;
    letter-spacing: -0.07em;
  }

  .guide-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 27px;
  }

  .guide-hero-stats > div {
    padding: 14px 11px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.09);
  }

  .guide-hero-stats strong {
    display: block;
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 850;
  }

  .guide-hero-stats span {
    display: block;
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.65rem;
    line-height: 1.35;
  }

  .guide-proof-section {
    border-top: 1px solid rgba(183, 101, 118, 0.10);
    border-bottom: 1px solid rgba(183, 101, 118, 0.10);
    background: rgba(255, 255, 255, 0.74);
  }

  .guide-proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .guide-proof-grid > div {
    min-height: 108px;
    padding: 23px 21px;
    border-right: 1px solid rgba(183, 101, 118, 0.12);
  }

  .guide-proof-grid > div:last-child {
    border-right: 0;
  }

