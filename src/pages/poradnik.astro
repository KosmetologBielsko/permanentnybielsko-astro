  .guide-final-card > p:not(.signature) {
    margin-inline: auto;
  }

  .guide-final-actions {
    max-width: 900px;
    margin-inline: auto;
  }

  @media (hover: hover) {
    .guide-article-card:hover,
    .guide-service-card:hover {
      transform: translateY(-2px);
      border-color: rgba(56, 187, 181, 0.25);
      box-shadow: 0 21px 58px rgba(89, 53, 67, 0.09);
    }
  }

  @media (max-width: 1080px) {
    .guide-filter-panel {
      position: sticky;
      top: 164px;
      z-index: 20;
    }

    .guide-filter-panel::before,
    .guide-filter-panel::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 38px;
      pointer-events: none;
      z-index: 3;
      transition: opacity 0.18s ease;
    }

    .guide-filter-panel::before {
      left: 0;
      opacity: 0;
      background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    .guide-filter-panel::after {
      right: 0;
      opacity: 1;
      background:
        linear-gradient(
          270deg,
          rgba(255, 255, 255, 0.98) 0%,
          rgba(255, 255, 255, 0) 100%
        );
    }

    .guide-filter-panel.is-scrolled::before {
      opacity: 1;
    }

    .guide-filter-panel.is-at-end::after {
      opacity: 0;
    }

    .guide-search-card {
      position: sticky;
      top: 78px;
      z-index: 21;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 16px 44px rgba(89, 53, 67, 0.09);
    }
    .guide-hero-grid,
    .guide-expert-panel {
      grid-template-columns: 1fr;
    }


    .guide-library-layout {
      grid-template-columns: 1fr;
    }

    .guide-filter-panel {
      overflow: hidden;
    }

    .guide-filter-panel > p,
    .guide-filter-help {
      display: none;
    }

    .guide-filter-list {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding: 2px 1px 7px;
      scrollbar-width: none;
    }

    .guide-filter-list::-webkit-scrollbar {
      display: none;
    }

    .guide-filter-button {
      min-height: 42px;
      flex: 0 0 auto;
      grid-template-columns: auto auto;
      padding-inline: 12px 8px;
      border-color: rgba(56, 187, 181, 0.12);
      background: rgba(255, 255, 255, 0.82);
      white-space: nowrap;
    }

    .guide-service-grid,
    .guide-proof-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .guide-search-card {
      top: 68px;
      margin-inline: -4px;
      padding: 10px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.93);
    }

    .guide-search-label,
    .guide-search-presets {
      display: none;
    }

    .guide-search-box {
      min-height: 50px;
      border-radius: 15px;
    }

    .guide-filter-panel {
      top: 130px;
      margin-inline: -4px;
      padding: 8px 32px 8px 8px;
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 12px 34px rgba(89, 53, 67, 0.075);
    }

    .guide-filter-panel::after {
      width: 54px;
      background:
        linear-gradient(
          270deg,
          rgba(255, 255, 255, 0.99) 0%,
          rgba(255, 255, 255, 0.88) 35%,
          rgba(255, 255, 255, 0) 100%
        );
    }

    .guide-filter-panel:not(.is-at-end)::after {
      content: "→";
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 8px;
      color: var(--color-turquoise-dark, #0f7773);
      font-size: 0.9rem;
      font-weight: 900;
    }

    .guide-filter-list {
      padding-right: 20px;
      scroll-padding-inline: 12px 42px;
      scroll-snap-type: x proximity;
    }

    .guide-filter-button {
      scroll-snap-align: center;
    }
    .guide-page .section-kicker {
      min-height: 29px;
      margin-bottom: 14px;
      padding-inline: 10px;
      font-size: 0.61rem;
      letter-spacing: 0.12em;
    }

    .guide-hero {
      padding: 112px 0 44px;
    }

    .guide-hero-grid {
      gap: 12px;
    }

    .guide-hero-copy,
    .guide-hero-card,
    .guide-search-card,
    .guide-filter-panel,
    .guide-article-card,
    .guide-expert-panel,
    .guide-service-card,
    .guide-final-card {
      border-radius: 25px;
    }

    .guide-hero-copy {
      padding: 24px 20px;
    }

    .guide-hero-copy h1 {
      font-size: clamp(2.24rem, 10.1vw, 3.25rem);
