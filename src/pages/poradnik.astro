    padding-top: 19px;
    color: var(--color-turquoise-dark, #0f7773);
    font-size: 0.73rem;
    font-weight: 850;
  }

  .guide-faq-list {
    display: grid;
    max-width: 980px;
    gap: 9px;
  }

  .guide-faq-item {
    overflow: hidden;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.90);
  }

  .guide-faq-item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 38px;
    gap: 13px;
    align-items: center;
    padding: 18px 20px;
    color: var(--color-text, #17151d);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    font-weight: 760;
    line-height: 1.34;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .guide-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .guide-faq-icon {
    position: relative;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(56, 187, 181, 0.17);
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.58);
  }

  .guide-faq-icon::before,
  .guide-faq-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-turquoise-dark, #0f7773);
    transform: translate(-50%, -50%);
  }

  .guide-faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .guide-faq-item[open] .guide-faq-icon::after {
    opacity: 0;
  }

  .guide-faq-item > div {
    padding: 0 20px 18px;
  }

  .guide-faq-item p {
    margin: 0;
    color: var(--color-muted, #6e6670);
    font-size: 0.92rem;
    line-height: 1.62;
