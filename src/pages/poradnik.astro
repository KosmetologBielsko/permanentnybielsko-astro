  .guide-service-card > p {
    width: fit-content;
    margin: 0 0 12px;
    padding: 6px 9px;
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.62);
    color: var(--color-turquoise-dark, #0f7773);
