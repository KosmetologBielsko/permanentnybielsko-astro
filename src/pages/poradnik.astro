    box-shadow: 0 10px 26px rgba(15, 143, 120, 0.16);
  }

  .guide-filter-button.is-active strong {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  .guide-filter-help {
    margin-top: 15px;
    padding: 15px;
    border-radius: 17px;
    background: rgba(255, 248, 251, 0.80);
  }

  .guide-filter-help strong {
