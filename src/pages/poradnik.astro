<script>
  const normalizeGuideText = (value) =>
    String(value || "")
      .toLocaleLowerCase("pl")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();

  const searchInput = document.querySelector("#guideSearchInput");
  const clearButton = document.querySelector("#guideSearchClear");
  const resetButton = document.querySelector("#guideResetFilters");
  const emptyReset = document.querySelector("#guideEmptyReset");
  const resultCount = document.querySelector("#guideResultCount");
  const activeLabel = document.querySelector("#guideActiveLabel");
  const emptyState = document.querySelector("#guideEmptyState");
  const articleGrid = document.querySelector("#guideArticleGrid");

  const articleCards = Array.from(document.querySelectorAll("[data-article-card]"));
  const filterButtons = Array.from(document.querySelectorAll("[data-guide-filter]"));
  const searchPresets = Array.from(document.querySelectorAll("[data-search-preset]"));

  let activeFilter = "all";

  const getActiveFilterLabel = () => {
    const button = filterButtons.find(
      (item) => item.getAttribute("data-guide-filter") === activeFilter
    );

    return button?.querySelector("span")?.textContent?.trim() || "Wszystkie poradniki";
  };

  const applyGuideFilters = () => {
    const query = normalizeGuideText(searchInput?.value || "");
    let visible = 0;

    articleCards.forEach((card) => {
      const groups = String(card.getAttribute("data-groups") || "").split(" ");
      const haystack = normalizeGuideText(card.getAttribute("data-search") || "");
      const matchesFilter = activeFilter === "all" || groups.includes(activeFilter);
      const matchesSearch = !query || haystack.includes(query);
      const show = matchesFilter && matchesSearch;

      card.hidden = !show;
      if (show) visible += 1;
    });

    if (resultCount) resultCount.textContent = String(visible);

    if (activeLabel) {
      const filterText = getActiveFilterLabel();
      activeLabel.textContent = query
        ? `${filterText} · wyniki dla „${searchInput.value.trim()}”`
        : filterText;
    }

    if (emptyState) emptyState.hidden = visible !== 0;
    if (articleGrid) articleGrid.hidden = visible === 0;
  };

  const filterPanel = document.querySelector(".guide-filter-panel");
  const filterTrack = document.querySelector(".guide-filter-list");

  const updateFilterScrollState = () => {
    if (!filterPanel || !filterTrack) return;

    const maxScroll = Math.max(0, filterTrack.scrollWidth - filterTrack.clientWidth);
    const current = filterTrack.scrollLeft;

    filterPanel.classList.toggle("is-scrolled", current > 8);
    filterPanel.classList.toggle("is-at-end", maxScroll - current < 10);
  };

  const centerSelectedFilter = (button) => {
    if (!button) return;

    button.scrollIntoView({
      behavior: "smooth",
      block: "nearest",
      inline: "center",
    });
  };

  const setFilter = (filter) => {
    activeFilter = filter || "all";
    let selectedButton = null;

    filterButtons.forEach((button) => {
      const selected = button.getAttribute("data-guide-filter") === activeFilter;
      button.classList.toggle("is-active", selected);
      button.setAttribute("aria-pressed", selected ? "true" : "false");

      if (selected) selectedButton = button;
    });

    centerSelectedFilter(selectedButton);
    applyGuideFilters();

    window.setTimeout(updateFilterScrollState, 220);
  };

  const resetGuide = () => {
    activeFilter = "all";
    if (searchInput) searchInput.value = "";
    setFilter("all");
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setFilter(button.getAttribute("data-guide-filter") || "all");
    });
  });


  searchPresets.forEach((button) => {
    button.addEventListener("click", () => {
      if (!searchInput) return;
      searchInput.value = button.getAttribute("data-search-preset") || "";
      setFilter("all");
      searchInput.focus();
      document.querySelector("#biblioteka-pmu")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  searchInput?.addEventListener("input", applyGuideFilters);

  clearButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }
    applyGuideFilters();
  });

  resetButton?.addEventListener("click", resetGuide);
  emptyReset?.addEventListener("click", resetGuide);

  filterTrack?.addEventListener("scroll", updateFilterScrollState, { passive: true });
  window.addEventListener("resize", updateFilterScrollState, { passive: true });

  updateFilterScrollState();
  applyGuideFilters();
</script>

