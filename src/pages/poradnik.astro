    href: "/usuwanie-makijazu-permanentnego/"

  }

];

const faqItems = [

  {

    question: "Od którego poradnika najlepiej zacząć?",

    answer: "Jeśli planujesz pierwszy zabieg, zacznij od ceny, przygotowania do makijażu permanentnego brwi albo wyboru metody. Jeśli jesteś po zabiegu, wybierz temat o gojeniu albo pielęgnacji. Przy starym lub nieudanym PMU zacznij od tekstu o korekcie, odświeżeniu albo rozjaśnianiu pigmentu."

  },

  {

    question: "Czy poradnik dotyczy tylko brwi permanentnych?",

    answer: "Nie. Poradnik obejmuje ceny, brwi, usta, kreski, gojenie, pielęgnację po zabiegu, opryszczkę, metody brwi, usuwanie starego PMU oraz szkolenia PMU."

  },

  {

    question: "Czy makijaż permanentny może wyglądać naturalnie?",

    answer: "Tak, ale naturalny efekt zależy od skóry, rysunku wstępnego, techniki, pigmentu, doświadczenia linergistki i tego, jak efekt wygoi się po zabiegu."

  },

  {

    question: "Gdzie sprawdzić ceny makijażu permanentnego?",

    answer: "Najważniejsze ceny znajdziesz w cenniku PMU oraz w poradnikach cenowych dotyczących brwi, kresek, odświeżenia i szkoleń PMU. Przy starym lub nieudanym makijażu permanentnym wycena może wymagać konsultacji."

  },

  {

    question: "Co zrobić, jeśli mam stary makijaż permanentny?",

    answer: "Nie zawsze warto od razu przykrywać stary pigment. Przy zbyt ciemnym, chłodnym lub nierównym PMU bezpieczniejszym pierwszym krokiem może być rozjaśnianie laserem albo removerem."

  }

];

const structuredData = [

  {

    "@context": "https://schema.org",

    "@type": "CollectionPage",

    "@id": `${pageUrl}#collection`,

    url: pageUrl,

    name: pageTitle,

    description: pageDescription,

    inLanguage: "pl-PL",

    isPartOf: { "@id": "https://www.permanentnybielsko.com/#website" },

    about: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },

  },

  {

    "@context": "https://schema.org",

    "@type": "BreadcrumbList",

    "@id": `${pageUrl}#breadcrumb`,

    itemListElement: [

      {

        "@type": "ListItem",

        position: 1,

        name: "Strona główna",

        item: "https://www.permanentnybielsko.com/",

      },

      {

        "@type": "ListItem",

        position: 2,

        name: "Poradnik PMU",

        item: pageUrl,

      },

    ],

  },

  {

    "@context": "https://schema.org",

    "@type": "ItemList",

    "@id": `${pageUrl}#articles`,

    name: "Poradniki PMU Bogusława Herda",

    itemListElement: articleCards.map((item, index) => ({

      "@type": "ListItem",

      position: index + 1,

      name: item.title,

      url: `https://www.permanentnybielsko.com${item.href}`,

    })),

  },

  {

    "@context": "https://schema.org",

    "@type": "FAQPage",

    "@id": `${pageUrl}#faq`,

    mainEntity: faqItems.map((item) => ({

      "@type": "Question",

      name: item.question,

      acceptedAnswer: {

        "@type": "Answer",

        text: item.answer,

      },

    })),

  },

];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/poradnik/"
  structuredData={structuredData}
>
  <div class="guide-page">
    <Header />

    <main>
      <section class="guide-hero">
        <div class="guide-glow guide-glow-one" aria-hidden="true"></div>
        <div class="guide-glow guide-glow-two" aria-hidden="true"></div>

        <div class="container guide-hero-grid">
          <div class="guide-hero-copy">
            <p class="section-kicker">Poradnik PMU</p>

            <h1>
              <span class="guide-turquoise-text">Wiedza o makijażu permanentnym</span>
              bez chaosu i przypadkowych odpowiedzi.
            </h1>

            <p class="guide-hero-lead">
              Brwi, usta, kreski, ceny, przygotowanie, gojenie, pielęgnacja
              i stare PMU. Wybierz temat odpowiadający Twojej sytuacji i przejdź
              od pytania do konkretnej decyzji.
            </p>

            <div class="guide-hero-actions" aria-label="Najważniejsze działania w poradniku">
              <a class="button-primary" href="#tematy-pmu">
                Wybierz temat <span aria-hidden="true">→</span>
              </a>

              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>
          </div>

          <aside class="guide-hero-card" aria-label="Centrum wiedzy o PMU">
            <p class="guide-card-label">PMU</p>
            <h2>Najpierw zrozum zabieg. Potem podejmij decyzję.</h2>
            <p>
              Poradnik łączy praktyczne odpowiedzi z właściwymi usługami:
              od pierwszego zabiegu po gojenie, korektę i usuwanie starego pigmentu.
            </p>
          </aside>
        </div>
      </section>

      <section class="guide-proof-section" aria-label="Zakres poradnika PMU">
        <div class="container guide-proof-grid">
          <div>
            <strong>{articleCards.length} poradników</strong>
            <span>w jednym centrum wiedzy</span>
          </div>

          <div>
            <strong>Brwi · Usta · Kreski</strong>
            <span>najważniejsze zabiegi PMU</span>
          </div>

          <div>
            <strong>Gojenie i pielęgnacja</strong>
            <span>praktyczne odpowiedzi po zabiegu</span>
          </div>

          <div>
            <strong>Korekta i usuwanie</strong>
            <span>gdy starego PMU nie warto przykrywać</span>
          </div>
        </div>
      </section>

      <section class="guide-start-section">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Od czego zacząć?</p>
            <h2>Wybierz sytuację, która jest najbliższa temu, czego teraz szukasz.</h2>
          </div>

          <div class="guide-start-grid">
            {situationCards.map((item, index) => {
              const targets = ["#przed-zabiegiem", "#gojenie", "#korekta", "#kreski"];

              return (
                <a class="guide-start-card" href={targets[index]}>
                  <span>{item.number}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <strong>Przejdź dalej →</strong>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="guide-quick-section" id="tematy-pmu">
        <div class="container guide-quick-card">
          <div>
            <p class="section-kicker">Szybki wybór</p>
            <h2>Przejdź bezpośrednio do interesującego Cię tematu.</h2>
          </div>

          <nav class="guide-topic-strip" aria-label="Kategorie poradnika PMU">
            {categorySections.map((section) => (
              <a href={`#${section.id}`}>{section.label}</a>
            ))}
          </nav>
        </div>
      </section>

      <section class="guide-featured-section">
        <div class="container">
          <div class="guide-featured-heading">
            <div class="guide-section-heading">
              <p class="section-kicker">Najczęściej wybierane</p>
              <h2>Tematy, od których najczęściej zaczyna się decyzja o PMU.</h2>
            </div>

            <div class="guide-slider-controls">
              <button
                type="button"
                class="guide-slider-button guide-featured-prev"
                aria-label="Poprzednie polecane poradniki"
              >
                ←
              </button>
              <button
                type="button"
                class="guide-slider-button guide-featured-next"
                aria-label="Następne polecane poradniki"
              >
                →
              </button>
            </div>
          </div>

          <div class="guide-featured-row" id="guideFeaturedRow">
            {articleCards
              .filter((article) => article.featured)
              .slice(0, 10)
              .map((article) => (
                <a class="guide-article-card guide-article-card--strong" href={article.href}>
                  <span class="guide-article-number">{article.number}</span>
                  <p class="guide-article-category">{article.category}</p>
                  <h3>{article.title}</h3>
                  <p>{article.text}</p>
                  <strong>Czytaj poradnik →</strong>
                </a>
              ))}
          </div>
        </div>
      </section>

      <section class="guide-articles-section" id="poradniki-pmu">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Wszystkie tematy</p>
            <h2>Poradnik uporządkowany według realnych pytań przed i po zabiegu.</h2>
            <p>
              Każda kategoria ma osobny poziomy przegląd. Na telefonie przesuwaj
              karty palcem; strzałki pozwalają szybko przejść dalej.
            </p>
          </div>

          <div class="guide-topic-list">
            {articlesByCategory.map((section) => (
              <section class="guide-topic-block" id={section.id} data-guide-slider>
                <div class="guide-topic-heading">
                  <div>
                    <p class="guide-topic-label">{section.label}</p>
                    <h3>{section.title}</h3>
                    <p>{section.text}</p>
                  </div>

                  <div class="guide-slider-controls">
                    <button
                      type="button"
                      class="guide-slider-button"
                      data-slider-prev
                      aria-label={`Poprzednie poradniki: ${section.label}`}
                    >
                      ←
                    </button>

                    <button
                      type="button"
                      class="guide-slider-button"
                      data-slider-next
                      aria-label={`Następne poradniki: ${section.label}`}
                    >
                      →
                    </button>
                  </div>
                </div>

                <div class="guide-article-row" data-slider-track>
                  {section.articles.map((article) => (
                    <a
                      class:list={[
                        "guide-article-card",
                        article.featured && "guide-article-card--accent",
                      ]}
                      href={article.href}
                    >
                      <span class="guide-article-number">{article.number}</span>
                      <p class="guide-article-category">{article.category}</p>
                      <h3>{article.title}</h3>
                      <p>{article.text}</p>
                      <strong>Czytaj poradnik →</strong>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-services-section">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Od wiedzy do zabiegu</p>
            <h2>Masz już odpowiedź? Zobacz konkretną usługę, efekty i ceny.</h2>
            <p>
              Poradnik ma pomagać zrozumieć temat. Podstrony usługowe pokazują
              efekty, przebieg zabiegu, kwalifikację i aktualny cennik.
            </p>
          </div>

          <div class="guide-service-grid">
            {categoryCards.map((item) => (
              <a class="guide-service-card" href={item.href}>
                <span>{item.number}</span>
                <p>{item.label}</p>
                <h3>{item.title}</h3>
                <em>{item.text}</em>
                <strong>Zobacz usługę →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-faq-section">
        <div class="container">
          <div class="guide-section-heading">
            <p class="section-kicker">Najczęstsze pytania</p>
            <h2>Jak korzystać z poradnika PMU?</h2>
          </div>

          <div class="guide-faq-list">
            {faqItems.map((item) => (
              <details class="guide-faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="guide-faq-icon" aria-hidden="true"></span>
                </summary>
                <div>
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="guide-final-cta">
        <div class="container guide-final-card">
          <p class="signature cta-signature">Powrót do natury</p>
          <h2>Masz już wiedzę. Teraz wybierz następny krok.</h2>
          <p>
            Sprawdź terminy, ceny albo przejdź do formularza kwalifikacji,
            jeśli masz stare PMU lub nie wiesz, który zabieg będzie właściwy.
          </p>

          <div class="guide-final-actions">
            <a
              class="button-booksy"
              href={booksyUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Booksy <span aria-hidden="true">→</span>
            </a>

            <a
              class="button-primary"
              href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu"
            >
              Formularz PMU <span aria-hidden="true">→</span>
            </a>

            <a class="button-secondary" href="/cennik-makijaz-permanentny/">
              Cennik
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .guide-page {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 78% 11%, rgba(56, 187, 181, 0.10), transparent 28rem),
      radial-gradient(circle at 12% 42%, rgba(201, 127, 143, 0.10), transparent 26rem),
      linear-gradient(180deg, #fffdfd 0%, #fff8fa 52%, #ffffff 100%);
  }

  .guide-page *,
  .guide-page *::before,
  .guide-page *::after {
    box-sizing: border-box;
  }

  .guide-page main,
  .guide-page section,
  .guide-page .container,
  .guide-page div,
  .guide-page nav {
    min-width: 0;
  }

  .guide-page .section-kicker {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    margin: 0 0 18px;
    padding: 0 13px;
    border: 1px solid rgba(56, 187, 181, 0.16);
    border-radius: 999px;
    background: rgba(219, 246, 243, 0.72);
    color: var(--color-turquoise-dark, #0f7773);
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .guide-hero {
    position: relative;
    overflow: hidden;
    padding: 146px 0 78px;
  }

  .guide-glow {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .guide-glow-one {
    top: 3rem;
    right: -13rem;
    width: 42rem;
    height: 42rem;
    background: radial-gradient(circle, rgba(56, 187, 181, 0.18), transparent 68%);
  }

  .guide-glow-two {
    left: -11rem;
    bottom: -14rem;
    width: 38rem;
    height: 38rem;
    background: radial-gradient(circle, rgba(201, 127, 143, 0.16), transparent 68%);
  }

  .guide-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: 24px;
    align-items: stretch;
  }

  .guide-hero-copy,
  .guide-hero-card,
  .guide-start-card,
  .guide-quick-card,
  .guide-topic-block,
  .guide-article-card,
  .guide-service-card,
  .guide-faq-item,
  .guide-final-card {
    border: 1px solid rgba(183, 101, 118, 0.14);
    box-shadow: 0 18px 54px rgba(89, 53, 67, 0.07);
  }

  .guide-hero-copy {
    padding: clamp(38px, 5vw, 68px);
    border-radius: 40px;
    background: rgba(255, 255, 255, 0.82);
  }

  .guide-hero-copy h1 {
    max-width: 1040px;
    margin: 0;
    color: var(--color-text, #17151d);
    font-family: inherit;
    font-size: clamp(3rem, 5.2vw, 6.1rem);
    font-weight: 770;
    line-height: 0.99;
    letter-spacing: -0.076em;
  }

  .guide-turquoise-text {
    background:
      linear-gradient(
        120deg,
        #0d6a67 0%,
        #0f7773 24%,
        #1aa5a0 48%,
        #63d7cf 72%,
        #0d6a67 100%
      );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .guide-hero-lead {
    max-width: 780px;
    margin: 26px 0 0;
    color: var(--color-muted, #6e6670);
    font-family: inherit;
    font-size: clamp(1.02rem, 1.25vw, 1.12rem);
    line-height: 1.68;
  }

  .guide-hero-actions,
  .guide-final-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin-top: 30px;
  }

  .guide-hero-actions > a,
  .guide-final-actions > a {
    display: inline-flex;
    width: 100%;
    min-width: 0;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 18px;
    border-radius: 999px;
    font-family: inherit !important;
    font-size: 0.98rem !important;
    font-weight: 820 !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    text-align: center;
    text-transform: none !important;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }

  .button-booksy {
    border: 1px solid rgba(8, 111, 91, 0.16);
    background:
      linear-gradient(135deg, #18a889 0%, #0f8f78 55%, #0b7868 100%);
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(15, 143, 120, 0.16);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .button-booksy:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 42px rgba(15, 143, 120, 0.22);
  }

  .guide-hero-card {
    position: relative;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: clamp(34px, 4vw, 52px);
    border-radius: 40px;
    color: #ffffff;
    background:
      radial-gradient(circle at 18% 16%, rgba(255, 255, 255, 0.30), transparent 12rem),
      radial-gradient(circle at 84% 20%, rgba(218, 255, 251, 0.20), transparent 13rem),
      linear-gradient(145deg, #0f7773 0%, #1aa5a0 38%, #63d7cf 67%, #0d6a67 100%);
    box-shadow: 0 28px 76px rgba(35, 156, 150, 0.20);
  }

  .guide-card-label {
    position: absolute;
    top: 32px;
    left: 38px;
    margin: 0;
    color: rgba(255, 255, 255, 0.19);
    font-family: inherit;
    font-size: clamp(4.8rem, 7.4vw, 8rem);
    font-weight: 850;
    line-height: 0.8;
    letter-spacing: -0.1em;
  }

  .guide-hero-card h2 {
    margin: 116px 0 0;
    color: #ffffff;
    font-family: inherit;
    font-size: clamp(2rem, 3vw, 3.15rem);
    font-weight: 770;
    line-height: 1;
    letter-spacing: -0.068em;
  }

  .guide-hero-card > p:not(.guide-card-label) {
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.90);
    font-size: 1rem;
    line-height: 1.64;
  }

  .guide-proof-section {
    border-top: 1px solid rgba(183, 101, 118, 0.10);
    border-bottom: 1px solid rgba(183, 101, 118, 0.10);
    background: rgba(255, 255, 255, 0.74);
  }

  .guide-proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .guide-proof-grid > div {
    min-height: 112px;
    padding: 24px 22px;
    border-right: 1px solid rgba(183, 101, 118, 0.12);
  }

  .guide-proof-grid > div:last-child {
    border-right: 0;
  }

  .guide-proof-grid strong {
    display: block;
    margin-bottom: 7px;
    color: var(--color-text, #17151d);
    font-family: inherit;
    font-size: 0.94rem;
    font-weight: 790;
  }

  .guide-proof-grid span {
    display: block;
    color: var(--color-muted, #6e6670);
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .guide-start-section,
  .guide-quick-section,
  .guide-featured-section,
  .guide-articles-section,
  .guide-services-section,
  .guide-faq-section,
  .guide-final-cta {
    padding: 82px 0;
  }

  .guide-section-heading {
    max-width: 1000px;
    margin-bottom: 34px;
  }

  .guide-section-heading h2,
  .guide-quick-card h2,
  .guide-final-card h2 {
    margin: 0;
    color: var(--color-text, #17151d);
    font-family: inherit;
    font-size: clamp(2.35rem, 4vw, 4.25rem);
    font-weight: 760;
    line-height: 1.02;
    letter-spacing: -0.072em;
  }

  .guide-section-heading > p:not(.section-kicker),
  .guide-final-card > p:not(.signature) {
    max-width: 840px;
    margin: 18px 0 0;
    color: var(--color-muted, #6e6670);
    font-size: clamp(0.98rem, 1.15vw, 1.06rem);
    line-height: 1.7;
  }

  .guide-start-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .guide-start-card {
    min-height: 270px;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: 28px;
    color: inherit;
    text-decoration: none;
    background:
      radial-gradient(circle at 94% 12%, rgba(56, 187, 181, 0.08), transparent 12rem),
      rgba(255, 255, 255, 0.88);
  }

  .guide-start-card > span,
  .guide-article-number,
  .guide-service-card > span {
    display: block;
    margin-bottom: 34px;
    color: var(--color-turquoise-dark, #0f7773);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.18em;
