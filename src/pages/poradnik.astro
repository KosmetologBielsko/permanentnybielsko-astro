<script>
  const bindGuideSlider = (
    root: HTMLElement,
    trackSelector: string,
    previousSelector: string,
    nextSelector: string
  ) => {
    const track = root.querySelector<HTMLElement>(trackSelector);
    const previous = root.querySelector<HTMLButtonElement>(previousSelector);
    const next = root.querySelector<HTMLButtonElement>(nextSelector);

    if (!track || !previous || !next) return;

    const getAmount = () => {
      const firstCard = track.querySelector<HTMLElement>(".guide-article-card");
      if (!firstCard) return Math.min(track.clientWidth * 0.86, 760);
      return firstCard.getBoundingClientRect().width + 14;
    };

    previous.addEventListener("click", () => {
      track.scrollBy({ left: -getAmount(), behavior: "smooth" });
    });

    next.addEventListener("click", () => {
      track.scrollBy({ left: getAmount(), behavior: "smooth" });
    });
  };

  document.querySelectorAll<HTMLElement>("[data-guide-slider]").forEach((section) => {
    bindGuideSlider(
      section,
      "[data-slider-track]",
      "[data-slider-prev]",
      "[data-slider-next]"
    );
  });

  const featuredRow = document.querySelector<HTMLElement>("#guideFeaturedRow");
  const featuredPrev = document.querySelector<HTMLButtonElement>(".guide-featured-prev");
  const featuredNext = document.querySelector<HTMLButtonElement>(".guide-featured-next");

  if (featuredRow && featuredPrev && featuredNext) {
    const featuredRoot = featuredRow.parentElement;

    if (featuredRoot) {
      bindGuideSlider(
        featuredRoot,
        "#guideFeaturedRow",
        ".guide-featured-prev",
        ".guide-featured-next"
      );
    }
  }
</script>
