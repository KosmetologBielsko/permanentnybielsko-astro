    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 11px;
  }

  .guide-service-card {
    min-height: 285px;
    display: flex;
    flex-direction: column;
    padding: 23px;
    border-radius: 25px;
    color: inherit;
    text-decoration: none;
    background:
      radial-gradient(circle at 94% 10%, rgba(56, 187, 181, 0.07), transparent 11rem),
      rgba(255, 255, 255, 0.91);
  }

  .guide-service-card > span {
    margin-bottom: 29px;
    color: var(--color-turquoise-dark, #0f7773);
    font-size: 0.66rem;
    font-weight: 850;
