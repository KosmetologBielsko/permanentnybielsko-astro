---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideSeriesByline from "../components/GuideSeriesByline.astro";
import GuideHubCard from "../components/GuideHubCard.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { articleCards } from "../data/guide-catalog";
import { guideMedia as media01, type GuideMedia } from "../data/guide-series-01";
import { guideMedia as media04 } from "../data/guide-series-04";
import { guideMedia as media05 } from "../data/guide-series-05";
import pilotCover from "../assets/poradnik/kreska-cena-okladka-ai.png";
import browsPhoto from "../assets/poradnik/seria-01/brwi-wlos-detal.webp";
import lipsPhoto from "../assets/poradnik/seria-01/usta-roz-detal.webp";
import eyePhoto from "../assets/poradnik/seria-01/kreska-subtelna.webp";
import "../styles/guide-hub.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pageUrl = "https://www.permanentnybielsko.com/poradnik/";
const pageTitle = "Poradnik makijażu permanentnego | Brwi, usta, kreski Bielsko-Biała";
const pageDescription = "Ekspercki poradnik PMU Bogusławy Herda: brwi, usta, kreski, gojenie, pielęgnacja, skóra, bezpieczeństwo, ceny, korekty i usuwanie makijażu permanentnego.";
const media: Record<string, GuideMedia> = { ...media01, ...media04, ...media05,
  "kreska-permanentna-cena": { cover: { src: pilotCover, alt: "Ilustracja delikatnego podkreślenia górnej linii rzęs", caption: "Ilustracja poradnika", kind: "illustration" }, photos: [], label: "Kreski permanentne" }
};
for (const article of articleCards) {
  if (!media[article.slug]?.cover) throw new Error(`Brak miniatury dla ${article.slug}`);
}
const topics = [
  { id: "brwi", label: "Brwi", detail: "Metody, kształt i naturalny efekt", image: browsPhoto, alt: "Detal brwi z galerii gabinetu", position: "centre" },
  { id: "usta", label: "Usta", detail: "Kolor, kontur i pielęgnacja", image: lipsPhoto, alt: "Różowy kolor ust z galerii gabinetu", position: "centre" },
  { id: "kreski", label: "Kreski", detail: "Rodzaje i dobór do oka", image: eyePhoto, alt: "Górna kreska z galerii gabinetu", position: "centre" }
];
const filterDefinitions = [
  { id: "all", label: "Wszystkie" },
  { id: "brwi", label: "Brwi" },
  { id: "usta", label: "Usta" },
  { id: "kreski", label: "Kreski" },
  { id: "gojenie", label: "Gojenie" },
  { id: "ceny", label: "Ceny" },
  { id: "przed", label: "Przed zabiegiem" },
  { id: "korekta", label: "Korekta i usuwanie" },
  { id: "bezpieczenstwo", label: "Skóra i bezpieczeństwo" },
  { id: "lokalne", label: "Gabinet w Bielsku-Białej" },
  { id: "szkolenia", label: "Szkolenia" }
];
const filters = filterDefinitions.map(filter => ({ ...filter,
  count: filter.id === "all" ? articleCards.length : articleCards.filter(article => article.groups.includes(filter.id)).length
}));
const serviceCards = [
  {
    "label": "Brwi",
    "title": "Makijaż permanentny brwi",
    "text": "Metoda włoskowa, cieniowanie, Silky Hairstroke Brows i kwalifikacja skóry.",
    "href": "/makijaz-permanentny-brwi/"
  },
  {
    "label": "Usta",
    "title": "Makijaż permanentny ust",
    "text": "Naturalny kolor, miękki kontur i plan pigmentacji czerwieni wargowej.",
    "href": "/makijaz-permanentny-ust/"
  },
  {
    "label": "Kreski",
    "title": "Makijaż permanentny oczu",
    "text": "Zagęszczenie linii rzęs, kreski i dopasowanie projektu do budowy oka.",
    "href": "/makijaz-permanentny-oczu/"
  },
  {
    "label": "Stare PMU",
    "title": "Usuwanie i rozjaśnianie",
    "text": "Laser, remover i etapowy plan przy zbyt mocnym lub niekorzystnym pigmencie.",
    "href": "/usuwanie-makijazu-permanentnego/"
  }
];
const faqItems = [
  {
    "question": "Jak najszybciej znaleźć odpowiedź w poradniku?",
    "answer": "Użyj wyszukiwarki i wpisz naturalnie to, czego szukasz — np. „opryszczka”, „botoks”, „ciemne brwi”, „mycie”, „cena” albo „stary pigment”. Możesz też zawęzić wyniki przyciskami kategorii."
  },
  {
    "question": "Czy poradnik obejmuje tylko brwi permanentne?",
    "answer": `Nie. Biblioteka obejmuje ${articleCards.length} poradników o brwiach, ustach, kreskach, przygotowaniu, bólu i komforcie, gojeniu, pielęgnacji, skórze, bezpieczeństwie, zabiegach łączonych, korektach, usuwaniu, cenach, Bielsku-Białej i szkoleniach PMU.`
  },
  {
    "question": "Od czego zacząć przed pierwszym makijażem permanentnym?",
    "answer": "Najpierw sprawdź przygotowanie do zabiegu, sposób wyboru metody i gabinetu oraz rysunek wstępny. Jeśli stosujesz retinol, miałaś botoks, filler albo planujesz wakacje, znajdziesz również osobne poradniki do tych sytuacji."
  },
  {
    "question": "Gdzie szukać informacji, jeśli jestem już po zabiegu?",
    "answer": "Wybierz kategorię „Gojenie”. Zebrane są tam osobne odpowiedzi dotyczące brwi, ust, kresek, mycia, smarowania, ciemnego koloru, nierównego przyjęcia pigmentu i aktywności fizycznej."
  },
  {
    "question": "Co zrobić przy starym lub nieudanym PMU?",
    "answer": "Przejdź do kategorii „Korekta i usuwanie”. Nie każdy stary pigment powinien być przykrywany kolejną warstwą — poradniki pomagają rozróżnić odświeżenie, korektę, rozjaśnienie i usuwanie."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#collection`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    dateModified: "2026-09-13",
    isPartOf: { "@id": "https://www.permanentnybielsko.com/#website" },
    about: { "@id": "https://www.permanentnybielsko.com/#localbusiness" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Poradnik PMU",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${pageUrl}#articles`,
    name: "Ekspercki poradnik PMU Bogusławy Herda",
    numberOfItems: articleCards.length,
    itemListElement: articleCards.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      url: `https://www.permanentnybielsko.com${item.href}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/poradnik/"
  structuredData={structuredData} showGuideSocial={false} inlineGuideAssistant>
  <a class="hub-skip" href="#biblioteka-pmu">Przejdź do poradników</a>
  <Header compact />
  <main class="pmu-hub" id="poradnik-pmu" data-guide-hub>
    <div class="hub-shell">
      <header class="hub-intro">
        <nav class="hub-breadcrumbs" aria-label="Ścieżka strony">
          <a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Poradnik PMU</span>
        </nav>
        <div class="hub-intro-grid">
          <div class="hub-intro-copy">
            <p class="hub-kicker">Wiedza i praktyka · Bielsko-Biała</p>
            <h1>Poradnik <span class="bph-title-accent">makijażu permanentnego.</span></h1>
            <p class="hub-lead">Brwi, usta, kreski — wybór efektu, gojenie, ceny i stare PMU. Znajdź odpowiedź dla siebie.</p>
            <GuideSeriesByline />
          </div>
          <section class="hub-finder" aria-labelledby="hub-finder-title">
            <p class="hub-kicker">Twoje pytanie</p>
            <h2 id="hub-finder-title">Czego szukasz?</h2>
            <form class="hub-search" role="search" aria-label="Wyszukaj poradnik" data-hub-controls>
              <label for="hub-search-input">Wpisz temat lub pytanie</label>
              <div class="hub-search-field">
                <input disabled id="hub-search-input" type="search" inputmode="search" enterkeyhint="search"
                  placeholder="np. gojenie brwi" maxlength="140" autocomplete="off"
                  aria-controls="hub-entries" aria-describedby="hub-search-help" />
                <button type="button" class="hub-clear" aria-label="Wyczyść wyszukiwanie" data-hub-clear hidden>×</button>
              </div>
              <button disabled class="hub-primary hub-submit" type="submit">Znajdź poradnik <span aria-hidden="true">↓</span></button>
              <p class="hub-search-help" id="hub-search-help">Przeszukaj {articleCards.length} poradników o PMU.</p>
            </form>
            <noscript><style>.pmu-hub [data-hub-controls] { display:none !important; }</style><p>Wszystkie poradniki znajdziesz poniżej.</p><a class="hub-primary" href="#biblioteka-pmu">Zobacz poradniki ↓</a></noscript>
            <div class="hub-presets" aria-label="Przykładowe wyszukiwania" data-hub-controls>
              <span>Na przykład:</span>
              <button disabled type="button" data-hub-preset="gojenie brwi">gojenie brwi</button>
              <button disabled type="button" data-hub-preset="cena kreski">cena kreski</button>
            </div>
          </section>
        </div>
      </header>

      <section class="hub-topics-section" aria-labelledby="hub-topics-title" data-hub-discovery>
        <div class="hub-section-heading hub-topic-heading">
          <h2 id="hub-topics-title">O czym chcesz przeczytać?</h2>
          <span>Brwi · usta · kreski</span>
        </div>
        <div class="hub-topics">
          {topics.map(topic => (
            <a class="hub-topic" href="#biblioteka-pmu" data-hub-topic={topic.id} aria-label={`Zobacz poradniki: ${topic.label}`}>
              <div class="hub-topic-photo">
                <Image src={topic.image} alt={topic.alt} width={600} height={360}
                  widths={[160, 320, 480, 600]} sizes="(max-width: 640px) 30vw, (max-width: 1200px) 30vw, 356px"
                  fit="cover" position={topic.position} format="webp" quality={78} loading="lazy" decoding="async" />
              </div>
              <div class="hub-topic-copy"><h3>{topic.label}</h3><span aria-hidden="true">↗</span><p>{topic.detail}</p></div>
            </a>
          ))}
        </div>
      </section>

      <section class="hub-library" id="biblioteka-pmu" aria-labelledby="hub-library-title">
        <div class="hub-section-heading">
          <div><p class="hub-kicker">Znajdź swoją odpowiedź</p><h2 id="hub-library-title">Wszystkie poradniki</h2></div>
          <a class="hub-back-search" href="#hub-search-input" data-hub-focus-search data-hub-controls>Szukaj po słowie ↑</a>
        </div>
        <div class="hub-filter-area" data-hub-controls>
          <div class="hub-filters" role="group" aria-label="Tematy poradników">
            {filters.slice(0, 6).map(filter => (
              <button disabled type="button" data-hub-filter={filter.id} data-label={filter.label}
                aria-controls="hub-entries" aria-pressed={filter.id === "all" ? "true" : "false"}>
                {filter.label}<span>{filter.count}</span>
              </button>
            ))}
          </div>
          <details class="hub-more-topics">
            <summary>Więcej tematów <span aria-hidden="true">+</span></summary>
            <div class="hub-filters" role="group" aria-label="Dodatkowe tematy">
              {filters.slice(6).map(filter => (
                <button disabled type="button" data-hub-filter={filter.id} data-label={filter.label}
                  aria-controls="hub-entries" aria-pressed="false">{filter.label}<span>{filter.count}</span></button>
              ))}
            </div>
          </details>
        </div>
        <div class="hub-results-line">
          <p role="status" aria-live="polite" aria-atomic="true" data-hub-status>{articleCards.length} poradników</p>
          <button type="button" class="hub-text-button" data-hub-reset hidden>Wyczyść filtry</button>
        </div>
        <div class="hub-entries" id="hub-entries">
          {articleCards.map(article => <GuideHubCard article={article} media={media[article.slug]} />)}
        </div>
        <div class="hub-empty" data-hub-empty hidden>
          <h3>Nie ma jeszcze odpowiedzi na to hasło.</h3>
          <p>Spróbuj krócej: „brwi”, „usta”, „mycie” lub „cena”.</p>
          <button class="hub-secondary" type="button" data-hub-all-topics hidden>Szukaj we wszystkich tematach</button>
          <button class="hub-text-button" type="button" data-hub-empty-reset>Pokaż wszystkie poradniki</button>
          <a href="/kontakt/">Zapytaj gabinet →</a>
        </div>
        <div class="hub-pagination" data-hub-pagination hidden>
          <button type="button" class="hub-secondary" data-hub-more aria-controls="hub-entries">Pokaż kolejne 12 poradników ↓</button>
          <button type="button" class="hub-text-button" data-hub-show-all aria-controls="hub-entries">Pokaż wszystkie</button>
        </div>
      </section>

      <section class="hub-expert" aria-labelledby="hub-expert-title">
        <div>
          <p class="hub-kicker">Praktyka gabinetowa</p>
          <h2 id="hub-expert-title">Wiedza, która pomaga podjąć decyzję.</h2>
          <p>Bogusława Herda dzieli się tu doświadczeniem z pracy w gabinecie i odpowiada na konkretne pytania o makijaż permanentny. W artykułach o skórze i bezpieczeństwie znajdziesz również źródła dermatologiczne i instytucjonalne.</p>
          <a class="hub-inline-link" href="/makijaz-permanentny-bielsko/#boguslawa-herda">O autorce i gabinecie →</a>
        </div>
        <div class="hub-expert-note">
          <span class="hub-kicker">Twój kolejny krok</span>
          <h3>Wolisz porozmawiać o swoim przypadku?</h3>
          <p>Prześlij pytanie do gabinetu lub sprawdź terminy konsultacji.</p>
          <a class="hub-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a>
          <a class="hub-inline-link" href="/kontakt/">Napisz do gabinetu →</a>
        </div>
      </section>

      <section class="hub-services" aria-labelledby="hub-services-title">
        <p class="hub-kicker">Od poradnika do zabiegu</p>
        <h2 id="hub-services-title">Zobacz, jak pracujemy.</h2>
        <div class="hub-service-grid">
          {serviceCards.map(service => <a href={service.href}><h3>{service.label}<span aria-hidden="true">↗</span></h3><p>{service.text}</p></a>)}
        </div>
        <a class="hub-inline-link" href="/cennik-makijaz-permanentny/">Pełny cennik zabiegów →</a>
      </section>

      <section class="hub-faq" id="faq" aria-labelledby="hub-faq-title">
        <p class="hub-kicker">Pytania i odpowiedzi</p>
        <h2 id="hub-faq-title">Jak korzystać z poradnika?</h2>
        {faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
        <GuideAssistant />
      </section>
    </div>
  </main>
  <Footer />
</Layout>
<script>
  import "../scripts/guide-hub";
</script>
