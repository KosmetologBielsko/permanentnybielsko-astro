const pageUrl = "https://www.permanentnybielsko.com/cennik-makijaz-permanentny/";
const pageTitle = "Cennik makijażu permanentnego Bielsko-Biała | Brwi od 1200 zł, usta 1400 zł";
const pageDescription =
  "Makijaż permanentny Bielsko-Biała — cennik: brwi od 1200 zł, usta 1400 zł, kreski od 500 zł, konsultacja 50 zł, usuwanie PMU 200–400 zł. Sprawdź pełne ceny zabiegów.";

const faqItems = [
  {
    question: "Ile kosztują brwi permanentne w Bielsku-Białej?",
    answer:
      "Makijaż permanentny brwi kosztuje od 1200 zł za cieniowanie do 1400 zł za metodę włoskową lub włoski z cieniem. Ceny oznaczone gwiazdką obejmują zabieg główny wraz z korektą do 2 miesięcy od zabiegu głównego."
  },
  {
    question: "Ile kosztuje makijaż permanentny ust w Bielsku-Białej?",
    answer:
      "Makijaż permanentny ust kosztuje 1400 zł. Cena obejmuje zabieg główny wraz z korektą do 2 miesięcy od zabiegu głównego. Pigmentacja ma odświeżyć kolor i kontur ust, a nie je powiększać."
  },
  {
    question: "Ile kosztują kreski permanentne?",
    answer:
      "Cena kresek permanentnych zaczyna się od 500 zł za kreskę dolną. Kreska zagęszczająca kosztuje 800 zł, a eyeliner lub kreska cieniowana 1100 zł. Zakres dobierany jest do budowy oka i oczekiwanego efektu."
  },
  {
    question: "Czy cena makijażu permanentnego obejmuje korektę?",
    answer:
      "Tak. Ceny oznaczone gwiazdką obejmują zabieg główny wraz z korektą do 2 miesięcy od zabiegu głównego. Korekta pozwala dopracować kolor, nasycenie i równowagę efektu po wygojeniu skóry."
  },
  {
    question: "Czy można poprawić makijaż permanentny wykonany w innym gabinecie?",
    answer:
      "Taką pigmentację trzeba najpierw ocenić indywidualnie. Znaczenie mają kolor, nasycenie, kształt, głębokość pracy i kondycja skóry. Czasem przed nowym zabiegiem potrzebne jest rozjaśnienie lub usuwanie."
  }
];

const getOfferPricing = (price: string) => {
  if (price.includes("%") || price.toLowerCase().includes("indywidualna")) {
    return {
      "description": `Cena ustalana indywidualnie: ${price}`
    };
  }

  const values = price
    .match(/\d+(?:[.,]\d+)?/g)
    ?.map((value) => value.replace(",", "."));

  if (!values?.length) {
    return {
      "description": `Cena: ${price}`
    };
  }

  if (values.length >= 2) {
    return {
      "priceSpecification": {
        "@type": "PriceSpecification",
        "minPrice": values[0],
        "maxPrice": values[1],
        "priceCurrency": "PLN"
      }
    };
  }

  return {
    "price": values[0],
    "priceCurrency": "PLN"
  };
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDescription,
    "inLanguage": "pl-PL",
    "dateModified": "2026-09-13",
    "isPartOf": {
      "@id": "https://www.permanentnybielsko.com/#website"
    },
    "about": {
      "@id": "https://www.permanentnybielsko.com/#localbusiness"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Strona główna",
        "item": "https://www.permanentnybielsko.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cennik makijażu permanentnego",
        "item": pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "@id": `${pageUrl}#offer-catalog`,
    "name": "Cennik makijażu permanentnego Bielsko-Biała",
    "url": pageUrl,
    "itemListElement": priceGroups.map((group) => ({
      "@type": "OfferCatalog",
      "name": group.title,
      "description": group.note,
      "itemListElement": group.items.map((item) => ({
        "@type": "Offer",
        "name": item.name,
        ...getOfferPricing(item.price),
        "availability": "https://schema.org/InStock",
        "itemOffered": {
          "@type": "Service",
          "name": item.name,
          "serviceType": group.title,
          "provider": {
            "@id": "https://www.permanentnybielsko.com/#localbusiness"
          },
          "areaServed": {
            "@type": "City",
            "name": "Bielsko-Biała"
          }
        }
      }))
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    "mainEntity": faqItems.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }
];


// Keep the existing anchors: other pages link to price-group-0 … price-group-6.
const groupOrder = [1, 3, 2, 0, 4, 5, 6];
const groupPhotos = { 1: browsPhoto, 3: lipsPhoto, 2: eyesPhoto };
const navLabels = ["Konsultacja", "Brwi", "Kreski", "Usta", "Odświeżenie", "Usuwanie", "Pozostałe"];
const groupHelp = {
  0: { label: "Jak wygląda konsultacja?", href: "/makijaz-permanentny-bielsko/#kwalifikacja-pmu" },
  1: { label: "Porównaj metody brwi", href: "/poradnik/metody-brwi-permanentnych-ombre-pudrowe-wloskowe/" },
  2: { label: "Porównaj rodzaje kresek", href: "/poradnik/kreska-permanentna-jak-wybrac-rodzaj/" },
  3: { label: "Jak wybrać kolor ust?", href: "/poradnik/makijaz-permanentny-ust-jak-wybrac-kolor/" },
  4: { label: "Kiedy odświeżyć makijaż?", href: "/poradnik/odswiezenie-makijazu-permanentnego-cena/" },
  5: { label: "Korekta czy usuwanie?", href: "/poradnik/kiedy-usuwac-stary-makijaz-permanentny/" },
  6: { label: "Poznaj #SercemMalowane", href: "/sercemmalowane/" }
};
const displayName = (name: string) => {
  const short = name.replace("Makijaż permanentny brwi — ", "");
  return short.charAt(0).toUpperCase() + short.slice(1);
};
const summaryPrices = [
  { label: "Brwi", price: `od ${priceGroups[1].items[0].price}`, detail: "Cieniowanie, włoski, włoski + cień", index: 1 },
  { label: "Usta", price: priceGroups[3].items[0].price, detail: "Pigmentacja koloru i konturu", index: 3 },
  { label: "Kreski", price: `od ${priceGroups[2].items[2].price}`, detail: "Dolna, zagęszczająca, dekoracyjna", index: 2 }
];
---

<Layout title={pageTitle} description={pageDescription}
  canonicalPath="/cennik-makijaz-permanentny/" structuredData={structuredData} inlineGuideAssistant>
  <Header compact />
  <a class="pmu-price-skip" href="#cennik-pmu">Przejdź do pełnego cennika</a>
  <main class="pmu-price">
    <div class="pmu-price-shell">
      <nav class="pmu-price-breadcrumbs" aria-label="Okruszki nawigacyjne">
        <a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Cennik PMU</span>
      </nav>
      <section class="pmu-price-intro" aria-labelledby="cennik-tytul">
        <div>
          <p class="pmu-price-kicker">Ceny zabiegów · Bielsko-Biała</p>
          <h1 id="cennik-tytul">Cennik makijażu permanentnego <span class="bph-title-accent">w Bielsku-Białej.</span></h1>
          <p class="pmu-price-lead">Wybierz brwi, usta lub kreski. Porównaj ceny, sprawdź zakres zabiegu i zobacz, kiedy korekta jest wliczona.</p>
          <a class="pmu-price-author" href="/makijaz-permanentny-bielsko/#boguslawa-herda">
            <Image src={guideAuthorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="lazy" decoding="async" />
            <span><strong>Bogusława Herda</strong><span>Gabinet makijażu permanentnego</span></span>
          </a>
        </div>
        <aside class="pmu-price-overview" aria-labelledby="cennik-skrot">
          <p class="pmu-price-kicker" id="cennik-skrot">Ceny w skrócie</p>
          <ul>
            {summaryPrices.map((item) => (
              <li><a href={`#price-group-${item.index}`}>
                <span><strong>{item.label}</strong><small>{item.detail}</small></span>
                <span class="pmu-price-overview-amount">{item.price}<span aria-hidden="true"> ↓</span></span>
              </a></li>
            ))}
          </ul>
          <p class="pmu-price-overview-note">Ceny z <strong>*</strong> obejmują zabieg główny i korektę po wygojeniu, <strong>do 2 miesięcy od zabiegu głównego.</strong></p>
          <a class="pmu-price-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a>
        </aside>
      </section>

      <section class="pmu-price-catalog" aria-labelledby="cennik-pmu">
        <p class="pmu-price-kicker">Pełny cennik PMU</p>
        <h2 id="cennik-pmu" tabindex="-1">Ile kosztuje makijaż permanentny w Bielsku-Białej?</h2>
        <nav class="pmu-price-nav" aria-label="Wybierz kategorię cennika">
          {groupOrder.map((index) => <a href={`#price-group-${index}`}>{navLabels[index]} <span aria-hidden="true">↓</span></a>)}
        <p class="pmu-price-catalog-note">Ceny i czas wizyty znajdziesz przy każdej usłudze. <a href="#zasady-cennika">Sprawdź zasady korekty i odświeżenia ↓</a></p>

        {groupOrder.map((index) => {
          const group = priceGroups[index];
          const photo = groupPhotos[index as keyof typeof groupPhotos];
          const help = groupHelp[index as keyof typeof groupHelp];
          return (
            <section class="pmu-price-group" id={`price-group-${index}`} aria-labelledby={`pmu-price-heading-${index}`}>
              <div class="pmu-price-group-intro">
                {photo && <Image class="pmu-price-group-photo" src={photo} alt="" width={160} height={160} widths={[80,160,240]} sizes="(max-width: 640px) 64px, 96px" fit="cover" format="webp" quality={80} loading="lazy" decoding="async" />}
                <div><h3 id={`pmu-price-heading-${index}`}>{group.title}</h3><p>{group.note}</p></div>
              </div>
              <div class="pmu-price-group-content">
                <dl class="pmu-price-list">
                  {group.items.map((item) => (
                    <div class:list={["pmu-price-row", { "pmu-price-row-text": item.price.includes("%") || item.price.includes("indywidualna") }]}>
                      <dt>{displayName(item.name)}<span class="pmu-price-time">{item.time}</span></dt>
                      <dd>{item.price}</dd>
                    </div>
                  ))}
                </dl>
                <details class="pmu-price-details">
                  <summary>Co warto wiedzieć przed rezerwacją?<span aria-hidden="true">+</span></summary>
                  <div class="pmu-price-details-copy">
                    {Array.from(new Set(group.items.map((item) => getPriceItemDetails(group.label, item.name).description))).map((description) => <p>{description}</p>)}
                  </div>
                </details>
                <div class="pmu-price-group-links">
                  <a href={help.href}>{help.label} <span aria-hidden="true">→</span></a>
                  {index === 5 ? <a href={pmuFormUrl}>Opisz stare PMU <span aria-hidden="true">→</span></a>
                    : index === 6 ? <a href={phoneUrl}>Zapytaj o dostępność <span aria-hidden="true">→</span></a>
                    : <a href={booksyUrl} target="_blank" rel="noopener noreferrer">{index === 0 ? "Umów konsultację" : "Sprawdź terminy"} <span aria-hidden="true">↗</span></a>}
                </div>
              </div>
            </section>
          );
        })}
      </section>

      <section class="pmu-price-rules" aria-labelledby="zasady-cennika">
        <p class="pmu-price-kicker">Zakres i zasady</p>
        <h2 id="zasady-cennika">Co obejmuje cena zabiegu?</h2>
        <div class="pmu-price-rule-grid">
          <article><span class="pmu-price-rule-mark" aria-hidden="true">01</span><h3>* Zabieg główny + korekta</h3><p>Cena oznaczona gwiazdką obejmuje zabieg główny i korektę po wygojeniu, <strong>do 2 miesięcy od zabiegu głównego</strong>. Korekta pozwala dopracować kolor, nasycenie i równowagę efektu.</p></article>
          <article><span class="pmu-price-rule-mark" aria-hidden="true">02</span><h3>** Odświeżenie do 2 lat</h3><p>Cena odświeżenia dotyczy makijażu wykonanego <strong>w naszym gabinecie, do 2 lat</strong>. Wcześniejszą pigmentację oceniamy przed wyborem dalszego postępowania.</p></article>
          <article><span class="pmu-price-rule-mark" aria-hidden="true">03</span><h3>PMU po innym gabinecie</h3><p>Naprawa wymaga <strong>indywidualnej wyceny po konsultacji</strong>. Znaczenie mają kolor, kształt i nasycenie pigmentu. Czasem przed nowym zabiegiem potrzebne jest rozjaśnienie.</p></article>
        </div>
        <div class="pmu-price-formal">
          <p>Przed rezerwacją sprawdź zasady zapisów, odwoływania terminów i kwalifikacji: <a href="/regulamin-salonu/">regulamin salonu →</a></p>
          <p>Przedstawiona oferta ma charakter informacyjny i nie stanowi oferty handlowej w rozumieniu art. 66 § 1 KC.</p>
        </div>
      </section>

      <section class="pmu-price-booking" aria-labelledby="cennik-rezerwacja">
        <div><p class="pmu-price-kicker">Twój następny krok</p><h2 id="cennik-rezerwacja">Znasz ceny. Wybierz termin lub zacznij od rozmowy.</h2><p>Przy nowym zabiegu sprawdź dostępne terminy. Jeśli masz starą pigmentację lub nie wiesz, jaką metodę wybrać, zacznij od konsultacji: <strong>{priceGroups[0].items[0].price} · {priceGroups[0].items[0].time}</strong>.</p></div>
        <div class="pmu-price-booking-actions">
          <a class="pmu-price-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a>
          <a class="pmu-price-secondary" href={phoneUrl}>Zadzwoń: 730 900 125</a>
          <a class="pmu-price-text-link" href={pmuFormUrl}>Opisz swoją sytuację w formularzu <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="pmu-price-faq" aria-labelledby="cennik-pytania">
        <p class="pmu-price-kicker">Pytania przed rezerwacją</p>
        <h2 id="cennik-pytania">Co warto wiedzieć o cenach makijażu permanentnego?</h2>
        {faqItems.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
      </section>
      <div class="pmu-price-guide-link"><p>Chcesz najpierw poznać zabieg?</p><a href="/poradnik/">Przejdź do poradnika PMU <span aria-hidden="true">→</span></a></div>
      <GuideAssistant />
    </div>
  </main>
  <Footer />
</Layout>
