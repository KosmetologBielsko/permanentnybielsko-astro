const getOfferPricing = (price: string) => {
  if (price.includes("%") || price.toLowerCase().includes("indywidualna")) {
    return {
      "description": `Cena ustalana indywidualnie: ${price}`
    };
  }

  const values = price
    .match(/\d+(?:[.,]\d+)?/g)
    ?.map((value) => value.replace(",", "."));

  if (!values?.length) {
    return {
      "description": `Cena: ${price}`
    };
  }

  if (values.length >= 2) {
    return {
      "priceSpecification": {
        "@type": "PriceSpecification",
        "minPrice": values[0],
        "maxPrice": values[1],
        "priceCurrency": "PLN"
      }
    };
  }

  return {
    "price": values[0],
    "priceCurrency": "PLN"
  };
};

