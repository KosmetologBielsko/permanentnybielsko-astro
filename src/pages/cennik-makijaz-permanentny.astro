---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { Image } from "astro:assets";
import { guideAuthorPortrait } from "../data/guide-series-01";
import browsPhoto from "../assets/poradnik/seria-01/brwi-wlos-detal.webp";
import lipsPhoto from "../assets/poradnik/seria-01/usta-roz-detal.webp";
import eyesPhoto from "../assets/poradnik/seria-01/kreska-subtelna.webp";
import "../styles/pmu-price.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pmuFormUrl = "/makijaz-permanentny-bielsko/#kwalifikacja-pmu";
const phoneUrl = "tel:+48730900125";

const getPriceItemDetails = (groupLabel: string, itemName: string) => {
  if (groupLabel === "Konsultacja") return {
    description: "Podczas konsultacji oceniamy obszar zabiegowy lub wcześniejszy makijaż permanentny, omawiamy oczekiwany efekt i ustalamy właściwy kierunek: nowa pigmentacja, korekta, odświeżenie albo rozjaśnienie starego PMU.",
    primaryLabel: "Umów konsultację", primaryHref: booksyUrl, primaryExternal: true,
    secondaryLabel: "Formularz PMU", secondaryHref: pmuFormUrl
  };

  if (groupLabel === "Brwi") return {
    description: "Dobór techniki zależy od skóry, naturalnego owłosienia, wcześniejszej pigmentacji i efektu, który chcesz uzyskać. Przy pierwszej wizycie nie musisz samodzielnie wybierać metody.",
    primaryLabel: "Zobacz brwi permanentne", primaryHref: "/makijaz-permanentny-brwi/",
    secondaryLabel: "Umów przez Booksy", secondaryHref: booksyUrl, secondaryExternal: true
  };

  if (groupLabel === "Oczy") return {
    description: "Kreskę dobieramy do budowy oka, powieki i linii rzęs. Jeśli nie wiesz, czy lepsze będzie subtelne zagęszczenie czy mocniejsza kreska, decyzję można podjąć po konsultacji przed zabiegiem.",
    primaryLabel: "Zobacz kreski permanentne", primaryHref: "/makijaz-permanentny-oczu/",
    secondaryLabel: "Umów przez Booksy", secondaryHref: booksyUrl, secondaryExternal: true
  };

  if (groupLabel === "Usta") return {
    description: itemName === "LIP LIGHT"
      ? "LIP LIGHT jest usługą dodatkową. Jeśli nie wiesz, czy ten zabieg jest odpowiedni dla Ciebie, najlepiej sprawdzić szczegóły oferty ust lub skontaktować się z gabinetem."
      : "Pigmentację ust dobieramy do naturalnej czerwieni wargowej, typu urody i oczekiwanego efektu. Zabieg ma odświeżyć kolor i kontur, a nie powiększać usta.",
    primaryLabel: "Zobacz makijaż permanentny ust", primaryHref: "/makijaz-permanentny-ust/",
    secondaryLabel: "Umów przez Booksy", secondaryHref: booksyUrl, secondaryExternal: true
  };

  if (groupLabel === "Odświeżenie") return {
    description: "Odświeżenie ma sens wtedy, gdy wcześniejszy makijaż jest nadal dobrym punktem wyjścia. Jeśli pigment mocno zmienił kolor, kształt lub nasycenie, przed kolejną pigmentacją może być potrzebna korekta albo rozjaśnienie.",
    primaryLabel: "Sprawdź zasady odświeżenia", primaryHref: "/poradnik/odswiezenie-makijazu-permanentnego-cena/",
    secondaryLabel: "Umów przez Booksy", secondaryHref: booksyUrl, secondaryExternal: true
  };

  if (groupLabel === "Usuwanie" && itemName.startsWith("Naprawa")) return {
    description: "Przy makijażu wykonanym w innym gabinecie najpierw trzeba ocenić kolor, kształt, nasycenie pigmentu i kondycję skóry. Nie każdą pracę można bezpiecznie przykryć nową pigmentacją.",
    primaryLabel: "Formularz PMU", primaryHref: pmuFormUrl,
    secondaryLabel: "Zobacz korektę i usuwanie", secondaryHref: "/usuwanie-makijazu-permanentnego/"
  };

  if (groupLabel === "Usuwanie") return {
    description: "Liczba sesji i metoda usuwania zależą od pigmentu, jego koloru, głębokości oraz reakcji skóry. Przed rozpoczęciem najlepiej ustalić realny plan pracy.",
    primaryLabel: "Zobacz usuwanie PMU", primaryHref: "/usuwanie-makijazu-permanentnego/",
    secondaryLabel: "Formularz PMU", secondaryHref: pmuFormUrl
  };

  if (itemName === "Sercem malowane") return {
    description: "To społeczna część działalności gabinetu. Wybrane zabiegi wykonywane są bezpłatnie dla osób po chorobie lub w szczególnie trudnej sytuacji życiowej — po wcześniejszej kwalifikacji.",
    primaryLabel: "Poznaj #SercemMalowane", primaryHref: "/sercemmalowane/"
  };

  if (itemName.startsWith("Usługa VIP")) return {
    description: "Usługa VIP zależy od bieżącej dostępności gabinetu i nie zastępuje standardowej rezerwacji. Przed przyjazdem warto skontaktować się telefonicznie.",
    primaryLabel: "Zadzwoń i zapytaj", primaryHref: phoneUrl,
    secondaryLabel: "Sprawdź Booksy", secondaryHref: booksyUrl, secondaryExternal: true
  };

  return {
    description: "Jeśli nie wiesz, czy ta usługa jest odpowiednia dla Ciebie, możesz najpierw opisać swoją sytuację w formularzu PMU.",
    primaryLabel: "Formularz PMU", primaryHref: pmuFormUrl
  };
};

