---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";
import { aboutMedia as photo } from "../data/about-media";
import "../styles/pmu-about.css";

const title = "Bogusława Herda — o mnie | Makijaż permanentny Bielsko-Biała";
const description = "Bogusława Herda — kosmetolog, trenerka Long-Time-Liner i wicemistrzyni świata PMU 2023. Autorska technika Silky, edukacja i podejście do klientki.";
const pageUrl = `${siteConfig.siteUrl}/o-mnie/`;
const expertsUrl = "https://www.longtimeliner.com.pl/ekspertkipmu/";
const trainersUrl = "https://www.longtimeliner.com.pl/centrum-szkoleniowe-magda-bogulak/trenerzy-long-time-liner/";
const munichUrl = "https://www.long-time-liner.com/en/masterclass-event-munich-2024/";
const milestones = [
  { year: "2017", title: "Własny gabinet w Bielsku-Białej", label: "Początek mojego miejsca", text: "Otwieram własny gabinet i zdobywam Licencję I Long-Time-Liner®. Od tego czasu rozwijam miejsce, w którym rozmowa i indywidualny dobór efektu są częścią każdej wizyty.", image: photo.license, caption: "Licencja I · z Magdą Bogulak", source: null },
  { year: "2019", title: "Mistrzostwo Polski", label: "Elitarne Mistrzostwa Long-Time-Liner", text: "Zdobywam tytuł mistrzyni Polski Elitarnych Mistrzostw Long-Time-Liner. Praca konkursowa uczy mnie jeszcze większej precyzji i konsekwencji w dopracowywaniu szczegółów.", image: photo.poland, caption: "Mistrzostwo Polski Long-Time-Liner · 2019", source: trainersUrl },
  { year: "2021", title: "Dołączam do grona trenerek", label: "Long-Time-Liner®", text: "Rozpoczynam pracę jako trenerka Long-Time-Liner®. Dzieląc się techniką, uczę także obserwacji, planowania i świadomego podejmowania decyzji.", image: photo.trainer, caption: "Z zespołem Long-Time-Liner", source: trainersUrl },
  { year: "2022", title: "Warsztaty w Düsseldorfie", label: "11–12 czerwca · Niemcy", text: "W programie warsztatów M. Bellmann Academy pojawiają się moje pokazy Nude Lips i Silky Hairstroke Brows — subtelnej pigmentacji ust oraz brwi wykonywanych włosem maszynowym.", image: photo.dusseldorf, caption: "Materiał warsztatów Silky · Düsseldorf 2022", source: "https://bellmann-academy.de/workshops/top10masterclass/" },
  { year: "2023", title: "Wicemistrzostwo świata PMU", label: "World PMU Industry Convention · Monachium", text: "Zdobywam drugie miejsce World PMU Industry Convention. Rok i tytuł potwierdza mój profil w gronie ekspertek Long-Time-Liner.", image: null, caption: null, source: expertsUrl },
  { year: "2024", title: "Silky na Masterclass w Monachium", label: "16–17 listopada · Niemcy", text: "Silky Hair Stroke Brows trafia do programu międzynarodowego Masterclass Long-Time-Liner®. Przedstawiam kierunek pracy, który rozwijam również w gabinecie.", image: photo.munich, caption: "Program Masterclass · Monachium 2024", source: munichUrl },
  { year: "2025", title: "Pokaz Silky w Ankarze", label: "Turcja · polski zespół Long-Time-Liner®", text: "Podczas warsztatów w Ankarze prezentuję technikę Silky linergistkom z Turcji. Praca przy stanowisku pozwala pokazać szczegóły, których nie odda sam opis metody.", image: photo.ankara, caption: "Ankara 2025 · fotografia z warsztatów", source: null },
  { year: "2026", title: "Jury kategorii Hairstroke w Lyonie", label: "27–29 marca · New Generation", text: "Biorę udział w New Generation Congress & Competition w Lyonie jako jurorka kategorii Hairstroke — techniki szczególnie bliskiej mojej pracy.", image: photo.lyon, caption: "Plakat organizatora · Juge Hairstroke", source: null }
];
const structuredData = [
  { "@context": "https://schema.org", "@type": "AboutPage", "@id": `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: "pl-PL", dateModified: "2026-10-04", isPartOf: { "@id": `${siteConfig.siteUrl}/#website` }, mainEntity: { "@type": "Person", "@id": `${siteConfig.siteUrl}/#person`, name: "Bogusława Herda", image: new URL(photo.hero.src.src, siteConfig.siteUrl).toString(), mainEntityOfPage: { "@id": `${pageUrl}#webpage` }, award: ["Wicemistrzyni świata World PMU Industry Convention 2023", "Mistrzyni Polski Elitarnych Mistrzostw Long-Time-Liner 2019"], knowsAbout: ["Makijaż permanentny", "Silky Hairstroke Brows", "Kosmetologia"], hasCredential: { "@type": "EducationalOccupationalCredential", name: "Trener linergista", credentialCategory: "Studia podyplomowe" }, subjectOf: [{ "@type": "WebPage", url: expertsUrl }, { "@type": "WebPage", url: trainersUrl }] } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Strona główna", item: `${siteConfig.siteUrl}/` }, { "@type": "ListItem", position: 2, name: "O mnie", item: pageUrl }] }
];
const robots = process.env.VERCEL_ENV === "preview" ? "noindex, nofollow" : undefined;
---
<Layout title={title} description={description} canonicalPath="/o-mnie/" ogImage={photo.hero.src.src} ogImageAlt={photo.hero.alt} robots={robots} structuredData={structuredData}>
  <Header />
  <a class="bphm-skip" href="#o-mnie">Przejdź do treści</a>
  <main class="bphm-about" id="o-mnie">
    <div class="bphm-shell">
      <nav class="bphm-breadcrumb" aria-label="Ścieżka nawigacji"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">O mnie</span></nav>

      <section class="bphm-hero" aria-labelledby="bphm-title">
        <div class="bphm-hero-heading"><p class="bphm-kicker">Kosmetolog · linergistka · Bielsko-Biała</p><h1 id="bphm-title">Bogusława<br/>Herda<span>.</span></h1><p class="bphm-motto">Naturalny efekt.<br/> Osobiste podejście.</p></div>
        <figure class="bphm-hero-photo"><Image {...photo.hero} width={800} widths={[360,540,800]} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 45vw, 550px" format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async"/><figcaption>Powrót do natury.</figcaption></figure>
        <div class="bphm-hero-intro"><p>Tworzę makijaż permanentny, który współgra z Twoją twarzą. Łączę pracę we własnym gabinecie z edukacją, autorską techniką Silky i doświadczeniem na międzynarodowej scenie PMU.</p><p class="bphm-role">Wicemistrzyni świata PMU 2023<br/>Elite Top Linergist · trenerka Long-Time-Liner®</p><div class="bphm-actions"><a class="bphm-button" href={siteConfig.booksyUrl} target="_blank" rel="noopener noreferrer">Umów wizytę ↗</a><a class="bphm-link" href="#podejscie">Poznaj mnie bliżej ↓</a></div></div>
      </section>

      <dl class="bphm-highlights" aria-label="Najważniejsze etapy kariery"><div><dt>2017</dt><dd>Własny gabinet<br/>w Bielsku-Białej</dd></div><div><dt>2019</dt><dd>Mistrzyni Polski<br/>Long-Time-Liner®</dd></div><div><dt>2021</dt><dd>Trenerka<br/>Long-Time-Liner®</dd></div><div><dt>2023</dt><dd><strong>Wicemistrzyni świata</strong><br/>World PMU Industry Convention</dd></div></dl>
      <nav class="bphm-anchor-nav" aria-label="Na tej stronie"><a href="#podejscie">Podejście</a><a href="#mistrzostwa">Osiągnięcia</a><a href="#wyksztalcenie">Wykształcenie</a><a href="#silky">Silky</a><a href="#droga">Moja droga</a><a href="#opinie">Opinie</a></nav>

      <section class="bphm-section bphm-approach" id="podejscie" aria-labelledby="approach-title"><div><p class="bphm-kicker">01 / W gabinecie</p><h2 id="approach-title">Zanim wybierzemy kolor,<br/><span>chcę poznać Ciebie.</span></h2></div><div class="bphm-approach-copy"><p class="bphm-lead">Jak malujesz się na co dzień? Jaki efekt lubisz? Czego się obawiasz? Od takich pytań zaczynam, zanim przejdziemy do rysunku.</p><p>Oceniam skórę, proporcje twarzy i wcześniejsze pigmentacje. Wyjaśniam możliwości oraz ograniczenia zabiegu. Zależy mi, żebyś rozumiała, co planujemy i mogła spokojnie podjąć decyzję.</p></div><ol class="bphm-principles"><li><span>01</span><h3>Najpierw rozmowa</h3><p>Masz czas na pytania i omówienie swoich oczekiwań.</p></li><li><span>02</span><h3>Projekt dopasowany do twarzy</h3><p>Kształt, kolor i intensywność ustalamy przed pigmentacją.</p></li><li><span>03</span><h3>Świadoma decyzja</h3><p>Czasem proponuję subtelniejszy efekt albo wcześniejsze przygotowanie skóry.</p></li></ol></section>

      <section class="bphm-section bphm-award" id="mistrzostwa" aria-labelledby="award-title"><figure><a href={photo.world.src.src} target="_blank" rel="noopener" aria-label="Powiększ fotografię z nagrodą World PMU"><Image {...photo.world} width={800} widths={[360,540,800]} sizes="(max-width: 700px) calc(100vw - 76px), 42vw" format="webp" quality={85} loading="lazy" decoding="async"/></a><figcaption>World PMU Industry Convention · Monachium, 2023</figcaption></figure><div class="bphm-award-copy"><p class="bphm-kicker">02 / Ważny moment mojej drogi</p><p class="bphm-award-year" aria-hidden="true">2023</p><h2 id="award-title">Wicemistrzyni<br/><span>świata PMU.</span></h2><p>W 2023 roku zdobyłam wicemistrzostwo świata World PMU Industry Convention w Monachium. Na zdjęciu trzymam nagrodę za drugie miejsce.</p><p>To ważne wyróżnienie w mojej drodze zawodowej. Konkursy mobilizują mnie do dopracowywania detali: rysunku, precyzji i spójności całej pracy.</p><div class="bphm-source-links"><a href={expertsUrl} target="_blank" rel="noopener noreferrer">Profil ekspertki Long-Time-Liner ↗</a><a href="https://www.facebook.com/p/World-Pmu-Industry-Convention-100076073861798/" target="_blank" rel="noopener noreferrer">Organizator mistrzostw ↗</a></div></div></section>

      <section class="bphm-section" id="wyksztalcenie" aria-labelledby="study-title"><div class="bphm-section-head"><p class="bphm-kicker">03 / Wykształcenie</p><h2 id="study-title">Praktyka daje doświadczenie.<br/><span>Nauka pomaga je zrozumieć.</span></h2><p>Rozwijam się w dwóch uzupełniających się obszarach: makijażu permanentnym i kosmetologii. Dzięki temu patrzę zarówno na efekt pigmentacji, jak i na potrzeby skóry.</p></div><div class="bphm-education-grid"><article class="bphm-education-card"><figure><Image {...photo.trainerDegree} width={540} widths={[320,540]} sizes="(max-width: 700px) calc(100vw - 40px), 30vw" format="webp" quality={83} loading="lazy" decoding="async"/></figure><p class="bphm-kicker">Studia podyplomowe · PMU</p><h3>Trener linergista</h3><p>Ukończyłam studia podyplomowe Trener linergista. Kierunek łączy wiedzę o pigmentacji z przygotowaniem do prowadzenia szkoleń.</p><p>Program opisany przez uczelnię obejmuje m.in. rysunek wstępny, analizę kolorystyczną, fizjologię skóry, przeciwwskazania oraz warsztat trenerski.</p><a class="bphm-link" href="https://www.gwsh.pl/studia/trener-linergista.html" target="_blank" rel="noopener noreferrer">O kierunku na stronie uczelni ↗</a></article><article class="bphm-education-card"><figure><Image {...photo.degree} width={650} widths={[360,650]} sizes="(max-width: 700px) calc(100vw - 40px), 30vw" format="webp" quality={83} loading="lazy" decoding="async"/></figure><p class="bphm-kicker">Studia podyplomowe</p><h3>Kosmetologia</h3><p>Wiedza o skórze jest podstawą mojej pracy. Pomaga mi dobierać zabiegi i rozmawiać z klientką o jej potrzebach oraz pielęgnacji.</p></article><article class="bphm-education-card"><figure><Image {...photo.advanced} width={540} widths={[320,540]} sizes="(max-width: 700px) calc(100vw - 40px), 30vw" format="webp" quality={83} loading="lazy" decoding="async"/></figure><p class="bphm-kicker">Dalsze kształcenie</p><h3>Kosmetologia zaawansowana</h3><p>Kolejny etap edukacji poszerzył moje spojrzenie na pracę ze skórą. W jednej z prac dyplomowych zajęłam się pigmentacją medyczną u osób z rozszczepem wargi i podniebienia.</p></article></div></section>

      <section class="bphm-section bphm-silky" id="silky" aria-labelledby="silky-title"><figure><img src="/images/galeria-10/silky/silky-01-800.webp" srcset="/images/galeria-10/silky/silky-01-480.webp 480w, /images/galeria-10/silky/silky-01-800.webp 800w" sizes="(max-width: 700px) calc(100vw - 40px), 40vw" width="1122" height="1402" alt="Brwi wykonane techniką Silky Hairstroke Brows — zbliżenie pracy z galerii gabinetu" loading="lazy" decoding="async"/><figcaption>Silky Hairstroke Brows · praca z galerii gabinetu</figcaption></figure><div><p class="bphm-kicker">04 / Moja autorska technika</p><h2 id="silky-title">Silky.<br/><span>Lekkość zapisana we włoskach.</span></h2><p>W Silky Hairstroke Brows tworzę delikatny rysunek włosa maszynowego. Kierunek i układ pigmentowanych włosków dobieram do naturalnych brwi oraz proporcji twarzy.</p><p>O wyborze metody decydujemy po ocenie skóry i wcześniejszej pigmentacji. Chcę, żeby technika odpowiadała temu, czego potrzebujesz.</p><div class="bphm-actions"><a class="bphm-button" href="/poradnik/silky-hairstroke-brows-naturalny-wlos-maszynowy/">Poznaj technikę Silky →</a><a class="bphm-link" href="/galeria/">Zobacz moje prace →</a></div></div></section>

      <section class="bphm-section bphm-career" id="droga" aria-labelledby="career-title"><div class="bphm-career-intro"><p class="bphm-kicker">05 / Moja droga</p><h2 id="career-title">Z Bielska-Białej<br/><span>dalej w świat PMU.</span></h2><p>Gabinet pozostaje moim miejscem codziennej pracy. Konkursy, pokazy i spotkania z linergistkami z innych krajów są kolejnymi etapami tej samej drogi.</p><p class="bphm-small">Wybierz rok, żeby zobaczyć fotografię lub materiał z wydarzenia.</p><a class="bphm-link" href="/poradnik/wydarzenia/">Wydarzenia i relacje →</a></div><ol class="bphm-timeline">{milestones.map(item => <li><details class="bphm-event" open={item.year === "2025"}><summary><span class="bphm-year">{item.year}</span><span><span class="bphm-event-title">{item.title}</span><span class="bphm-event-label">{item.label}</span></span><span class="bphm-toggle" aria-hidden="true">+</span></summary><div class="bphm-event-body"><p>{item.text}</p>{item.image && <figure><a href={item.image.src.src} target="_blank" rel="noopener" aria-label={`Powiększ: ${item.caption}`}><Image {...item.image} width={700} widths={[360,540,700]} sizes="(max-width: 700px) calc(100vw - 60px), 40vw" format="webp" quality={82} loading="lazy" decoding="async"/></a><figcaption>{item.caption}</figcaption></figure>}{item.source && <a class="bphm-link" href={item.source} target="_blank" rel="noopener noreferrer">Zobacz materiał źródłowy ↗</a>}{item.year === "2022" && <a class="bphm-link" href="/images/o-mnie/boguslawa-herda-dusseldorf-2022-kompozycja.webp" target="_blank" rel="noopener">Düsseldorf — kolaż wspomnień ↗</a>}{item.year === "2025" && <a class="bphm-link" href="/images/o-mnie/boguslawa-herda-ankara-2025-kompozycja.webp" target="_blank" rel="noopener">Ankara — kolaż wspomnień ↗</a>}</div></details></li>)}</ol></section>

      <aside class="bphm-next"><div><p class="bphm-kicker">Wydarzenia / październik 2026</p><h2>Dżakarta · PMU Indonesia Festival</h2><p>Zapowiedź mojego udziału w jury i materiały z wyjazdu znajdziesz w Wydarzeniach. Obserwuj również profil gabinetu, na którym planujemy relacje.</p></div><div class="bphm-next-links"><a class="bphm-link" href="/poradnik/boguslawa-herda-pmu-indonesia-jakarta-2026/">Przeczytaj zapowiedź →</a><a class="bphm-link" href="https://www.instagram.com/permanentnybielsko" target="_blank" rel="noopener noreferrer">Obserwuj na Instagramie ↗</a></div></aside>

      <section class="bphm-section bphm-heart" id="sercem" aria-labelledby="heart-title"><figure><Image {...photo.heart} width={540} widths={[320,540]} sizes="(max-width: 700px) 260px, 320px" format="webp" quality={83} loading="lazy" decoding="async"/><figcaption>Ambasador Serca · Long-Time-Liner®</figcaption></figure><div><p class="bphm-kicker">06 / #SercemMalowane</p><h2 id="heart-title">Za każdą twarzą<br/><span>stoi czyjaś historia.</span></h2><p>Utrata brwi czy zmiany po leczeniu mogą wpływać na to, jak czujemy się ze sobą. W projekcie #SercemMalowane wspieram osoby, dla których pigmentacja ma szczególne, osobiste znaczenie.</p><p>Ta część mojej pracy łączy zainteresowanie pigmentacją medyczną z potrzebą pomagania. Wyróżnienie Ambasador Serca przypomina mi, jak wiele może znaczyć uważność poświęcona drugiej osobie.</p><a class="bphm-link" href="/sercemmalowane/">Poznaj #SercemMalowane →</a></div></section>

      <section class="bphm-section bphm-reviews" id="opinie" aria-labelledby="reviews-title"><div><p class="bphm-kicker">07 / Z perspektywy klientek</p><h2 id="reviews-title">Poznaj także<br/><span>ich doświadczenia.</span></h2><p>Przed wizytą warto poznać różne perspektywy. Na Booksy przeczytasz opinie o zabiegach i wizytach w naszym gabinecie.</p><a class="bphm-link" href={siteConfig.booksyUrl} target="_blank" rel="noopener noreferrer">Przeczytaj opinie w Booksy ↗</a></div><a class="bphm-review-score" href={siteConfig.booksyUrl} target="_blank" rel="noopener noreferrer" aria-label="Ocena gabinetu 5,0 na 5 w Booksy, ponad 1200 opinii — zobacz profil"><span class="bphm-stars" aria-hidden="true">★★★★★</span><strong>5,0<span>/ 5</span></strong><span>Ponad 1200 opinii w Booksy</span><small>Ocena gabinetu · stan na 4.10.2026</small></a></section>

      <section class="bphm-booking" aria-labelledby="booking-title"><div><p class="bphm-kicker">Spotkajmy się w gabinecie</p><h2 id="booking-title">Twój makijaż<br/>zaczyna się od rozmowy.</h2><p>Nie musisz znać nazwy techniki. Powiedz, jaki efekt Ci się podoba i co chcesz zmienić.</p><p class="bphm-address">Bogusława Herda<br/>ul. Barlickiego 5/23 · Bielsko-Biała</p></div><div class="bphm-booking-actions"><a class="bphm-button" href={siteConfig.booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="bphm-button bphm-button-outline" href="/kontakt/">Mam pytanie przed wizytą →</a><a class="bphm-phone" href="tel:+48730900125">730 900 125</a><a class="bphm-link" href="/cennik-makijaz-permanentny/">Zobacz cennik zabiegów →</a></div></section>
    </div>
  </main>
  <Footer />
</Layout>
