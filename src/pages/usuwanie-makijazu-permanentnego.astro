---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PmuServiceCompass from "../components/PmuServiceCompass.astro";
import PmuExpertAuthority from "../components/PmuExpertAuthority.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/usuwanie-makijazu-permanentnego/";

const pageTitle =
  "Usuwanie makijażu permanentnego Bielsko-Biała | Laser i remover";

const pageDescription =
  "Usuwanie makijażu permanentnego Bielsko-Biała: rozjaśnianie starego PMU laserem GLOVCON Q-Switch Nd:YAG lub removerem Bye-Bye Pigment Long-Time-Liner. Cena 200–400 zł.";

const proofItems = [
  { title: "Kwalifikacja", text: "ocena starego pigmentu i skóry" },
  { title: "Laser / remover", text: "dobór metody do sytuacji" },
  { title: "200–400 zł", text: "orientacyjna cena zabiegu" },
  { title: "Plan etapowy", text: "bez pośpiechu i dokładania kolejnej warstwy" },
];

const decisionItems = [
  {
    title: "Liczba zabiegów",
    text: "zależy od koloru, głębokości, nasycenia pigmentu i reakcji skóry",
  },
  {
    title: "Przerwy między etapami",
    text: "są potrzebne do regeneracji i spokojnej oceny efektu rozjaśnienia",
  },
  {
    title: "Realne oczekiwania",
    text: "nie każdy pigment reaguje tak samo i nie zawsze można przewidzieć tempo rozjaśniania",
  },
  {
    title: "Plan korekty",
    text: "nowy makijaż permanentny planujemy dopiero wtedy, gdy skóra daje do tego warunki",
  },
];

const indicationsItems = [
  {
    title: "Zbyt ciemny pigment",
    text: "gdy brwi, usta albo kreska są za mocne i nie współpracują z urodą",
    image: "/images/01-zbyt-ciemny-pigment.webp",
  },
  {
    title: "Nieodpowiedni kształt",
    text: "gdy stary rysunek zaburza proporcje twarzy albo ogranicza nowy projekt",
    image: "/images/02-nieodpowiedni-ksztalt.webp",
  },
  {
    title: "Chłodny odcień",
    text: "gdy pigment po czasie zmienił ton i wymaga oceny przed dalszą pracą",
    image: "/images/03-chlodny-odcien.webp",
  },
  {
    title: "Nierówna pigmentacja",
    text: "gdy kolor nie rozłożył się równomiernie albo wymaga etapowego rozjaśniania",
    image: "/images/04-nierowna-pigmentacja.webp",
  },
  {
    title: "Plan nowego PMU",
    text: "gdy przed korektą trzeba przygotować skórę i stworzyć miejsce na nowy efekt",
    image: "/images/05-plan-nowego-pmu.webp",
  },
  {
    title: "Stara praca w skórze",
    text: "gdy nie da się odpowiedzialnie przykryć starego pigmentu kolejną pigmentacją",
    image: "/images/06-stara-praca-w-skorze.webp",
  },
];

const processItems = [
  {
    title: "Konsultacja",
    text: "Historia pigmentacji, oczekiwany efekt i możliwe ograniczenia.",
  },
  {
    title: "Ocena pigmentu",
    text: "Kolor, głębokość, nasycenie, kształt i aktualny stan skóry.",
  },
  {
    title: "Dobór metody",
    text: "Laser, remover albo etapowe przygotowanie do późniejszej korekty.",
  },
  {
    title: "Zabieg",
    text: "Precyzyjna praca wyłącznie w zakresie uzgodnionym po kwalifikacji.",
  },
  {
    title: "Gojenie",
    text: "Czas na regenerację skóry i ocenę tego, jak pigment zareagował.",
  },
  {
    title: "Dalszy plan",
    text: "Kolejny etap, przerwa albo przygotowanie do nowego makijażu permanentnego.",
  },
];

const faqItems = [
  {
    question: "Ile kosztuje usuwanie makijażu permanentnego w Bielsku-Białej?",
    answer:
      "Orientacyjna cena laserowego usuwania PMU oraz zabiegu removerem wynosi 200–400 zł. Dokładny koszt zależy od obszaru i planu pracy.",
  },
  {
    question: "Czy jeden zabieg usuwania makijażu permanentnego wystarczy?",
    answer:
      "Nie zawsze. Liczba etapów zależy od koloru, głębokości i nasycenia pigmentu oraz indywidualnej reakcji skóry.",
  },
  {
    question: "Co jest lepsze: laser czy remover?",
    answer:
      "Nie ma jednej odpowiedzi dla każdego przypadku. Metodę dobiera się po ocenie pigmentu, skóry, miejsca zabiegowego i planu dalszej korekty.",
  },
  {
    question: "Czy można od razu przykryć stary makijaż permanentny nowym?",
    answer:
      "Czasem tak, ale bardzo często najpierw trzeba rozjaśnić starą pigmentację. Dokładanie kolejnej warstwy na zbyt ciemny lub niekorzystnie ułożony pigment może ograniczyć możliwości korekty.",
  },
  {
    question: "Kiedy można planować nowy makijaż permanentny po rozjaśnianiu?",
    answer:
      "Dopiero po wygojeniu skóry i ocenie efektu poprzedniego etapu. Plan nowego PMU powinien wynikać z realnego stanu skóry.",
  },
  {
    question: "Czy można usuwać pigment z brwi, ust i kresek?",
    answer:
      "Każda okolica wymaga osobnej kwalifikacji. Decyzja o metodzie zapada po analizie konkretnego przypadku.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website",
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/usuwanie-pmu-glovcon-q-switch-nd-yag.webp",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Usuwanie makijażu permanentnego",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Usuwanie makijażu permanentnego Bielsko-Biała",
    serviceType: "Usuwanie makijażu permanentnego",
    description:
      "Usuwanie i rozjaśnianie starego makijażu permanentnego w Bielsku-Białej: kwalifikacja, laser GLOVCON Q-Switch Nd:YAG, remover Bye-Bye Pigment Long-Time-Liner i plan korekty PMU.",
    areaServed: {
      "@type": "City",
      name: "Bielsko-Biała",
    },
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Metody usuwania makijażu permanentnego",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Laserowe usuwanie makijażu permanentnego",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Remover Bye-Bye Pigment Long-Time-Liner",
          },
        },
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/usuwanie-makijazu-permanentnego/"
  structuredData={structuredData}
>
  <div class="removal-page">
    <Header />

    <main>
      <section class="removal-hero">
        <div class="removal-glow removal-glow-one" aria-hidden="true"></div>
        <div class="removal-glow removal-glow-two" aria-hidden="true"></div>

        <div class="container removal-hero-grid">
          <div class="removal-hero-copy">
            <p class="section-kicker">Usuwanie makijażu permanentnego Bielsko-Biała</p>

            <h1>
              Stary makijaż permanentny czasem trzeba najpierw
              <span class="removal-turquoise-text">rozjaśnić</span>,
              a dopiero potem poprawiać.
            </h1>

            <p class="removal-hero-lead">
              Zbyt ciemny pigment, niekorzystny kształt, chłodny odcień albo
              nierówna pigmentacja wymagają spokojnej oceny. Usuwanie makijażu permanentnego
              może oznaczać laserowe rozjaśnianie, remover albo plan etapowy przygotowujący skórę
              do późniejszej korekty — bez dokładania kolejnej warstwy do istniejącego problemu.
            </p>

            <div class="removal-hero-actions" aria-label="Usuwanie PMU — szybkie działania">
              <a class="button-primary" href="#kwalifikacja">
                Kwalifikacja <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="#cena-usuwania">
                Cena 200–400 zł
              </a>

              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>
            </div>

            <p class="removal-hero-note">
              Jeśli nie wiesz, czy potrzebujesz lasera, removera czy tylko korekty,
              zacznij od oceny starego pigmentu.
            </p>
          </div>

          <aside class="removal-hero-card" aria-label="Podejście do usuwania PMU">
            <p class="removal-card-label">PMU</p>
            <h2>Nie przykrywamy problemu. Najpierw sprawdzamy, co jest w skórze.</h2>
            <p>
              Kolor, nasycenie, głębokość pigmentu, kształt i stan skóry
              decydują o tym, czy lepszy będzie laser, remover czy etapowe
              przygotowanie do późniejszej korekty.
            </p>
          </aside>
        </div>
      </section>

      <section class="removal-proof-section" aria-label="Najważniejsze informacje o usuwaniu PMU">
        <div class="container removal-proof-grid">
          {proofItems.map((item) => (
            <div>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </div>
          ))}
        </div>
      </section>

      <div id="usuwanie-pmu-informacje">
        <PmuServiceCompass
          eyebrow="Usuwanie PMU — szybka decyzja"
          title="Najpierw pigment i cel. Potem metoda."
          lead="Nie wybieraj lasera albo removera wyłącznie po nazwie technologii. Najpierw oceniamy kolor, nasycenie, kształt, obszar i to, co chcesz zrobić później — całkowicie rozjaśnić pigment czy przygotować skórę do nowego PMU."
          items={[
            { label: "Laser", title: "GLOVCON Q-Switch →", href: "#laser" },
            { label: "Remover", title: "Bye-Bye Pigment →", href: "#remover" },
            { label: "Cena", title: "200–400 zł →", href: "#cena-usuwania" },
            { label: "Kwalifikacja", title: "Ocena starego PMU →", href: "#kwalifikacja" }
          ]}
          secondary={[
            { label: "Kiedy usuwać?", title: "Czy stary PMU trzeba rozjaśnić? →", href: "/poradnik/kiedy-usuwac-stary-makijaz-permanentny/" },
            { label: "Brwi", title: "Laserowe usuwanie brwi →", href: "/poradnik/laserowe-usuwanie-brwi-permanentnych/" },
            { label: "Stary pigment", title: "Brwi permanentne po latach →", href: "/poradnik/brwi-permanentne-po-latach/" }
          ]}
        />
      </div>


      <section class="removal-assessment-section" id="kwalifikacja">
        <div class="container removal-assessment-card">
          <figure class="removal-photo-frame removal-assessment-media">
            <img
              src="/images/szkolenia-pmu-praktyka-zabiegowa-long-time-liner.webp"
              alt="Bogusława Herda podczas pracy zabiegowej — kwalifikacja przed korektą lub usuwaniem PMU"
              width="1200"
              height="1800"
              loading="eager"
              decoding="async"
            />
          </figure>

          <div class="removal-assessment-copy">
            <p class="section-kicker">Kwalifikacja</p>
            <h2>Najpierw ocena starego pigmentu. Dopiero potem wybór metody.</h2>
            <p>
              Inaczej pracuje się przy zbyt ciemnych brwiach, inaczej przy
              chłodnym odcieniu, a jeszcze inaczej przy starej pigmentacji
              w okolicy ust lub oczu.
            </p>
            <p>
              Dlatego pierwsza decyzja brzmi nie „czym usuwać?”, ale
              „co dokładnie znajduje się w skórze i jaki ma być dalszy cel?”.
            </p>
          </div>
        </div>
      </section>

      <section class="removal-methods-section" id="laser-remover">
        <div class="container">
          <div class="removal-section-heading">
            <p class="section-kicker">Dwie ścieżki pracy</p>
            <h2>Laser albo remover — metoda wynika z konkretnej pigmentacji.</h2>
            <p>
              Nie każdy pigment zachowuje się tak samo. Dlatego przed zabiegiem
              oceniamy kolor, nasycenie, głębokość, obszar i dalszy plan.
            </p>
          </div>

          <div class="removal-methods-grid">
            <article class="removal-method-card" id="remover">
              <figure class="removal-method-media">
                <img
                  src="/images/usuwanie-pmu-bye-bye-pigment-zestaw.webp"
                  alt="Remover Bye-Bye Pigment Long-Time-Liner do usuwania makijażu permanentnego"
                  width="1600"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <div class="removal-method-copy">
                <p class="section-kicker">Remover Long-Time-Liner®</p>
                <h3>Bye-Bye Pigment w wybranych przypadkach.</h3>
                <p>
                  Remover może być jedną ze ścieżek przy konkretnych pigmentacjach,
                  szczególnie gdy potrzebna jest punktowa, etapowa praca i późniejsza
                  ponowna ocena skóry.
                </p>
              </div>
            </article>

            <article class="removal-method-card removal-method-card-turquoise" id="laser">
              <figure class="removal-method-media">
                <img
                  src="/images/usuwanie-pmu-glovcon-q-switch-nd-yag.webp"
                  alt="GLOVCON Q-Switch Nd:YAG — technologia laserowa do rozjaśniania pigmentu"
                  width="1800"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <div class="removal-method-copy">
                <p class="section-kicker">Laserowe rozjaśnianie</p>
                <h3>GLOVCON® Q-Switch Nd:YAG jako druga ścieżka pracy.</h3>
                <p>
                  Rozjaśnianie laserowe planowane jest etapowo. Po każdym zabiegu
                  potrzebny jest czas na regenerację i ocenę tego, jak pigment
                  oraz skóra zareagowały.
                </p>
              </div>
            </article>
          </div>

          <div class="removal-price-strip" id="cena-usuwania" aria-label="Cena usuwania makijażu permanentnego">
            <div>
              <span>Laserowe usuwanie PMU</span>
              <strong>200–400 zł</strong>
            </div>
            <div>
              <span>Remover Bye-Bye Pigment</span>
              <strong>200–400 zł</strong>
            </div>
            <a href="/cennik-makijaz-permanentny/">
              Pełny cennik <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="removal-decision-section">
        <div class="container removal-decision-panel">
          <div class="removal-decision-copy">
            <p class="section-kicker section-kicker-light">Plan etapowy</p>
            <h2>Najważniejsze jest to, co dzieje się między zabiegami.</h2>
            <p>
              Rozjaśnianie starego PMU nie powinno być traktowane jak jednorazowa
              szybka poprawka. Liczą się reakcja skóry, przerwy, efekt poprzedniego
              etapu i dopiero na tej podstawie kolejna decyzja.
            </p>
          </div>

          <div class="removal-decision-points">
            {decisionItems.map((item, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="removal-indications-section" id="kiedy-usuwac">
        <div class="container">
          <div class="removal-section-heading">
            <p class="section-kicker">Kiedy rozważyć rozjaśnianie?</p>
            <h2>Czasem najlepsza korekta zaczyna się od przygotowania skóry.</h2>
            <p>
              Jeśli pigment jest zbyt mocny, ma niekorzystny kolor albo blokuje
              nowy projekt, dokładanie kolejnej pigmentacji nie zawsze jest dobrym kierunkiem.
            </p>
          </div>

          <div class="removal-indications-grid">
            {indicationsItems.map((item) => (
              <figure class="removal-indication-card">
                <img
                  src={item.image}
                  alt={`${item.title} — ${item.text}`}
                  title={item.title}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="removal-product-section">
        <div class="container removal-product-card">
          <div class="removal-product-copy">
            <p class="section-kicker">Bye-Bye Pigment</p>
            <h2>Remover stosujemy wtedy, gdy wynika to z kwalifikacji.</h2>
            <p>
              Nie każda pigmentacja wymaga tej samej metody. W wybranych
              przypadkach remover może być elementem etapowego planu
              rozjaśniania i późniejszej korekty.
            </p>
          </div>

          <figure class="removal-product-media">
            <img
              src="/images/usuwanie-pmu-bye-bye-pigment.webp"
              alt="Bye-Bye Pigment Long-Time-Liner — remover do makijażu permanentnego"
              width="1200"
              height="1200"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="removal-process-section" id="proces-usuwania">
        <div class="container">
          <div class="removal-section-heading">
            <p class="section-kicker">Proces pracy</p>
            <h2>Najpierw plan. Potem zabieg. Na końcu decyzja o kolejnym kroku.</h2>
            <p>
              Przy starym PMU najważniejsze jest, żeby nie pogłębić problemu
              i nie przyspieszać kolejnych etapów bez oceny skóry.
            </p>
          </div>

          <div class="removal-process-grid">
            {processItems.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="removal-next-step-section" id="co-po-usuwaniu">
        <div class="container removal-next-step-grid">
          <div class="removal-next-step-copy">
            <p class="section-kicker">Co po rozjaśnianiu?</p>
            <h2>Nowe PMU planujemy dopiero wtedy, gdy skóra jest gotowa.</h2>
            <p>
              Jeśli celem jest późniejsza korekta brwi, ust albo kresek,
              decyzję o nowej pigmentacji podejmujemy dopiero po wygojeniu
              i ocenie efektu poprzednich etapów.
            </p>

            <a
              class="button-primary removal-form-link"
              href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu"
            >
              Formularz kwalifikacji PMU <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="removal-next-step-links">
            <a href="/makijaz-permanentny-brwi/">
              <span>Brwi</span>
              <strong>Brwi permanentne</strong>
              <em>metody, efekty i Silky Hairstroke Brows</em>
            </a>

            <a href="/makijaz-permanentny-ust/">
              <span>Usta</span>
              <strong>Makijaż permanentny ust</strong>
              <em>kolor, kontur i naturalny efekt</em>
            </a>

            <a href="/makijaz-permanentny-oczu/">
              <span>Kreski</span>
              <strong>Makijaż permanentny oczu</strong>
              <em>zagęszczenie rzęs i kreski permanentne</em>
            </a>
          </div>
        </div>
      </section>


      <section class="removal-guides-section" id="poradniki-usuwanie">
        <div class="container">
          <div class="removal-section-heading">
            <p class="section-kicker">Decyzja przed zabiegiem</p>
            <h2>Nie każdy stary makijaż permanentny trzeba usuwać do zera.</h2>
            <p>
              Czasem wystarcza kontrolowane rozjaśnienie, czasem potrzebna jest korekta,
              a w części przypadków najważniejsze jest najpierw odzyskanie przestrzeni
              na nowy, naturalniejszy projekt.
            </p>
          </div>

          <div class="removal-guides-grid">
