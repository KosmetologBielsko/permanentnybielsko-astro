---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import { Image } from "astro:assets";
import { booksyUrl } from "../data/site-navigation";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import practicePhoto from "../../public/images/szkolenia-pmu-praktyka-zabiegowa-long-time-liner.webp";
import "../styles/pmu-landing.css";
import "../styles/pmu-brows.css";
import "../styles/pmu-services-17.css";
import removerPhoto from "../../public/images/usuwanie-pmu-bye-bye-pigment-zestaw.webp";
const pageUrl =
  "https://www.permanentnybielsko.com/usuwanie-makijazu-permanentnego/";
const pageTitle =
  "Usuwanie makijażu permanentnego Bielsko-Biała | Laser i remover";
const pageDescription =
  "Usuwanie makijażu permanentnego Bielsko-Biała: rozjaśnianie starego PMU laserem GLOVCON Q-Switch Nd:YAG lub removerem Bye-Bye Pigment Long-Time-Liner. Cena 200–400 zł.";
const faqItems = [
  {
    question: "Ile kosztuje usuwanie makijażu permanentnego w Bielsku-Białej?",
    answer:
      "Orientacyjna cena laserowego usuwania PMU oraz zabiegu removerem wynosi 200–400 zł. Dokładny koszt zależy od obszaru i planu pracy.",
  },
  {
    question: "Czy jeden zabieg usuwania makijażu permanentnego wystarczy?",
    answer:
      "Nie zawsze. Liczba etapów zależy od koloru, głębokości i nasycenia pigmentu oraz indywidualnej reakcji skóry.",
  },
  {
    question: "Co jest lepsze: laser czy remover?",
    answer:
      "Nie ma jednej odpowiedzi dla każdego przypadku. Metodę dobiera się po ocenie pigmentu, skóry, miejsca zabiegowego i planu dalszej korekty.",
  },
  {
    question: "Czy można od razu przykryć stary makijaż permanentny nowym?",
    answer:
      "Czasem tak, ale bardzo często najpierw trzeba rozjaśnić starą pigmentację. Dokładanie kolejnej warstwy na zbyt ciemny lub niekorzystnie ułożony pigment może ograniczyć możliwości korekty.",
  },
  {
    question: "Kiedy można planować nowy makijaż permanentny po rozjaśnianiu?",
    answer:
      "Dopiero po wygojeniu skóry i ocenie efektu poprzedniego etapu. Plan nowego PMU powinien wynikać z realnego stanu skóry.",
  },
  {
    question: "Czy można usuwać pigment z brwi, ust i kresek?",
    answer:
      "Każda okolica wymaga osobnej kwalifikacji. Decyzja o metodzie zapada po analizie konkretnego przypadku.",
  },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    dateModified: "2026-09-20",
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website",
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/szkolenia-pmu-praktyka-zabiegowa-long-time-liner.webp",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Usuwanie makijażu permanentnego",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Usuwanie makijażu permanentnego Bielsko-Biała",
    serviceType: "Usuwanie makijażu permanentnego",
    description:
      "Usuwanie i rozjaśnianie starego makijażu permanentnego w Bielsku-Białej: kwalifikacja, laser GLOVCON Q-Switch Nd:YAG, remover Bye-Bye Pigment Long-Time-Liner i plan korekty PMU.",
    areaServed: {
      "@type": "City",
      name: "Bielsko-Biała",
    },
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Metody usuwania makijażu permanentnego",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Laserowe usuwanie makijażu permanentnego",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Remover Bye-Bye Pigment Long-Time-Liner",
          },
        },
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/usuwanie-makijazu-permanentnego/" structuredData={structuredData} inlineGuideAssistant={true}>
<a class="pmu-landing-skip" href="#tresc">Przejdź do treści</a><Header compact />
<main id="tresc" class="pmu-landing pmu-brows pmu-service17 pmu-removal"><div class="pmu-landing-shell"><nav class="pmu-landing-breadcrumbs" aria-label="Okruszki"><a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Usuwanie PMU</span></nav>
<section class="pmu-landing-intro pmu-brows-hero" aria-labelledby="tytul-strony"><div><p class="pmu-landing-kicker">Usuwanie makijażu permanentnego · Bielsko-Biała</p><h1 id="tytul-strony">Stary makijaż permanentny czasem trzeba <span class="bph-title-accent">najpierw rozjaśnić</span>, a dopiero potem poprawiać.</h1><p class="pmu-landing-lead">Laser czy remover? Zaczynamy od oceny pigmentu, skóry i wcześniejszych zabiegów. Ustalamy realny plan rozjaśnienia oraz możliwości późniejszej korekty.</p><a class="pmu-landing-author" href="#ekspert-usuwanie-pmu"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} /><span><strong>Bogusława Herda</strong><span>Linergistka · trenerka Long-Time-Liner®</span></span></a><p class="pmu-service17-hero-price"><strong>200–400 zł</strong><span>za jeden zabieg · laser lub remover</span></p><div class="pmu-brows-hero-actions"><a class="pmu-landing-primary" href="#kwalifikacja">Zacznij od kwalifikacji ↓</a><a class="pmu-landing-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div></div><figure class="pmu-brows-hero-photo"><Image src={practicePhoto} alt="Bogusława Herda podczas precyzyjnej pracy w gabinecie" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="eager" decoding="async" fetchpriority="high" /><figcaption>Uważna praca ze skórą. Bogusława Herda w gabinecie.</figcaption></figure></section><nav class="pmu-landing-nav" aria-label="Na tej stronie"><a href="#laser-remover">Laser czy remover?<span aria-hidden="true">↓</span></a><a href="#cena-usuwania">Cena<span aria-hidden="true">↓</span></a><a href="#kwalifikacja">Kwalifikacja<span aria-hidden="true">↓</span></a><a href="#ekspert-usuwanie-pmu">Doświadczenie<span aria-hidden="true">↓</span></a><a href="#faq">Pytania<span aria-hidden="true">↓</span></a></nav><div id="usuwanie-pmu-informacje"><section class="pmu-landing-section " id="laser-remover"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Dwie możliwości</p><h2>Metodę dobieramy do pigmentu i skóry.</h2></div><div class="pmu-brows-methods"><article class="pmu-brows-method" id="laser"><p class="pmu-landing-kicker">GLOVCON Q-Switch Nd:YAG</p><h3>Laser</h3><p>Rozjaśnianie starej pigmentacji planujemy etapami. Znaczenie mają kolor, nasycenie pigmentu, miejsce zabiegu i reakcja skóry. Możliwy zakres określamy po kwalifikacji.</p><a href="/poradnik/laserowe-usuwanie-brwi-permanentnych/">Jak wygląda usuwanie laserowe →</a></article><article class="pmu-brows-method pmu-brows-method-shade" id="remover"><p class="pmu-landing-kicker">Long-Time-Liner®</p><h3>Bye-Bye Pigment Remover</h3><p>Remover jest inną metodą pracy ze starym PMU. Jego wybór wymaga osobnej oceny skóry, pigmentacji i planu dalszej korekty. Nie jest automatycznie zamiennikiem lasera dla każdej osoby.</p><a href="#kwalifikacja">Porozmawiaj o swoim PMU →</a></article></div></section></div><section class="pmu-landing-section " id="cena-usuwania"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">02 / Cena jednego etapu</p><h2>Ile kosztuje usuwanie PMU?</h2></div><div class="pmu-brows-price"><div><p>Laser i remover: <strong>200–400 zł za pojedynczy zabieg.</strong> Dokładną cenę ustalamy po ocenie zakresu pracy.</p><p class="pmu-brows-price-note">To cena jednej wizyty. Liczba etapów jest indywidualna, dlatego nie obiecujemy całkowitego usunięcia pigmentu po jednym zabiegu. Ewentualne nowe PMU wyceniamy osobno.</p></div><div><dl class="pmu-brows-price-list"><div><dt>Laser · ok. 40 minut</dt><dd>200–400 zł</dd></div><div><dt>Remover · ok. 60 minut</dt><dd>200–400 zł</dd></div></dl><div class="pmu-landing-links"><a href="/cennik-makijaz-permanentny/#price-group-5">Pełny cennik usuwania i korekt →</a></div></div></div></section><section class="pmu-landing-section " id="kiedy-usuwac"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">03 / Zanim dodamy nowy pigment</p><h2>Stary kolor nie zawsze da się przykryć.</h2></div><p>Zbyt ciemne brwi, zmieniony odcień, nierówny pigment lub kształt ograniczający nowy projekt to powody, aby zacząć od oceny. Czasem możliwa jest korekta, a czasem najpierw potrzebne jest rozjaśnienie.</p><div class="pmu-landing-links"><a href="/poradnik/kiedy-usuwac-stary-makijaz-permanentny/">Kiedy rozważyć usuwanie starego PMU? →</a></div></section><section class="pmu-landing-section pmu-landing-callout" id="kwalifikacja"><p class="pmu-landing-kicker">Twój pierwszy krok</p><h2>Masz stary makijaż permanentny?</h2><p>Opisz, kiedy i gdzie był wykonany, czy był poprawiany lub usuwany oraz jaki efekt chcesz uzyskać. Na tej podstawie ustalimy, od czego zacząć. Ostateczna kwalifikacja odbywa się po ocenie skóry i pigmentu.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Opisz swój przypadek w formularzu →</a><a href="tel:+48730900125">Zadzwoń: 730 900 125</a></div></section><section class="pmu-landing-section " id="proces-usuwania"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">04 / Spokojnie, etap po etapie</p><h2>Jak wygląda wizyta?</h2></div><ol class="pmu-landing-steps"><li><span>01</span><div><h3>Rozmowa i ocena</h3><p>Poznajemy historię PMU, oczekiwania i aktualny stan skóry.</p></div></li><li><span>02</span><div><h3>Metoda i zabieg</h3><p>Ustalamy zakres, koszt oraz sposób pracy odpowiedni do przypadku.</p></div></li><li><span>03</span><div><h3>Gojenie i kontrola</h3><p>Otrzymujesz indywidualne zalecenia. Oceniamy reakcję skóry i pigmentu.</p></div></li><li><span>04</span><div><h3>Dalsza decyzja</h3><p>Planujemy przerwę, kolejny etap albo możliwość nowego PMU.</p></div></li></ol></section><section class="pmu-landing-section pmu-service17-split" id="co-po-usuwaniu"><div><p class="pmu-landing-kicker">Po rozjaśnieniu</p><h2>Miejsce na nowy projekt — kiedy skóra jest gotowa.</h2><p>Nowy makijaż permanentny planujemy po wygojeniu i ocenie efektu poprzednich etapów. Sama zmiana koloru nie oznacza jeszcze, że można od razu pigmentować.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-brwi/">Brwi →</a><a href="/makijaz-permanentny-ust/">Usta →</a><a href="/makijaz-permanentny-oczu/">Kreski →</a></div></div><figure><Image src={removerPhoto} alt="Preparaty Bye-Bye Pigment Long-Time-Liner do pracy z removerem" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="lazy" decoding="async" /><figcaption>Bye-Bye Pigment · Long-Time-Liner®</figcaption></figure></section><section class="pmu-landing-section pmu-landing-expert" id="ekspert-usuwanie-pmu"><figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — trenerka makijażu permanentnego" width={900} widths={[320,480,640,900]} sizes="(max-width:900px) calc(100vw - 36px), 480px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-landing-kicker">Doświadczenie i sposób pracy</p><h2>Bogusława Herda</h2><p>Trenerka Long-Time-Liner®, Elite Top Linergist i wicemistrzyni świata w makijażu permanentnym. W pracy ze starym PMU najważniejsze są ocena skóry, możliwości korekty i realny plan. Kolejny pigment nie jest rozwiązaniem dla każdej sytuacji.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie i podejście do PMU →</a></div></div></section><section class="pmu-landing-faq" id="faq"><p class="pmu-landing-kicker">Przed wizytą</p><h2>Pytania o usuwanie makijażu permanentnego.</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</section><section class="pmu-landing-section " id="poradniki-usuwanie"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">Więcej odpowiedzi</p><h2>Przeczytaj przed konsultacją.</h2></div><div class="pmu-brows-guides"><a href="/poradnik/kiedy-usuwac-stary-makijaz-permanentny/"><h3>Kiedy usuwać stare PMU?</h3><p>Korekta czy rozjaśnianie — od czego zależy decyzja.</p><span>Czytaj poradnik →</span></a><a href="/poradnik/brwi-permanentne-po-latach/"><h3>Brwi permanentne po latach</h3><p>Co oznaczają zmiany koloru i kształtu.</p><span>Czytaj poradnik →</span></a><a href="/poradnik/nieudany-makijaz-permanentny-brwi-co-zrobic/"><h3>Nieudane brwi — co dalej?</h3><p>Jak przygotować się do oceny wcześniejszej pigmentacji.</p><span>Czytaj poradnik →</span></a></div></section><section class="pmu-landing-booking" id="kontakt"><div><p class="pmu-landing-kicker">Gabinet w Bielsku-Białej</p><h2>Zacznij od dobrego planu.</h2><p>Masz już ustalony zakres? Sprawdź terminy. Przy nieocenionej wcześniejszej pigmentacji najpierw skontaktuj się z gabinetem.</p><p class="pmu-service17-note">Barlickiego 5/23 · Bielsko-Biała</p></div><div class="pmu-landing-booking-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy ↗</a><a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-landing-text-link" href="#kwalifikacja">Potrzebuję kwalifikacji ↑</a></div></section>
<GuideAssistant /></div></main><Footer />
</Layout>
