<script>
  const bindEyeSlider = (
    scrollSelector: string,
    leftSelector: string,
    rightSelector: string,
    cardSelector: string,
    fallbackAmount: number,
    gap: number
  ) => {
    const scroll = document.querySelector<HTMLElement>(scrollSelector);
    const left = document.querySelector<HTMLButtonElement>(leftSelector);
    const right = document.querySelector<HTMLButtonElement>(rightSelector);

    if (!scroll || !left || !right) return;

    const getAmount = () => {
      const firstCard = scroll.querySelector<HTMLElement>(cardSelector);
      if (!firstCard) return fallbackAmount;
      return firstCard.getBoundingClientRect().width + gap;
    };

    left.addEventListener("click", () => {
      scroll.scrollBy({
        left: -getAmount(),
        behavior: "smooth",
      });
    });

    right.addEventListener("click", () => {
      scroll.scrollBy({
        left: getAmount(),
        behavior: "smooth",
      });
    });
  };

  bindEyeSlider(
    "#eyeMethodScroll",
    ".eye-method-arrow-left",
    ".eye-method-arrow-right",
    ".eye-method-card",
    350,
    18
  );

  bindEyeSlider(
    "#eyeGalleryScroll",
    ".eye-gallery-arrow-left",
    ".eye-gallery-arrow-right",
    ".eye-gallery-card",
    300,
    14
  );
</script>
