---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import GalleryPhoto from "../components/GalleryPhoto.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import media from "../data/pmu-media-library.json";
import "../styles/pmu-gallery.css";
import "../styles/pmu-landing.css";
import "../styles/pmu-brows.css";
import "../styles/pmu-eyes.css";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-oczu/";
const pageTitle =
  "Kreski permanentne Bielsko-Biała | Makijaż permanentny oczu";
const pageDescription =
  "Kreski permanentne Bielsko-Biała u Bogusławy Herda. Zagęszczenie linii rzęs od 800 zł, kreska dekoracyjna 1100 zł, kreska dolna 500 zł. Zobacz efekty i terminy.";

const heroPhoto = media.oczy[7];
// Własne zdjęcia z zatwierdzonej kategorii Oczy. Bez deklarowania etapu wygojenia.
const eyePhotos = [
  { ...media.oczy[1], alt: "Górna kreska permanentna przy linii rzęs — zbliżenie brązowego oka", caption: "Podkreślenie górnej linii rzęs w zbliżeniu." },
  { ...media.oczy[3], alt: "Górna kreska dekoracyjna — wyraźniejsza linia z zakończeniem", caption: "Wyraźniejsza górna kreska i jej zakończenie." },
  { ...media.oczy[11], alt: "Kreska permanentna na zamkniętej górnej powiece", caption: "Przebieg kreski na zamkniętej powiece." },
  { ...media.oczy[12], alt: "Górna kreska cieniowana — kontur i miękkie rozproszenie koloru", caption: "Kontur i miękkie cieniowanie górnej kreski." },
];
const steps = [
  { title: "Rozmowa i ocena oka", text: "Omawiamy oczekiwany efekt, stan skóry, wrażliwość oczu oraz wcześniejszą pigmentację. Oglądamy powiekę i naturalną linię rzęs." },
  { title: "Rysunek wstępny", text: "Dobieramy przebieg, grubość i zakończenie kreski. Zanim zaczniemy pigmentację, akceptujesz projekt dopasowany do Twoich oczu." },
  { title: "Pigmentacja i zalecenia", text: "Pracujemy według ustalonego projektu. Po zabiegu otrzymujesz indywidualne zalecenia dotyczące pielęgnacji i gojenia." },
  { title: "Wygojenie i korekta", text: "Oceniamy wygojony efekt i dopracowujemy linię. Korekta zabiegu głównego oznaczonego gwiazdką w Cenniku odbywa się do 2 miesięcy." },
];
const faqItems = [
  { question: "Ile trwa zabieg kreski permanentnej?", answer: "W Cenniku przewidziano 120 minut na kreskę zagęszczającą, dekoracyjną i warianty łączone oraz 90 minut na kreskę dolną. Czas obejmuje także rozmowę i przygotowanie projektu.", href: "/poradnik/ile-trwa-zabieg-makijazu-permanentnego/", label: "Jak zaplanować czas wizyty" },
  { question: "Czy makijaż permanentny oczu boli?", answer: "Odczucia są indywidualne, a okolica oka jest wrażliwa. Przed zabiegiem omawiamy przebieg pracy, stan skóry i Twój komfort.", href: "/poradnik/czy-makijaz-permanentny-boli/", label: "Odczucia podczas pigmentacji" },
  { question: "Czy przy opadającej powiece można zrobić eyeliner?", answer: "Nie zawsze. Decyzja zależy od budowy powieki i zachowania skóry przy otwartym oku. Czasem lepszym kierunkiem jest subtelne podkreślenie linii rzęs; najpierw potrzebna jest kwalifikacja.", href: "/poradnik/kreska-permanentna-przy-opadajacej-powiece/", label: "Kreska przy opadającej powiece" },
  { question: "Jak goi się kreska i kiedy ocenić efekt?", answer: "Bezpośrednio po zabiegu kreska może wyglądać intensywniej. Efekt oceniamy po wygojeniu i stabilizacji pigmentu. W tym czasie stosuj indywidualne zalecenia gabinetu.", href: "/poradnik/kreska-permanentna-gojenie/", label: "Gojenie i pielęgnacja kreski" },
  { question: "Czy cena obejmuje korektę?", answer: "Tak. Zabiegi główne oznaczone w Cenniku gwiazdką obejmują korektę po wygojeniu, do 2 miesięcy od zabiegu głównego. Późniejsze odświeżenie lub poprawa pracy z innego gabinetu wymagają osobnej oceny i wyceny.", href: "/cennik-makijaz-permanentny/#price-group-2", label: "Zakres i aktualne ceny kresek" },
  { question: "Czym różni się eyeliner od kreski cieniowanej?", answer: "Eyeliner ma wyraźniej zaznaczoną linię, a cieniowanie daje bardziej miękkie przejście koloru. Oba kierunki należą w naszym Cenniku do kreski dekoracyjnej; efekt dobieramy do konkretnej powieki.", href: "/poradnik/kreski-permanentne-cieniowane/", label: "Więcej o kresce cieniowanej" },
  { question: "Czy kreska dolna jest dla każdego?", answer: "Nie wybieramy jej automatycznie. Ocenie podlegają budowa oka, dolna powieka oraz to, jak linia współgra z górną kreską i całą oprawą oka.", href: "/poradnik/kreska-permanentna-jak-wybrac-rodzaj/", label: "Jak wybrać rodzaj kreski" },
  { question: "Co zgłosić przed pigmentacją oczu?", answer: "Poinformuj gabinet o chorobach oczu, wrażliwości, przyjmowanych lekach, soczewkach kontaktowych i wcześniejszych zabiegach. Przygotowanie oraz możliwość pigmentacji ustalamy podczas kwalifikacji; w razie potrzeby również po konsultacji lekarskiej.", href: "/poradnik/przeciwwskazania-do-makijazu-permanentnego/", label: "Przeciwwskazania i kwalifikacja" },
];
const guides = [
  { title: "Jaka kreska pasuje do oka?", text: "Zagęszczenie, eyeliner, cieniowanie i kreska dolna — porównanie efektów.", href: "/poradnik/kreska-permanentna-jak-wybrac-rodzaj/" },
  { title: "Co obejmuje cena kreski?", text: "Zakres pracy i korekta. Pełne aktualne kwoty znajdziesz w Cenniku.", href: "/poradnik/kreska-permanentna-cena/" },
  { title: "Subtelne podkreślenie rzęs", text: "Na czym polega zagęszczenie linii rzęs i kiedy warto je rozważyć.", href: "/poradnik/kreska-zageszczajaca-linie-rzes/" },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    dateModified: "2026-09-20",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website",
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/galeria-10/oczy/oczy-08.webp",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Makijaż permanentny oczu",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Kreski permanentne Bielsko-Biała",
    serviceType: "Makijaż permanentny oczu",
    description:
      "Kreski permanentne w Bielsku-Białej: zagęszczenie linii rzęs, kreska dekoracyjna, kreska dolna i warianty łączone.",
    areaServed: {
      "@type": "City",
      name: "Bielsko-Biała",
    },
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "500",
      highPrice: "1400",
      priceCurrency: "PLN",
      offerCount: "5",
      url: pageUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/makijaz-permanentny-oczu/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-landing-skip" href="#zakres-kresek">Przejdź do wyboru kreski</a>
  <main class="pmu-landing pmu-gallery pmu-brows pmu-eyes">
    <div class="pmu-landing-shell">
      <nav class="pmu-landing-breadcrumbs" aria-label="Okruszki nawigacyjne"><a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/makijaz-permanentny-bielsko/">Makijaż permanentny</a><span aria-hidden="true">/</span><span aria-current="page">Kreski</span></nav>
      <section class="pmu-landing-intro pmu-brows-hero" aria-labelledby="kreski-tytul">
        <div>
          <p class="pmu-landing-kicker">Kreski permanentne · Bielsko-Biała</p>
          <h1 id="kreski-tytul"><span>Kreski permanentne</span>, które podkreślają spojrzenie bez ciężkiego efektu.</h1>
          <p class="pmu-landing-lead">Subtelna linia przy rzęsach czy bardziej wyrazisty eyeliner? Dobieramy kreskę do powieki, kształtu oka i Twojego codziennego stylu. Zaczynamy od rozmowy i rysunku.</p>
          <a class="pmu-landing-author" href="#doswiadczenie-kreski"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" /><span><strong>Bogusława Herda</strong><span>Wicemistrzyni świata · trenerka PMU</span></span></a>
          <p class="pmu-eyes-hero-price"><strong>Górna kreska od 800 zł</strong><span>z korektą po wygojeniu, do 2 miesięcy</span></p>
          <div class="pmu-brows-hero-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a><a class="pmu-landing-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div>
        </div>
        <figure class="pmu-brows-hero-photo"><img src={heroPhoto.thumb} srcset={heroPhoto.srcset} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) 520px, (max-width:1156px) calc((100vw - 92px) / 2.15), 495px" width={heroPhoto.width} height={heroPhoto.height} alt="Górna kreska permanentna — podkreślenie niebieskiego oka, praca gabinetu Bogusława Herda" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Linia dopasowana do oka. <span>Praca gabinetu Bogusława Herda.</span></figcaption></figure>
      </section>
      <nav class="pmu-landing-nav" aria-label="Przejdź do wybranej części strony"><a href="#zakres-kresek">Rodzaje kresek ↓</a><a href="#efekty-kresek">Zdjęcia i film ↓</a><a href="#cena-kresek">Cena i korekta ↓</a><a href="#doswiadczenie-kreski">Doświadczenie ↓</a><a href="#pytania-kreski">Pytania ↓</a></nav>

      <section class="pmu-landing-section" id="zakres-kresek" aria-labelledby="zakres-tytul">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Twój efekt</p><h2 id="zakres-tytul">Delikatna oprawa czy widoczna kreska?</h2><p>Nie musisz znać nazwy techniki. Powiedz, jaki efekt lubisz — dyskretny akcent przy rzęsach czy wyraźniejszą linię na powiece.</p></div>
        <div class="pmu-brows-methods">
          <article class="pmu-brows-method"><p class="pmu-landing-kicker">Subtelne podkreślenie</p><h3>Zagęszczenie linii rzęs</h3><p>Pigmentacja blisko nasady górnych rzęs. Podkreśla oprawę oka bez rozbudowanego zakończenia charakterystycznego dla eyelinera.</p><dl><div><dt>Dla jakiego efektu?</dt><dd>Gdy zależy Ci na delikatniejszym, codziennym wyglądzie i optycznie pełniejszej linii rzęs.</dd></div></dl><a href="/poradnik/kreska-zageszczajaca-linie-rzes/">Poznaj zagęszczenie linii rzęs <span aria-hidden="true">→</span></a></article>
          <article class="pmu-brows-method pmu-brows-method-shade"><p class="pmu-landing-kicker">Eyeliner lub cieniowanie</p><h3>Kreska dekoracyjna</h3><p>Wyraźniejsza linia albo bardziej miękkie przejście koloru. Grubość, długość i zakończenie dopasowujemy do budowy powieki.</p><dl><div><dt>Dla jakiego efektu?</dt><dd>Gdy lubisz mocniejsze podkreślenie oka, a budowa i stan powieki pozwalają wykonać wybrany projekt.</dd></div></dl><a href="#efekty-kresek">Zobacz prace gabinetu <span aria-hidden="true">↓</span></a></article>
        </div>
        <div class="pmu-brows-choice" id="naturalny-efekt-kreski"><h3>A kreska dolna?</h3><p>To osobny zakres pracy, który można połączyć z górną kreską. Nie jest automatycznym dodatkiem: oceniamy, czy podkreśli oko zgodnie z oczekiwanym efektem.</p><p class="pmu-eyes-choice-note" id="dla-kogo-kreski">Jasne rzęsy, asymetria czy opadająca powieka wymagają różnych rozwiązań. <strong>Najpierw oceniamy oko, skórę i wcześniejszy pigment. Dopiero potem wybieramy kreskę.</strong></p></div>
      </section>

      <section class="pmu-landing-section" id="efekty-kresek" aria-labelledby="efekty-tytul" data-pmu-gallery-section data-media-label="Kreski permanentne" data-service-href="/galeria/#galeria-kreski" data-service-label="Więcej zdjęć kresek w galerii">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">02 / Prace gabinetu</p><h2 id="efekty-tytul">Zobacz linię, kontur i cieniowanie.</h2><p>Dotknij zdjęcia, aby je powiększyć. To przykłady górnych kresek wykonanych w gabinecie. Inspiracja pomaga w rozmowie — projekt powstaje dla Twojej powieki, a efekt oceniamy po wygojeniu.</p></div>
        <div class="pmu-brows-photo-grid pmu-eyes-photo-grid">{eyePhotos.map(image => <GalleryPhoto image={image} />)}</div>
        <details class="pmu-landing-more pmu-brows-film"><summary>Zobacz kreskę w ruchu — film z gabinetu <span aria-hidden="true">+</span></summary><figure><video width="1080" height="1350" controls playsinline muted preload="none" poster="/video/makijaz-permanentny-oczu-efekt-01-poster.webp" aria-label="Film z gabinetu: górna kreska permanentna w zbliżeniu"><source src="/video/makijaz-permanentny-oczu-efekt-01.mp4" type="video/mp4" />Twoja przeglądarka nie obsługuje odtwarzania filmu.</video><figcaption>Przebieg kreski na górnej powiece.</figcaption></figure></details>
        <div class="pmu-landing-links"><a href="/galeria/#galeria-kreski">Zobacz więcej realizacji kresek →</a></div>
      </section>

      <section class="pmu-landing-section pmu-brows-price" id="cena-kresek" aria-labelledby="cena-tytul">
        <div><p class="pmu-landing-kicker">03 / Cena i zakres</p><h2 id="cena-tytul">Wybierz zakres pigmentacji.</h2><dl class="pmu-brows-price-list"><div><dt>Kreska dolna*</dt><dd>500 zł</dd></div><div><dt>Zagęszczenie górnej linii rzęs*</dt><dd>800 zł</dd></div><div><dt>Kreska dekoracyjna*</dt><dd>1100 zł</dd></div></dl><p class="pmu-brows-price-note">Warianty łączone: dolna + górna zagęszczająca* — 1100 zł; dolna + dekoracyjna* — 1400 zł.</p><div class="pmu-landing-links"><a href="/cennik-makijaz-permanentny/#price-group-2">Pełny cennik makijażu permanentnego oczu →</a></div></div>
        <div><h3>Korekta jest w cenie.</h3><p>* Zabieg główny oznaczony gwiazdką obejmuje korektę po wygojeniu, <strong>do 2 miesięcy od zabiegu głównego</strong>.</p><p class="pmu-brows-price-note">Późniejsze odświeżenie oraz poprawa pracy z innego gabinetu wymagają indywidualnej oceny i wyceny.</p><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="pmu-landing-section" id="proces-kreski" aria-labelledby="proces-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">04 / Od projektu do wygojenia</p><h2 id="proces-tytul">Najpierw rysunek. Potem pigmentacja.</h2></div><ol class="pmu-landing-steps">{steps.map((step,index) => <li><span aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><div class="pmu-landing-links"><a href="/poradnik/kreska-permanentna-gojenie/">Jak goi się kreska permanentna? →</a></div></section>

      <section class="pmu-landing-callout" id="kwalifikacja-kreski" aria-labelledby="kwalifikacja-tytul"><p class="pmu-landing-kicker">Przed wyborem terminu</p><h2 id="kwalifikacja-tytul">Opadająca powieka, stare PMU lub wrażliwe oczy?</h2><p>Zacznij od kwalifikacji. Wcześniejsza kreska, stan skóry i budowa powieki wpływają na możliwość wykonania nowego projektu. Czasem potrzebna jest zmiana zakresu pracy lub ocena możliwości usunięcia pigmentu.</p><div class="pmu-landing-links"><a class="pmu-landing-secondary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Opisz swoją sytuację — formularz kwalifikacji →</a><a href="/poradnik/kreska-permanentna-przy-opadajacej-powiece/">Kreska przy opadającej powiece →</a><a href="/usuwanie-makijazu-permanentnego/">Kiedy rozważyć usuwanie PMU →</a></div></section>

      <section class="pmu-landing-section pmu-landing-expert" id="doswiadczenie-kreski" aria-labelledby="doswiadczenie-tytul"><figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — linergistka i trenerka makijażu permanentnego" width={720} widths={[240,360,540,720]} sizes="(max-width:640px) 200px, (max-width:900px) 280px, 340px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-landing-kicker">05 / Doświadczenie i uważny projekt</p><h2 id="doswiadczenie-tytul">Bogusława Herda</h2><p>Wicemistrzyni świata w makijażu permanentnym, europejski trener Long-Time-Liner® i kosmetolog z ponad 10-letnią praktyką gabinetową.</p><p class="pmu-brows-expert-note">W kreskach liczy się więcej niż sama linia: kształt oka, ruch powieki, rzęsy i cała oprawa twarzy. Projekt ustalamy wspólnie, z myślą o efekcie po wygojeniu.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie i sposób pracy →</a></div></div></section>

      <section class="pmu-landing-faq" id="pytania-kreski" aria-labelledby="faq-tytul"><p class="pmu-landing-kicker">Przed rezerwacją</p><h2 id="faq-tytul">Pytania o kreski permanentne.</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}<br /><a class="pmu-brows-faq-link" href={item.href}>{item.label} →</a></p></details>)}</section>

      <section class="pmu-landing-section" aria-labelledby="poradniki-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">Więcej odpowiedzi w Poradniku</p><h2 id="poradniki-tytul">Wybierz temat, który Cię interesuje.</h2></div><div class="pmu-brows-guides">{guides.map(item => <a href={item.href}><h3>{item.title}</h3><p>{item.text}</p><span>Czytaj poradnik →</span></a>)}</div></section>

      <section class="pmu-landing-booking" id="kontakt" aria-labelledby="rezerwacja-tytul"><div><p class="pmu-landing-kicker">Twój następny krok</p><h2 id="rezerwacja-tytul">Dobierzmy kreskę do Twojego spojrzenia.</h2><p>Sprawdź terminy w gabinecie Bogusława Herda.<br />Bielsko-Biała, ul. Barlickiego 5/23.</p></div><div class="pmu-landing-booking-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a><a class="pmu-landing-secondary" href="tel:+48730900125">Zadzwoń: 730 900 125</a><a class="pmu-landing-text-link" href="/kontakt/">Sprawdź dojazd i kontakt →</a></div></section>
      <GuideAssistant />
