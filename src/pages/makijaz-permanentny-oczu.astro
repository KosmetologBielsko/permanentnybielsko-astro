---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const booksyUrl =
  "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";

const pageUrl =
  "https://www.permanentnybielsko.com/makijaz-permanentny-oczu/";

const pageTitle =
  "Kreski permanentne Bielsko-Biała | Makijaż permanentny oczu";

const pageDescription =
  "Kreski permanentne Bielsko-Biała u Bogusławy Herda. Zagęszczenie linii rzęs od 800 zł, kreska dekoracyjna 1100 zł, kreska dolna 500 zł. Zobacz efekty i terminy.";

const eyeGalleryImages = Array.from({ length: 12 }, (_, index) => {
  const number = String(index + 1).padStart(2, "0");

  return {
    src: `/images/makijaz-permanentny-oczu-bielsko-biala-efekt-${number}.webp`,
    alt: `Makijaż permanentny oczu Bielsko-Biała — efekt kreski permanentnej ${number}`,
  };
});

const forWhoItems = [
  {
    title: "Jasna linia rzęs",
    text: "gdy oko potrzebuje subtelnego podkreślenia bez efektu mocnej, widocznej kreski",
    image: "/images/01-jasna-linia-rzes.webp",
  },
  {
    title: "Codzienna kreska",
    text: "gdy klientka regularnie maluje linię rzęs i chce skrócić poranną rutynę",
    image: "/images/02-codzienna-kreska.webp",
  },
  {
    title: "Mało wyraziste oko",
    text: "gdy oprawa oka wymaga delikatnego uporządkowania i optycznego zagęszczenia rzęs",
    image: "/images/03-malo-wyraziste-oko.webp",
  },
  {
    title: "Asymetria powiek",
    text: "gdy przebieg kreski trzeba dopasować do różnic między jednym i drugim okiem",
    image: "/images/04-asymetria-powiek.webp",
  },
  {
    title: "Opadająca powieka",
    text: "gdy potrzebna jest szczególnie ostrożna kwalifikacja i spokojny plan kreski",
    image: "/images/05-opadajaca-powieka.webp",
  },
  {
    title: "Naturalna zmiana",
    text: "gdy celem jest świeższe spojrzenie bez ciężkiego, graficznego efektu",
    image: "/images/06-naturalna-zmiana.webp",
  },
];

const methodItems = [
  {
    title: "Zagęszczenie linii rzęs",
    text: "Najsubtelniejszy wariant, który wzmacnia oprawę oka bez efektu klasycznej kreski.",
    price: "800 zł",
  },
  {
    title: "Kreska dekoracyjna",
    text: "Eyeliner lub kreska cieniowana — bardziej wyrazisty efekt, jeśli pozwala na to budowa powieki.",
    price: "1100 zł",
  },
  {
    title: "Kreska dolna",
    text: "Delikatne podkreślenie dolnej powieki, zawsze dopasowane do oka i całego efektu.",
    price: "500 zł",
  },
  {
    title: "Dolna + górna zagęszczająca",
    text: "Połączenie subtelnej kreski dolnej z zagęszczeniem linii rzęs na górnej powiece.",
    price: "1100 zł",
  },
  {
    title: "Dolna + dekoracyjna",
    text: "Najbardziej rozbudowany wariant, wymagający dobrej kwalifikacji i odpowiedniej budowy oka.",
    price: "1400 zł",
  },
];

const processItems = [
  {
    title: "Konsultacja",
    text: "Oczekiwania, codzienny makijaż, wrażliwość oczu i wcześniejsze zabiegi.",
  },
  {
    title: "Analiza oka",
    text: "Ocena powieki, asymetrii, linii rzęs, opadania skóry i naturalnego kształtu oka.",
  },
  {
    title: "Rysunek wstępny",
    text: "Przebieg kreski, jej długość, grubość i intensywność omawiane są przed pigmentacją.",
  },
  {
    title: "Dobór wariantu",
    text: "Ustalamy, czy najlepsze będzie zagęszczenie rzęs, kreska dekoracyjna czy inny zakres.",
  },
  {
    title: "Pigmentacja",
    text: "Precyzyjna praca przy linii rzęs z kontrolą kształtu, symetrii i reakcji skóry.",
  },
  {
    title: "Gojenie",
    text: "Skóra się stabilizuje, a kreska stopniowo pokazuje finalny kierunek efektu.",
  },
  {
    title: "Dopigmentowanie",
    text: "Jeśli jest potrzebne, pozwala dopracować nasycenie, równość i stabilność kreski.",
  },
];

const avoidItems = [
  {
    title: "Nie robimy kreski na siłę",
    text: "Kształt kreski musi wynikać z budowy oka, powieki, rzęs i możliwości skóry.",
  },
  {
    title: "Nie każda powieka lubi kreskę dekoracyjną",
    text: "Przy opadającej lub wiotkiej powiece często lepszy jest subtelniejszy wariant.",
  },
  {
    title: "Nie kopiujemy trendów",
    text: "Kreska ma pasować do oka i twarzy, a nie do chwilowej mody z internetu.",
  },
  {
    title: "Nie pomijamy kwalifikacji",
    text: "Wrażliwość oczu, stan skóry i wcześniejsze zabiegi mają znaczenie dla planu pracy.",
  },
  {
    title: "Nie oceniamy efektu od razu",
    text: "Finalny wygląd kreski ocenia się po wygojeniu i stabilizacji pigmentu.",
  },
];

const faqItems = [
  {
    question: "Ile kosztują kreski permanentne w Bielsku-Białej?",
    answer:
      "Kreska zagęszczająca kosztuje 800 zł, kreska dekoracyjna — eyeliner lub cieniowana — 1100 zł, a kreska dolna 500 zł. W cenniku dostępne są także warianty łączone.",
  },
  {
    question: "Czy kreski permanentne mogą wyglądać naturalnie?",
    answer:
      "Tak. Najbardziej naturalnym wariantem jest często zagęszczenie linii rzęs, które podkreśla oko bez efektu klasycznej, mocnej kreski.",
  },
  {
    question: "Czym różni się zagęszczenie rzęs od kreski?",
    answer:
      "Zagęszczenie rzęs jest bardzo subtelne i wykonywane blisko linii rzęs. Kreska dekoracyjna jest bardziej widoczna i daje mocniejszy efekt makijażu.",
  },
  {
    question: "Czy kreska jest dobierana do kształtu oka?",
    answer:
      "Tak. Kreska powinna być dopasowana do powieki, kształtu oka, asymetrii, naturalnej linii rzęs i codziennego makijażu klientki.",
  },
  {
    question: "Czy makijaż permanentny oczu boli?",
    answer:
      "Odczucia są indywidualne. Okolica oka jest wrażliwa, dlatego przed zabiegiem omawiany jest przebieg pracy i komfort klientki.",
  },
  {
    question: "Czy przy opadającej powiece można zrobić kreskę dekoracyjną?",
    answer:
      "Nie zawsze. Przy opadającej powiece, wiotkiej skórze lub szczególnej budowie oka lepszym rozwiązaniem może być subtelniejsze zagęszczenie linii rzęs.",
  },
  {
    question: "Kiedy widać finalny efekt?",
    answer:
      "Bezpośrednio po zabiegu kreska może być intensywniejsza. Finalny efekt ocenia się po wygojeniu skóry i stabilizacji pigmentu.",
  },
  {
    question: "Gdzie wykonywany jest makijaż permanentny oczu?",
    answer:
      "Zabieg wykonywany jest w gabinecie Bogusławy Herda w Bielsku-Białej. Aktualne terminy można sprawdzić w Booksy.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website",
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url:
        "https://www.permanentnybielsko.com/images/makijaz-permanentny-oczu-bielsko-biala-efekt-01.webp",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item:
          "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Makijaż permanentny oczu",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Kreski permanentne Bielsko-Biała",
    serviceType: "Makijaż permanentny oczu",
    description:
      "Kreski permanentne w Bielsku-Białej: zagęszczenie linii rzęs, kreska dekoracyjna, kreska dolna i warianty łączone.",
    areaServed: {
      "@type": "City",
      name: "Bielsko-Biała",
    },
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "500",
      highPrice: "1400",
      priceCurrency: "PLN",
      offerCount: "5",
      url: pageUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/makijaz-permanentny-oczu/"
  structuredData={structuredData}
>
  <div class="eye-page">
    <Header />

    <main>
      <section class="eye-hero">
        <div class="eye-glow eye-glow-one" aria-hidden="true"></div>
        <div class="eye-glow eye-glow-two" aria-hidden="true"></div>

        <div class="container eye-hero-grid">
          <div class="eye-hero-copy">
            <p class="section-kicker">Kreski permanentne Bielsko-Biała</p>

            <h1>
              <span class="eye-rose-text">Kreski permanentne</span>,
              które podkreślają spojrzenie bez ciężkiego efektu.
            </h1>

            <p class="eye-hero-lead">
              Od subtelnego zagęszczenia linii rzęs po kreskę dekoracyjną.
              Każdy wariant dobierany jest do powieki, kształtu oka, asymetrii
              i codziennego stylu.
            </p>

            <div class="eye-hero-actions" aria-label="Kreski permanentne — szybkie działania">
              <a
                class="button-booksy"
                href={booksyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booksy <span aria-hidden="true">→</span>
              </a>

              <a class="button-primary" href="#efekty-kresek">
                Zobacz efekty <span aria-hidden="true">→</span>
              </a>

              <a class="button-secondary" href="/cennik-makijaz-permanentny/">
                Cennik
              </a>
            </div>

            <p class="eye-hero-note">
              Masz opadającą powiekę, stare PMU albo bardzo wrażliwe oczy?
              Warto zacząć od kwalifikacji zamiast wybierać rodzaj kreski w ciemno.
            </p>
          </div>

          <aside class="eye-hero-card" aria-label="Podejście do kresek permanentnych">
            <p class="eye-card-label">Eyes</p>
            <h2>Najlepsza kreska to ta, która pasuje do oka.</h2>
            <p>
              Nie kopiujemy jednego wzoru. Linia musi współpracować z powieką,
              rzęsami i naturalnym kierunkiem spojrzenia — również po wygojeniu.
            </p>
          </aside>
        </div>
      </section>

      <section class="eye-proof-section" aria-label="Najważniejsze informacje o kreskach permanentnych">
        <div class="container eye-proof-grid">
          <div>
            <strong>Zagęszczenie rzęs</strong>
            <span>od 800 zł</span>
          </div>
          <div>
            <strong>Kreska dekoracyjna</strong>
            <span>1100 zł</span>
          </div>
          <div>
            <strong>Analiza powieki</strong>
            <span>kształt dobierany do oka</span>
          </div>
          <div>
            <strong>Rysunek wstępny</strong>
            <span>przebieg kreski przed pigmentacją</span>
          </div>
        </div>
      </section>

      <section class="eye-natural-section">
        <div class="container eye-natural-card">
          <figure class="eye-photo-frame eye-natural-photo">
            <img
              src="/images/makijaz-permanentny-oczu-bielsko-biala-efekt-01.webp"
              alt="Makijaż permanentny oczu Bielsko-Biała — subtelne zagęszczenie linii rzęs"
              width="1400"
              height="1400"
              loading="eager"
              decoding="async"
            />
          </figure>

          <div class="eye-natural-copy">
            <p class="section-kicker">Naturalne spojrzenie</p>
            <h2>Kreska permanentna nie musi wyglądać jak eyeliner z wieczorowego makijażu.</h2>
            <p>
              Najsubtelniejszy efekt może być prawie niewidoczną linią pomiędzy rzęsami.
              Mocniejsza kreska ma sens tylko wtedy, gdy pasuje do budowy powieki
              i nie zamyka optycznie oka.
            </p>
          </div>
        </div>
      </section>

      <section class="eye-methods-section" id="zakres-kresek">
        <div class="container">
          <div class="eye-section-heading">
            <p class="section-kicker">Zakres kresek</p>
            <h2>Najpierw oko i powieka. Dopiero później wybór rodzaju kreski.</h2>
            <p>
              Wariant dobieramy do anatomii oka i oczekiwanego efektu,
              a nie do samej nazwy techniki.
            </p>
          </div>

          <figure class="eye-collage-card">
            <img
              src="/images/makijaz-permanentny-oczu-metody-kolaz.webp"
              alt="Kolaż efektów makijażu permanentnego oczu pokazujący różne typy kreski permanentnej"
              width="1672"
              height="941"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="eye-slider-controls" aria-label="Przewijanie wariantów kresek">
            <button
              class="eye-slider-arrow eye-method-arrow-left"
              type="button"
              aria-label="Poprzedni wariant kreski"
            >
              ←
            </button>
            <button
              class="eye-slider-arrow eye-method-arrow-right"
              type="button"
              aria-label="Następny wariant kreski"
            >
              →
            </button>
          </div>

          <div class="eye-method-scroll" id="eyeMethodScroll">
            {methodItems.map((item, index) => (
              <article
                class:list={[
                  "eye-method-card",
                  index % 2 === 1 && "eye-method-card-rose",
                  index === 4 && "eye-method-card-strong",
                ]}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <strong>{item.price}</strong>
              </article>
            ))}
          </div>

          <div class="eye-price-strip" aria-label="Najważniejsze ceny kresek permanentnych">
            <div>
              <span>Zagęszczająca</span>
              <strong>800 zł</strong>
            </div>
            <div>
              <span>Dekoracyjna</span>
              <strong>1100 zł</strong>
            </div>
            <div>
              <span>Dolna</span>
              <strong>500 zł</strong>
            </div>
            <a href="/cennik-makijaz-permanentny/">
              Pełny cennik <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="eye-signature-section">
        <div class="container eye-signature-card">
          <div class="eye-signature-copy">
            <p class="section-kicker section-kicker-light">Kształt i powieka</p>
            <h2>Kreska dobrana do oka, nie do chwilowego trendu.</h2>
            <p>
              Celem jest świeższe spojrzenie i linia, która współpracuje
              z powieką, rzęsami oraz naturalną mimiką oka.
            </p>
          </div>

          <figure class="eye-signature-video-frame">
            <video
              class="eye-signature-video"
              poster="/video/makijaz-permanentny-oczu-efekt-01-poster.webp"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Makijaż permanentny oczu — subtelne podkreślenie spojrzenia"
            >
              <source
                src="/video/makijaz-permanentny-oczu-efekt-01.mp4"
                type="video/mp4"
              />
            </video>
          </figure>

          <div class="eye-signature-points">
            <div>
              <span>01</span>
              <strong>Linia rzęs</strong>
              <p>Pigmentacja wzmacnia oprawę oka bez przypadkowej, ciężkiej plamy.</p>
            </div>
            <div>
              <span>02</span>
              <strong>Budowa powieki</strong>
              <p>Kształt kreski uwzględnia skórę, opadanie i naturalny układ oka.</p>
            </div>
            <div>
              <span>03</span>
              <strong>Kontrolowana intensywność</strong>
              <p>Efekt może być subtelny albo mocniejszy, ale zawsze zaplanowany.</p>
            </div>
            <div>
              <span>04</span>
              <strong>Wygojenie</strong>
              <p>Finalną linię oceniamy po stabilizacji pigmentu i skóry.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="eye-gallery-section" id="efekty-kresek">
        <div class="container eye-gallery-heading-row">
          <div class="eye-section-heading">
            <p class="section-kicker">Efekty kresek</p>
            <h2>Różne oczy, jeden standard: kreska ma pasować do spojrzenia.</h2>
            <p>
              Galeria pokazuje różne kierunki — od subtelnego zagęszczenia
              po bardziej widoczną kreskę.
            </p>
          </div>

          <div class="eye-slider-controls" aria-label="Przewijanie galerii kresek">
            <button
              class="eye-slider-arrow eye-gallery-arrow-left"
              type="button"
              aria-label="Poprzednie zdjęcie"
            >
              ←
            </button>
            <button
              class="eye-slider-arrow eye-gallery-arrow-right"
              type="button"
              aria-label="Następne zdjęcie"
            >
              →
            </button>
          </div>
        </div>

        <div class="eye-gallery-scroll" id="eyeGalleryScroll">
          {eyeGalleryImages.map((image) => (
            <figure class="eye-gallery-card">
              <img
                src={image.src}
                alt={image.alt}
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>

      <section class="eye-for-section" aria-label="Kiedy warto wykonać kreskę permanentną">
        <div class="container">
          <div class="eye-section-heading">
            <p class="section-kicker">Kiedy warto?</p>
            <h2>Kreska permanentna ma podkreślić oko, a nie walczyć z jego budową.</h2>
            <p>
              Od jasnej linii rzęs po opadającą powiekę — różne sytuacje
              wymagają innego planu.
            </p>
          </div>

          <div class="eye-for-grid">
            {forWhoItems.map((item) => (
              <figure class="eye-for-card">
                <img
                  src={item.image}
                  alt={`${item.title} — ${item.text}`}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="eye-process-section">
        <div class="container">
          <div class="eye-process-intro">
            <div class="eye-process-copy">
              <p class="section-kicker">Proces zabiegu</p>
              <h2>Najpierw analiza oka i rysunek. Dopiero później pigmentacja.</h2>
              <p>
                Przebieg kreski wpływa na odbiór całej twarzy, dlatego przed zabiegiem
                omawiamy powiekę, linię rzęs, asymetrię, długość i grubość linii.
              </p>
            </div>

            <figure class="eye-photo-frame eye-process-photo">
              <img
                src="/images/makijaz-permanentny-oczu-proces-boguslawa-herda.webp"
                alt="Bogusława Herda podczas wykonywania makijażu permanentnego oczu"
                width="1000"
                height="1500"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>

          <div class="eye-process-grid">
            {processItems.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="eye-safety-section">
        <div class="container eye-safety-grid">
          <div class="eye-safety-card">
            <p class="section-kicker">Bezpieczna kwalifikacja</p>
            <h2>Nie każda powieka potrzebuje mocnej kreski.</h2>
            <p>
              Opadająca powieka, wiotka skóra, wcześniejsze PMU czy wrażliwość oka
              mogą zmienić zakres pracy. Czasem mniej daje lepszy efekt.
            </p>

            <a
              class="button-primary eye-form-link"
