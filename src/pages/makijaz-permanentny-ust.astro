<script>
  const bindLipsSlider = (
    scrollSelector: string,
    leftSelector: string,
    rightSelector: string,
    cardSelector: string,
    fallbackAmount: number,
    gap: number
  ) => {
    const scroll = document.querySelector<HTMLElement>(scrollSelector);
    const left = document.querySelector<HTMLButtonElement>(leftSelector);
    const right = document.querySelector<HTMLButtonElement>(rightSelector);

    if (!scroll || !left || !right) return;

    const getAmount = () => {
      const card = scroll.querySelector<HTMLElement>(cardSelector);
      return card ? card.getBoundingClientRect().width + gap : fallbackAmount;
    };

    left.addEventListener("click", () => {
      scroll.scrollBy({ left: -getAmount(), behavior: "smooth" });
    });

    right.addEventListener("click", () => {
      scroll.scrollBy({ left: getAmount(), behavior: "smooth" });
    });
  };
</script>

<script>
  const bindUnifiedPmuUx = () => {
    document.querySelectorAll<HTMLElement>("[data-pmu-effects]").forEach((section) => {
      const track = section.querySelector<HTMLElement>("[data-pmu-effects-track]");
      const prev = section.querySelector<HTMLButtonElement>("[data-pmu-effects-prev]");
      const next = section.querySelector<HTMLButtonElement>("[data-pmu-effects-next]");

      if (!track) return;

      const amount = () => {
        const card = track.querySelector<HTMLElement>(".pmu-effect-card");
        return card ? card.getBoundingClientRect().width + 12 : Math.min(track.clientWidth * 0.82, 360);
      };

      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -amount(), behavior: "smooth" });
      });

      next?.addEventListener("click", () => {
        track.scrollBy({ left: amount(), behavior: "smooth" });
      });
    });

    document.querySelectorAll<HTMLDetailsElement>(".pmu-method-item").forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;

        document.querySelectorAll<HTMLDetailsElement>(".pmu-method-item[open]").forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>("[data-pmu-effect-dialog]");
    const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-pmu-effect-dialog-image]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-pmu-effect-dialog-close]");
    const previous = dialog?.querySelector<HTMLButtonElement>("[data-pmu-effect-dialog-prev]");
    const next = dialog?.querySelector<HTMLButtonElement>("[data-pmu-effect-dialog-next]");
    const counter = dialog?.querySelector<HTMLElement>("[data-pmu-effect-dialog-counter]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-pmu-effect-image]"));
    let activeIndex = 0;

    const showImage = (index: number) => {
      if (!dialogImage || cards.length === 0) return;
      activeIndex = (index + cards.length) % cards.length;
      const card = cards[activeIndex];
      dialogImage.src = card.dataset.imageSrc ?? "";
      dialogImage.alt = card.dataset.imageAlt ?? "";
      if (counter) counter.textContent = `${activeIndex + 1} / ${cards.length}`;
    };

    const closeDialog = () => {
      if (!dialog) return;
      if (dialog.open && typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");

      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
    };

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (!dialog || !dialogImage) return;
        showImage(index);

        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");

        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
      });
    });

    close?.addEventListener("click", closeDialog);
    previous?.addEventListener("click", () => showImage(activeIndex - 1));
    next?.addEventListener("click", () => showImage(activeIndex + 1));

    dialog?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showImage(activeIndex - 1);
      if (event.key === "ArrowRight") showImage(activeIndex + 1);
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) closeDialog();
    });

    dialog?.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });
  };

  bindUnifiedPmuUx();
</script>
