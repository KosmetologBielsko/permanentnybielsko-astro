---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideAssistant from "../components/GuideAssistant.astro";
import GalleryPhoto from "../components/GalleryPhoto.astro";
import { Image } from "astro:assets";
import authorPortrait from "../assets/poradnik/seria-01/boguslawa-herda-portret.webp";
import expertPortrait from "../assets/pmu-12/boguslawa-herda-doswiadczenie.webp";
import media from "../data/pmu-media-library.json";
import "../styles/pmu-gallery.css";
import "../styles/pmu-landing.css";
import "../styles/pmu-brows.css";
import "../styles/pmu-lips.css";

const booksyUrl = "https://booksy.com/pl-pl/104871_boguslawa-herda-permanentny-make-up_salon-kosmetyczny_12680_bielsko-biala";
const pageUrl = "https://www.permanentnybielsko.com/makijaz-permanentny-ust/";
const pageTitle = "Makijaż permanentny ust Bielsko-Biała | Usta permanentne 1400 zł";
const pageDescription = "Makijaż permanentny ust Bielsko-Biała u Bogusławy Herda. Naturalne usta permanentne, dobór koloru, miękki kontur, efekty, gojenie i cena 1400 zł.";
const heroPhoto = media.usta[10];
// Oryginalne prace z kategorii Usta. Nie przypisujemy niepotwierdzonego etapu wygojenia.
const lipsPhotos = [
  { ...media.usta[6], alt: "Makijaż permanentny ust — zgaszony róż i kształt ust w zbliżeniu", caption: "Zgaszony róż — kształt i kolor." },
  { ...media.usta[25], alt: "Makijaż permanentny ust — ciepły odcień w zbliżeniu", caption: "Ciepły odcień — detal ust." },
  { ...media.usta[0], alt: "Makijaż permanentny ust — czerwień i miękkie przejście konturu", caption: "Czerwień — miękkie przejście konturu." },
  { ...media.usta[5], alt: "Makijaż permanentny ust — malinowy kolor z połyskiem", caption: "Malinowy kolor — zbliżenie z połyskiem." },
];
const steps = [
  { title: "Rozmowa i ocena ust", text: "Omawiamy naturalny kolor, oczekiwania, wcześniejsze pigmentacje i zabiegi. Pytamy także o stan zdrowia oraz skłonność do opryszczki." },
  { title: "Rysunek i dobór koloru", text: "Ustalamy granicę pigmentacji, kształt i intensywność. Zanim zaczniemy, akceptujesz projekt oraz kierunek kolorystyczny." },
  { title: "Pigmentacja i zalecenia", text: "Pracujemy zgodnie z ustalonym planem. Po zabiegu otrzymujesz indywidualne zalecenia dotyczące pielęgnacji i gojenia ust." },
  { title: "Wygojenie i korekta", text: "Oceniamy wygojony kolor i równomierność pigmentacji. Korekta zabiegu głównego jest w cenie i odbywa się do 2 miesięcy od zabiegu." },
];
const faqItems = [
  { question: "Ile trwa makijaż permanentny ust?", answer: "W cenniku na zabieg przewidziano 120 minut. Zarezerwuj około 2 godzin na rozmowę, projekt, dobór koloru i pigmentację.", href: "/poradnik/ile-trwa-zabieg-makijazu-permanentnego/", label: "Jak zaplanować czas wizyty" },
  { question: "Czy makijaż permanentny ust boli?", answer: "Odczucia są indywidualne i zależą między innymi od wrażliwości oraz stanu ust. Przed zabiegiem omawiamy jego przebieg i Twój komfort.", href: "/poradnik/czy-makijaz-permanentny-boli/", label: "Odczucia podczas pigmentacji" },
  { question: "Jak goją się usta po makijażu permanentnym?", answer: "Świeży kolor może być mocniejszy, a w trakcie gojenia zmieniać intensywność. Stosuj indywidualne zalecenia gabinetu; szczegółowy przebieg i pielęgnację opisujemy w poradniku.", href: "/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/", label: "Gojenie ust dzień po dniu" },
  { question: "Kiedy ocenić kolor i trwałość efektu?", answer: "Kolor oceniamy po wygojeniu i stabilizacji, nie bezpośrednio po zabiegu. Z czasem pigment może się rozjaśniać; potrzeba odświeżenia zależy od skóry, pigmentacji i pielęgnacji.", href: "/poradnik/usta-permanentne-po-wygojeniu/", label: "Usta permanentne po wygojeniu" },
  { question: "Czy cena 1400 zł obejmuje korektę?", answer: "Tak. Zabieg główny oznaczony gwiazdką w Cenniku obejmuje korektę po wygojeniu, do 2 miesięcy od zabiegu głównego. Późniejsze odświeżenie oraz poprawa pigmentacji z innego gabinetu wymagają osobnej oceny i wyceny.", href: "/cennik-makijaz-permanentny/#price-group-3", label: "Zakres i aktualne ceny" },
  { question: "Mam skłonność do opryszczki — co ustalić przed wizytą?", answer: "Poinformuj o tym gabinet przed zabiegiem. Przygotowanie i ewentualną potrzebę konsultacji lekarskiej ustalamy indywidualnie; nie dobieraj samodzielnie leków na podstawie porad z internetu.", href: "/poradnik/opryszczka-a-makijaz-permanentny-ust/", label: "Opryszczka a pigmentacja ust" },
  { question: "Czy można wykonać PMU po powiększaniu ust?", answer: "Wymaga to indywidualnej oceny. Ważne są czas od zabiegu, stan tkanek i stabilny kształt ust. Poinformuj gabinet o wykonanych oraz planowanych zabiegach przed ustaleniem terminu.", href: "/poradnik/kwas-hialuronowy-w-ustach-a-makijaz-permanentny/", label: "Łączenie wypełniacza i PMU" },
  { question: "Jak przygotować się do wizyty i zgłosić przeciwwskazania?", answer: "Przekaż informacje o stanie ust, chorobach, przyjmowanych lekach i wcześniejszych zabiegach. Indywidualne przygotowanie oraz możliwość wykonania pigmentacji ustalamy podczas kwalifikacji.", href: "/poradnik/przeciwwskazania-do-makijazu-permanentnego/", label: "Przeciwwskazania i kwalifikacja" },
];
const guides = [
  { title: "Jak wybrać kolor ust?", text: "Naturalna czerwień wargowa, odcień skóry i oczekiwany efekt.", href: "/poradnik/makijaz-permanentny-ust-jak-wybrac-kolor/" },
  { title: "Co obejmuje cena?", text: "Zakres pigmentacji i korekta. Aktualne kwoty znajdziesz w Cenniku.", href: "/poradnik/makijaz-permanentny-ust-cena/" },
  { title: "Poprawa wcześniejszego PMU", text: "Od czego zacząć, gdy kolor lub kontur wymagają ponownej oceny.", href: "/poradnik/nieudany-makijaz-permanentny-ust/" },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "pl-PL",
    dateModified: "2026-09-19",
    isPartOf: {
      "@id": "https://www.permanentnybielsko.com/#website",
    },
    about: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: "https://www.permanentnybielsko.com/images/galeria-10/usta/usta-11.webp",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://www.permanentnybielsko.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Makijaż permanentny Bielsko-Biała",
        item: "https://www.permanentnybielsko.com/makijaz-permanentny-bielsko/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Makijaż permanentny ust",
        item: pageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: "Makijaż permanentny ust Bielsko-Biała",
    serviceType: "Makijaż permanentny ust",
    description:
      "Makijaż permanentny ust w Bielsku-Białej: naturalne odświeżenie koloru, wyrównanie czerwieni wargowej, miękki kontur i efekt bez przerysowania.",
    areaServed: [
      {
        "@type": "City",
        name: "Bielsko-Biała",
      },
      {
        "@type": "AdministrativeArea",
        name: "województwo śląskie",
      },
    ],
    provider: {
      "@id": "https://www.permanentnybielsko.com/#localbusiness",
    },
    offers: {
      "@type": "Offer",
      price: "1400",
      priceCurrency: "PLN",
      url: pageUrl,
    },
    brand: {
      "@type": "Brand",
      name: "Bogusława Herda Makijaż Permanentny",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Zakres pigmentacji ust",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Odświeżenie koloru ust",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Wyrównanie konturu ust",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Pełniejszy efekt koloru ust",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Korekta lub odświeżenie makijażu permanentnego ust",
          },
        },
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalPath="/makijaz-permanentny-ust/" structuredData={structuredData} inlineGuideAssistant>
  <Header />
  <a class="pmu-landing-skip" href="#zakres-ust">Przejdź do wyboru efektu</a>
  <main class="pmu-landing pmu-gallery pmu-brows pmu-lips">
    <div class="pmu-landing-shell">
      <nav class="pmu-landing-breadcrumbs" aria-label="Okruszki nawigacyjne"><a href="/">Strona główna</a><span aria-hidden="true">/</span><a href="/makijaz-permanentny-bielsko/">Makijaż permanentny</a><span aria-hidden="true">/</span><span aria-current="page">Usta</span></nav>
      <section class="pmu-landing-intro pmu-brows-hero" aria-labelledby="usta-tytul">
        <div>
          <p class="pmu-landing-kicker">Makijaż permanentny ust · Bielsko-Biała</p>
          <h1 id="usta-tytul"><span>Makijaż permanentny ust</span>, który odświeża kolor bez efektu przerysowania.</h1>
          <p class="pmu-landing-lead">Od delikatnego różu po wyraźniejsze podkreślenie. Dobieramy kolor do Twojej urody, a kontur do naturalnej linii ust. Zaczynamy od rozmowy i rysunku wstępnego.</p>
          <a class="pmu-landing-author" href="#doswiadczenie-ust"><Image src={authorPortrait} alt="" width={92} height={92} fit="cover" position="top" format="webp" quality={82} loading="eager" decoding="async" /><span><strong>Bogusława Herda</strong><span>Wicemistrzyni świata · trenerka PMU</span></span></a>
          <p class="pmu-lips-hero-price"><strong>1400 zł</strong><span>z korektą po wygojeniu, do 2 miesięcy</span></p>
          <div class="pmu-brows-hero-actions"><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a><a class="pmu-landing-text-link" href="tel:+48730900125">Zadzwoń: 730 900 125</a></div>
        </div>
        <figure class="pmu-brows-hero-photo"><img src={heroPhoto.thumb} srcset={heroPhoto.srcset} sizes="(max-width:640px) calc(100vw - 36px), (max-width:900px) 520px, (max-width:1156px) calc((100vw - 92px) / 2.15), 495px" width={heroPhoto.width} height={heroPhoto.height} alt="Makijaż permanentny ust — różowy kolor i miękki kontur, praca gabinetu Bogusława Herda" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Kolor dopasowany do ust. <span>Praca gabinetu Bogusława Herda.</span></figcaption></figure>
      </section>
      <nav class="pmu-landing-nav" aria-label="Przejdź do wybranej części strony"><a href="#zakres-ust">Dobór efektu ↓</a><a href="#efekty-ust">Zdjęcia i film ↓</a><a href="#cena-ust">Cena i korekta ↓</a><a href="#doswiadczenie-ust">Doświadczenie ↓</a><a href="#pytania-ust">Pytania ↓</a></nav>

      <section class="pmu-landing-section" id="zakres-ust" aria-labelledby="zakres-tytul">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">01 / Twój kolor, Twoja intensywność</p><h2 id="zakres-tytul">Subtelne odświeżenie czy więcej koloru?</h2><p>Nie musisz znać nazwy techniki. Powiedz, jaki efekt lubisz na co dzień — lekki akcent czy wyraźniejsze podkreślenie ust.</p></div>
        <div class="pmu-brows-methods">
          <article class="pmu-brows-method"><p class="pmu-landing-kicker">Natural Lips</p><h3>Delikatne odświeżenie</h3><p>Miękkie podkreślenie czerwieni wargowej i wyrównanie wrażenia koloru. Kierunek dla osoby, która chce zachować lekki, codzienny wygląd ust.</p><dl><div><dt>Co ustalamy?</dt><dd>Odcień wynikający z naturalnego koloru ust oraz delikatną intensywność po wygojeniu.</dd></div></dl><a href="#efekty-ust">Zobacz prace gabinetu <span aria-hidden="true">↓</span></a></article>
          <article class="pmu-brows-method pmu-brows-method-shade"><p class="pmu-landing-kicker">Pełniejsze nasycenie</p><h3>Wyraźniejsze podkreślenie</h3><p>Więcej koloru dla osoby, która lubi efekt zadbanej pomadki. Nasycenie dobieramy do urody i ust; kontur nadal powinien pozostać miękki.</p><dl><div><dt>Co ustalamy?</dt><dd>Zakres koloru i jego intensywność, uwzględniając wyjściową czerwień wargową oraz wcześniejszy pigment.</dd></div></dl><a href="/poradnik/makijaz-permanentny-ust-jak-wybrac-kolor/">Jak dobieramy kolor ust <span aria-hidden="true">→</span></a></article>
        </div>
        <div class="pmu-brows-choice" id="naturalny-kolor-ust"><h3>Miękki kontur, zgodny z naturalną linią ust.</h3><p><strong>Kontur z cieniowaniem</strong> łączy podkreślenie granicy czerwieni wargowej z kolorem. Pigmentacja może uporządkować jej wygląd, ale <strong>nie zwiększa objętości ust</strong>. Kształt i zakres pracy omawiamy przed zabiegiem.</p></div>
      </section>

      <section class="pmu-landing-section" id="efekty-ust" aria-labelledby="efekty-tytul" data-pmu-gallery-section data-media-label="Makijaż permanentny ust" data-service-href="/galeria/#galeria-usta" data-service-label="Więcej zdjęć ust w galerii">
        <div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">02 / Prace gabinetu</p><h2 id="efekty-tytul">Różne odcienie. Indywidualny projekt.</h2><p>Dotknij zdjęcia, aby obejrzeć je w powiększeniu. Świeża pigmentacja może być intensywniejsza niż wygojony kolor — zdjęcie służy rozmowie o kierunku, a efekt oceniamy po wygojeniu.</p></div>
        <div class="pmu-brows-photo-grid pmu-lips-photo-grid">{lipsPhotos.map(image => <GalleryPhoto image={image} />)}</div>
        <details class="pmu-landing-more pmu-brows-film"><summary>Zobacz usta w ruchu — film z gabinetu <span aria-hidden="true">+</span></summary><figure><video width="720" height="1558" controls playsinline muted preload="none" poster="/video/makijaz-permanentny-ust-efekt-01-poster.webp" aria-label="Film z gabinetu: makijaż permanentny ust w zbliżeniu"><source src="/video/makijaz-permanentny-ust-efekt-01.mp4" type="video/mp4" />Twoja przeglądarka nie obsługuje odtwarzania filmu.</video><figcaption>Kolor i kontur ust w zbliżeniu.</figcaption></figure></details>
        <div class="pmu-landing-links"><a href="/galeria/#galeria-usta">Zobacz więcej realizacji ust →</a></div>
      </section>

      <section class="pmu-landing-section pmu-brows-price" id="cena-ust" data-analytics-price="lips" data-service-key="lips" aria-labelledby="cena-tytul">
        <div><p class="pmu-landing-kicker">03 / Cena i zakres</p><h2 id="cena-tytul">Makijaż permanentny ust<br /><span class="pmu-lips-amount">1400 zł</span></h2><p>Zabieg główny poprzedzony konsultacją, rysunkiem i doborem koloru. W Cenniku sprawdzisz także odświeżenia i pozostałe usługi.</p><div class="pmu-landing-links"><a href="/cennik-makijaz-permanentny/#price-group-3">Pełny cennik makijażu permanentnego ust →</a></div></div>
        <div><h3>Korekta jest w cenie.</h3><p>Zabieg główny oznaczony gwiazdką obejmuje korektę po wygojeniu, <strong>do 2 miesięcy od zabiegu głównego</strong>.</p><p class="pmu-brows-price-note">Późniejsze odświeżenie i poprawa pracy z innego gabinetu wymagają indywidualnej oceny oraz wyceny.</p><a class="pmu-landing-primary" href={booksyUrl} target="_blank" rel="noopener noreferrer">Sprawdź terminy w Booksy <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="pmu-landing-section" id="proces-ust" aria-labelledby="proces-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">04 / Od projektu do wygojenia</p><h2 id="proces-tytul">Najpierw plan. Potem pigmentacja.</h2></div><ol class="pmu-landing-steps">{steps.map((step,index) => <li><span aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><div class="pmu-landing-links"><a href="/poradnik/makijaz-permanentny-ust-gojenie-dzien-po-dniu/">Jak goją się usta po zabiegu? →</a></div></section>

      <section class="pmu-landing-callout" id="kwalifikacja-ust" aria-labelledby="kwalifikacja-tytul"><p class="pmu-landing-kicker">Przed wyborem terminu</p><h2 id="kwalifikacja-tytul">Masz stare PMU lub wątpliwości?</h2><p>Wcześniejszy pigment, zmieniony kontur czy niedawne powiększanie ust wymagają oceny przed rezerwacją. Zgłoś także skłonność do opryszczki. Najpierw ustalamy, czy możliwa jest nowa pigmentacja, korekta koloru, czy potrzebny będzie inny plan.</p><div class="pmu-landing-links"><a class="pmu-landing-secondary" href="/makijaz-permanentny-bielsko/#kwalifikacja-pmu">Opisz swoją sytuację — formularz kwalifikacji →</a><a href="/usuwanie-makijazu-permanentnego/">Kiedy rozważyć usuwanie PMU →</a></div></section>

      <section class="pmu-landing-section pmu-landing-expert" id="doswiadczenie-ust" aria-labelledby="doswiadczenie-tytul"><figure class="pmu-landing-expert-photo"><Image src={expertPortrait} alt="Bogusława Herda — linergistka i trenerka makijażu permanentnego" width={720} widths={[240,360,540,720]} sizes="(max-width:640px) 200px, (max-width:900px) 280px, 340px" format="webp" quality={82} loading="lazy" decoding="async" /></figure><div><p class="pmu-landing-kicker">05 / Doświadczenie i uważny projekt</p><h2 id="doswiadczenie-tytul">Bogusława Herda</h2><p>Wicemistrzyni świata w makijażu permanentnym, europejski trener Long-Time-Liner® i kosmetolog z ponad 10-letnią praktyką gabinetową.</p><p class="pmu-brows-expert-note">W pigmentacji ust liczą się odcień wyjściowy, granica czerwieni wargowej oraz wygląd całej twarzy. Projekt ustalamy wspólnie, z myślą o efekcie po wygojeniu.</p><div class="pmu-landing-links"><a href="/makijaz-permanentny-bielsko/#boguslawa-herda">Poznaj doświadczenie i sposób pracy →</a></div></div></section>

      <section class="pmu-landing-faq" id="pytania-ust" aria-labelledby="faq-tytul"><p class="pmu-landing-kicker">Przed rezerwacją</p><h2 id="faq-tytul">Pytania o pigmentację ust.</h2>{faqItems.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}<br /><a class="pmu-brows-faq-link" href={item.href}>{item.label} →</a></p></details>)}</section>

      <section class="pmu-landing-section" aria-labelledby="poradniki-tytul"><div class="pmu-landing-section-heading"><p class="pmu-landing-kicker">Więcej odpowiedzi w Poradniku</p><h2 id="poradniki-tytul">Wybierz temat, który Cię interesuje.</h2></div><div class="pmu-brows-guides">{guides.map(item => <a href={item.href}><h3>{item.title}</h3><p>{item.text}</p><span>Czytaj poradnik →</span></a>)}</div></section>

